          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c59add1a4c9c86f096a8",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 32,
      "hadithIndex": 4007,
      "bookHadithIndex": 39,

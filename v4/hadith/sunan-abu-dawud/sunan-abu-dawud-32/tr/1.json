    {
      "id": "69b6c59add1a4c9c86f0969d",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 32,
      "hadithIndex": 3996,
      "bookHadithIndex": 28,
      "text": "Ebu Kılâbe'den (rivayet olunduğuna göre; Sahabilerden birine) Resulullah (s.a.)'in (\"O gün Allah'ın edeceği azabı hiç kimse edemez, onun vuracağı bağı kimse vuramaz”[Fecr 25-26.] ayetini) kendisine ... (şeklinde) okutmuştur. Ebu Davud~dedi ki: Bazıları Halid ile ebû Kılabe arasında bırravi sok­muşlardır",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-32-3996-alalbani",
          "name": "Al-Albani",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-32-3996-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Daif Isnaad"

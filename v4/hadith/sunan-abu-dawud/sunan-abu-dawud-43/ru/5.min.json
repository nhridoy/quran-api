{"total":502,"totalPage":11,"page":5,"pageSize":50,"items":[{"id":"69b6c5dbdd1a4c9c86f09a6e","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4973,"bookHadithIndex":201,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4973-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4973-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4973-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim (2408)"}]},{"id":"69b6c5dbdd1a4c9c86f09a6f","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4974,"bookHadithIndex":202,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4974-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4974-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4974-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09a70","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4975,"bookHadithIndex":203,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4975-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4975-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4975-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09a71","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4976,"bookHadithIndex":204,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4976-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4976-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4976-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4976-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09a72","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4977,"bookHadithIndex":205,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4977-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4977-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4977-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09a73","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4978,"bookHadithIndex":206,"text":"Передает Абу Умама ибн Сахль ибн Хунейф от своего отцы, что Пророк ﷺ сказал: «Пусть никто из вас ни в коем случае не говорит: “Я плох” /Хабусат нафси/, но пусть говорит: “Я заслуживаю порицания”»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4978-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4978-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4978-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (6180) Sahih Muslim (2251)"}]},{"id":"69b6c5dbdd1a4c9c86f09a74","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4979,"bookHadithIndex":207,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4979-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4979-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4979-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4979-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09a75","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4980,"bookHadithIndex":208,"text":"Передается от Хузайфы, что Пророк ﷺ сказал: «Не говорите: “Как пожелал Аллах и пожелал такой-то”, но говорите: “Как пожелал Аллах, а потом пожелал такой-то”»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4980-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4980-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4980-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4980-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09a76","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4981,"bookHadithIndex":209,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4981-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4981-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4981-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4981-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim (870)"}]},{"id":"69b6c5dbdd1a4c9c86f09a77","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4982,"bookHadithIndex":210,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4982-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4982-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4982-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09a78","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4983,"bookHadithIndex":211,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4983-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4983-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4983-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6
amid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4987-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4987-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09a7d","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4988,"bookHadithIndex":216,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4988-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4988-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4988-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4988-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (2627) Sahih Muslim (2307)"}]},{"id":"69b6c5dbdd1a4c9c86f09a7e","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4989,"bookHadithIndex":217,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4989-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4989-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4989-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (6094) Sahih Muslim (2607)"}]},{"id":"69b6c5dbdd1a4c9c86f09a7f","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4990,"bookHadithIndex":218,"text":"Сообщается, что Бахз ибн Хаким сказал: Рассказал мне мой отец со слов своего отца, который сказал: «Я слышал, как Посланник Аллаха ﷺ говорил: “Горе тому, кто рассказывает о чем-либо и лжёт, чтобы рассмешить этим людей! Горе ему, горе ему!”»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4990-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4990-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4990-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09a80","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4991,"bookHadithIndex":219,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4991-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4991-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4991-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09a81","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4992,"bookHadithIndex":220,"text":"Передают со слов Абу Хурайры (да будет доволен им Аллах), что Пророк ﷺ сказал: «Достаточно для человека греха, если он рассказывает обо всём, что он услышал»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4992-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4992-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4992-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09a82","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4993,"bookHadithIndex":221,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4993-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4993-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4993-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09a83","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4994,"bookHadithIndex":222,"text":"Сообщается, что Сафийа (бинт Хуйайй) сказала: (Однажды) ночью, когда Посланник Аллаха ﷺ неотлучно находился в мечети, я пришла навестить его. Поговорив с ним (некоторое время), я поднялась, чтобы вернуться (к себе домой), и (Пророк ﷺ тоже) поднялся вместе со мной, чтобы проводить меня. (В это время) мимо проходили двое из числа ансаров, которые ускорили шаги, увидев Пророка ﷺ. Пророк ﷺ сказал (им): «Не спешите, это ведь Сафийа бинт Хуйайй!» Они воскликнули: «Преславен Аллах, /Субхана-Ллахи/ о Посланник Аллаха!» (Тогда Пророк ﷺ) сказал: «Поистине, шайтан (проникает) в человека (распространяясь в нём) подобно крови, и, поистине, я побоялся, что он сможет заронить в ваши сердца (что-нибудь) дурное (или: … что-нибудь)!»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4994-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4994-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4994-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4994-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (3281) Sahih Muslim (2175)"}]},{"id":"69b6c5dbdd1a4c9c86f09a84","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4995,"bookHadithIndex":223,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4995-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4995-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4995-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09a85","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4996,"bookHadithIndex":224,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4996-alalbani","name":"Al-Albani","grade":"Daif Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4996-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4996-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09a86","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4997,"bookHadithIndex":225,"text":"Сообщается, что Асма бинт Аби Бакр, да будет доволен ими обоими Аллах, сказала: Одна женщина сказала: «О Посланник Аллаха, у моего мужа есть ещё одна жена. Будет ли на мне грех, если я сделаю вид /ташабба‘ту/, что получила в подарок от мужа то, чего на самом деле он мне не дарил?» (В ответ на это) Пророк ﷺ сказал (ей): «Делающий вид /муташабби‘/, что он получил то, чего (на самом деле) ему не дарили, подобен надевшему два одеяния лжи»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4997-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4997-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4997-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (5219) Sahih Muslim (2130)"}]},{"id":"69b6c5dbdd1a4c9c86f09a87","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4998,"bookHadithIndex":226,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4998-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4998-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4998-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4998-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09a88","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4999,"bookHadithIndex":227,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4999-alalbani","name":"Al-Albani","grade":"Daif Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4999-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4999-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4999-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09a89","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5000,"bookHadithIndex":228,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5000-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5000-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5000-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (3176)"}]},{"id":"69b6c5dbdd1a4c9c86f09a8a","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5001,"bookHadithIndex":229,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5001-alalbani","name":"Al-Albani","grade":"Daif Isnaad Maqtu"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5001-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif Isnaad Maqtu"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5001-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09a8b","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5002,"bookHadithIndex":230,"text":"Сообщается, что Анас (ибн Малик), да будет доволен им Аллах, сказал: «(Однажды) Посланник Аллаха ﷺ обратился ко мне так: “О двуухий”»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5002-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5002-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5002-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09a8c","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5003,"bookHadithIndex":231,"text":"Сообщается, что Язид (ас-Сакафи) слышал, как Посланник Аллаха ﷺ говорил: «Пусть никто из вас ни в коем случае не берёт вещи своего брата ни в шутку, ни всерьёз»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5003-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5003-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5003-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5003-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09a8d","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5004,"bookHadithIndex":232,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5004-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5004-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5004-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5004-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09a8e","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5005,"bookHadithIndex":233,"text":"Передается от ‘Абдуллаха бин ‘Амра бин аль-‘Аса, да будет доволен им Аллах, что Посланник Аллаха ﷺ сказал: «Поистине, Аллах ненавидит того краснобая из людей, который скручивает свой язык подобно (жующей) корове!»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5005-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5005-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5005-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09a8f","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5006,"bookHadithIndex":234,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5006-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5006-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5006-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5006-zubairalizai","name":"Zubair Ali Zai","g
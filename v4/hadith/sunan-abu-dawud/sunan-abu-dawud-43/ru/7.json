    {
      "id": "69b6c5dbdd1a4c9c86f09b00",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 43,
      "hadithIndex": 5119,
      "bookHadithIndex": 347,
      "text": "Рассказал нам Махмуд ибн Халид ад-Димашкъи: Рассказал нам аль-Фирйаби: Рассказал нам Саляма ибн Бишр ад-Димашкъи, передавший от дочери Вàсиля ибн аль-Аскъа‘ о том, что она слышала, как её отец, да будет доволен им Аллах, говорил: «(Однажды) я спросил (Пророка ﷺ): “О Посланник Аллаха, что такое слепая приверженность (к своему племени)?” Он ответил: “Это, когда ты поддерживаешь свой народ в несправедливости”»",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-43-5119-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-43-5119-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-43-5119-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-43-5119-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09b01",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 43,
      "hadithIndex": 5120,
      "bookHadithIndex": 348,
      "text": "Рассказал нам Ахмад ибн ‘Амр ибн ас-Сарх: Рассказал нам Аййюб ибн Сувайд от Усамы ибн Зейда о том, что он слышал, как Са‘ид ибн аль-Мусаййиб рассказывал от Суракъи ибн Малика ибн Джу‘шум аль-Мудлиджи, который сказал: «(Однажды) Посланник Аллаха ﷺ обратился к нам с проповедью и сказал: “Лучший из вас защищающий свой род (племя), если не совершает (при этом) грех”»",

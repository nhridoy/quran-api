{"total":502,"totalPage":11,"page":6,"pageSize":50,"items":[{"id":"69b6c5dbdd1a4c9c86f09aa0","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5023,"bookHadithIndex":251,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5023-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5023-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5023-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5023-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (6993) Sahih Muslim (2266)"}]},{"id":"69b6c5dbdd1a4c9c86f09aa1","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5024,"bookHadithIndex":252,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5024-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5024-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5024-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (7042)"}]},{"id":"69b6c5dbdd1a4c9c86f09aa2","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5025,"bookHadithIndex":253,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5025-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5025-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5025-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5025-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim (2270)"}]},{"id":"69b6c5dbdd1a4c9c86f09aa3","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5026,"bookHadithIndex":254,"text":"Передают со слов Абу Са‘ида аль-Худри, да будет доволен им Аллах, что Пророк ﷺ сказал: «Если кто-нибудь из вас (захочет) зевнуть, пусть прикроет рот рукой, (ибо иначе) шайтан обязательно проникнет в него»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5026-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5026-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5026-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5026-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim (2995)"}]},{"id":"69b6c5dbdd1a4c9c86f09aa4","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5027,"bookHadithIndex":255,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5027-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5027-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5027-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5027-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim (2995)"}]},{"id":"69b6c5dbdd1a4c9c86f09aa5","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5028,"bookHadithIndex":256,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5028-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5028-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5028-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (6226)"}]},{"id":"69b6c5dbdd1a4c9c86f09aa6","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5029,"bookHadithIndex":257,"text":"Сообщается, что Абу Хурайра, да будет доволен им Аллах, сказал: «Когда Посланник Аллаха ﷺ чихал, он прикрывал рот рукой (или: … одеждой), тем самым приглушая звук»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5029-alalbani","name":"Al-Albani","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5029-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5029-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09aa7","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5030,"bookHadithIndex":258,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5030-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5030-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5030-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim (2162)"}]},{"id":"69b6c5dbdd1a4c9c86f09aa8","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5031,"bookHadithIndex":259,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5031-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5031-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09aa9","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5032,"bookHadithIndex":260,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5032-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5032-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5032-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09aaa","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5033,"bookHadithIndex":261,"text":"Передают со слов Абу Хурайры, да будет доволен им Аллах, что Пророк ﷺ сказал: Если кто-нибудь из вас чихнёт, пусть скажет: «Хвала Аллаху!» /Аль-хамду ли-Лляхи! /, и пусть его брат (или: … его спутник) скажет ему: «Да помилует тебя Аллах!» /Йархаму-кя-Ллаху! /, а если он скажет ему: «Да помилует тебя Аллах!», пусть (чихнувший) скажет (ему в ответ): «Да укажет вам Аллах правильный путь и да приведёт Он в порядок все дела ваши!» /Йахдикуму-Ллаху ва йуслиху баля-кум","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5033-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5033-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5033-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5033-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09aab","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5034,"bookHadithIndex":262,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5034-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5034-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5034-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09aac","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5035,"bookHadithIndex":263,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5035-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5035-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5035-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09aad","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5036,"bookHadithIndex":264,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5036-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5036-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5036-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09aae","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5037,"bookHadithIndex":265,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5037-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5037-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5037-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim (2993)"}]},{"id":"69b6c5dbdd1a4c9c86f09aaf","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5038,"bookHadithIndex":266,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5038-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5038-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5038-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5038-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09ab0","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5039,"bookHadithIndex":267,"text":"Сообщается, что Анас бин Малик, да будет доволен им Аллах, сказал: (Однажды) два человека чихнули в присутствии Пророка ﷺ и одному он сказал: «Да помилует тебя Аллах!» /Йархаму-кя-Ллаху!/, другому же он этого не сказал. Тогда его спросил: «О Посланник Аллаха! (Почему когда) двое чихнули, то одному из них ты сказал: “Да помилует тебя Аллах!”, а другому ты не сказал ему этого?» (В ответ ему Пророк ﷺ) сказал: «Этот воздал хвалу Аллаху, а этот хвалы Аллаху не воздал!»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5039-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5039-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5039-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (6221) Sahih Muslim (2991)"}]},{"id":"69b6c5dbdd1a4c9c86f09ab1","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5040,"bookHadithIndex":268,"text":"Рассказал нам Мухаммад ибн аль-Мусанна: Рассказал нам Му‘аз ибн Хишам, который сказал: Рассказал мне мой отец от Яхйи ибн Аби Касира, который сказал: Рассказал нам Абу Саляма ибн ‘Абдуррахман от Йа‘иша ибн Тыхфа ибн Къайса аль-Гъифари, который сказал: «Мой отец был из числа людей живших под навесом мечети и (как-то) Посланник Аллаха ﷺ сказал (нам): “Пойдемте с нами в дом ‘Аиши, да будет доволен ею Аллах”, и мы отправились (вместе с ним, и когда мы пришли), он сказал: “О ‘Аиша, накорми нас!”, и тогда она принесла нам хашишу, и мы поели. Затем он опять сказал: “О ‘Аиша, накорми нас!”, и она принесла хейс, размером с куропатку (т.е немного), и мы поели (её). Затем он сказал: “О ‘Аиша, напои нас!”, и тогда она принесла нам кубок молока, и мы попили (его). Затем он (снова) сказал: “О Аиша, напои нас!”, и она принесла нам маленький котелок, и мы попили, после чего он сказал: “Если вы хотите, то можете заночевать (здесь), а если хотите, то можете отправиться в мечеть!”» (Мой отец) сказал: «И когда я лежал в мечети на животе из-за болезни легких, какой-то человек пошевелил меня своей ногой и сказал: “Поистине Аллах ненавидит, когда так лежат!”, и я посмотрел (на верх), и оказалось, что (этим человеком был) Посланник Аллаха ﷺ»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5040-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5040-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5040-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09ab2","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5041,"bookHadithIndex":269,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5041-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5041-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5041-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09ab3","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5042,"bookHadithIndex":270,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5042-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5042-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5042-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09ab4","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5043,"bookHadithIndex":271,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5043-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5043-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5043-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (6316) Sahih Muslim (763)"}]},{"id":"69b6c5dbdd1a4c9c86f09ab5","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5044,"bookHadithIndex":272,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5044-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5044-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5044-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09ab6","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5045,"bookHadithIndex":273,"text":"Передают со слов Хафсы, да будет доволен ею Аллах, жены Пророка ﷺ что когда Посланник Аллаха ﷺ хотел заснуть, он клал свою правую руку под голову, а потом говорил три раза: «О Аллах, упаси меня от Твоего наказания в тот День, когда Ты воскресишь Своих рабов! /Аллахумма, кы-ни ‘азаба-кя йаума таб‘асу ‘ибада-кя/»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5045-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5045-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5045-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5045-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09ab7","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5046,"bookHadithIndex":274,"text":"Сообщается, что аль-Бара бин ‘Азиб, да будет доволен им Аллах, сказал: (Однажды) Посланник Аллаха ﷺ сказал мне: «Когда (захочешь) лечь спать, соверши такое же омовение, какое совершаешь ты перед молитвой, ляг на правый бок и скажи: “О Аллах, я предался Тебе, и обратился к Тебе лицом своим, и вручил Тебе дело своё, и к Тебе обратился в поисках убежища по желанию своему и из страха (перед Тобой). Нет убежища и нет спасения от Тебя, кроме обращения к Тебе! Уверовал я в Твоё Писание, которое Ты ниспослал, и в Твоего пророка, которого Ты послал. /Аллахумма, аслямту нафси иляй-кя, ва ваджжахту ваджхи иляй-кя, ва фаввадту амри иляй-кя, ва альджаъту захри иляй-кя рагбатан ва рахбатан иляй-кя. Ля мальджаъа, ва ля манджя мин-кя илля иляй-кя! Аманту би-китаби-кя аллязи анзальта ва набиййи-кя аллязи арсальта/“»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5046-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5046-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5046-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5046-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (6311) Sahih Muslim (2710)"}]},{"id":"69b6c5dbdd1a4c9c86f09ab8","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5047,"bookHadithIndex":275,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5047-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5047-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5047-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5047-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09ab9","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5048,"bookHadithIndex":276,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5048-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5048-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5048-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5048-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09aba","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5049,"bookHadithIndex":277,"text":"Сообщается, что Хузайфа, да будет доволен Аллах ими обоими, говорил: Когда Посланник Аллаха ﷺ хотел отправиться спать, он обычно говорил: «С именем Твоим, о Аллах, я умру (и с ним) оживу» /Би-сми-кя, Аллахумма, амуту ва ахйа/, а когда просыпался, то говорил: «Хвала Аллаху, воскресившему нас после того, как Он умертвил нас, и к Нему (возвращение после) воскресения!» /Аль-хамду ли-Лляхи аллязи ахйа-на ба‘да ма амата-на ва иляй-хи-н-нушуру","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5049-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5049-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5049-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5049-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (6312)"}]},{"id":"69b6c5dbdd1a4c9c86f09abb","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5050,"bookHadithIndex":278,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5050-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5050-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5050-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (6320) Sahih Muslim (2714)"}]},{"id":"69b6c5dbdd1a4c9c86f09abc","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5051,"bookHadithIndex":279,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5051-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5051-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5051-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5051-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim (2713)"}]},{"id":"69b6c5dbdd1a4c9c86f09abd","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5052,"bookHadithIndex":280,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5052-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5052-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5052-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5052-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09abe","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5053,"bookHadithIndex":281,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5053-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5053-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5053-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5053-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim (2715)"}]},{"id":"69b6c5dbdd1a4c9c86f09abf","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5054,"bookHadithIndex":282,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5054-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5054-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5054-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09ac0","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5055,"bookHadithIndex":283,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5055-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5055-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5055-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5055-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09ac1","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5056,"bookHadithIndex":284,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5056-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5056-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5056-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5056-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (5017)"}]},{"id":"69b6c5dbdd1a4c9c86f09ac2","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5057,"bookHadithIndex":285,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5057-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5057-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5057-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5057-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09ac3","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5058,"bookHadithIndex":286,"text":"Сообщается, что Ибн ‘Умар известил о том, что обычно, когда Посланник Аллаха ﷺ ложился в постель (перед сном), он говорил: «Хвала Аллаху, Который обеспечил меня (уделом), предоставил мне убежище, накормил и напоил меня, Который оказал мне милость Свою щедро и Который даровал мне обильно. Хвала Аллаху в любой ситуации. О Аллах! Господь и Властелин всего сущего, и Бог всякой вещи! Я ищу Твоей защиты от Огня!». /Аль-Хамду ли-Лляхи-ллязи кафани уа ауани уа ат’амани уа сакани уа-ллязи манна ‘алеййя фа-афдаля уа-ллязи а’тани фа-аджзаль. Аль-Хамду ли-Лляхи ‘аля кулли халь. Аллахумма рабба кулли шейъин уа маликаху уа иляха кулли шейъин а’узу бикя мин-ан-нар","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5058-alalbani","name":"Al-Albani","grade":"Sahih Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5058-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5058-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5058-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09ac4","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5059,"bookHadithIndex":287,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5059-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5059-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5059-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09ac5","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5060,"bookHadithIndex":288,"text":"Передают со слов ‘Убады бин ас-Самита, да будет доволен им Аллах, что Пророк ﷺ сказал: «Если человек проснётся ночью и скажет: „Нет истинного бога, кроме одного лишь Аллаха, у Которого нет сотоварища, Ему принадлежит власть и Ему хвала; Он всё может; хвала Аллаху; пречист Аллах; нет истинного бога, кроме Аллаха; Аллах велик; нет мощи и силы ни у кого, кроме Аллаха /Ля иляха илля-Ллаху вахда-ху ля шарикя ля-ху, ля-ху-ль-мульку, ва ля-ху-ль-хамд, ва хуа ‘аля кулли шайй‘ин кадир; аль-хамду ли-Ллях, ва субхана-Ллах, ва ля иляха илля-Ллах, ва-Ллаху акбар, ва ля хауля ва ля куввата илля би-Ллях/“, а потом скажет: „О Аллах, прости меня! /Аллахумма-гфир ли! /“ или же обратится к Аллаху с (какой-нибудь иной) мольбой, то на мольбу его будет дан ответ, если же он совершит омовение и совершит намаз, то намаз его будет принят»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5060-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5060-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5060-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5060-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (1154)"}]},{"id":"69b6c5dbdd1a4c9c86f09ac6","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5061,"bookHadithIndex":289,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5061-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5061-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5061-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5061-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09ac7","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5062,"bookHadithIndex":290,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5062-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5062-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5062-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5062-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (5361) Sahih Muslim (2727)"}]},{"id":"69b6c5dbdd1a4c9c86f09ac8","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5063,"bookHadithIndex":291,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5063-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5063-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5063-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09ac9","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5064,"bookHadithIndex":292,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5064-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5064-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5064-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09aca","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5065,"bookHadithIndex":293,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5065-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5065-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5065-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09acb","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5066,"bookHadithIndex":294,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5066-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5066-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5066-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09acc","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5067,"bookHadithIndex":295,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5067-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5067-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5067-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09acd","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5068,"bookHadithIndex":296,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5068-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5068-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5068-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5068-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09ace","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5069,"bookHadithIndex":297,"text":"Рассказал нам Ахмад ибн Салих: Рассказал нам Мухаммад ибн Абу Фудайк, который сказал: Сообщил мне ‘Абдуррахман ибн ‘Абдульмаджид от Хишама ибн аль-Гъази ибн Раби‘а, передавшего от Макхуля ад-Димашкъи, передавшего со слов Анаса, да будет доволен им Аллах, что Посланник Аллаха ﷺ сказал: «Аллах освободит от огня четверть (тела) того, кто утром и вечером станет (один раз) произносить слова: “О Аллах, поистине, этим утром я призываю Тебя, тех, кто несёт Твой престол, Твоих ангелов и всех тех, кого Ты создал, засвидетельствовать, что Ты – Аллах, и нет бога, достойного поклонения, кроме Тебя, и что Мухаммад – Твой раб и Твой посланник /Аллахумма, инни асбахту (амсайту) ушхидука, ва ушхиду хамалята ‘аршика, ва маляикатака, ва джами‘а халькъика аннака Анта-Ллаху ля иляха илля Анта, ва анна Мухаммадан ‘абдука ва расулюка/”. Того, кто станет произносить эти слова по два раза, Аллах освободит от огня наполовину, того, кто станет делать это трижды, Аллах Всевышний освободит от огня на три четверти, того же, кто станет произносить их по четыре раза, Аллах Всевышний освободит от огня (полностью)»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5069-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5069-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5069-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09acf","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5070,"bookHadithIndex":298,"text":"Передают со слов Ибн Бурайды, передавшего со слов своего отца (Бурайды ибн Хусайба, да будет доволен им Аллах,) что Пророк ﷺ сказал: «Тот, кто скажет с наступлением утра или вечера: “О Аллах, Ты Господь мой, и нет бога, достойного поклонения, кроме Тебя; Ты создал меня, а я Твой раб, и я буду верен обещанному Тебе, пока у меня хватит сил. Прибегаю к Твоей защите от зла того, что я сделал, признаю милости, оказанные Тобой, и признаю грех свой, прости же меня, ибо, поистине, никто не прощает грехов, кроме Тебя!” /Аллахумма, Анта Рабби, ля иляха илля Анта, халякътани ва ана ‘абдука, ва ана ‘аля ‘ахдика ва ва‘дика ма-стата‘ту. А‘узу бика мин шарри ма сана‘ту, абуу би-ни‘мати-ка, ва абуу би-занби, фа-гъфир ли, фа-иннаху ля йагъфиру-з-зунуба илля Анта/, и умрёт в тот же день или ночью, войдёт в рай»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5070-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5070-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5070-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09ad0","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5071,"bookHadithIndex":299,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5071-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5071-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5071-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim (2732)"}]},{"id":"69b6c5dbdd1a4c9c86f09ad1","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5072,"bookHadithIndex":300,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5072-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5072-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5072-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]}]}
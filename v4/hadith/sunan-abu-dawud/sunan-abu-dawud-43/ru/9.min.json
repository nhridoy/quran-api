{"total":502,"totalPage":11,"page":9,"pageSize":50,"items":[{"id":"69b6c5dbdd1a4c9c86f09b36","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5173,"bookHadithIndex":401,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5173-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5173-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09b37","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5174,"bookHadithIndex":402,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5174-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5174-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5174-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09b38","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5175,"bookHadithIndex":403,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5175-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5175-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5175-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5175-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09b39","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5176,"bookHadithIndex":404,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5176-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5176-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5176-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09b3a","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5177,"bookHadithIndex":405,"text":"Сообщается, что Риб‘и (бин Хираш) сказал: Один человек из (племени) бану амир рассказал нам, что как-то раз он попросил у находившегося у себя дома Пророка ﷺ разрешения войти, сказав: «Могу ли я войти?» Тогда Посланник Аллаха ﷺ велел своему слуге: «Выйди к этому (человеку), научи его, как следует спрашивать разрешения, и скажи ему, чтобы он говорил: “Мир вам /ас-Саляму ‘алейкум/, можно ли мне войти?”» И этот человек выслушал его, а потом сказал: «Мир вам /ас-Саляму ‘алейкум/, можно ли мне войти?», после чего Пророк ﷺ разрешил ему войти и он вошёл","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5177-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5177-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5177-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09b3b","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5178,"bookHadithIndex":406,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5178-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5178-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5178-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09b3c","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5179,"bookHadithIndex":407,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5179-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5179-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5179-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5179-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09b3d","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5180,"bookHadithIndex":408,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5180-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5180-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5180-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5180-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (6245) Sahih Muslim (2153)"}]},{"id":"69b6c5dbdd1a4c9c86f09b3e","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5181,"bookHadithIndex":409,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5181-alalbani","name":"Al-Albani","grade":"Hasan Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5181-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5181-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim (2154)"}]},{"id":"69b6c5dbdd1a4c9c86f09b3f","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5182,"bookHadithIndex":410,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5182-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5182-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5182-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5182-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (2062) Sahih Muslim (2153)"}]},{"id":"69b6c5dbdd1a4c9c86f09b40","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5183,"bookHadithIndex":411,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5183-alalbani","name":"Al-Albani","grade":"Sahih Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5183-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5183-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5183-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09b41","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5184,"bookHadithIndex":412,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5184-alalbani","name":"Al-Albani","grade":"Sahih Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5184-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5184-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09b42","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5185,"bookHadithIndex":413,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5185-alalbani","name":"Al-Albani","grade":"Daif Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5185-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5185-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5185-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09b43","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5186,"bookHadithIndex":414,"text":"Сообщается, что сподвижник Пророка ﷺ ‘Абдуллах ибн Буср, да будет доволен им Аллах, сказал: «Обычно, подойдя к чьему-либо дому, Посланник Аллаха ﷺ не стоял прямо напротив двери, а становился справа или слева от нее и говорил: “Ас-саляму алейкум, ас-саляму алейкум! (Мир вам! Мир вам!)”, и это было ещё в то время, когда на дверях не было занавесок»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5186-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5186-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5186-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5186-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09b44","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5187,"bookHadithIndex":415,"text":"Сообщается, что Джабир (бин ‘Абдуллах), да будет доволен Аллах ими обоими, сказал: «(Однажды) я пришёл к Пророку ﷺ чтобы (поговорить с ним) о долге моего отца, и постучал в дверь. Он спросил: “Кто это?” Я ответил: “Я”, он же (стал повторять): “Я, я!” (говоря это так, что мне показалось), будто (мой ответ) ему не понравился»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5187-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5187-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5187-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5187-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (6250) Sahih Muslim (2155)"}]},{"id":"69b6c5dbdd1a4c9c86f09b45","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5188,"bookHadithIndex":416,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5188-alalbani","name":"Al-Albani","grade":"Hasan Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5188-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5188-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09b46","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5189,"bookHadithIndex":417,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5189-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5189-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5189-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09b47","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5190,"bookHadithIndex":418,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5190-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5190-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5190-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09b48","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5191,"bookHadithIndex":419,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5191-alalbani","name":"Al-Albani","grade":"Sahih Isnaad Mauquf"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5191-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih Isnaad Mauquf"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5191-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09b49","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5192,"bookHadithIndex":420,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5192-alalbani","name":"Al-Albani","grade":"Hasan Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5192-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5192-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09b4a","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5193,"bookHadithIndex":421,"text":"Передают со слов Абу Хурайры, да будет доволен им Аллах, что Посланник Аллаха ﷺ сказал: «Клянусь Тем, в чьей длани душа моя, не войдёте вы в рай, пока не уверуете, а не уверуете вы до тех пор, пока не станете любить друг друга, так не указать ли мне вам на то, что приведёт вас к взаимной любви, если вы будете делать это? Распространяйте мир между собой!»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5193-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5193-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5193-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5193-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim (54)"}]},{"id":"69b6c5dbdd1a4c9c86f09b4b","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5194,"bookHadithIndex":422,"text":"Сообщается, что ‘Абдуллах бин ‘Амр бин аль-‘Ас, да будет доволен Аллах ими обоими, сказал: Один человек спросил Посланника Аллаха ﷺ: «Какое (проявление) ислама является наилучшим?» Он ответил: «(Лучшее состоит в том, чтобы) ты кормил (людей) и приветствовал тех, кого знаешь и кого не знаешь»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5194-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5194-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5194-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5194-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (28) Sahih Muslim (39)"}]},{"id":"69b6c5dbdd1a4c9c86f09b4c","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5195,"bookHadithIndex":423,"text":"Сообщается, что ‘Имран бин аль-Хусайн, да будет доволен Аллах ими обоими, сказал: Один человек пришёл к Пророку ﷺ и сказал: «Мир вам!», и он ответил на приветствие (этого человека), после чего тот сел, а Пророк ﷺ сказал: «Десять». Потом пришёл другой и сказал: «Мир вам и милость Аллаха!», и он ответил на приветствие (этого человека), после чего тот сел, а (Пророк ﷺ сказал): «Двадцать». Потом пришёл другой и сказал: «Мир вам, милость Аллаха и Его благословения!», и он ответил на приветствие (этого человека), после чего тот сел, а (Пророк ﷺ), сказал: «Тридцать»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5195-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5195-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5195-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09b4d","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5196,"bookHadithIndex":424,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5196-alalbani","name":"Al-Albani","grade":"Daif Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5196-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif Isnaad"}]},{"id":"69b6c5dbdd1a4c9c86f09b4e","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5197,"bookHadithIndex":425,"text":"Абу Умама (Судайй бин ‘Аджлян аль-Бахили), да будет доволен им Аллах, передал, что Посланник Аллаха ﷺ сказал: «Поистине, самыми близкими людьми к Аллаху являются те, кто приветствует (других) первыми»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5197-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5197-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5197-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09b4f","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5198,"bookHadithIndex":426,"text":"Передают со слов Абу Хурайры, да будет доволен им Аллах, что Пророк ﷺ сказал: «Младший (должен первым) приветствовать салямом старшего, идущий сидящего, а меньшая (по количеству группа людей) большую»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5198-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5198-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5198-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09b50","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5199,"bookHadithIndex":427,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5199-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5199-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5199-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (6233) Sahih Muslim (2160)"}]},{"id":"69b6c5dbdd1a4c9c86f09b51","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5200,"bookHadithIndex":428,"text":"Передают со слов Абу Хурайры, да будет доволен им Аллах, что Посланник Аллаха ﷺ сказал: «Когда кто-нибудь из вас встретит своего брата, пусть приветствует его салямом, если же (в это время) их будет отделять друг от друга дерево, стена или камень, пусть приветствует его салямом, когда встретится с ним потом»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5200-alalbani","name":"Al-Albani","grade":"Sahih Muquf"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5200-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih Muquf"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5200-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09b52","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5201,"bookHadithIndex":429,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5201-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5201-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5201-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09b53","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5202,"bookHadithIndex":430,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5202-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5202-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5202-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5202-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09b54","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5203,"bookHadithIndex":431,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5203-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5203-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5203-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5203-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09b55","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5204,"bookHadithIndex":432,"text":"Сообщается, что Асма бинт Йазид, да будет доволен ею Аллах, сказала: (Однажды) Пророк ﷺ проходивший мимо нас, находившихся среди (других) женщин, приветствовал нас","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5204-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5204-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5204-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09b56","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5205,"bookHadithIndex":433,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5205-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5205-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5205-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5205-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim (2167)"}]},{"id":"69b6c5dbdd1a4c9c86f09b57","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5206,"bookHadithIndex":434,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5206-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5206-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5206-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5206-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih Sahih Bukhari (6257) Sahih Muslim (2164)"}]},{"id":"69b6c5dbdd1a4c9c86f09b58","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5207,"bookHadithIndex":435,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5207-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5207-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5207-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5207-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (6258، 6024) Sahih Muslim (2163، 2165)"}]},{"id":"69b6c5dbdd1a4c9c86f09b59","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5208,"bookHadithIndex":436,"text":"Передают со слов Абу Хурайры, да будет доволен им Аллах, что Посланник Аллаха ﷺ сказал: «Когда кто-нибудь из вас явится в собрание, пусть приветствует салямом (присутствующих), и когда он захочет уйти, пусть (тоже) приветствует салямом их, ибо первое не более обязательно, чем второе»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5208-alalbani","name":"Al-Albani","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5208-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5208-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5208-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09b5a","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5209,"bookHadithIndex":437,"text":"Сообщается, что Абу Джурайй аль-Худжайми, да будет доволен Аллах ими обоими, сказал: Я пришёл к Посланнику Аллаха ﷺ и сказал (ему): «Тебе мир /‘Аляй-кя-с-саляму/, о Посланник Аллаха!» (На это) он сказал (мне): «Не говори “Тебе мир”, ибо (словами) “Тебе мир” приветствуют покойных»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5209-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5209-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5209-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5209-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09b5b","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5210,"bookHadithIndex":438,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5210-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5210-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5210-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09b5c","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5211,"bookHadithIndex":439,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5211-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5211-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5211-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09b5d","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5212,"bookHadithIndex":440,"text":"Передают со слов аль-Бараъ, да будет доволен им Аллах, что Пророк ﷺ сказал: «Когда двое мусульман встречаются и пожимают друг другу руки (, их прегрешения) обязательно прощаются им ещё до того, как они расстаются друг с другом»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5212-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5212-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5212-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5212-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09b5e","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5213,"bookHadithIndex":441,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5213-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5213-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5213-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09b5f","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5214,"bookHadithIndex":442,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5214-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5214-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5214-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09b60","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5215,"bookHadithIndex":443,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5215-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5215-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5215-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5215-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (4121) Sahih Muslim (1768)"}]},{"id":"69b6c5dbdd1a4c9c86f09b61","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5216,"bookHadithIndex":444,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5216-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5216-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5216-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09b62","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5217,"bookHadithIndex":445,"text":"Сообщается, что мать правоверных ‘Аиша, да будет доволен ею Аллах, сказала: «Я никого не видела более похожим на Посланника Аллаха ﷺ внешностью, в образе жизни, в достоинствах и в речи, чем Фатима, да возвеличит её Аллах! Когда она приходила к нему, он вставал ей навстречу, брал её за руку, целовал её и усаживал на своё место. А когда он приходил к ней, она вставала ему навстречу, брала его за руку, целовала его и усаживала на своё место»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5217-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5217-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5217-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5217-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c5dbdd1a4c9c86f09b63","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5218,"bookHadithIndex":446,"text":"Сообщается, что Абу Хурайра, да будет доволен им Аллах, сказал: (Однажды, когда) Пророк ﷺ поцеловал аль-Хасана бин Али, да будет доволен им Аллах, в присутствии аль-Акра‘а бин Хабиса, аль-Акра‘ сказал: «Поистине, у меня есть десять сыновей, но я (ни разу) не поцеловал никого из них!» Тогда Посланник Аллаха ﷺ сказал: «Не помилуют того, кто сам не жалеет (других)!»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5218-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5218-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5218-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5218-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (5997) Sahih Muslim (2118)"}]},{"id":"69b6c5dbdd1a4c9c86f09b64","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5219,"bookHadithIndex":447,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5219-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5219-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5219-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09b65","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5220,"bookHadithIndex":448,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5220-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5220-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5220-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c5dbdd1a4c9c86f09b66","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5221,"bookHadithIndex":449,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5221-alalbani","name":"Al-Albani","grade":"Sahih Isnaad Maqtu"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5221-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih Isnaad Maqtu"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5221-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c5dbdd1a4c9c86f09b67","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":5222,"bookHadithIndex":450,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-5222-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5222-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-5222-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (3918)"}]}]}
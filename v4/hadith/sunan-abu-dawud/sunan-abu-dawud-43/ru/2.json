    },
    {
      "id": "69b6c59add1a4c9c86f099f8",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 43,
      "hadithIndex": 4855,
      "bookHadithIndex": 83,
      "text": "Передают со слов Абу Хурайры, да будет доволен им Аллах, что Посланник Аллаха ﷺ сказал: «Люди, покидающие собрание, в котором они не поминают Аллаха Всевышнего, (всегда) покидают нечто подобное туше дохлого осла и испытают (из-за этого) скорбь»",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-43-4855-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-43-4855-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-43-4855-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c59add1a4c9c86f099f9",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 43,
      "hadithIndex": 4856,
      "bookHadithIndex": 84,
      "text": "Передают со слов Абу Хурайры, да будет доволен им Аллах, что Посланник Аллаха ﷺ сказал: «Отмщение /тира/ Аллаха постигнет того, кто усядется где-либо, не помянув там Аллаха Всевышнего, как постигнет оно и того, кто уляжется где-либо, не помянув там Аллаха Всевышнего!»",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-43-4856-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {

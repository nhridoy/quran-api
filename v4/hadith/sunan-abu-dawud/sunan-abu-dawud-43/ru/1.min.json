okIndex":43,"hadithIndex":4799,"bookHadithIndex":27,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4799-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4799-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4799-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c59add1a4c9c86f099c1","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4800,"bookHadithIndex":28,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4800-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4800-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4800-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c59add1a4c9c86f099c2","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4801,"bookHadithIndex":29,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4801-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4801-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4801-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4801-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c59add1a4c9c86f099c3","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4802,"bookHadithIndex":30,"text":"Сообщается, что Анас, да будет доволен им Аллах, сказал: «(У Пророка, да будет доволен им Аллах, была верблюдица по кличке) аль-‘Адба, которую никто не мог обогнать, но однажды приехал какой-то бедуин на верблюде, которому было меньше шести лет, и обогнал её. Мусульмане были так огорчены этим, что (Пророк ﷺ) заметил это и сказал: «Что бы ни возвысилось в мире этом, Аллах обязательно принижает это»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4802-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4802-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4802-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4802-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c59add1a4c9c86f099c4","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4803,"bookHadithIndex":31,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4803-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4803-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4803-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4803-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (6501)"}]},{"id":"69b6c59add1a4c9c86f099c5","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4804,"bookHadithIndex":32,"text":"Передается от Хаммама (бин аль-Хариса), что (как-то раз один) человек принялся восхвалять ‘Усмана в присутствии аль-Микдада и тогда аль-Микдад взял землю и стал бросать в лицо (восхвалявшему), сказав: «Поистине, Посланник Аллаха ﷺ сказал: “Если увидите восхваляющих, забросайте их лица землёй!”»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4804-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4804-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4804-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim (3002)"}]},{"id":"69b6c59add1a4c9c86f099c6","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4805,"bookHadithIndex":33,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4805-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4805-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4805-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (6061) Sahih Muslim (3000)"}]},{"id":"69b6c59add1a4c9c86f099c7","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4806,"bookHadithIndex":34,"text":"Сообщается, что ‘Абдуллах ибн аш-Шиххир рассказывал: «Однажды я пришел к Посланнику Аллаха ﷺ в составе делегации (племени) бану ‘амир, и мы сказали: “Ты наш господин (сеййид)!”, но он ответил: “Господь (ас-сеййид) это Всевышний Аллах!” Тогда мы сказали: “(Ты) самый достойный и самый великий из нас!” (Пророк ﷺ) сказал: “Говорите ваши слова или некоторые из ваших слов, но пусть шайтан не завлечет вас (в чрезмерность)!”»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4806-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4806-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4806-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c59add1a4c9c86f099c8","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4807,"bookHadithIndex":35,"text":"Передается от ‘Абдуллаха ибн Мугаффаля, да будет доволен им Аллах, что Посланник Аллаха ﷺ сказал: «Поистине, Аллах добр, Он любит доброту и дарует за неё то, чего не дарует за суровость»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4807-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4807-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4807-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c59add1a4c9c86f099c9","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4808,"bookHadithIndex":36,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4808-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4808-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4808-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c59add1a4c9c86f099ca","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4809,"bookHadithIndex":37,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4809-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4809-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4809-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim (2592)"}]},{"id":"69b6c59add1a4c9c86f099cb","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4810,"bookHadithIndex":38,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4810-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4810-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4810-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c59add1a4c9c86f099cc","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4811,"bookHadithIndex":39,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4811-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4811-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4811-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4811-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c59add1a4c9c86f099cd","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4812,"bookHadithIndex":40,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4812-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4812-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4812-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4812-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c59add1a4c9c86f099ce","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4813,"bookHadithIndex":41,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4813-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4813-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4813-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4813-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c59add1a4c9c86f099cf","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4814,"bookHadithIndex":42,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4814-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4814-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4814-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c59add1a4c9c86f099d0","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4815,"bookHadithIndex":43,"text":"Передается от Абу Са‘ида аль-Худри что (однажды) Пророк ﷺ сказал: «Ни в коем случае не следует вам сидеть на дорогах!» (Люди) сказали: «Но мы обязательно должны (делать это), ведь там мы (собираемся и) беседуем (друг с другом)!» Тогда Посланник Аллаха ﷺ сказал: «Если уж вам непременно нужно (собираться там, то по крайней мере) воздавайте дороге должное!» (Люди) спросили: «А что значит воздавать должное дороге?» Он ответил: «(Это значит) потуплять взоры, (никому) не причинять вреда, отвечать на приветствия, побуждать к одобряемому и удерживать от порицаемого»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4815-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4815-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4815-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (2465) Sahih Muslim (2121)"}]},{"id":"69b6c59add1a4c9c86f099d1","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4816,"bookHadithIndex":44,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4816-alalbani","name":"Al-Albani","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4816-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4816-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c59add1a4c9c86f099d2","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4817,"bookHadithIndex":45,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4817-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4817-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4817-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c59add1a4c9c86f099d3","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4818,"bookHadithIndex":46,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4818-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4818-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4818-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c59add1a4c9c86f099d4","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4819,"bookHadithIndex":47,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4819-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4819-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4819-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4819-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (2326)"}]},{"id":"69b6c59add1a4c9c86f099d5","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4820,"bookHadithIndex":48,"text":"Сообщается, что Абу Са‘ид аль-Худри, да будет доволен им Аллах, сказал: Я слышал, как Посланник Аллаха ﷺ сказал: «Лучшими местами для собраний являются наиболее просторные из них»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4820-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4820-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4820-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4820-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c59add1a4c9c86f099d6","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4821,"bookHadithIndex":49,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4821-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4821-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4821-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4821-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c59add1a4c9c86f099d7","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":43,"hadithIndex":4822,"bookHadithIndex":50,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-43-4822-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4822-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4822-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-43-4822-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]}]}
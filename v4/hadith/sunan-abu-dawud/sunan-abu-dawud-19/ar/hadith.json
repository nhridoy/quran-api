    },
    {
      "id": "69b6c518dd1a4c9c86f09254",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2899,
      "bookHadithIndex": 15,
      "text": "حدثنا حفص بن عمر، حدثنا شعبة، عن بديل، عن علي بن ابي طلحة، عن راشد بن سعد، عن ابي عامر الهوزني عبد الله بن لحى، عن المقدام، قال قال رسول الله صلى الله عليه وسلم \" من ترك كلا فالى \" . وربما قال \" الى الله والى رسوله \" . \" ومن ترك مالا فلورثته وانا وارث من لا وارث له اعقل له وارثه والخال وارث من لا وارث له يعقل عنه ويرثه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2899-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2899-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2899-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2899-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f09255",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2900,
      "bookHadithIndex": 16,
      "text": "حدثنا سليمان بن حرب، - في اخرين - قالوا حدثنا حماد، عن بديل، - يعني ابن ميسرة - عن علي بن ابي طلحة، عن راشد بن سعد، عن ابي عامر الهوزني، عن المقدام الكندي، قال قال رسول الله صلى الله عليه وسلم \" انا اولى بكل مومن من نفسه فمن ترك دينا او ضيعة فالى ومن ترك مالا فلورثته وانا مولى من لا مولى له ارث ماله وافك عانه والخال مولى من لا مولى له يرث ماله ويفك عانه \" . قال ابو داود رواه الزبيدي عن راشد بن سعد عن ابن عايذ عن المقدام ورواه معاوية بن صالح عن راشد قال سمعت المقدام . قال ابو داود يقول الضيعة معناه عيال",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2900-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2900-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2900-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2900-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f09256",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2901,
      "bookHadithIndex": 17,
      "text": "حدثنا عبد السلام بن عتيق الدمشقي، حدثنا محمد بن المبارك، حدثنا اسماعيل بن عياش، عن يزيد بن حجر، عن صالح بن يحيى بن المقدام، عن ابيه، عن جده، قال سمعت رسول الله صلى الله عليه وسلم يقول \" انا وارث من لا وارث له افك عانيه وارث ماله والخال وارث من لا وارث له يفك عانيه ويرث ماله",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2901-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2901-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2901-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f09257",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2902,
      "bookHadithIndex": 18,
      "text": "حدثنا مسدد، حدثنا يحيى، حدثنا شعبة، ح وحدثنا عثمان بن ابي شيبة، حدثنا وكيع بن الجراح، عن سفيان، جميعا عن ابن الاصبهاني، عن مجاهد بن وردان، عن عروة، عن عايشة، رضى الله عنها ان مولى، للنبي صلى الله عليه وسلم مات وترك شييا ولم يدع ولدا ولا حميما فقال النبي صلى الله عليه وسلم \" اعطوا ميراثه رجلا من اهل قريته \" . قال ابو داود وحديث سفيان اتم وقال مسدد قال فقال النبي صلى الله عليه وسلم \" ها هنا احد من اهل ارضه \" . قالوا نعم . قال \" فاعطوه ميراثه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2902-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2902-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2902-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f09258",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2903,
      "bookHadithIndex": 19,
      "text": "حدثنا عبد الله بن سعيد الكندي، حدثنا المحاربي، عن جبريل بن احمر، عن عبد الله بن بريدة، عن ابيه، قال اتى النبي صلى الله عليه وسلم رجل فقال ان عندي ميراث رجل من الازد ولست اجد ازديا ادفعه اليه . قال \" اذهب فالتمس ازديا حولا \" . قال فاتاه بعد الحول فقال يا رسول الله لم اجد ازديا ادفعه اليه . قال \" فانطلق فانظر اول خزاعي تلقاه فادفعه اليه \" . فلما ولى قال \" على الرجل \" . فلما جاء قال \" انظر كبر خزاعة فادفعه اليه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2903-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2903-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2903-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f09259",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2904,
      "bookHadithIndex": 20,
      "text": "حدثنا الحسين بن اسود العجلي، حدثنا يحيى بن ادم، حدثنا شريك، عن جبريل بن احمر ابي بكر، عن ابن بريدة، عن ابيه، قال مات رجل من خزاعة فاتي النبي صلى الله عليه وسلم بميراثه فقال \" التمسوا له وارثا او ذا رحم \" . فلم يجدوا له وارثا ولا ذا رحم فقال رسول الله صلى الله عليه وسلم \" اعطوه الكبر من خزاعة \" . قال يحيى قد سمعته مرة يقول في هذا الحديث \" انظروا اكبر رجل من خزاعة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2904-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2904-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2904-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f0925a",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2905,
      "bookHadithIndex": 21,
      "text": "حدثنا موسى بن اسماعيل، حدثنا حماد، اخبرنا عمرو بن دينار، عن عوسجة، عن ابن عباس، ان رجلا، مات ولم يدع وارثا الا غلاما له كان اعتقه فقال رسول الله صلى الله عليه وسلم \" هل له احد \" . قالوا لا الا غلاما له كان اعتقه . فجعل رسول الله صلى الله عليه وسلم ميراثه له",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2905-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2905-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2905-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2905-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f0925b",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2906,
      "bookHadithIndex": 22,
      "text": "حدثنا ابراهيم بن موسى الرازي، حدثنا محمد بن حرب، حدثني عمر بن روبة التغلبي، عن عبد الواحد بن عبد الله النصري، عن واثلة بن الاسقع، عن النبي صلى الله عليه وسلم قال \" المراة تحرز ثلاثة مواريث عتيقها ولقيطها وولدها الذي لاعنت عنه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2906-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2906-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2906-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2906-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f0925c",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2907,
      "bookHadithIndex": 23,
      "text": "حدثنا محمود بن خالد، وموسى بن عامر، قالا حدثنا الوليد، اخبرنا ابن جابر، حدثنا مكحول، قال جعل رسول الله صلى الله عليه وسلم ميراث ابن الملاعنة لامه ولورثتها من بعدها",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2907-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2907-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2907-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f0925d",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2908,
      "bookHadithIndex": 24,
      "text": "حدثنا موسى بن عامر، حدثنا الوليد، اخبرني عيسى ابو محمد، عن العلاء بن الحارث، عن عمرو بن شعيب، عن ابيه، عن جده، عن النبي صلى الله عليه وسلم مثله",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2908-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2908-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2908-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f0925e",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2909,
      "bookHadithIndex": 25,
      "text": "حدثنا مسدد، حدثنا سفيان، عن الزهري، عن علي بن حسين، عن عمرو بن عثمان، عن اسامة بن زيد، عن النبي صلى الله عليه وسلم قال \" لا يرث المسلم الكافر ولا الكافر المسلم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2909-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2909-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2909-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari (4282، 4283) Sahih Muslim (1614)"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f0925f",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2910,
      "bookHadithIndex": 26,
      "text": "حدثنا احمد بن حنبل، حدثنا عبد الرزاق، اخبرنا معمر، عن الزهري، عن علي بن حسين، عن عمرو بن عثمان، عن اسامة بن زيد، قال قلت يا رسول الله اين تنزل غدا في حجته . قال \" وهل ترك لنا عقيل منزلا \" . ثم قال \" نحن نازلون بخيف بني كنانة حيث تقاسمت قريش على الكفر \" . يعني المحصب وذاك ان بني كنانة حالفت قريشا على بني هاشم ان لا يناكحوهم ولا يبايعوهم ولا ييووهم . قال الزهري والخيف الوادي",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2910-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2910-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2910-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2910-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari (3058) Sahih Muslim (1351)"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f09260",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2911,
      "bookHadithIndex": 27,
      "text": "حدثنا موسى بن اسماعيل، حدثنا حماد، عن حبيب المعلم، عن عمرو بن شعيب، عن ابيه، عن جده عبد الله بن عمرو، قال قال رسول الله صلى الله عليه وسلم \" لا يتوارث اهل ملتين شتى",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2911-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2911-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2911-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2911-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f09261",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2912,
      "bookHadithIndex": 28,
      "text": "حدثنا مسدد، حدثنا عبد الوارث، عن عمرو بن ابي حكيم الواسطي، حدثنا عبد الله بن بريدة، ان اخوين، اختصما الى يحيى بن يعمر يهودي ومسلم فورث المسلم منهما وقال حدثني ابو الاسود ان رجلا حدثه ان معاذا حدثه قال سمعت رسول الله صلى الله عليه وسلم يقول \" الاسلام يزيد ولا ينقص \" . فورث المسلم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2912-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"

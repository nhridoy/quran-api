      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f09247",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2886,
      "bookHadithIndex": 2,
      "text": "حدثنا احمد بن حنبل، حدثنا سفيان، قال سمعت ابن المنكدر، انه سمع جابرا، يقول مرضت فاتاني النبي صلى الله عليه وسلم يعودني هو وابو بكر ماشيين وقد اغمي على فلم اكلمه فتوضا وصبه على فافقت فقلت يا رسول الله كيف اصنع في مالي ولي اخوات قال فنزلت اية المواريث { يستفتونك قل الله يفتيكم في الكلالة}",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2886-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2886-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2886-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari (6723) Sahih Muslim (1616)"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f09248",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2887,
      "bookHadithIndex": 3,
      "text": "حدثنا عثمان بن ابي شيبة، حدثنا كثير بن هشام، حدثنا هشام، - يعني الدستوايي - عن ابي الزبير، عن جابر، قال اشتكيت وعندي سبع اخوات فدخل على رسول الله صلى الله عليه وسلم فنفخ في وجهي فافقت فقلت يا رسول الله الا اوصي لاخواتي بالثلث قال \" احسن \" . قلت الشطر قال \" احسن \" . ثم خرج وتركني فقال \" يا جابر لا اراك ميتا من وجعك هذا وان الله قد انزل فبين الذي لاخواتك فجعل لهن الثلثين \" . قال فكان جابر يقول انزلت هذه الاية في { يستفتونك قل الله يفتيكم في الكلالة}",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2887-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2887-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2887-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f09249",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2888,
      "bookHadithIndex": 4,
      "text": "حدثنا مسلم بن ابراهيم، حدثنا شعبة، عن ابي اسحاق، عن البراء بن عازب، قال اخر اية نزلت في الكلالة { يستفتونك قل الله يفتيكم في الكلالة}",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2888-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2888-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2888-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2888-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari (4605) Sahih Muslim (1618)"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f0924a",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2889,
      "bookHadithIndex": 5,
      "text": "حدثنا منصور بن ابي مزاحم، حدثنا ابو بكر، عن ابي اسحاق، عن البراء بن عازب، قال جاء رجل الى النبي صلى الله عليه وسلم فقال يا رسول الله يستفتونك في الكلالة فما الكلالة قال \" تجزيك اية الصيف \" . فقلت لابي اسحاق هو من مات ولم يدع ولدا ولا والدا قال كذلك ظنوا انه كذلك",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2889-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2889-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2889-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2889-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f0924b",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2890,
      "bookHadithIndex": 6,
      "text": "حدثنا عبد الله بن عامر بن زرارة، حدثنا علي بن مسهر، عن الاعمش، عن ابي قيس الاودي، عن هزيل بن شرحبيل الاودي، قال جاء رجل الى ابي موسى الاشعري وسلمان بن ربيعة فسالهما عن ابنة وابنة ابن واخت، لاب وام فقالا لابنته النصف وللاخت من الاب والام النصف ولم يورثا ابنة الابن شييا وات ابن مسعود فانه سيتابعنا فاتاه الرجل فساله واخبره بقولهما فقال لقد ضللت اذا وما انا من المهتدين ولكني ساقضي فيها بقضاء النبي صلى الله عليه وسلم لابنته النصف ولابنة الابن سهم تكملة الثلثين وما بقي فللاخت من الاب والام",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2890-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2890-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2890-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari (6736)"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f0924c",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2891,
      "bookHadithIndex": 7,
      "text": "حدثنا مسدد، حدثنا بشر بن المفضل، حدثنا عبد الله بن محمد بن عقيل، عن جابر بن عبد الله، قال خرجنا مع رسول الله صلى الله عليه وسلم حتى جينا امراة من الانصار في الاسواق فجاءت المراة بابنتين لها فقالت يا رسول الله هاتان بنتا ثابت بن قيس قتل معك يوم احد وقد استفاء عمهما مالهما وميراثهما كله فلم يدع لهما مالا الا اخذه فما ترى يا رسول الله فوالله لا تنكحان ابدا الا ولهما مال . فقال رسول الله صلى الله عليه وسلم \" يقضي الله في ذلك \" . قال ونزلت سورة النساء { يوصيكم الله في اولادكم } الاية . فقال رسول الله صلى الله عليه وسلم \" ادعوا لي المراة وصاحبها \" . فقال لعمهما \" اعطهما الثلثين واعط امهما الثمن وما بقي فلك \" . قال ابو داود اخطا بشر فيه انما هما ابنتا سعد بن الربيع وثابت بن قيس قتل يوم اليمامة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2891-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2891-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2891-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2891-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f0924d",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2892,
      "bookHadithIndex": 8,
      "text": "حدثنا ابن السرح، حدثنا ابن وهب، اخبرني داود بن قيس، وغيره، من اهل العلم عن عبد الله بن محمد بن عقيل، عن جابر بن عبد الله، ان امراة، سعد بن الربيع قالت يا رسول الله ان سعدا هلك وترك ابنتين . وساق نحوه قال ابو داود وهذا هو الصواب",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2892-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2892-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2892-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f0924e",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2893,
      "bookHadithIndex": 9,
      "text": "حدثنا موسى بن اسماعيل، حدثنا ابان، حدثنا قتادة، حدثني ابو حسان، عن الاسود بن يزيد، ان معاذ بن جبل، ورث اختا وابنة فجعل لكل واحدة منهما النصف وهو باليمن ونبي الله صلى الله عليه وسلم يوميذ حى",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2893-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2893-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2893-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari (6734)"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f0924f",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2894,
      "bookHadithIndex": 10,
      "text": "حدثنا القعنبي، عن مالك، عن ابن شهاب، عن عثمان بن اسحاق بن خرشة، عن قبيصة بن ذويب، انه قال جاءت الجدة الى ابي بكر الصديق تساله ميراثها فقال ما لك في كتاب الله تعالى شىء وما علمت لك في سنة نبي الله صلى الله عليه وسلم شييا فارجعي حتى اسال الناس . فسال الناس فقال المغيرة بن شعبة حضرت رسول الله صلى الله عليه وسلم اعطاها السدس . فقال ابو بكر هل معك غيرك فقام محمد بن مسلمة فقال مثل ما قال المغيرة بن شعبة فانفذه لها ابو بكر ثم جاءت الجدة الاخرى الى عمر بن الخطاب رضى الله عنه تساله ميراثها فقال ما لك في كتاب الله تعالى شىء وما كان القضاء الذي قضي به الا لغيرك وما انا بزايد في الفرايض ولكن هو ذلك السدس فان اجتمعتما فيه فهو بينكما وايتكما خلت به فهو لها",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2894-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2894-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2894-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2894-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f09250",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2895,
      "bookHadithIndex": 11,
      "text": "حدثنا محمد بن عبد العزيز بن ابي رزمة، اخبرني ابي، حدثنا عبيد الله ابو المنيب العتكي، عن ابن بريدة، عن ابيه، ان النبي صلى الله عليه وسلم جعل للجدة السدس اذا لم تكن دونها ام",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2895-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2895-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2895-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2895-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f09251",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2896,
      "bookHadithIndex": 12,
      "text": "حدثنا محمد بن كثير، اخبرنا همام، عن قتادة، عن الحسن، عن عمران بن حصين، ان رجلا، اتى النبي صلى الله عليه وسلم فقال ان ابن ابني مات فما لي من ميراثه فقال \" لك السدس \" . فلما ادبر دعاه فقال \" لك سدس اخر \" . فلما ادبر دعاه فقال \" ان السدس الاخر طعمة \" . قال قتادة فلا يدرون مع اى شىء ورثه . قال قتادة اقل شىء ورث الجد السدس",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2896-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2896-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2896-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f09252",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2897,
      "bookHadithIndex": 13,
      "text": "حدثنا وهب بن بقية، عن خالد، عن يونس، عن الحسن، ان عمر، قال ايكم يعلم ما ورث رسول الله صلى الله عليه وسلم الجد فقال معقل بن يسار انا ورثه رسول الله صلى الله عليه وسلم السدس . قال مع من قال لا ادري . قال لا دريت فما تغني اذا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2897-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2897-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2897-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f09253",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 19,
      "hadithIndex": 2898,
      "bookHadithIndex": 14,
      "text": "حدثنا احمد بن صالح، ومخلد بن خالد، - وهذا حديث مخلد وهو الاشبع - قال حدثنا عبد الرزاق حدثنا معمر عن ابن طاوس عن ابيه عن ابن عباس قال قال رسول الله صلى الله عليه وسلم \" اقسم المال بين اهل الفرايض على كتاب الله فما تركت الفرايض فلاولى ذكر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2898-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2898-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-19-2898-shuaibalarnaut",

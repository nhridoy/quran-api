        }
      ]
    },
    {
      "id": "69b6c4d4dd1a4c9c86f08d00",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 8,
      "hadithIndex": 1535,
      "bookHadithIndex": 120,
      "text": "Abdullah b. Amr b. el-As (r.a.)'dan rivayet edildiğine göre, Resulullah (s.a.v.) şöyle buyurmuştur: \"En çabuk kabul edilen dua, gaibin gâib için yaptığı duadır",
      "grades": [

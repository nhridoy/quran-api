      ]
    },
    {
      "id": "69b6c4d4dd1a4c9c86f08d0f",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 8,
      "hadithIndex": 1550,
      "bookHadithIndex": 135,
      "text": "Ferve b. Nevfel el-Eşca'î'den: demiştir ki: - Mü'minlerin anası Âişe (r.anhâ)'ya Resûlullah (s.a.v.)'in nasıl dua ettiğim sordum, şöyle cevap verdi: \"Allah'ım, yaptıklarımın ve yapmadıklarımın şerrinden sana sığınırım\" derdi",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-8-1550-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-8-1550-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-8-1550-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {

        }
      ]
    },
    {
      "id": "69b6c4d4dd1a4c9c86f08d09",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 8,
      "hadithIndex": 1544,
      "bookHadithIndex": 129,
      "text": "Ebû Hureyre (r.a.)'den rivayet edildiğine göre, Nebi (s.a.v.) şöyle duâ ederdi: \"Allah'ım, fakirlikten (hayrımın) azlığından, zilletten, zulmetmekten ve zulme uğramaktan sana sığınırım",

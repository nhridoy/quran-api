          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c4d4dd1a4c9c86f08cef",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 8,
      "hadithIndex": 1518,
      "bookHadithIndex": 103,
      "text": "Rapporté par Abdullah ibn Abbas : Le Prophète ﷺ a dit : « Si quelqu’un demande pardon continuellement, Allah lui accordera une issue à toute détresse, un soulagement à toute angoisse, et lui donnera une subsistance d’où il ne s’attendait pas. »",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-8-1518-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"

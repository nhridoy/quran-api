          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-2-1147-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-2-1147-zubairalizai",

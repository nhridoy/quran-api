          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c4d4dd1a4c9c86f08b87",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 2,
      "hadithIndex": 1158,
      "bookHadithIndex": 769,
      "text": "Bekr b. Mübeşşir el-Ensârî'den şöyle dediği rivayet edilmiştir: Ramazan ve kurban bayramı günleri Resûlullah'ın ashabı ile birlikte Bethan vadisi yoluyla musallaya gider. Nebi (s.a.v.) ile birlikte namaz kılar yine Bethân vadisinden evlerimize dönerdik",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-2-1158-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-2-1158-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Daif"
        },
        {

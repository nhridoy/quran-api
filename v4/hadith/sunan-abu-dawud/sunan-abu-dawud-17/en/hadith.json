    },
    {
      "id": "69b6c518dd1a4c9c86f0921f",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 17,
      "hadithIndex": 2846,
      "bookHadithIndex": 3,
      "text": "Narrated Jabir ibn Abdullah: The Prophet of Allah (ﷺ) ordered to kill dogs, and we were even killing a dog which a woman brought with her from the desert. Afterwards he forbade to kill them, saying: Confine yourselves to the type which is black",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-17-2846-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {

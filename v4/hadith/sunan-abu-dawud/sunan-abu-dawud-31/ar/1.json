    {
      "id": "69b6c55add1a4c9c86f09665",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 31,
      "hadithIndex": 3940,
      "bookHadithIndex": 15,
      "text": "حدثنا القعنبي، عن مالك، عن نافع، عن عبد الله بن عمر، ان رسول الله صلى الله عليه وسلم قال \" من اعتق شركا له في مملوك اقيم عليه قيمة العدل فاعطى شركاءه حصصهم واعتق عليه العبد والا فقد عتق منه ما عتق",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3940-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"

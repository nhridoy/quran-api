        }
      ]
    },
    {
      "id": "69b6c59add1a4c9c86f09673",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 31,
      "hadithIndex": 3954,
      "bookHadithIndex": 29,
      "text": "حدثنا موسى بن اسماعيل، حدثنا حماد، عن قيس، عن عطاء، عن جابر بن عبد الله، قال بعنا امهات الاولاد على عهد رسول الله صلى الله عليه وسلم وابي بكر فلما كان عمر نهانا فانتهينا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3954-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3954-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3954-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c59add1a4c9c86f09674",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 31,
      "hadithIndex": 3955,
      "bookHadithIndex": 30,
      "text": "حدثنا احمد بن حنبل، حدثنا هشيم، عن عبد الملك بن ابي سليمان، عن عطاء، واسماعيل بن ابي خالد، عن سلمة بن كهيل، عن عطاء، عن جابر بن عبد الله، ان رجلا، اعتق غلاما له عن دبر منه ولم يكن له مال غيره فامر به النبي صلى الله عليه وسلم فبيع بسبعماية او بتسعماية",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3955-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3955-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3955-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari (2230) Sahih Muslim (997 After 1668)"
        }
      ]
    },
    {
      "id": "69b6c59add1a4c9c86f09675",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 31,
      "hadithIndex": 3956,
      "bookHadithIndex": 31,
      "text": "حدثنا جعفر بن مسافر، حدثنا بشر بن بكر، اخبرنا الاوزاعي، حدثني عطاء بن ابي رباح، حدثني جابر بن عبد الله، بهذا زاد وقال - يعني النبي صلى الله عليه وسلم - \" انت احق بثمنه والله اغنى عنه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3956-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Hadith"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3956-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3956-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c59add1a4c9c86f09676",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 31,
      "hadithIndex": 3957,
      "bookHadithIndex": 32,
      "text": "حدثنا احمد بن حنبل، حدثنا اسماعيل بن ابراهيم، حدثنا ايوب، عن ابي الزبير، عن جابر، ان رجلا، من الانصار يقال له ابو مذكور اعتق غلاما له يقال له يعقوب عن دبر ولم يكن له مال غيره فدعا به رسول الله صلى الله عليه وسلم فقال \" من يشتريه \" . فاشتراه نعيم بن عبد الله بن النحام بثمانماية درهم فدفعها اليه ثم قال \" اذا كان احدكم فقيرا فليبدا بنفسه فان كان فيها فضل فعلى عياله فان كان فيها فضل فعلى ذي قرابته \" . او قال \" على ذي رحمه فان كان فضلا فها هنا وها هنا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3957-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3957-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3957-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3957-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim (997)"
        }
      ]
    },
    {
      "id": "69b6c59add1a4c9c86f09677",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 31,
      "hadithIndex": 3958,
      "bookHadithIndex": 33,
      "text": "حدثنا سليمان بن حرب، حدثنا حماد بن زيد، عن ايوب، عن ابي قلابة، عن ابي المهلب، عن عمران بن حصين، ان رجلا، اعتق ستة اعبد عند موته ولم يكن له مال غيرهم فبلغ ذلك النبي صلى الله عليه وسلم فقال له قولا شديدا ثم دعاهم فجزاهم ثلاثة اجزاء فاقرع بينهم فاعتق اثنين وارق اربعة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3958-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3958-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3958-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3958-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim (1668)"
        }
      ]
    },
    {
      "id": "69b6c59add1a4c9c86f09678",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 31,
      "hadithIndex": 3959,
      "bookHadithIndex": 34,
      "text": "حدثنا ابو كامل، حدثنا عبد العزيز، - يعني ابن المختار - حدثنا خالد، عن ابي قلابة، باسناده ومعناه ولم يقل فقال له قولا شديدا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3959-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3959-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3959-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c59add1a4c9c86f09679",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 31,
      "hadithIndex": 3960,
      "bookHadithIndex": 35,
      "text": "حدثنا وهب بن بقية، حدثنا خالد بن عبد الله، - هو الطحان - عن خالد، عن ابي قلابة، عن ابي زيد، ان رجلا، من الانصار بمعناه وقال - يعني النبي صلى الله عليه وسلم - \" لو شهدته قبل ان يدفن لم يدفن في مقابر المسلمين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3960-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3960-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3960-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c59add1a4c9c86f0967a",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 31,
      "hadithIndex": 3961,
      "bookHadithIndex": 36,
      "text": "حدثنا مسدد، حدثنا حماد بن زيد، عن يحيى بن عتيق، وايوب، عن محمد بن سيرين، عن عمران بن حصين، ان رجلا، اعتق ستة اعبد عند موته ولم يكن له مال غيرهم فبلغ ذلك النبي صلى الله عليه وسلم فاقرع بينهم فاعتق اثنين وارق اربعة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3961-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3961-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3961-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3961-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih Sahih Muslim (1668)"
        }
      ]
    },
    {
      "id": "69b6c59add1a4c9c86f0967b",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 31,
      "hadithIndex": 3962,
      "bookHadithIndex": 37,
      "text": "حدثنا احمد بن صالح، حدثنا ابن وهب، اخبرني ابن لهيعة، والليث بن سعد، عن عبيد الله بن ابي جعفر، عن بكير بن الاشج، عن نافع، عن عبد الله بن عمر، قال قال رسول الله صلى الله عليه وسلم \" من اعتق عبدا وله مال فمال العبد له الا ان يشترطه السيد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3962-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3962-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3962-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3962-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih Sahih Bukhari (2379)"
        }
      ]
    },
    {
      "id": "69b6c59add1a4c9c86f0967c",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 31,
      "hadithIndex": 3963,
      "bookHadithIndex": 38,
      "text": "حدثنا ابراهيم بن موسى، اخبرنا جرير، عن سهيل بن ابي صالح، عن ابيه، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" ولد الزنا شر الثلاثة \" . وقال ابو هريرة لان امتع بسوط في سبيل الله عز وجل احب الى من ان اعتق ولد زنية",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3963-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3963-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3963-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3963-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c59add1a4c9c86f0967d",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 31,
      "hadithIndex": 3964,
      "bookHadithIndex": 39,
      "text": "حدثنا عيسى بن محمد الرملي، حدثنا ضمرة، عن ابراهيم بن ابي عبلة، عن الغريف بن الديلمي، قال اتينا واثلة بن الاسقع فقلنا له حدثنا حديثا، ليس فيه زيادة ولا نقصان فغضب وقال ان احدكم ليقرا ومصحفه معلق في بيته فيزيد وينقص . قلنا انما اردنا حديثا سمعته من النبي صلى الله عليه وسلم . قال اتينا رسول الله صلى الله عليه وسلم في صاحب لنا اوجب - يعني - النار بالقتل فقال \" اعتقوا عنه يعتق الله بكل عضو منه عضوا منه من النار",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3964-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3964-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3964-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3964-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c59add1a4c9c86f0967e",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 31,
      "hadithIndex": 3965,
      "bookHadithIndex": 40,
      "text": "حدثنا محمد بن المثنى، حدثنا معاذ بن هشام، حدثني ابي، عن قتادة، عن سالم بن ابي الجعد، عن معدان بن ابي طلحة اليعمري، عن ابي نجيح السلمي، قال حاصرنا مع رسول الله صلى الله عليه وسلم بقصر الطايف - قال معاذ سمعت ابي يقول بقصر الطايف بحصن الطايف كل ذلك - فسمعت رسول الله صلى الله عليه وسلم يقول \" من بلغ بسهم في سبيل الله عز وجل فله درجة \" . وساق الحديث وسمعت رسول الله صلى الله عليه وسلم يقول \" ايما رجل مسلم اعتق رجلا مسلما فان الله عز وجل جاعل وقاء كل عظم من عظامه عظما من عظام محرره من النار وايما امراة اعتقت امراة مسلمة فان الله جاعل وقاء كل عظم من عظامها عظما من عظام محررها من النار يوم القيامة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3965-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3965-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3965-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3965-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c59add1a4c9c86f0967f",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 31,
      "hadithIndex": 3966,
      "bookHadithIndex": 41,
      "text": "حدثنا عبد الوهاب بن نجدة، حدثنا بقية، حدثنا صفوان بن عمرو، حدثني سليم بن عامر، عن شرحبيل بن السمط، انه قال لعمرو بن عبسة حدثنا حديثا، سمعته من، رسول الله صلى الله عليه وسلم قال سمعت رسول الله صلى الله عليه وسلم يقول \" من اعتق رقبة مومنة كانت فداءه من النار",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3966-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3966-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3966-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c59add1a4c9c86f09680",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 31,
      "hadithIndex": 3967,
      "bookHadithIndex": 42,
      "text": "حدثنا حفص بن عمر، حدثنا شعبة، عن عمرو بن مرة، عن سالم بن ابي الجعد، عن شرحبيل بن السمط، انه قال لكعب بن مرة او مرة بن كعب حدثنا حديثا، سمعته من، رسول الله صلى الله عليه وسلم فذكر معنى معاذ الى قوله \" وايما امري اعتق مسلما وايما امراة اعتقت امراة مسلمة \" . زاد \" وايما رجل اعتق امراتين مسلمتين الا كانتا فكاكه من النار يجزى مكان كل عظمين منهما عظم من عظامه \" . قال ابو داود سالم لم يسمع من شرحبيل مات شرحبيل بصفين",
      "grades": [
        {

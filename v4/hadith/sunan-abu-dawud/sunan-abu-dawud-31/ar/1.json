    {
      "id": "69b6c55add1a4c9c86f09668",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 31,
      "hadithIndex": 3943,
      "bookHadithIndex": 18,
      "text": "حدثنا ابراهيم بن موسى الرازي، اخبرنا عيسى بن يونس، حدثنا عبيد الله، عن نافع، عن ابن عمر، قال قال رسول الله صلى الله عليه وسلم \" من اعتق شركا من مملوك له فعليه عتقه كله ان كان له ما يبلغ ثمنه وان لم يكن له مال عتق نصيبه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3943-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3943-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3943-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3943-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari (2523) Sahih Muslim (1501 After 1667)"
        }
      ]
    },
    {
      "id": "69b6c55add1a4c9c86f09669",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 31,
      "hadithIndex": 3944,
      "bookHadithIndex": 19,
      "text": "حدثنا مخلد بن خالد، حدثنا يزيد بن هارون، اخبرنا يحيى بن سعيد، عن نافع، عن ابن عمر، عن النبي صلى الله عليه وسلم بمعنى ابراهيم بن موسى",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3944-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3944-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari (2525) Sahih Muslim (1501)"
        }
      ]
    },
    {
      "id": "69b6c55add1a4c9c86f0966a",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 31,
      "hadithIndex": 3945,
      "bookHadithIndex": 20,
      "text": "حدثنا عبد الله بن محمد بن اسماء، حدثنا جويرية، عن نافع، عن ابن عمر، عن النبي صلى الله عليه وسلم بمعنى مالك ولم يذكر \" والا فقد عتق منه ما عتق \" . انتهى حديثه الى \" واعتق عليه العبد \" . على معناه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3945-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3945-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3945-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari (2503)"
        }
      ]
    },
    {
      "id": "69b6c55add1a4c9c86f0966b",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 31,
      "hadithIndex": 3946,
      "bookHadithIndex": 21,
      "text": "حدثنا الحسن بن علي، حدثنا عبد الرزاق، اخبرنا معمر، عن الزهري، عن سالم، عن ابن عمر، ان النبي صلى الله عليه وسلم قال \" من اعتق شركا له في عبد عتق منه ما بقي في ماله اذا كان له ما يبلغ ثمن العبد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3946-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3946-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3946-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim (1501 After  1667)"
        }
      ]
    },
    {
      "id": "69b6c55add1a4c9c86f0966c",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 31,
      "hadithIndex": 3947,
      "bookHadithIndex": 22,
      "text": "حدثنا احمد بن حنبل، حدثنا سفيان، عن عمرو بن دينار، عن سالم، عن ابيه، يبلغ به النبي صلى الله عليه وسلم \" اذا كان العبد بين اثنين فاعتق احدهما نصيبه فان كان موسرا يقوم عليه قيمة لا وكس ولا شطط ثم يعتق",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3947-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3947-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3947-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3947-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari (2521) Sahih Muslim (1501 After  1667)"
        }
      ]
    },
    {
      "id": "69b6c55add1a4c9c86f0966d",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 31,
      "hadithIndex": 3948,
      "bookHadithIndex": 23,
      "text": "حدثنا احمد بن حنبل، حدثنا محمد بن جعفر، حدثنا شعبة، عن خالد، عن ابي بشر العنبري، عن ابن التلب، عن ابيه، ان رجلا، اعتق نصيبا له من مملوك فلم يضمنه النبي صلى الله عليه وسلم . قال احمد انما هو بالتاء - يعني التلب - وكان شعبة الثغ لم يبين التاء من الثاء",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3948-alalbani",
          "name": "Al-Albani",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3948-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3948-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3948-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c55add1a4c9c86f0966e",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 31,
      "hadithIndex": 3949,
      "bookHadithIndex": 24,
      "text": "حدثنا مسلم بن ابراهيم، وموسى بن اسماعيل، قالا حدثنا حماد بن سلمة، عن قتادة، عن الحسن، عن سمرة، عن النبي صلى الله عليه وسلم وقال موسى في موضع اخر عن سمرة بن جندب فيما يحسب حماد قال قال رسول الله صلى الله عليه وسلم \" من ملك ذا رحم محرم فهو حر \" . قال ابو داود روى محمد بن بكر البرساني عن حماد بن سلمة عن قتادة وعاصم عن الحسن عن سمرة عن النبي صلى الله عليه وسلم مثل ذلك الحديث . قال ابو داود ولم يحدث ذلك الحديث الا حماد بن سلمة وقد شك فيه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3949-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3949-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3949-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3949-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c55add1a4c9c86f0966f",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 31,
      "hadithIndex": 3950,
      "bookHadithIndex": 25,
      "text": "حدثنا محمد بن سليمان الانباري، حدثنا عبد الوهاب، عن سعيد، عن قتادة، ان عمر بن الخطاب، - رضى الله عنه - قال من ملك ذا رحم محرم فهو حر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3950-alalbani",

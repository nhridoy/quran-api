      ]
    },
    {
      "id": "69b6c55add1a4c9c86f0965d",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 31,
      "hadithIndex": 3932,
      "bookHadithIndex": 7,
      "text": "حدثنا مسدد بن مسرهد، حدثنا عبد الوارث، عن سعيد بن جمهان، عن سفينة، قال كنت مملوكا لام سلمة فقالت اعتقك واشترط عليك ان تخدم رسول الله صلى الله عليه وسلم ما عشت . فقلت ان لم تشترطي على ما فارقت رسول الله صلى الله عليه وسلم ما عشت فاعتقتني واشترطت على",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3932-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3932-muhammadmuhyialdinabdulhamid",

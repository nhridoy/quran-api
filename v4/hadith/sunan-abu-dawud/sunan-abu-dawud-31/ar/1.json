          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-31-3942-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari (2524) Sahih Muslim (1501)"
        }
      ]

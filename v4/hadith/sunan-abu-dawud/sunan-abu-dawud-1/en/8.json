    },
    {
      "id": "69b6c493dd1a4c9c86f08884",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 1,
      "hadithIndex": 387,
      "bookHadithIndex": 387,
      "text": "Aishah reported a similar tradition from the Messenger of Allah (ﷺ)",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-387-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-387-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"

    },
    {
      "id": "69b6c493dd1a4c9c86f08863",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 1,
      "hadithIndex": 354,
      "bookHadithIndex": 354,
      "text": "حدثنا ابو الوليد الطيالسي، حدثنا همام، عن قتادة، عن الحسن، عن سمرة، قال قال رسول الله صلى الله عليه وسلم \" من توضا يوم الجمعة فبها ونعمت ومن اغتسل فهو افضل",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-354-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-354-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-354-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Hasan Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-354-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c493dd1a4c9c86f08864",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 1,
      "hadithIndex": 355,
      "bookHadithIndex": 355,
      "text": "حدثنا محمد بن كثير العبدي، اخبرنا سفيان، حدثنا الاغر، عن خليفة بن حصين، عن جده، قيس بن عاصم قال اتيت النبي صلى الله عليه وسلم اريد الاسلام فامرني ان اغتسل بماء وسدر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-355-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-355-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-355-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c493dd1a4c9c86f08865",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 1,
      "hadithIndex": 356,
      "bookHadithIndex": 356,
      "text": "حدثنا مخلد بن خالد، حدثنا عبد الرزاق، اخبرنا ابن جريج، قال اخبرت عن عثيم بن كليب، عن ابيه، عن جده، انه جاء الى النبي صلى الله عليه وسلم فقال قد اسلمت . فقال له النبي صلى الله عليه وسلم \" الق عنك شعر الكفر \" . يقول احلق . قال واخبرني اخر ان النبي صلى الله عليه وسلم قال لاخر معه \" الق عنك شعر الكفر واختتن",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-356-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-356-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-356-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-356-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c493dd1a4c9c86f08866",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 1,
      "hadithIndex": 357,
      "bookHadithIndex": 357,
      "text": "حدثنا احمد بن ابراهيم، حدثنا عبد الصمد بن عبد الوارث، حدثني ابي، حدثتني ام الحسن، - يعني جدة ابي بكر العدوي - عن معاذة، قالت سالت عايشة - رضى الله عنها - عن الحايض يصيب ثوبها الدم . قالت تغسله فان لم يذهب اثره فلتغيره بشىء من صفرة . قالت ولقد كنت احيض عند رسول الله صلى الله عليه وسلم ثلاث حيض جميعا لا اغسل لي ثوبا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-357-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-357-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-357-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c493dd1a4c9c86f08867",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 1,
      "hadithIndex": 358,
      "bookHadithIndex": 358,
      "text": "حدثنا محمد بن كثير العبدي، اخبرنا ابراهيم بن نافع، قال سمعت الحسن، - يعني ابن مسلم - يذكر عن مجاهد، قال قالت عايشة ما كان لاحدانا الا ثوب واحد تحيض فيه فان اصابه شىء من دم بلته بريقها ثم قصعته بريقها",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-358-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-358-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-358-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c493dd1a4c9c86f08868",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 1,
      "hadithIndex": 359,
      "bookHadithIndex": 359,
      "text": "حدثنا يعقوب بن ابراهيم، حدثنا عبد الرحمن، - يعني ابن مهدي - حدثنا بكار بن يحيى، حدثتني جدتي، قالت دخلت على ام سلمة فسالتها امراة من قريش عن الصلاة في ثوب الحايض فقالت ام سلمة قد كان يصيبنا الحيض على عهد رسول الله صلى الله عليه وسلم فتلبث احدانا ايام حيضها ثم تطهر فتنظر الثوب الذي كانت تقلب فيه فان اصابه دم غسلناه وصلينا فيه وان لم يكن اصابه شىء تركناه ولم يمنعنا ذلك من ان نصلي فيه واما الممتشطة فكانت احدانا تكون ممتشطة فاذا اغتسلت لم تنقض ذلك ولكنها تحفن على راسها ثلاث حفنات فاذا رات البلل في اصول الشعر دلكته ثم افاضت على ساير جسدها",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-359-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-359-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-359-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c493dd1a4c9c86f08869",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 1,
      "hadithIndex": 360,
      "bookHadithIndex": 360,
      "text": "حدثنا عبد الله بن محمد النفيلي، حدثنا محمد بن سلمة، عن محمد بن اسحاق، عن فاطمة بنت المنذر، عن اسماء بنت ابي بكر، قالت سمعت امراة، تسال رسول الله صلى الله عليه وسلم كيف تصنع احدانا بثوبها اذا رات الطهر اتصلي فيه قال \" تنظر فان رات فيه دما فلتقرصه بشىء من ماء ولتنضح ما لم تر ولتصل فيه",

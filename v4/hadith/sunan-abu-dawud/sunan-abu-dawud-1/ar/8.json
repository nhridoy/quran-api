          "name": "Shuaib Al Arnaut",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-367-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c493dd1a4c9c86f08871",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 1,
      "hadithIndex": 368,
      "bookHadithIndex": 368,
      "text": "حدثنا الحسن بن علي، حدثنا سليمان بن حرب، حدثنا حماد، عن هشام، عن ابن سيرين، عن عايشة، ان النبي صلى الله عليه وسلم كان لا يصلي في ملاحفنا . قال حماد وسمعت سعيد بن ابي صدقة قال سالت محمدا عنه فلم يحدثني وقال سمعته منذ زمان ولا ادري ممن سمعته ولا ادري اسمعته من ثبت او لا فسلوا عنه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-368-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-368-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-368-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-368-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c493dd1a4c9c86f08872",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 1,
      "hadithIndex": 369,
      "bookHadithIndex": 369,
      "text": "حدثنا محمد بن الصباح بن سفيان، حدثنا سفيان، عن ابي اسحاق الشيباني، سمعه من عبد الله بن شداد، يحدثه عن ميمونة، ان النبي صلى الله عليه وسلم صلى وعليه مرط وعلى بعض ازواجه منه وهي حايض وهو يصلي وهو عليه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-369-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-369-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-369-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-369-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c493dd1a4c9c86f08873",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 1,
      "hadithIndex": 370,
      "bookHadithIndex": 370,
      "text": "حدثنا عثمان بن ابي شيبة، حدثنا وكيع بن الجراح، حدثنا طلحة بن يحيى، عن عبيد الله بن عبد الله بن عتبة، عن عايشة، قالت كان رسول الله صلى الله عليه وسلم يصلي بالليل وانا الى جنبه وانا حايض وعلى مرط لي وعليه بعضه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-370-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-370-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-370-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim (514)"
        }
      ]
    },
    {
      "id": "69b6c493dd1a4c9c86f08874",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 1,
      "hadithIndex": 371,
      "bookHadithIndex": 371,
      "text": "حدثنا حفص بن عمر، عن شعبة، عن الحكم، عن ابراهيم، عن همام بن الحارث، انه كان عند عايشة - رضى الله عنها - فاحتلم فابصرته جارية لعايشة وهو يغسل اثر الجنابة من ثوبه او يغسل ثوبه فاخبرت عايشة فقالت لقد رايتني وانا افركه من ثوب رسول الله صلى الله عليه وسلم . قال ابو داود رواه الاعمش كما رواه الحكم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-371-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-371-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-371-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-371-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim (288)"
        }
      ]
    },
    {
      "id": "69b6c493dd1a4c9c86f08875",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 1,
      "hadithIndex": 372,
      "bookHadithIndex": 372,
      "text": "حدثنا موسى بن اسماعيل، حدثنا حماد بن سلمة، عن حماد بن ابي سليمان، عن ابراهيم، عن الاسود، عن عايشة، قالت كنت افرك المني من ثوب رسول الله صلى الله عليه وسلم فيصلي فيه . قال ابو داود وافقه مغيرة وابو معشر وواصل",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-372-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-372-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-372-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-372-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim (288)"
        }
      ]
    },
    {
      "id": "69b6c493dd1a4c9c86f08876",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 1,
      "hadithIndex": 373,
      "bookHadithIndex": 373,
      "text": "حدثنا عبد الله بن محمد النفيلي، حدثنا زهير، ح حدثنا محمد بن عبيد بن حساب البصري، حدثنا سليم، - يعني ابن اخضر المعنى والاخبار في حديث سليم - قالا حدثنا عمرو بن ميمون بن مهران سمعت سليمان بن يسار يقول سمعت عايشة تقول انها كانت تغسل المني من ثوب رسول الله صلى الله عليه وسلم . قالت ثم ارى فيه بقعة او بقعا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-373-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-373-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-373-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-373-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari (229) Sahih Muslim (289)"
        }
      ]
    },
    {
      "id": "69b6c493dd1a4c9c86f08877",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 1,
      "hadithIndex": 374,
      "bookHadithIndex": 374,
      "text": "حدثنا عبد الله بن مسلمة القعنبي، عن مالك، عن ابن شهاب، عن عبيد الله بن عبد الله بن عتبة بن مسعود، عن ام قيس بنت محصن، انها اتت بابن لها صغير لم ياكل الطعام الى رسول الله صلى الله عليه وسلم فاجلسه رسول الله صلى الله عليه وسلم في حجره فبال على ثوبه فدعا بماء فنضحه ولم يغسله",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-374-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-374-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-374-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari (223) Sahih Muslim (287)"
        }
      ]
    },
    {
      "id": "69b6c493dd1a4c9c86f08878",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 1,
      "hadithIndex": 375,
      "bookHadithIndex": 375,
      "text": "حدثنا مسدد بن مسرهد، والربيع بن نافع ابو توبة، - المعنى - قالا حدثنا ابو الاحوص، عن سماك، عن قابوس، عن لبابة بنت الحارث، قالت كان الحسين بن علي - رضى الله عنه - في حجر رسول الله صلى الله عليه وسلم فبال عليه فقلت البس ثوبا واعطني ازارك حتى اغسله قال \" انما يغسل من بول الانثى وينضح من بول الذكر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-375-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-375-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-375-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-375-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c493dd1a4c9c86f08879",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 1,
      "hadithIndex": 376,
      "bookHadithIndex": 376,
      "text": "حدثنا مجاهد بن موسى، وعباس بن عبد العظيم العنبري، - المعنى - قالا حدثنا عبد الرحمن بن مهدي، حدثني يحيى بن الوليد، حدثني محل بن خليفة، حدثني ابو السمح، قال كنت اخدم النبي صلى الله عليه وسلم فكان اذا اراد ان يغتسل قال \" ولني قفاك \" . فاوليه قفاى فاستره به فاتي بحسن او حسين - رضى الله عنهما - فبال على صدره فجيت اغسله فقال \" يغسل من بول الجارية ويرش من بول الغلام \" . قال عباس حدثنا يحيى بن الوليد . قال ابو داود وهو ابو الزعراء . قال هارون بن تميم عن الحسن قال الابوال كلها سواء",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-376-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-376-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-376-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c493dd1a4c9c86f0887a",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 1,
      "hadithIndex": 377,
      "bookHadithIndex": 377,
      "text": "حدثنا مسدد، حدثنا يحيى، عن ابن ابي عروبة، عن قتادة، عن ابي حرب بن ابي الاسود، عن ابيه، عن علي، - رضى الله عنه - قال يغسل من بول الجارية وينضح من بول الغلام ما لم يطعم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-377-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Muquf"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-377-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih Muquf"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-377-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c493dd1a4c9c86f0887b",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 1,
      "hadithIndex": 378,
      "bookHadithIndex": 378,
      "text": "حدثنا ابن المثنى، حدثنا معاذ بن هشام، حدثني ابي، عن قتادة، عن ابي حرب بن ابي الاسود، عن ابيه، عن علي بن ابي طالب، - رضى الله عنه - ان النبي صلى الله عليه وسلم قال فذكر معناه ولم يذكر \" ما لم يطعم \" . زاد قال قتادة هذا ما لم يطعما الطعام فاذا طعما غسلا جميعا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-378-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-378-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-378-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c493dd1a4c9c86f0887c",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 1,
      "hadithIndex": 379,
      "bookHadithIndex": 379,
      "text": "حدثنا عبد الله بن عمرو بن ابي الحجاج ابو معمر، حدثنا عبد الوارث، عن يونس، عن الحسن، عن امه، انها ابصرت ام سلمة تصب الماء على بول الغلام ما لم يطعم فاذا طعم غسلته وكانت تغسل بول الجارية",

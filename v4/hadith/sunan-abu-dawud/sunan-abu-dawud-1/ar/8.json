    {
      "id": "69b6c493dd1a4c9c86f08861",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 1,
      "hadithIndex": 352,
      "bookHadithIndex": 352,
      "text": "حدثنا مسدد، حدثنا حماد بن زيد، عن يحيى بن سعيد، عن عمرة، عن عايشة، قالت كان الناس مهان انفسهم فيروحون الى الجمعة بهييتهم فقيل لهم لو اغتسلتم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-352-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-352-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-352-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari (903) Sahih Muslim (847)"
        }
      ]
    },
    {
      "id": "69b6c493dd1a4c9c86f08862",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 1,
      "hadithIndex": 353,
      "bookHadithIndex": 353,
      "text": "حدثنا عبد الله بن مسلمة، حدثنا عبد العزيز، - يعني ابن محمد - عن عمرو بن ابي عمرو، عن عكرمة، ان اناسا، من اهل العراق جاءوا فقالوا يا ابن عباس اترى الغسل يوم الجمعة واجبا قال لا ولكنه اطهر وخير لمن اغتسل ومن لم يغتسل فليس عليه بواجب وساخبركم كيف بدء الغسل كان الناس مجهودين يلبسون الصوف ويعملون على ظهورهم وكان مسجدهم ضيقا مقارب السقف انما هو عريش فخرج رسول الله صلى الله عليه وسلم في يوم حار وعرق الناس في ذلك الصوف حتى ثارت منهم رياح اذى بذلك بعضهم بعضا فلما وجد رسول الله صلى الله عليه وسلم تلك الريح قال \" ايها الناس اذا كان هذا اليوم فاغتسلوا وليمس احدكم افضل ما يجد من دهنه وطيبه \" . قال ابن عباس ثم جاء الله بالخير ولبسوا غير الصوف وكفوا العمل ووسع مسجدهم وذهب بعض الذي كان يوذي بعضهم بعضا من العرق",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-353-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-353-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-1-353-shuaibalarnaut",

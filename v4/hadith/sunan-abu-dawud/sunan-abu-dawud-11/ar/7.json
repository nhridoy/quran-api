    {
      "id": "69b6c518dd1a4c9c86f08ee7",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 11,
      "hadithIndex": 2022,
      "bookHadithIndex": 302,
      "text": "حدثنا القعنبي، حدثنا عبد العزيز، - يعني الدراوردي - عن عبد الرحمن بن حميد، انه سمع عمر بن عبد العزيز، يسال السايب بن يزيد هل سمعت في الاقامة، بمكة شييا قال اخبرني ابن الحضرمي، انه سمع رسول الله صلى الله عليه وسلم يقول \" للمهاجرين اقامة بعد الصدر ثلاثا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2022-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2022-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2022-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2022-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari (3933) Sahih Muslim (1352)"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f08ee8",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 11,
      "hadithIndex": 2023,
      "bookHadithIndex": 303,
      "text": "حدثنا القعنبي، عن مالك، عن نافع، عن عبد الله بن عمر، ان رسول الله صلى الله عليه وسلم دخل الكعبة هو واسامة بن زيد وعثمان بن طلحة الحجبي وبلال فاغلقها عليه فمكث فيها قال عبد الله بن عمر فسالت بلالا حين خرج ماذا صنع رسول الله صلى الله عليه وسلم فقال جعل عمودا عن يساره وعمودين عن يمينه وثلاثة اعمدة وراءه - وكان البيت يوميذ على ستة اعمدة - ثم صلى",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2023-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2023-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2023-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2023-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari (505) Sahih Muslim (1329)"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f08ee9",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 11,
      "hadithIndex": 2024,
      "bookHadithIndex": 304,
      "text": "حدثنا عبد الله بن محمد بن اسحاق الاذرمي، حدثنا عبد الرحمن بن مهدي، عن مالك، بهذا الحديث لم يذكر السواري قال ثم صلى وبينه وبين القبلة ثلاثة اذرع",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2024-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2024-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2024-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2024-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f08eea",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 11,
      "hadithIndex": 2025,
      "bookHadithIndex": 305,
      "text": "حدثنا عثمان بن ابي شيبة، حدثنا ابو اسامة، عن عبيد الله، عن نافع، عن ابن عمر، عن النبي صلى الله عليه وسلم بمعنى حديث القعنبي . قال ونسيت ان اساله كم صلى",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2025-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2025-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2025-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2025-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f08eeb",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 11,
      "hadithIndex": 2026,
      "bookHadithIndex": 306,
      "text": "حدثنا زهير بن حرب، حدثنا جرير، عن يزيد بن ابي زياد، عن مجاهد، عن عبد الرحمن بن صفوان، قال قلت لعمر بن الخطاب كيف صنع رسول الله صلى الله عليه وسلم حين دخل الكعبة قال صلى ركعتين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2026-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2026-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2026-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2026-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f08eec",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 11,
      "hadithIndex": 2027,
      "bookHadithIndex": 307,
      "text": "حدثنا ابو معمر عبد الله بن عمرو بن ابي الحجاج، حدثنا عبد الوارث، عن ايوب، عن عكرمة، عن ابن عباس، ان النبي صلى الله عليه وسلم لما قدم مكة ابى ان يدخل البيت وفيه الالهة فامر بها فاخرجت قال فاخرج صورة ابراهيم واسماعيل وفي ايديهما الازلام فقال رسول الله صلى الله عليه وسلم \" قاتلهم الله والله لقد علموا ما استقسما بها قط \" . قال ثم دخل البيت فكبر في نواحيه وفي زواياه ثم خرج ولم يصل فيه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2027-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2027-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2027-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2027-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari (1601)"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f08eed",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 11,
      "hadithIndex": 2028,
      "bookHadithIndex": 308,
      "text": "حدثنا القعنبي، حدثنا عبد العزيز، عن علقمة، عن امه، عن عايشة، انها قالت كنت احب ان ادخل البيت فاصلي فيه فاخذ رسول الله صلى الله عليه وسلم بيدي فادخلني في الحجر فقال \" صلي في الحجر اذا اردت دخول البيت فانما هو قطعة من البيت فان قومك اقتصروا حين بنوا الكعبة فاخرجوه من البيت",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2028-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2028-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2028-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Hasan Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2028-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f08eee",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 11,
      "hadithIndex": 2029,
      "bookHadithIndex": 309,
      "text": "حدثنا مسدد، حدثنا عبد الله بن داود، عن اسماعيل بن عبد الملك، عن عبد الله بن ابي مليكة، عن عايشة، ان النبي صلى الله عليه وسلم خرج من عندها وهو مسرور ثم رجع الى وهو كييب فقال \" اني دخلت الكعبة ولو استقبلت من امري ما استدبرت ما دخلتها اني اخاف ان اكون قد شققت على امتي",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2029-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2029-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2029-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f08eef",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 11,
      "hadithIndex": 2030,
      "bookHadithIndex": 310,
      "text": "حدثنا ابن السرح، وسعيد بن منصور، ومسدد، قالوا حدثنا سفيان، عن منصور الحجبي، حدثني خالي، عن امي، صفية بنت شيبة قالت سمعت الاسلمية، تقول قلت لعثمان ما قال لك رسول الله صلى الله عليه وسلم حين دعاك قال \" اني نسيت ان امرك ان تخمر القرنين فانه ليس ينبغي ان يكون في البيت شىء يشغل المصلي \" . قال ابن السرح خالي مسافع بن شيبة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2030-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2030-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2030-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2030-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f08ef0",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 11,
      "hadithIndex": 2031,
      "bookHadithIndex": 311,
      "text": "حدثنا احمد بن حنبل، حدثنا عبد الرحمن بن محمد المحاربي، عن الشيباني، عن واصل الاحدب، عن شقيق، عن شيبة، - يعني ابن عثمان - قال قعد عمر بن الخطاب - رضى الله عنه - في مقعدك الذي انت فيه فقال لا اخرج حتى اقسم مال الكعبة . قال قلت ما انت بفاعل . قال بلى لافعلن . قال قلت ما انت بفاعل . قال لم قلت لان رسول الله صلى الله عليه وسلم قد راى مكانه وابو بكر - رضى الله عنه - وهما احوج منك الى المال فلم يخرجاه . فقام فخرج",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2031-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2031-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2031-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2031-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f08ef1",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 11,
      "hadithIndex": 2032,
      "bookHadithIndex": 312,
      "text": "حدثنا حامد بن يحيى، حدثنا عبد الله بن الحارث، عن محمد بن عبد الله بن انسان الطايفي، عن ابيه، عن عروة بن الزبير، عن الزبير، قال لما اقبلنا مع رسول الله صلى الله عليه وسلم من لية حتى اذا كنا عند السدرة وقف رسول الله صلى الله عليه وسلم في طرف القرن الاسود حذوها فاستقبل نخبا ببصره وقال مرة واديه ووقف حتى اتقف الناس كلهم ثم قال \" ان صيد وج وعضاهه حرام محرم لله \" . وذلك قبل نزوله الطايف وحصاره لثقيف",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2032-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2032-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2032-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-11-2032-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f08ef2",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 11,
      "hadithIndex": 2033,
      "bookHadithIndex": 313,
      "text": "حدثنا مسدد، حدثنا سفيان، عن الزهري، عن سعيد بن المسيب، عن ابي هريرة، عن النبي صلى الله عليه وسلم قال \" لا تشد الرحال الا الى ثلاثة مساجد مسجد الحرام ومسجدي هذا والمسجد الاقصى",

{"total":311,"totalPage":7,"page":4,"pageSize":50,"items":[{"id":"69b6c518dd1a4c9c86f09144","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":15,"hadithIndex":2627,"bookHadithIndex":151,"text":"Сообщается, что ‘Укба ибн Малик рассказывал: «Однажды Пророк ﷺ отправил отряд, а я отдал одному из участников (этого отряда) меч. Вернувшись, он сказал: “О, если бы ты видел, как Посланник Аллаха ﷺ порицал нас и сказал: “Если я посылаю одного из вас (в качестве руководителя отряда), а он не выполняет моих приказов, то неужели вы не можете назначить вместо него того, кто будет их выполнять?!”»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-15-2627-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-15-2627-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-15-2627-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c518dd1a4c9c86f09145","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":15,"hadithIndex":2628,"bookHadithIndex":152,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-15-2628-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-15-2628-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-15-2628-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-15-2628-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c518dd1a4c9c86f09146","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":15,"hadithIndex":2629,"bookHadithIndex":153,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-15-2629-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-15-2629-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-15-2629-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c518dd1a4c9c86f09147","editionId":"69b55e8d6f42ba7ccb2a1320","bookInde
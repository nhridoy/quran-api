    {
      "id": "69b6c518dd1a4c9c86f09123",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 15,
      "hadithIndex": 2594,
      "bookHadithIndex": 118,
      "text": "Сообщается со слов Абу ад-Дарды, что Посланник Аллаха ﷺ сказал: «Ищите моего расположения посредством слабых (из вас), ибо вы наделяетесь уделом и помощью (от Аллаха) именно за счёт них»",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-15-2594-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-15-2594-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-15-2594-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },

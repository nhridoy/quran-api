    {
      "id": "69b6c518dd1a4c9c86f090f5",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 15,
      "hadithIndex": 2548,
      "bookHadithIndex": 72,
      "text": "Сообщается, что Сахль ибн аль-Ханзалия рассказывал: «Однажды Посланник Аллаха ﷺ проходил мимо верблюда, спина которого примыкала к его животу (от голода или усталости), и сказал: “Остерегайтесь (наказания) Аллаха за (своё отношение) к этим безмолвным животным! Садитесь на них, когда они пригодны (для этого), и ешьте их, когда они пригодны (для этого)!”»",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-15-2548-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-15-2548-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-15-2548-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-15-2548-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]

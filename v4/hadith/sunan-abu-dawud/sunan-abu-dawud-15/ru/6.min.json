6f42ba7ccb2a1320-15-2768-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (3031) Sahih Muslim (1801)"}]},{"id":"69b6c518dd1a4c9c86f091d2","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":15,"hadithIndex":2769,"bookHadithIndex":293,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-15-2769-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-15-2769-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-15-2769-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1320-15-2769-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c518dd1a4c9c86f091d3","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":15,"hadithIndex":2770,"bookHadithIndex":294,"text":"Передают со слов ‘Абдуллаха бин ‘Умара, да будет доволен Аллах ими обоими, что, когда Посланник Аллаха ﷺ возвращался (в Медину) после военного похода, хаджа или умры, он по три раза произносил слова “Аллах велик”, (поднимаясь) на каждую возвышенность, после чего говорил: «Нет истинного бога, кроме одного лишь Аллаха, у Которого нет сотоварища, Ему принадлежит владычество, Ему хвала, Он всё может! Мы возвращаемся, каемся, Господу нашему поклоняемся (и пред Ним) до земли склоняемся и (Его) восхваляем! Аллах сдержал Своё обещание, и помог Своему рабу, и один разбил племена./Ля иляха илля-Ллаху вахда-ху ля шарикя ля-ху, ля-ху-ль-мульку, ва ля-ху-ль-хамду ва хуа ‘аля кулли шайй‘ин кадир! Аййибуна, та‘ибуна, ‘абидуна, саджидуна, ли-Рабби-на хамидуна! Садака-Ллаху ва‘да-ху, ва насара ‘абда-ху ва хазама-ль-ахзаба вахда-ху/»","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-15-2770-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-15-2770-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-15-2770-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-15-2770-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (1797) Sahih Muslim (1344)"}]},{"id":"69b6c518dd1a4c9c86f091d4","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":15,"hadithIndex":2771,"bookHadithIndex":295,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-15-2771-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-15-2771-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-15-2771-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1320-15-2771-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c518dd1a4c9c86f091d5","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":15,"hadithIndex":2772,"bookHadithIndex":296,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-15-2772-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-15-2772-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-15-2772-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-15-2772-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (3076) Sahih Muslim (2476)"}]},{"id":"69b6c518dd1a4c9c86f091d6","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":15,"hadithIndex":2773,"bookHadithIndex":297,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1320-15-2773-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-15-2773-muhammadmuhyialdinabdulhamid","name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-15-2773-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-15-2773-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (4676) Sahih Muslim (2769)"}]},{"id":"69b6c518dd1a4c9c86f091d7","editionId":"69b55e8d6f42ba7ccb2a1320","bookIndex":15,"hadithIndex":2774,"bookHadithIndex":298,"text
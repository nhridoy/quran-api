        }
      ]
    },
    {
      "id": "69b6c55add1a4c9c86f0960a",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 28,
      "hadithIndex": 3849,
      "bookHadithIndex": 114,
      "text": "Abu Umamah رضي الله عنه a dit : Quand la nappe était retirée, le Messager d’Allah ﷺ disait : « Louange à Allah, abondamment et sincèrement, d’une manière qui apporte la bénédiction, qui n’est ni insuffisante, ni abandonnée, ni négligée, ô notre Seigneur. »",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-28-3849-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-28-3849-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-28-3849-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-28-3849-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari (5458)"
        }
      ]
    },
    {
      "id": "69b6c55add1a4c9c86f0960b",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 28,
      "hadithIndex": 3850,
      "bookHadithIndex": 115,
      "text": "Rapporté par Abu Sa'id al-Khudri رضي الله عنه : Quand le Messager d’Allah ﷺ terminait son repas, il disait : « Louange à Allah qui nous a donné à manger et à boire et qui a fait de nous des musulmans. »",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-28-3850-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-28-3850-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-28-3850-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-28-3850-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c55add1a4c9c86f0960c",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 28,
      "hadithIndex": 3851,
      "bookHadithIndex": 116,
      "text": "Rapporté par Abu Ayyub al-Ansari رضي الله عنه : Lorsque le Messager d’Allah ﷺ mangeait ou buvait, il disait : « Louange à Allah qui a donné la nourriture et la boisson, qui a facilité leur passage et qui a prévu une sortie pour eux. »",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-28-3851-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-28-3851-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-28-3851-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-28-3851-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c55add1a4c9c86f0960d",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 28,
      "hadithIndex": 3852,
      "bookHadithIndex": 117,
      "text": "Rapporté par Abu Hurayrah رضي الله عنه : Le Prophète ﷺ a dit : « Si quelqu’un passe la nuit avec de la graisse sur la main sans l’avoir lavée, il ne devra s’en prendre qu’à lui-même si un problème lui arrive. »",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-28-3852-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-28-3852-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {

          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari (5471، 5472)"
        }
      ]
    },
    {
      "id": "69b6c518dd1a4c9c86f09219",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 16,
      "hadithIndex": 2840,
      "bookHadithIndex": 53,
      "text": "حدثنا يحيى بن خلف، حدثنا عبد الاعلى، حدثنا هشام، عن الحسن، انه كان يقول اماطة الاذى حلق الراس",
      "grades": [
        {

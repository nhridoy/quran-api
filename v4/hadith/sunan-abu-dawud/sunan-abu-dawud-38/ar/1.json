          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c59add1a4c9c86f097b9",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 38,
      "hadithIndex": 4280,
      "bookHadithIndex": 2,
      "text": "حدثنا موسى بن اسماعيل، حدثنا وهيب، حدثنا داود، عن عامر، عن جابر بن سمرة، قال سمعت رسول الله صلى الله عليه وسلم يقول \" لا يزال هذا الدين عزيزا الى اثنى عشر خليفة \" . قال فكبر الناس وضجوا ثم قال كلمة خفية قلت لابي يا ابة ما قال قال \" كلهم من قريش",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4280-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4280-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4280-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4280-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim (1821)"
        }
      ]
    },
    {
      "id": "69b6c59add1a4c9c86f097ba",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 38,
      "hadithIndex": 4281,
      "bookHadithIndex": 3,
      "text": "حدثنا ابن نفيل، حدثنا زهير، حدثنا زياد بن خيثمة، حدثنا الاسود بن سعيد الهمداني، عن جابر بن سمرة، بهذا الحديث زاد فلما رجع الى منزله اتته قريش فقالوا ثم يكون ماذا قال \" ثم يكون الهرج",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4281-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4281-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4281-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c59add1a4c9c86f097bb",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 38,
      "hadithIndex": 4282,
      "bookHadithIndex": 4,
      "text": "حدثنا مسدد، ان عمر بن عبيد، حدثهم ح، وحدثنا محمد بن العلاء، حدثنا ابو بكر، - يعني ابن عياش ح وحدثنا مسدد، حدثنا يحيى، عن سفيان، ح وحدثنا احمد بن ابراهيم، حدثنا عبيد الله بن موسى، اخبرنا زايدة، ح وحدثنا احمد بن ابراهيم، حدثني عبيد الله بن موسى، عن فطر، - المعنى واحد - كلهم عن عاصم، عن زر، عن عبد الله، عن النبي صلى الله عليه وسلم قال \" لو لم يبق من الدنيا الا يوم \" . قال زايدة في حديثه \" لطول الله ذلك اليوم \" . ثم اتفقوا \" حتى يبعث فيه رجلا مني \" . او \" من اهل بيتي يواطي اسمه اسمي واسم ابيه اسم ابي \" . زاد في حديث فطر \" يملا الارض قسطا وعدلا كما مليت ظلما وجورا \" . وقال في حديث سفيان \" لا تذهب او لا تنقضي الدنيا حتى يملك العرب رجل من اهل بيتي يواطي اسمه اسمي \" . قال ابو داود لفظ عمر وابي بكر بمعنى سفيان",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4282-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4282-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4282-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c59add1a4c9c86f097bc",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 38,
      "hadithIndex": 4283,
      "bookHadithIndex": 5,
      "text": "حدثنا عثمان بن ابي شيبة، حدثنا الفضل بن دكين، حدثنا فطر، عن القاسم بن ابي بزة، عن ابي الطفيل، عن علي، - رضى الله تعالى عنه - عن النبي صلى الله عليه وسلم قال \" لو لم يبق من الدهر الا يوم لبعث الله رجلا من اهل بيتي يملاها عدلا كما مليت جورا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4283-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4283-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4283-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c59add1a4c9c86f097bd",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 38,
      "hadithIndex": 4284,
      "bookHadithIndex": 6,
      "text": "حدثنا احمد بن ابراهيم، حدثنا عبد الله بن جعفر الرقي، حدثنا ابو المليح الحسن بن عمر، عن زياد بن بيان، عن علي بن نفيل، عن سعيد بن المسيب، عن ام سلمة، قالت سمعت رسول الله صلى الله عليه وسلم يقول \" المهدي من عترتي من ولد فاطمة \" . قال عبد الله بن جعفر وسمعت ابا المليح يثني على علي بن نفيل ويذكر منه صلاحا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4284-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4284-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4284-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c59add1a4c9c86f097be",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 38,
      "hadithIndex": 4285,
      "bookHadithIndex": 7,
      "text": "حدثنا سهل بن تمام بن بزيع، حدثنا عمران القطان، عن قتادة، عن ابي نضرة، عن ابي سعيد الخدري، قال قال رسول الله صلى الله عليه وسلم \" المهدي مني اجلى الجبهة اقنى الانف يملا الارض قسطا وعدلا كما مليت جورا وظلما يملك سبع سنين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4285-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4285-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4285-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4285-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c59add1a4c9c86f097bf",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 38,
      "hadithIndex": 4286,
      "bookHadithIndex": 8,
      "text": "حدثنا محمد بن المثنى، حدثنا معاذ بن هشام، حدثني ابي، عن قتادة، عن صالح ابي الخليل، عن صاحب، له عن ام سلمة، زوج النبي صلى الله عليه وسلم عن النبي صلى الله عليه وسلم قال \" يكون اختلاف عند موت خليفة فيخرج رجل من اهل المدينة هاربا الى مكة فياتيه ناس من اهل مكة فيخرجونه وهو كاره فيبايعونه بين الركن والمقام ويبعث اليه بعث من الشام فيخسف بهم بالبيداء بين مكة والمدينة فاذا راى الناس ذلك اتاه ابدال الشام وعصايب اهل العراق فيبايعونه بين الركن والمقام ثم ينشا رجل من قريش اخواله كلب فيبعث اليهم بعثا فيظهرون عليهم وذلك بعث كلب والخيبة لمن لم يشهد غنيمة كلب فيقسم المال ويعمل في الناس بسنة نبيهم صلى الله عليه وسلم ويلقي الاسلام بجرانه الى الارض فيلبث سبع سنين ثم يتوفى ويصلي عليه المسلمون \" . قال ابو داود قال بعضهم عن هشام \" تسع سنين \" . وقال بعضهم \" سبع سنين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4286-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4286-muhammadmuhyialdinabdulhamid",
          "name": "Muhammad Muhyi Al-Din Abdul Hamid",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4286-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4286-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c59add1a4c9c86f097c0",
      "editionId": "69b55e8d6f42ba7ccb2a1320",
      "bookIndex": 38,
      "hadithIndex": 4287,
      "bookHadithIndex": 9,
      "text": "حدثنا هارون بن عبد الله، حدثنا عبد الصمد، عن همام، عن قتادة، بهذا الحديث وقال \" تسع سنين \" . قال ابو داود وقال غير معاذ عن هشام \" تسع سنين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1320-38-4287-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"

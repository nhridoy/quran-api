 Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-21-3241-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1320-21-3241-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari (1839)"}]}]}
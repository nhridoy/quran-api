        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1015-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1015-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"

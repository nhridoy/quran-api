    },
    {
      "id": "69b6c611dd1a4c9c86f09f8d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 1008,
      "bookHadithIndex": 133,
      "text": "اخبرنا محمد بن بشار، قال حدثنا يحيى، وعبد الرحمن، وابن ابي عدي، عن شعبة، عن سليمان، عن سعد بن عبيدة، عن المستورد بن الاحنف، عن صلة بن زفر، عن حذيفة، انه صلى الى جنب النبي صلى الله عليه وسلم ليلة فقرا فكان اذا مر باية عذاب وقف وتعوذ واذا مر باية رحمة وقف فدعا وكان يقول في ركوعه \" سبحان ربي العظيم \" . وفي سجوده \" سبحان ربي الاعلى",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1008-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1008-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1008-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f8e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 1009,
      "bookHadithIndex": 134,
      "text": "اخبرنا محمد بن ادم، عن حفص بن غياث، عن العلاء بن المسيب، عن عمرو بن مرة، عن طلحة بن يزيد، عن حذيفة، والاعمش، عن سعد بن عبيدة، عن المستورد بن الاحنف، عن صلة بن زفر، عن حذيفة، ان النبي صلى الله عليه وسلم قرا البقرة وال عمران والنساء في ركعة لا يمر باية رحمة الا سال ولا باية عذاب الا استجار",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1009-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1009-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1009-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f8f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 1010,
      "bookHadithIndex": 135,
      "text": "اخبرنا نوح بن حبيب، قال حدثنا يحيى بن سعيد القطان، قال حدثنا قدامة بن عبد الله، قال حدثتني جسرة بنت دجاجة، قالت سمعت ابا ذر، يقول قام النبي صلى الله عليه وسلم حتى اصبح باية والاية { ان تعذبهم فانهم عبادك وان تغفر لهم فانك انت العزيز الحكيم}",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1010-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1010-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1010-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f90",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 1011,
      "bookHadithIndex": 136,
      "text": "اخبرنا احمد بن منيع، ويعقوب بن ابراهيم الدورقي، قالا حدثنا هشيم، قال حدثنا ابو بشر، جعفر بن ابي وحشية - وهو ابن اياس - عن سعيد بن جبير، عن ابن عباس، في قوله عز وجل { ولا تجهر بصلاتك ولا تخافت بها } قال نزلت ورسول الله صلى الله عليه وسلم مختف بمكة فكان اذا صلى باصحابه رفع صوته - وقال ابن منيع يجهر بالقران - وكان المشركون اذا سمعوا صوته سبوا القران ومن انزله ومن جاء به فقال الله عز وجل لنبيه صلى الله عليه وسلم { ولا تجهر بصلاتك } اى بقراءتك فيسمع المشركون فيسبوا القران { ولا تخافت بها } عن اصحابك فلا يسمعوا { وابتغ بين ذلك سبيلا}",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1011-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1011-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1011-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f91",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 1012,
      "bookHadithIndex": 137,
      "text": "اخبرنا محمد بن قدامة، قال حدثنا جرير، عن الاعمش، عن جعفر بن اياس، عن سعيد بن جبير، عن ابن عباس، قال كان النبي صلى الله عليه وسلم يرفع صوته بالقران وكان المشركون اذا سمعوا صوته سبوا القران ومن جاء به فكان النبي صلى الله عليه وسلم يخفض صوته بالقران ما كان يسمعه اصحابه فانزل الله عز وجل { ولا تجهر بصلاتك ولا تخافت بها وابتغ بين ذلك سبيلا}",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1012-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1012-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1012-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"

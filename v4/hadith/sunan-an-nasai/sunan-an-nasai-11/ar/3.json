      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f95",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 1016,
      "bookHadithIndex": 141,
      "text": "اخبرنا عمرو بن علي، قال حدثنا يحيى، قال حدثنا شعبة، قال حدثني طلحة، عن عبد الرحمن بن عوسجة، عن البراء بن عازب، قال قال رسول الله صلى الله عليه وسلم \" زينوا القران باصواتكم \" . قال ابن عوسجة كنت نسيت هذه \" زينوا القران \" . حتى ذكرنيه الضحاك بن مزاحم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1016-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"

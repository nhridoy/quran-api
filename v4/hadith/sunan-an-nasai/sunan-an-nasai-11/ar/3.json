    },
    {
      "id": "69b6c611dd1a4c9c86f09f93",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 1014,
      "bookHadithIndex": 139,
      "text": "اخبرنا عمرو بن علي، قال حدثنا عبد الرحمن، قال حدثنا جرير بن حازم، عن قتادة، قال سالت انسا كيف كانت قراءة رسول الله صلى الله عليه وسلم قال كان يمد صوته مدا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1014-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"

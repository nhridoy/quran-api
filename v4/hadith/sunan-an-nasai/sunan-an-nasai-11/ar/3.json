    },
    {
      "id": "69b6c611dd1a4c9c86f09f94",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 1015,
      "bookHadithIndex": 140,
      "text": "اخبرنا علي بن حجر، قال حدثنا جرير، عن الاعمش، عن طلحة بن مصرف، عن عبد الرحمن بن عوسجة، عن البراء، قال قال رسول الله صلى الله عليه وسلم \" زينوا القران باصواتكم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1015-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"

        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-992-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f7e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 993,
      "bookHadithIndex": 118,
      "text": "اخبرنا سليمان بن داود، عن ابن وهب، قال حدثنا عمرو بن الحارث، عن سعيد بن ابي هلال، ان ابا الرجال، محمد بن عبد الرحمن حدثه عن امه، عمرة عن عايشة، ان رسول الله صلى الله عليه وسلم بعث رجلا على سرية فكان يقرا لاصحابه في صلاتهم فيختم ب { قل هو الله احد } فلما رجعوا ذكروا ذلك لرسول الله صلى الله عليه وسلم فقال \" سلوه لاى شىء فعل ذلك \" . فسالوه فقال لانها صفة الرحمن عز وجل فانا احب ان اقرا بها . قال رسول الله صلى الله عليه وسلم \" اخبروه ان الله عز وجل يحبه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-993-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-993-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-993-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f7f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 994,
      "bookHadithIndex": 119,
      "text": "اخبرنا قتيبة، عن مالك، عن عبيد الله بن عبد الرحمن، عن عبيد بن حنين، مولى ال زيد بن الخطاب قال سمعت ابا هريرة، يقول اقبلت مع رسول الله صلى الله عليه وسلم فسمع رجلا يقرا { قل هو الله احد * الله الصمد * لم يلد ولم يولد * ولم يكن له كفوا احد } فقال رسول الله صلى الله عليه وسلم \" وجبت \" . فسالته ماذا يا رسول الله قال \" الجنة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-994-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-994-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-994-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f80",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 995,
      "bookHadithIndex": 120,
      "text": "اخبرنا قتيبة، عن مالك، عن عبد الرحمن بن عبد الله بن عبد الرحمن بن ابي صعصعة، عن ابيه، عن ابي سعيد الخدري، ان رجلا، سمع رجلا، يقرا { قل هو الله احد } يرددها فلما اصبح جاء الى النبي صلى الله عليه وسلم فذكر ذلك له فقال رسول الله صلى الله عليه وسلم \" والذي نفسي بيده انها لتعدل ثلث القران",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-995-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-995-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-995-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f81",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 996,
      "bookHadithIndex": 121,
      "text": "اخبرنا محمد بن بشار، قال حدثنا عبد الرحمن، قال حدثنا زايدة، عن منصور، عن هلال بن يساف، عن ربيع بن خثيم، عن عمرو بن ميمون، عن ابن ابي ليلى، عن امراة، عن ابي ايوب، عن النبي صلى الله عليه وسلم قال \" { قل هو الله احد } ثلث القران \" . قال ابو عبد الرحمن ما اعرف اسنادا اطول من هذا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-996-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-996-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-996-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f82",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 997,
      "bookHadithIndex": 122,
      "text": "اخبرنا محمد بن قدامة، قال حدثنا جرير، عن الاعمش، عن محارب بن دثار، عن جابر، قال قام معاذ فصلى العشاء الاخرة فطول فقال النبي صلى الله عليه وسلم \" افتان يا معاذ افتان يا معاذ اين كنت عن { سبح اسم ربك الاعلى } والضحى و { اذا السماء انفطرت}",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-997-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-997-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-997-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f83",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 998,
      "bookHadithIndex": 123,
      "text": "اخبرنا قتيبة، قال حدثنا الليث، عن ابي الزبير، عن جابر، قال صلى معاذ بن جبل لاصحابه العشاء فطول عليهم فانصرف رجل منا فاخبر معاذ عنه فقال انه منافق . فلما بلغ ذلك الرجل دخل على النبي صلى الله عليه وسلم فاخبره بما قال معاذ . فقال له النبي صلى الله عليه وسلم \" اتريد ان تكون فتانا يا معاذ اذا اممت الناس فاقرا بالشمس وضحاها و { سبح اسم ربك الاعلى } و { والليل اذا يغشى } و { اقرا باسم ربك}",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-998-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-998-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-998-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f84",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 999,
      "bookHadithIndex": 124,
      "text": "اخبرنا محمد بن علي بن الحسن بن شقيق، قال حدثنا ابي قال، انبانا الحسين بن واقد، عن عبد الله بن بريدة، عن ابيه، ان رسول الله صلى الله عليه وسلم كان يقرا في صلاة العشاء الاخرة بالشمس وضحاها واشباهها من السور",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-999-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-999-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-999-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f85",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 1000,
      "bookHadithIndex": 125,
      "text": "اخبرنا قتيبة، عن مالك، عن يحيى بن سعيد، عن عدي بن ثابت، عن البراء بن عازب، قال صليت مع رسول الله صلى الله عليه وسلم العتمة فقرا فيها بالتين والزيتون",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1000-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1000-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1000-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f86",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 1001,
      "bookHadithIndex": 126,
      "text": "اخبرنا اسماعيل بن مسعود، قال حدثنا يزيد بن زريع، قال حدثنا شعبة، عن عدي بن ثابت، عن البراء بن عازب، قال كان رسول الله صلى الله عليه وسلم في سفر فقرا في العشاء في الركعة الاولى بالتين والزيتون",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1001-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1001-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1001-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f87",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 1002,
      "bookHadithIndex": 127,
      "text": "اخبرنا عمرو بن علي، قال حدثنا يحيى بن سعيد، قال حدثنا شعبة، قال حدثني ابو عون، قال سمعت جابر بن سمرة، يقول قال عمر لسعد قد شكاك الناس في كل شىء حتى في الصلاة . فقال سعد اتيد في الاوليين واحذف في الاخريين وما الو ما اقتديت به من صلاة رسول الله صلى الله عليه وسلم . قال ذاك الظن بك",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1002-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1002-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1002-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f88",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 1003,
      "bookHadithIndex": 128,
      "text": "اخبرنا حماد بن اسماعيل بن ابراهيم ابن علية ابو الحسن، قال حدثنا ابي، عن داود الطايي، عن عبد الملك بن عمير، عن جابر بن سمرة، قال وقع ناس من اهل الكوفة في سعد عند عمر فقالوا والله ما يحسن الصلاة . فقال اما انا فاصلي بهم صلاة رسول الله صلى الله عليه وسلم لا اخرم عنها اركد في الاوليين واحذف في الاخريين . قال ذاك الظن بك",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1003-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1003-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1003-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f89",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 1004,
      "bookHadithIndex": 129,
      "text": "اخبرنا اسحاق بن ابراهيم، قال انبانا عيسى بن يونس، عن الاعمش، عن شقيق، عن عبد الله، قال اني لاعرف النظاير التي كان يقرا بهن رسول الله صلى الله عليه وسلم عشرين سورة في عشر ركعات ثم اخذ بيد علقمة فدخل ثم خرج الينا علقمة فسالناه فاخبرنا بهن",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1004-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1004-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1004-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f8a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 1005,
      "bookHadithIndex": 130,
      "text": "اخبرنا اسماعيل بن مسعود، قال حدثنا خالد، قال حدثنا شعبة، عن عمرو بن مرة، قال سمعت ابا وايل، يقول قال رجل عند عبد الله قرات المفصل في ركعة . قال هذا كهذ الشعر لقد عرفت النظاير التي كان رسول الله صلى الله عليه وسلم يقرن بينهن . فذكر عشرين سورة من المفصل سورتين سورتين في ركعة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1005-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1005-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1005-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f8b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 1006,
      "bookHadithIndex": 131,
      "text": "اخبرنا عمرو بن منصور، قال حدثنا عبد الله بن رجاء، قال انبانا اسراييل، عن ابي حصين، عن يحيى بن وثاب، عن مسروق، عن عبد الله، واتاه، رجل فقال اني قرات الليلة المفصل في ركعة . فقال هذا كهذ الشعر لكن رسول الله صلى الله عليه وسلم كان يقرا النظاير عشرين سورة من المفصل من ال حم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1006-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1006-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1006-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f8c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 1007,
      "bookHadithIndex": 132,
      "text": "اخبرنا محمد بن عبد الاعلى، قال حدثنا خالد، قال حدثنا ابن جريج، قال اخبرني محمد بن عباد، حديثا رفعه الى ابن سفيان عن عبد الله بن السايب، قال حضرت رسول الله صلى الله عليه وسلم يوم الفتح فصلى في قبل الكعبة فخلع نعليه فوضعهما عن يساره فافتتح بسورة المومنين فلما جاء ذكر موسى او عيسى - عليهما السلام - اخذته سعلة فركع",
      "grades": [

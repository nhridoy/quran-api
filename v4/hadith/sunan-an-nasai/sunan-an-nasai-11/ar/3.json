          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1020-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f9a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 1021,
      "bookHadithIndex": 146,
      "text": "اخبرنا اسحاق بن ابراهيم، قال حدثنا عبد الرزاق، قال حدثنا معمر، عن الزهري، عن عروة، عن عايشة، قالت سمع رسول الله صلى الله عليه وسلم قراءة ابي موسى فقال \" لقد اوتي هذا مزمارا من مزامير ال داود عليه السلام",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1021-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1021-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1021-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f9b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 1022,
      "bookHadithIndex": 147,
      "text": "اخبرنا قتيبة، قال حدثنا الليث بن سعد، عن عبد الله بن عبيد الله بن ابي مليكة، عن يعلى بن مملك، انه سال ام سلمة عن قراءة، رسول الله صلى الله عليه وسلم وصلاته قالت ما لكم وصلاته ثم نعتت فاذا هي تنعت قراءته مفسرة حرفا حرفا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1022-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1022-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1022-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f9c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 1023,
      "bookHadithIndex": 148,
      "text": "اخبرنا سويد بن نصر، قال انبانا عبد الله بن المبارك، عن يونس، عن الزهري، عن ابي سلمة بن عبد الرحمن، ان ابا هريرة، حين استخلفه مروان على المدينة كان اذا قام الى الصلاة المكتوبة كبر ثم يكبر حين يركع فاذا رفع راسه من الركعة قال سمع الله لمن حمده ربنا ولك الحمد ثم يكبر حين يهوي ساجدا ثم يكبر حين يقوم من الثنتين بعد التشهد يفعل مثل ذلك حتى يقضي صلاته فاذا قضى صلاته وسلم اقبل على اهل المسجد فقال والذي نفسي بيده اني لاشبهكم صلاة برسول الله صلى الله عليه وسلم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1023-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1023-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1023-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f9d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 1024,
      "bookHadithIndex": 149,
      "text": "اخبرنا علي بن حجر، قال انبانا اسماعيل، عن سعيد، عن قتادة، عن نصر بن عاصم الليثي، عن مالك بن الحويرث، قال رايت رسول الله صلى الله عليه وسلم يرفع يديه اذا كبر واذا ركع واذا رفع راسه من الركوع حتى بلغتا فروع اذنيه",
      "grades": [

          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1017-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f97",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 1018,
      "bookHadithIndex": 143,
      "text": "اخبرنا قتيبة، قال حدثنا سفيان، عن الزهري، عن ابي سلمة، عن ابي هريرة، ان النبي صلى الله عليه وسلم قال \" ما اذن الله عز وجل لشىء يعني اذنه لنبي يتغنى بالقران",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1018-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1018-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1018-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f98",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 1019,
      "bookHadithIndex": 144,
      "text": "اخبرنا سليمان بن داود، عن ابن وهب، قال اخبرني عمرو بن الحارث، ان ابن شهاب، اخبره ان ابا سلمة اخبره ان ابا هريرة حدثه ان رسول الله صلى الله عليه وسلم سمع قراءة ابي موسى فقال \" لقد اوتي مزمارا من مزامير ال داود عليه السلام",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1019-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1019-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1019-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f09f99",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 11,
      "hadithIndex": 1020,
      "bookHadithIndex": 145,
      "text": "اخبرنا عبد الجبار بن العلاء بن عبد الجبار، عن سفيان، عن الزهري، عن عروة، عن عايشة، قالت سمع النبي صلى الله عليه وسلم قراءة ابي موسى فقال \" لقد اوتي هذا من مزامير ال داود عليه السلام",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1020-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-11-1020-alalbani",

      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0aa98",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 35,
      "hadithIndex": 3831,
      "bookHadithIndex": 71,
      "text": "Rapporté par Abu Hurairah : Le Messager d'Allah a dit : « Soulayman bin Dawud a dit : \"Cette nuit, je vais aller voir quatre-vingt-dix femmes, chacune d'elles donnera naissance à un cavalier qui combattra pour la cause d'Allah.\" Son compagnon lui a dit : \"Si Allah le veut.\" Mais il n'a pas dit : \"Si Allah le veut.\" Puis il est allé voir toutes ces femmes, mais aucune n'est tombée enceinte sauf une, qui a donné naissance à un demi-homme. Par Celui qui détient mon âme dans Sa main ! S'il avait dit : \"Si Allah le veut\", elles auraient toutes combattu pour la cause d'Allah en tant que cavalières. »",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-35-3831-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-35-3831-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },

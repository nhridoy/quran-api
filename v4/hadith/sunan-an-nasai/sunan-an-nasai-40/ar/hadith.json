          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ac17",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 40,
      "hadithIndex": 4214,
      "bookHadithIndex": 3,
      "text": "اخبرنا محمد بن المثنى، قال حدثنا عفان، قال حدثنا حماد بن سلمة، قال حدثنا ايوب، وحبيب، ويونس، وقتادة، عن محمد بن سيرين، عن سلمان بن عامر الضبي، ان رسول الله صلى الله عليه وسلم قال \" في الغلام عقيقة فاهريقوا عنه دما واميطوا عنه الاذى",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-40-4214-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-40-4214-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-40-4214-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ac18",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 40,
      "hadithIndex": 4215,
      "bookHadithIndex": 4,
      "text": "اخبرنا احمد بن سليمان، قال حدثنا عفان، قال حدثنا حماد، عن قيس بن سعد، عن عطاء، وطاوس، ومجاهد، عن ام كرز، ان رسول الله صلى الله عليه وسلم قال \" في الغلام شاتان مكافاتان وفي الجارية شاة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-40-4215-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-40-4215-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-40-4215-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ac19",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 40,
      "hadithIndex": 4216,
      "bookHadithIndex": 5,
      "text": "اخبرنا عبيد الله بن سعيد، قال حدثنا سفيان، قال قال عمرو عن عطاء، عن حبيبة بنت ميسرة، عن ام كرز، ان رسول الله صلى الله عليه وسلم قال \" عن الغلام شاتان مكافاتان وعن الجارية شاة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-40-4216-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-40-4216-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-40-4216-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ac1a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 40,
      "hadithIndex": 4217,
      "bookHadithIndex": 6,
      "text": "اخبرنا قتيبة، قال حدثنا سفيان، عن عبيد الله، - وهو ابن ابي يزيد - عن سباع بن ثابت، عن ام كرز، قالت اتيت النبي صلى الله عليه وسلم بالحديبية اساله عن لحوم الهدى فسمعته يقول \" على الغلام شاتان وعلى الجارية شاة لا يضركم ذكرانا كن ام اناثا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-40-4217-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-40-4217-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-40-4217-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ac1b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 40,
      "hadithIndex": 4218,
      "bookHadithIndex": 7,
      "text": "اخبرنا عمرو بن علي، قال حدثنا يحيى، قال حدثنا ابن جريج، قال حدثني عبيد الله بن ابي يزيد، عن سباع بن ثابت، عن ام كرز، ان رسول الله صلى الله عليه وسلم قال \" عن الغلام شاتان وعن الجارية شاة لا يضركم ذكرانا كن ام اناثا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-40-4218-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-40-4218-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-40-4218-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ac1c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 40,
      "hadithIndex": 4219,
      "bookHadithIndex": 8,
      "text": "اخبرنا احمد بن حفص بن عبد الله، قال حدثني ابي قال، حدثني ابراهيم، - هو ابن طهمان - عن الحجاج بن الحجاج، عن قتادة، عن عكرمة، عن ابن عباس، قال عق رسول الله صلى الله عليه وسلم عن الحسن والحسين رضى الله عنهما بكبشين كبشين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-40-4219-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-40-4219-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-40-4219-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ac1d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 40,
      "hadithIndex": 4220,
      "bookHadithIndex": 9,
      "text": "اخبرنا عمرو بن علي، ومحمد بن عبد الاعلى، قالا حدثنا يزيد، - وهو ابن زريع - عن سعيد، انبانا قتادة، عن الحسن، عن سمرة بن جندب، عن رسول الله صلى الله عليه وسلم قال \" كل غلام رهين بعقيقته تذبح عنه يوم سابعه ويحلق راسه ويسمى",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-40-4220-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-40-4220-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-40-4220-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ac1e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 40,
      "hadithIndex": 4221,
      "bookHadithIndex": 10,
      "text": "اخبرنا هارون بن عبد الله، قال حدثنا قريش بن انس، عن حبيب بن الشهيد، قال لي محمد بن سيرين سل الحسن ممن سمع حديثه، في العقيقة . فسالته عن ذلك، فقال سمعته من، سمرة",
      "grades": [
        {

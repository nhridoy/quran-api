          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1383-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a105",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1384,
      "bookHadithIndex": 21,
      "text": "اخبرني عمرو بن عثمان بن سعيد بن كثير، قال حدثنا الوليد، عن عبد الرحمن بن يزيد بن جابر، انه سمع ابا الاشعث، حدثه انه، سمع اوس بن اوس، صاحب رسول الله صلى الله عليه وسلم يقول قال رسول الله صلى الله عليه وسلم \" من اغتسل يوم الجمعة وغسل وغدا وابتكر ومشى ولم يركب ودنا من الامام وانصت ولم يلغ كان له بكل خطوة عمل سنة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1384-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1384-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1384-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a106",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1385,
      "bookHadithIndex": 22,
      "text": "اخبرنا نصر بن علي بن نصر، عن عبد الاعلى، قال حدثنا معمر، عن الزهري، عن الاغر ابي عبد الله، عن ابي هريرة، ان النبي صلى الله عليه وسلم قال \" اذا كان يوم الجمعة قعدت الملايكة على ابواب المسجد فكتبوا من جاء الى الجمعة فاذا خرج الامام طوت الملايكة الصحف \" . قال فقال رسول الله صلى الله عليه وسلم \" المهجر الى الجمعة كالمهدي بدنة ثم كالمهدي بقرة ثم كالمهدي شاة ثم كالمهدي بطة ثم كالمهدي دجاجة ثم كالمهدي بيضة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1385-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1385-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1385-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a107",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1386,
      "bookHadithIndex": 23,
      "text": "اخبرنا محمد بن منصور، قال حدثنا سفيان، حدثنا الزهري، عن سعيد، عن ابي هريرة، يبلغ به النبي صلى الله عليه وسلم \" اذا كان يوم الجمعة كان على كل باب من ابواب المسجد ملايكة يكتبون الناس على منازلهم الاول فالاول فاذا خرج الامام طويت الصحف واستمعوا الخطبة فالمهجر الى الصلاة كالمهدي بدنة ثم الذي يليه كالمهدي بقرة ثم الذي يليه كالمهدي كبشا \" . حتى ذكر الدجاجة والبيضة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1386-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1386-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1386-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a108",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1387,
      "bookHadithIndex": 24,
      "text": "اخبرنا الربيع بن سليمان، قال حدثنا شعيب بن الليث، قال انبانا الليث، عن ابن عجلان، عن سمى، عن ابي صالح، عن ابي هريرة، عن رسول الله صلى الله عليه وسلم قال \" تقعد الملايكة يوم الجمعة على ابواب المسجد يكتبون الناس على منازلهم فالناس فيه كرجل قدم بدنة وكرجل قدم بقرة وكرجل قدم شاة وكرجل قدم دجاجة وكرجل قدم عصفورا وكرجل قدم بيضة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1387-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1387-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1387-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a109",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1388,
      "bookHadithIndex": 25,
      "text": "اخبرنا قتيبة، عن مالك، عن سمى، عن ابي صالح، عن ابي هريرة، ان رسول الله صلى الله عليه وسلم قال \" من اغتسل يوم الجمعة غسل الجنابة ثم راح فكانما قرب بدنة ومن راح في الساعة الثانية فكانما قرب بقرة ومن راح في الساعة الثالثة فكانما قرب كبشا ومن راح في الساعة الرابعة فكانما قرب دجاجة ومن راح في الساعة الخامسة فكانما قرب بيضة فاذا خرج الامام حضرت الملايكة يستمعون الذكر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1388-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1388-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1388-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a10a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1389,
      "bookHadithIndex": 26,
      "text": "اخبرنا عمرو بن سواد بن الاسود بن عمرو، والحارث بن مسكين، قراءة عليه وانا اسمع، - واللفظ له - عن ابن وهب، عن عمرو بن الحارث، عن الجلاح، مولى عبد العزيز ان ابا سلمة بن عبد الرحمن، حدثه عن جابر بن عبد الله، عن رسول الله صلى الله عليه وسلم قال \" يوم الجمعة اثنتا عشرة ساعة لا يوجد فيها عبد مسلم يسال الله شييا الا اتاه اياه فالتمسوها اخر ساعة بعد العصر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1389-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1389-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1389-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a10b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1390,
      "bookHadithIndex": 27,
      "text": "اخبرني هارون بن عبد الله، قال حدثني يحيى بن ادم، قال حدثنا حسن بن عياش، قال حدثنا جعفر بن محمد، عن ابيه، عن جابر بن عبد الله، قال كنا نصلي مع رسول الله صلى الله عليه وسلم الجمعة ثم نرجع فنريح نواضحنا . قلت اية ساعة قال زوال الشمس",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1390-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1390-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1390-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a10c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1391,
      "bookHadithIndex": 28,
      "text": "اخبرنا شعيب بن يوسف، قال انبانا عبد الرحمن، عن يعلى بن الحارث، قال سمعت اياس بن سلمة بن الاكوع، يحدث عن ابيه، قال كنا نصلي مع رسول الله صلى الله عليه وسلم الجمعة ثم نرجع وليس للحيطان فىء يستظل به",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1391-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1391-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1391-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a10d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1392,
      "bookHadithIndex": 29,
      "text": "اخبرنا محمد بن سلمة، قال حدثنا ابن وهب، عن يونس، عن ابن شهاب، قال اخبرني السايب بن يزيد، ان الاذان، كان اول حين يجلس الامام على المنبر يوم الجمعة في عهد رسول الله صلى الله عليه وسلم وابي بكر وعمر فلما كان في خلافة عثمان وكثر الناس امر عثمان يوم الجمعة بالاذان الثالث فاذن به على الزوراء فثبت الامر على ذلك",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1392-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1392-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1392-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a10e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1393,
      "bookHadithIndex": 30,
      "text": "اخبرنا محمد بن يحيى بن عبد الله، قال حدثنا يعقوب، قال حدثنا ابي، عن صالح، عن ابن شهاب، ان السايب بن يزيد، اخبره قال انما امر بالتاذين الثالث عثمان حين كثر اهل المدينة ولم يكن لرسول الله صلى الله عليه وسلم غير موذن واحد وكان التاذين يوم الجمعة حين يجلس الامام",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1393-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1393-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1393-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a10f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1394,
      "bookHadithIndex": 31,
      "text": "اخبرنا محمد بن عبد الاعلى، قال حدثنا المعتمر، عن ابيه، عن الزهري، عن السايب بن يزيد، قال كان بلال يوذن اذا جلس رسول الله صلى الله عليه وسلم على المنبر يوم الجمعة فاذا نزل اقام ثم كان كذلك في زمن ابي بكر وعمر رضى الله عنهما",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1394-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1394-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1394-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a110",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1395,
      "bookHadithIndex": 32,
      "text": "اخبرنا محمد بن عبد الاعلى، قال حدثنا خالد، قال حدثنا شعبة، عن عمرو بن دينار، قال سمعت جابر بن عبد الله، يقول ان رسول الله صلى الله عليه وسلم قال \" اذا جاء احدكم وقد خرج الامام فليصل ركعتين \" . قال شعبة يوم الجمعة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1395-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1395-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1395-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a111",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1396,
      "bookHadithIndex": 33,
      "text": "اخبرنا عمرو بن سواد بن الاسود، قال انبانا ابن وهب، قال انبانا ابن جريج، ان ابا الزبير، اخبره انه، سمع جابر بن عبد الله، يقول كان رسول الله صلى الله عليه وسلم اذا خطب يستند الى جذع نخلة من سواري المسجد فلما صنع المنبر واستوى عليه اضطربت تلك السارية كحنين الناقة حتى سمعها اهل المسجد حتى نزل اليها رسول الله صلى الله عليه وسلم فاعتنقها فسكتت",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1396-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1396-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1396-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a112",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1397,
      "bookHadithIndex": 34,
      "text": "اخبرنا احمد بن عبد الله بن الحكم، قال حدثنا محمد بن جعفر، قال حدثنا شعبة، عن منصور، عن عمرو بن مرة، عن ابي عبيدة، عن كعب بن عجرة، قال دخل المسجد وعبد الرحمن بن ام الحكم يخطب قاعدا فقال انظروا الى هذا يخطب قاعدا وقد قال الله عز وجل { واذا راوا تجارة او لهوا انفضوا اليها وتركوك قايما}",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1397-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1397-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1397-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a113",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1398,
      "bookHadithIndex": 35,
      "text": "اخبرنا محمود بن خالد، قال حدثني عمر بن عبد الواحد، قال سمعت يحيى بن الحارث، يحدث عن ابي الاشعث الصنعاني، عن اوس بن اوس الثقفي، عن رسول الله صلى الله عليه وسلم قال \" من غسل واغتسل وابتكر وغدا ودنا من الامام وانصت ثم لم يلغ كان له بكل خطوة كاجر سنة صيامها وقيامها",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1398-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1398-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1398-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a114",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1399,
      "bookHadithIndex": 36,
      "text": "اخبرنا وهب بن بيان، قال انبانا ابن وهب، قال سمعت معاوية بن صالح، عن ابي الزاهرية، عن عبد الله بن بسر، قال كنت جالسا الى جانبه يوم الجمعة فقال جاء رجل يتخطى رقاب الناس فقال له رسول الله صلى الله عليه وسلم \" اى اجلس فقد اذيت",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1399-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1399-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1399-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a115",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1400,
      "bookHadithIndex": 37,
      "text": "اخبرنا ابراهيم بن الحسن، ويوسف بن سعيد، - واللفظ له - قالا حدثنا حجاج، عن ابن جريج، قال اخبرني عمرو بن دينار، انه سمع جابر بن عبد الله، يقول جاء رجل والنبي صلى الله عليه وسلم على المنبر يوم الجمعة فقال له \" اركعت ركعتين \" . قال لا . قال \" فاركع",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1400-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1400-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1400-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a116",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1401,
      "bookHadithIndex": 38,
      "text": "اخبرنا قتيبة، قال حدثنا الليث، عن عقيل، عن الزهري، عن سعيد بن المسيب، عن ابي هريرة، عن النبي صلى الله عليه وسلم قال \" من قال لصاحبه يوم الجمعة والامام يخطب انصت فقد لغا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1401-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1401-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1401-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a117",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1402,
      "bookHadithIndex": 39,
      "text": "اخبرنا عبد الملك بن شعيب بن الليث بن سعد، قال حدثني ابي، عن جدي، قال حدثني عقيل، عن ابن شهاب، عن عمر بن عبد العزيز، عن عبد الله بن ابراهيم بن قارظ، وعن سعيد بن المسيب، انهما حدثاه ان ابا هريرة قال سمعت رسول الله صلى الله عليه وسلم يقول \" اذا قلت لصاحبك انصت يوم الجمعة والامام يخطب فقد لغوت",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1402-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1402-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1402-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a118",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1403,
      "bookHadithIndex": 40,
      "text": "اخبرنا اسحاق بن ابراهيم، قال انبانا جرير، عن منصور، عن ابي معشر، زياد بن كليب عن ابراهيم، عن علقمة، عن القرثع الضبي، - وكان من القراء الاولين - عن سلمان، قال قال لي رسول الله صلى الله عليه وسلم \" ما من رجل يتطهر يوم الجمعة كما امر ثم يخرج من بيته حتى ياتي الجمعة وينصت حتى يقضي صلاته الا كان كفارة لما قبله من الجمعة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1403-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1403-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1403-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a119",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1404,
      "bookHadithIndex": 41,
      "text": "اخبرنا محمد بن المثنى، ومحمد بن بشار، قالا حدثنا محمد بن جعفر، قال حدثنا شعبة، قال سمعت ابا اسحاق، يحدث عن ابي عبيدة، عن عبد الله، عن النبي صلى الله عليه وسلم قال \" علمنا خطبة الحاجة الحمد لله نستعينه ونستغفره ونعوذ بالله من شرور انفسنا وسييات اعمالنا من يهده الله فلا مضل له ومن يضلل فلا هادي له واشهد ان لا اله الا الله واشهد ان محمدا عبده ورسوله ثم يقرا ثلاث ايات { يا ايها الذين امنوا اتقوا الله حق تقاته ولا تموتن الا وانتم مسلمون } { يا ايها الناس اتقوا ربكم الذي خلقكم من نفس واحدة وخلق منها زوجها وبث منهما رجالا كثيرا ونساء واتقوا الله الذي تساءلون به والارحام ان الله كان عليكم رقيبا } { يا ايها الذين امنوا اتقوا الله وقولوا قولا سديدا } \" . قال ابو عبد الرحمن ابو عبيدة لم يسمع من ابيه شييا ولا عبد الرحمن بن عبد الله بن مسعود ولا عبد الجبار بن وايل بن حجر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1404-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1404-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1404-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a11a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1405,
      "bookHadithIndex": 42,
      "text": "اخبرنا محمد بن بشار، قال حدثنا محمد بن جعفر، قال حدثنا شعبة، عن الحكم، عن نافع، عن ابن عمر، قال خطب رسول الله صلى الله عليه وسلم فقال \" اذا راح احدكم الى الجمعة فليغتسل",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1405-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1405-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1405-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a11b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1406,
      "bookHadithIndex": 43,
      "text": "اخبرنا محمد بن سلمة، قال حدثنا ابن وهب، عن ابراهيم بن نشيط، انه سال ابن شهاب عن الغسل، يوم الجمعة فقال سنة وقد حدثني به، سالم بن عبد الله عن ابيه، ان رسول الله صلى الله عليه وسلم تكلم بها على المنبر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1406-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1406-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1406-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a11c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1407,
      "bookHadithIndex": 44,
      "text": "اخبرنا قتيبة، قال حدثنا الليث، عن ابن شهاب، عن عبد الله بن عبد الله، عن عبد الله بن عمر، عن رسول الله صلى الله عليه وسلم انه قال وهو قايم على المنبر \" من جاء منكم الجمعة فليغتسل \" . قال ابو عبد الرحمن ما اعلم احدا تابع الليث على هذا الاسناد غير ابن جريج واصحاب الزهري يقولون عن سالم بن عبد الله عن ابيه بدل عبد الله بن عبد الله بن عمر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1407-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1407-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1407-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a11d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1408,
      "bookHadithIndex": 45,
      "text": "اخبرنا محمد بن عبد الله بن يزيد، قال حدثنا سفيان، عن ابن عجلان، عن عياض بن عبد الله، قال سمعت ابا سعيد الخدري، يقول جاء رجل يوم الجمعة والنبي صلى الله عليه وسلم يخطب بهيية بذة فقال له رسول الله صلى الله عليه وسلم \" اصليت \" . قال لا . قال \" صل ركعتين \" . وحث الناس على الصدقة فالقوا ثيابا فاعطاه منها ثوبين فلما كانت الجمعة الثانية جاء ورسول الله صلى الله عليه وسلم يخطب فحث الناس على الصدقة - قال - فالقى احد ثوبيه فقال رسول الله صلى الله عليه وسلم \" جاء هذا يوم الجمعة بهيية بذة فامرت الناس بالصدقة فالقوا ثيابا فامرت له منها بثوبين ثم جاء الان فامرت الناس بالصدقة فالقى احدهما \" . فانتهره وقال \" خذ ثوبك",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1408-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1408-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1408-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a11e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1409,
      "bookHadithIndex": 46,
      "text": "اخبرنا قتيبة، قال حدثنا حماد بن زيد، عن عمرو بن دينار، عن جابر بن عبد الله، قال بينا النبي صلى الله عليه وسلم يخطب يوم الجمعة اذ جاء رجل فقال له النبي صلى الله عليه وسلم \" صليت \" . قال لا . قال \" قم فاركع",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1409-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1409-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1409-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a11f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1410,
      "bookHadithIndex": 47,
      "text": "اخبرنا محمد بن منصور، قال حدثنا سفيان، قال حدثنا ابو موسى، اسراييل بن موسى قال سمعت الحسن، يقول سمعت ابا بكرة، يقول لقد رايت رسول الله صلى الله عليه وسلم على المنبر والحسن معه وهو يقبل على الناس مرة وعليه مرة ويقول \" ان ابني هذا سيد ولعل الله ان يصلح به بين فيتين من المسلمين عظيمتين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1410-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1410-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1410-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a120",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1411,
      "bookHadithIndex": 48,
      "text": "اخبرنا محمد بن المثنى، قال حدثنا هارون بن اسماعيل، قال حدثنا علي، - وهو ابن المبارك - عن يحيى، عن محمد بن عبد الرحمن، عن ابنة حارثة بن النعمان، قالت حفظت { ق والقران المجيد } من في رسول الله صلى الله عليه وسلم وهو على المنبر يوم الجمعة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1411-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1411-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1411-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a121",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1412,
      "bookHadithIndex": 49,
      "text": "اخبرنا محمود بن غيلان، قال حدثنا وكيع، قال حدثنا سفيان، عن حصين، ان بشر بن مروان، رفع يديه يوم الجمعة على المنبر فسبه عمارة بن رويبة الثقفي وقال ما زاد رسول الله صلى الله عليه وسلم على هذا واشار باصبعه السبابة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1412-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1412-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1412-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a122",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1413,
      "bookHadithIndex": 50,
      "text": "اخبرنا محمد بن عبد العزيز، قال حدثنا الفضل بن موسى، عن حسين بن واقد، عن عبد الله بن بريدة، عن ابيه، قال كان النبي صلى الله عليه وسلم يخطب فجاء الحسن والحسين - رضى الله عنهما - وعليهما قميصان احمران يعثران فيهما فنزل النبي صلى الله عليه وسلم فقطع كلامه فحملهما ثم عاد الى المنبر ثم قال \" صدق الله { انما اموالكم واولادكم فتنة } رايت هذين يعثران في قميصيهما فلم اصبر حتى قطعت كلامي فحملتهما",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1413-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1413-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1413-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a123",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1414,
      "bookHadithIndex": 51,
      "text": "اخبرنا محمد بن عبد العزيز بن غزوان، قال انبانا الفضل بن موسى، عن الحسين بن واقد، قال حدثني يحيى بن عقيل، قال سمعت عبد الله بن ابي اوفى، يقول كان رسول الله صلى الله عليه وسلم يكثر الذكر ويقل اللغو ويطيل الصلاة ويقصر الخطبة ولا يانف ان يمشي مع الارملة والمسكين فيقضي له الحاجة",
      "grades": [
        {

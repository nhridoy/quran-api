          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1371-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a0f9",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1372,
      "bookHadithIndex": 8,
      "text": "",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1372-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1372-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a0fa",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1373,
      "bookHadithIndex": 10,
      "text": "اخبرنا سويد بن نصر، قال انبانا عبد الله، عن يونس، عن الزهري، قال حدثنا عبد الرحمن الاعرج، انه سمع ابا هريرة، يقول قال رسول الله صلى الله عليه وسلم \" خير يوم طلعت فيه الشمس يوم الجمعة فيه خلق ادم عليه السلام وفيه ادخل الجنة وفيه اخرج منها",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1373-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1373-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1373-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a0fb",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1374,
      "bookHadithIndex": 11,
      "text": "اخبرنا اسحاق بن منصور، قال حدثنا حسين الجعفي، عن عبد الرحمن بن يزيد بن جابر، عن ابي الاشعث الصنعاني، عن اوس بن اوس، عن النبي صلى الله عليه وسلم قال \" ان من افضل ايامكم يوم الجمعة فيه خلق ادم عليه السلام وفيه قبض وفيه النفخة وفيه الصعقة فاكثروا على من الصلاة فان صلاتكم معروضة على \" . قالوا يا رسول الله وكيف تعرض صلاتنا عليك وقد ارمت اى يقولون قد بليت . قال \" ان الله عز وجل قد حرم على الارض ان تاكل اجساد الانبياء عليهم السلام",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1374-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1374-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1374-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a0fc",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1375,
      "bookHadithIndex": 12,
      "text": "اخبرنا محمد بن سلمة، قال حدثنا ابن وهب، عن عمرو بن الحارث، ان سعيد بن ابي هلال، وبكير بن الاشج، حدثاه عن ابي بكر بن المنكدر، عن عمرو بن سليم، عن عبد الرحمن بن ابي سعيد، عن ابيه، ان رسول الله صلى الله عليه وسلم قال \" الغسل يوم الجمعة واجب على كل محتلم والسواك ويمس من الطيب ما قدر عليه \" . الا ان بكيرا لم يذكر عبد الرحمن وقال في الطيب \" ولو من طيب المراة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1375-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1375-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1375-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a0fd",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1376,
      "bookHadithIndex": 13,
      "text": "اخبرنا قتيبة، عن مالك، عن نافع، عن ابن عمر، ان رسول الله صلى الله عليه وسلم قال \" اذا جاء احدكم الجمعة فليغتسل",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1376-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1376-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1376-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a0fe",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1377,
      "bookHadithIndex": 14,
      "text": "اخبرنا قتيبة، عن مالك، عن صفوان بن سليم، عن عطاء بن يسار، عن ابي سعيد الخدري، ان رسول الله صلى الله عليه وسلم قال \" غسل يوم الجمعة واجب على كل محتلم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1377-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1377-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1377-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a0ff",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1378,
      "bookHadithIndex": 15,
      "text": "اخبرنا حميد بن مسعدة، قال حدثنا بشر، قال حدثنا داود بن ابي هند، عن ابي الزبير، عن جابر، قال قال رسول الله صلى الله عليه وسلم \" على كل رجل مسلم في كل سبعة ايام غسل يوم وهو يوم الجمعة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1378-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1378-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1378-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a100",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1379,
      "bookHadithIndex": 16,
      "text": "اخبرنا محمود بن خالد، عن الوليد، قال حدثنا عبد الله بن العلاء، انه سمع القاسم بن محمد بن ابي بكر، انهم ذكروا غسل يوم الجمعة عند عايشة فقالت انما كان الناس يسكنون العالية فيحضرون الجمعة وبهم وسخ فاذا اصابهم الروح سطعت ارواحهم فيتاذى بها الناس فذكر ذلك لرسول الله صلى الله عليه وسلم فقال \" اولا يغتسلون",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1379-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1379-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1379-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a101",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1380,
      "bookHadithIndex": 17,
      "text": "اخبرنا ابو الاشعث، عن يزيد بن زريع، قال حدثنا شعبة، عن قتادة، عن الحسن، عن سمرة، قال قال رسول الله صلى الله عليه وسلم \" من توضا يوم الجمعة فبها ونعمت ومن اغتسل فالغسل افضل \" . قال ابو عبد الرحمن الحسن عن سمرة كتابا ولم يسمع الحسن من سمرة الا حديث العقيقة والله تعالى اعلم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1380-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1380-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1380-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a102",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1381,
      "bookHadithIndex": 18,
      "text": "اخبرنا عمرو بن منصور، وهارون بن محمد بن بكار بن بلال، - واللفظ له - قالا حدثنا ابو مسهر، قال حدثنا سعيد بن عبد العزيز، عن يحيى بن الحارث، عن ابي الاشعث الصنعاني، عن اوس بن اوس، عن النبي صلى الله عليه وسلم قال \" من غسل واغتسل وغدا وابتكر ودنا من الامام ولم يلغ كان له بكل خطوة عمل سنة صيامها وقيامها",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1381-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1381-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1381-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a103",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1382,
      "bookHadithIndex": 19,
      "text": "اخبرنا قتيبة، عن مالك، عن نافع، عن عبد الله بن عمر، ان عمر بن الخطاب، راى حلة فقال يا رسول الله لو اشتريت هذه فلبستها يوم الجمعة وللوفد اذا قدموا عليك قال رسول الله صلى الله عليه وسلم \" انما يلبس هذه من لا خلاق له في الاخرة \" . ثم جاء رسول الله صلى الله عليه وسلم مثلها فاعطى عمر منها حلة فقال عمر يا رسول الله كسوتنيها وقد قلت في حلة عطارد ما قلت قال رسول الله صلى الله عليه وسلم \" لم اكسكها لتلبسها \" . فكساها عمر اخا له مشركا بمكة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1382-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1382-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1382-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a104",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 14,
      "hadithIndex": 1383,
      "bookHadithIndex": 20,
      "text": "اخبرني هارون بن عبد الله، قال حدثنا الحسن بن سوار، قال حدثنا الليث، قال حدثنا خالد، عن سعيد، عن ابي بكر بن المنكدر، ان عمرو بن سليم، اخبره عن عبد الرحمن بن ابي سعيد، عن ابيه، عن رسول الله صلى الله عليه وسلم قال \" ان الغسل يوم الجمعة على كل محتلم والسواك وان يمس من الطيب ما يقدر عليه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-14-1383-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },

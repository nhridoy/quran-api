    {
      "id": "69b6c6d6dd1a4c9c86f0aefd",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 46,
      "hadithIndex": 4956,
      "bookHadithIndex": 86,
      "text": "",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4956-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Shadh"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4956-alalbani",

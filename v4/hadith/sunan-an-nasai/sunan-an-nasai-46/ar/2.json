          "grade": "Maqtu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4955-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0aefd",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 46,
      "hadithIndex": 4956,
      "bookHadithIndex": 86,
      "text": "اخبرنا خلاد بن اسلم، عن عبد الله بن ادريس، عن محمد بن اسحاق، عن عمرو بن شعيب، عن ابيه، عن جده، قال كان ثمن المجن على عهد رسول الله صلى الله عليه وسلم عشرة دراهم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4956-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Shadh"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4956-alalbani",
          "name": "Al-Albani",
          "grade": "Shadh"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0aefe",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 46,
      "hadithIndex": 4957,
      "bookHadithIndex": 87,
      "text": "اخبرنا قتيبة، قال حدثنا ابو عوانة، عن عبيد الله بن الاخنس، عن عمرو بن شعيب، عن ابيه، عن جده، قال سيل رسول الله صلى الله عليه وسلم في كم تقطع اليد قال \" لا تقطع اليد في ثمر معلق فاذا ضمه الجرين قطعت في ثمن المجن ولا تقطع في حريسة الجبل فاذا اوى المراح قطعت في ثمن المجن",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4957-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4957-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4957-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0aeff",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 46,
      "hadithIndex": 4958,
      "bookHadithIndex": 88,
      "text": "اخبرنا قتيبة، قال حدثنا الليث، عن ابن عجلان، عن عمرو بن شعيب، عن ابيه، عن جده عبد الله بن عمرو، عن رسول الله صلى الله عليه وسلم انه سيل عن الثمر المعلق فقال \" ما اصاب من ذي حاجة غير متخذ خبنة فلا شىء عليه ومن خرج بشىء منه فعليه غرامة مثليه والعقوبة ومن سرق شييا منه بعد ان ييويه الجرين فبلغ ثمن المجن فعليه القطع ومن سرق دون ذلك فعليه غرامة مثليه والعقوبة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4958-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4958-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4958-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0af00",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 46,
      "hadithIndex": 4959,
      "bookHadithIndex": 89,
      "text": "قال الحارث بن مسكين قراءة عليه وانا اسمع، عن ابن وهب، قال اخبرني عمرو بن الحارث، وهشام بن سعد، عن عمرو بن شعيب، عن ابيه، عن جده عبد الله بن عمرو، ان رجلا، من مزينة اتى رسول الله صلى الله عليه وسلم فقال يا رسول الله كيف ترى في حريسة الجبل فقال \" هي ومثلها والنكال وليس في شىء من الماشية قطع الا فيما اواه المراح فبلغ ثمن المجن ففيه قطع اليد وما لم يبلغ ثمن المجن ففيه غرامة مثليه وجلدات نكال \" . قال يا رسول الله كيف ترى في الثمر المعلق قال \" هو ومثله معه والنكال وليس في شىء من الثمر المعلق قطع الا فيما اواه الجرين فما اخذ من الجرين فبلغ ثمن المجن ففيه القطع وما لم يبلغ ثمن المجن ففيه غرامة مثليه وجلدات نكال",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4959-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "-"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4959-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4959-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0af01",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 46,
      "hadithIndex": 4960,
      "bookHadithIndex": 90,
      "text": "اخبرنا محمد بن خالد بن خلي، قال حدثنا ابي قال، حدثنا سلمة، - يعني ابن عبد الملك العوصي - عن الحسن، - وهو ابن صالح - عن يحيى بن سعيد، عن القاسم بن محمد بن ابي بكر، عن رافع بن خديج، قال سمعت رسول الله صلى الله عليه وسلم يقول \" لا قطع في ثمر ولا كثر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4960-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4960-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4960-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0af02",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 46,
      "hadithIndex": 4961,
      "bookHadithIndex": 91,
      "text": "اخبرنا عمرو بن علي، قال سمعت يحيى بن سعيد القطان، يقول حدثنا يحيى بن سعيد، عن محمد بن يحيى بن حبان، عن رافع بن خديج، قال سمعت رسول الله صلى الله عليه وسلم يقول \" لا قطع في ثمر ولا كثر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4961-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4961-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4961-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0af03",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 46,
      "hadithIndex": 4962,
      "bookHadithIndex": 92,
      "text": "اخبرني يحيى بن حبيب بن عربي، قال حدثنا حماد، عن يحيى، عن محمد بن يحيى بن حبان، عن رافع بن خديج، قال سمعت رسول الله صلى الله عليه وسلم يقول \" لا قطع في ثمر ولا كثر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4962-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4962-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4962-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0af04",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 46,
      "hadithIndex": 4963,
      "bookHadithIndex": 93,
      "text": "اخبرنا عبد الرحمن بن محمد بن سلام، قال حدثنا ابو معاوية، عن يحيى بن سعيد، عن محمد بن يحيى بن حبان، عن رافع بن خديج، قال قال رسول الله صلى الله عليه وسلم \" لا قطع في ثمر ولا كثر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4963-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4963-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4963-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0af05",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 46,
      "hadithIndex": 4964,
      "bookHadithIndex": 94,
      "text": "اخبرنا عبد الحميد بن محمد، قال حدثنا مخلد، قال حدثنا سفيان، عن يحيى، عن محمد بن يحيى بن حبان، عن رافع بن خديج، عن النبي صلى الله عليه وسلم قال \" لا قطع في ثمر ولا كثر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4964-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4964-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4964-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0af06",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 46,
      "hadithIndex": 4965,
      "bookHadithIndex": 95,
      "text": "اخبرنا محمد بن اسماعيل بن ابراهيم، قال حدثنا ابو نعيم، عن سفيان، عن يحيى، عن محمد بن يحيى بن حبان، عن رافع بن خديج، قال قال رسول الله صلى الله عليه وسلم \" لا قطع في ثمر ولا كثر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4965-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4965-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4965-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0af07",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 46,
      "hadithIndex": 4966,
      "bookHadithIndex": 96,
      "text": "اخبرنا احمد بن محمد بن عبيد الله، - هو ابن ابي رجاء - قال حدثنا وكيع، عن سفيان، عن يحيى بن سعيد، عن محمد بن يحيى بن حبان، عن عمه، واسع، عن رافع بن خديج، قال قال رسول الله صلى الله عليه وسلم \" لا قطع في ثمر ولا كثر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4966-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4966-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4966-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0af08",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 46,
      "hadithIndex": 4967,
      "bookHadithIndex": 97,
      "text": "اخبرنا قتيبة، قال حدثنا الليث، عن يحيى بن سعيد، عن محمد بن يحيى بن حبان، عن عمه، ان رافع بن خديج، قال سمعت رسول الله صلى الله عليه وسلم يقول \" لا قطع في ثمر ولا كثر \" . والكثر الجمار",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4967-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4967-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4967-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0af09",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 46,
      "hadithIndex": 4968,
      "bookHadithIndex": 98,
      "text": "اخبرنا محمد بن علي بن ميمون، قال حدثنا سعيد بن منصور، قال حدثنا عبد العزيز بن محمد، عن يحيى بن سعيد، عن محمد بن يحيى بن حبان، عن ابي ميمون، عن رافع بن خديج، ان رسول الله صلى الله عليه وسلم قال \" لا قطع في ثمر ولا كثر \" . قال ابو عبد الرحمن هذا خطا ابو ميمون لا اعرفه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4968-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4968-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-46-4968-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0af0a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 46,
      "hadithIndex": 4969,
      "bookHadithIndex": 99,
      "text": "اخبرنا الحسين بن منصور، قال حدثنا ابو اسامة، قال حدثنا يحيى بن سعيد، عن محمد بن يحيى بن حبان، عن رجل، من قومه عن رافع بن خديج، قال سمعت رسول الله صلى الله عليه وسلم يقول \" لا قطع في ثمر ولا كثر",
      "grades": [

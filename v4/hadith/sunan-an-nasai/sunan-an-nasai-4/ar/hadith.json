      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09d41",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 4,
      "hadithIndex": 421,
      "bookHadithIndex": 26,
      "text": "اخبرنا سويد بن نصر، قال انبانا عبد الله، عن شعبة، عن الاشعث بن ابي الشعثاء، عن ابيه، عن مسروق، عن عايشة، قالت كان النبي صلى الله عليه وسلم يحب التيمن ما استطاع في طهوره وتنعله وترجله وقال بواسط في شانه كله",
      "grades": [

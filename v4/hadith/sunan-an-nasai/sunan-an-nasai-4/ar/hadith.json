          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09d3c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 4,
      "hadithIndex": 416,
      "bookHadithIndex": 21,
      "text": "اخبرنا سويد بن نصر، قال انبانا عبد الله، عن ابراهيم بن طهمان، عن ابي الزبير، عن عبيد بن عمير، ان عايشة، قالت لقد رايتني اغتسل انا ورسول الله صلى الله عليه وسلم من هذا فاذا تور موضوع مثل الصاع او دونه فنشرع فيه جميعا فافيض على راسي بيدى ثلاث مرات وما انقض لي شعرا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-416-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },

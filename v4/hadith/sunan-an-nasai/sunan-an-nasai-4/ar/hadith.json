    },
    {
      "id": "69b6c5dbdd1a4c9c86f09d49",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 4,
      "hadithIndex": 429,
      "bookHadithIndex": 34,
      "text": "اخبرنا عمرو بن علي، ومحمد بن المثنى، ويعقوب بن ابراهيم، - واللفظ له - قالوا حدثنا يحيى بن سعيد، قال حدثنا جعفر بن محمد، قال حدثني ابي قال، اتينا جابر بن عبد الله فسالناه عن حجة الوداع، فحدثنا ان رسول الله صلى الله عليه وسلم خرج لخمس بقين من ذي القعدة . وخرجنا معه حتى اذا اتى ذا الحليفة ولدت اسماء بنت عميس محمد بن ابي بكر فارسلت الى رسول الله صلى الله عليه وسلم كيف اصنع فقال \" اغتسلي ثم استثفري ثم اهلي",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-429-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-429-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-429-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09d4a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 4,
      "hadithIndex": 430,
      "bookHadithIndex": 35,
      "text": "اخبرنا احمد بن عثمان بن حكيم، قال حدثنا ابي، حدثنا حسن، عن ابي اسحاق، ح وانبانا عمرو بن علي، قال حدثنا عبد الرحمن، قال حدثنا شريك، عن ابي اسحاق، عن الاسود، عن عايشة، قالت كان رسول الله صلى الله عليه وسلم لا يتوضا بعد الغسل",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-430-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-430-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-430-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09d4b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 4,
      "hadithIndex": 431,
      "bookHadithIndex": 36,
      "text": "اخبرنا حميد بن مسعدة، عن بشر، - وهو ابن المفضل - قال حدثنا شعبة، عن ابراهيم بن محمد، عن ابيه، قال قالت عايشة كنت اطيب رسول الله صلى الله عليه وسلم فيطوف على نسايه ثم يصبح محرما ينضخ طيبا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-431-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-431-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-431-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09d4c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 4,
      "hadithIndex": 432,
      "bookHadithIndex": 37,
      "text": "اخبرنا الحسن بن اسماعيل بن سليمان، قال حدثنا هشيم، قال انبانا سيار، عن يزيد الفقير، عن جابر بن عبد الله، قال قال رسول الله صلى الله عليه وسلم \" اعطيت خمسا لم يعطهن احد قبلي نصرت بالرعب مسيرة شهر وجعلت لي الارض مسجدا وطهورا فاينما ادرك الرجل من امتي الصلاة يصلي واعطيت الشفاعة ولم يعط نبي قبلي وبعثت الى الناس كافة وكان النبي يبعث الى قومه خاصة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-432-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-432-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-432-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09d4d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 4,
      "hadithIndex": 433,
      "bookHadithIndex": 38,
      "text": "اخبرنا مسلم بن عمرو بن مسلم، قال حدثني ابن نافع، عن الليث بن سعد، عن بكر بن سوادة، عن عطاء بن يسار، عن ابي سعيد، ان رجلين، تيمما وصليا ثم وجدا ماء في الوقت فتوضا احدهما وعاد لصلاته ما كان في الوقت ولم يعد الاخر فسالا النبي صلى الله عليه وسلم فقال للذي لم يعد \" اصبت السنة واجزاتك صلاتك \" . وقال للاخر \" اما انت فلك مثل سهم جمع",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-433-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-433-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-433-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09d4e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 4,
      "hadithIndex": 434,
      "bookHadithIndex": 39,
      "text": "اخبرنا سويد بن نصر، قال حدثنا عبد الله، عن ليث بن سعد، قال حدثني عميرة، وغيره، عن بكر بن سوادة، عن عطاء بن يسار، ان رجلين، وساق الحديث،",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-434-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09d4f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 4,
      "hadithIndex": 434,
      "bookHadithIndex": 40,
      "text": "اخبرنا محمد بن عبد الاعلى، انبانا امية بن خالد، حدثنا شعبة، ان مخارقا، اخبرهم عن طارق بن شهاب، ان رجلا، اجنب فلم يصل فاتى النبي صلى الله عليه وسلم فذكر ذلك له فقال \" اصبت \" . فاجنب رجل اخر فتيمم وصلى فاتاه فقال نحوا مما قال للاخر يعني \" اصبت",
      "grades": []
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09d50",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 4,
      "hadithIndex": 435,
      "bookHadithIndex": 41,
      "text": "اخبرنا علي بن ميمون، قال حدثنا مخلد بن يزيد، عن ابن جريج، عن عطاء، عن ابن عباس، قال تذاكر علي والمقداد وعمار فقال علي اني امرو مذاء واني استحي ان اسال رسول الله صلى الله عليه وسلم لمكان ابنته مني فيساله احدكما فذكر لي ان احدهما ونسيته ساله فقال النبي صلى الله عليه وسلم \" ذاك المذى اذا وجده احدكم فليغسل ذلك منه وليتوضا وضوءه للصلاة او كوضوء الصلاة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-435-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-435-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-435-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09d51",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 4,
      "hadithIndex": 436,
      "bookHadithIndex": 42,
      "text": "اخبرنا محمد بن حاتم قال: حدثنا عبيدة قال: حدثنا سليمان الاعمش عن حبيب بن ابي ثابت عن سعيد بن جبير عن ابن عباس عن علي رضي الله عنه قال: كنت رجلا مذاء فامرت رجلا فسال النبي صلى الله عليه وسلم فقال: «فيه الوضوء»",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-436-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-436-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-436-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09d52",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 4,
      "hadithIndex": 437,
      "bookHadithIndex": 43,
      "text": "اخبرنا محمد بن عبد الاعلى، قال حدثنا خالد بن الحارث، قال حدثنا شعبة، قال اخبرني سليمان الاعمش، قال سمعت منذرا، عن محمد بن علي، عن علي، - رضى الله عنه - قال استحييت ان اسال رسول الله صلى الله عليه وسلم عن المذى من اجل فاطمة فامرت المقداد فساله فقال \" فيه الوضوء",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-437-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-437-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-437-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09d53",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 4,
      "hadithIndex": 438,
      "bookHadithIndex": 44,
      "text": "اخبرنا احمد بن عيسى عن ابن وهب وذكر كلمة معناها اخبرني مخرمة بن بكير عن ابيه عن سليمان بن يسار عن ابن عباس قال: قال علي رضي الله عنه ارسلت المقداد الى رسول الله صلى الله عليه وسلم يساله عن المذي فقال: «توضا وانضح فرجك». قال ابو عبد الرحمن: مخرمة لم يسمع من ابيه شييا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-438-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-438-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-438-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09d54",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 4,
      "hadithIndex": 439,
      "bookHadithIndex": 45,
      "text": "اخبرنا سويد بن نصر، قال انبانا عبد الله، عن ليث بن سعد، عن بكير بن الاشج، عن سليمان بن يسار، قال ارسل علي بن ابي طالب - رضى الله عنه - المقداد الى رسول الله صلى الله عليه وسلم يساله عن الرجل يجد المذى فقال رسول الله صلى الله عليه وسلم \" يغسل ذكره ثم ليتوضا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-439-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-439-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-439-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09d55",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 4,
      "hadithIndex": 440,
      "bookHadithIndex": 46,
      "text": "اخبرنا عتبة بن عبد الله، قال قري على مالك وانا اسمع، عن ابي النضر، عن سليمان بن يسار، عن المقداد بن الاسود، عن علي بن ابي طالب، رضى الله عنه امره ان يسال رسول الله صلى الله عليه وسلم عن الرجل اذا دنا من المراة فخرج منه المذى فان عندي ابنته وانا استحيي ان اساله . فسال رسول الله صلى الله عليه وسلم عن ذلك فقال \" اذا وجد احدكم ذلك فلينضح فرجه وليتوضا وضوءه للصلاة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-440-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-440-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-440-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09d56",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 4,
      "hadithIndex": 441,
      "bookHadithIndex": 47,
      "text": "اخبرنا عمران بن يزيد، قال حدثنا اسماعيل بن عبد الله، قال حدثنا الاوزاعي، قال حدثنا محمد بن مسلم الزهري، قال حدثني سعيد بن المسيب، قال حدثني ابو هريرة، قال قال رسول الله صلى الله عليه وسلم \" اذا قام احدكم من الليل فلا يدخل يده في الاناء حتى يفرغ عليها مرتين او ثلاثا فان احدكم لا يدري اين باتت يده",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-441-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-441-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-441-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09d57",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 4,
      "hadithIndex": 442,
      "bookHadithIndex": 48,
      "text": "اخبرنا قتيبة، قال حدثنا داود، عن عمرو، عن كريب، عن ابن عباس، قال صليت مع النبي صلى الله عليه وسلم ذات ليلة فقمت عن يساره فجعلني عن يمينه فصلى ثم اضطجع ورقد فجاءه الموذن فصلى ولم يتوضا مختصر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-442-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-442-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-442-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09d58",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 4,
      "hadithIndex": 443,
      "bookHadithIndex": 49,
      "text": "اخبرنا يعقوب بن ابراهيم، قال حدثنا محمد بن عبد الرحمن الطفاوي، قال حدثنا ايوب، عن ابي قلابة، عن انس، ان رسول الله صلى الله عليه وسلم قال \" اذا نعس احدكم في صلاته فلينصرف وليرقد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-443-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-443-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-443-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09d59",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 4,
      "hadithIndex": 444,
      "bookHadithIndex": 50,
      "text": "اخبرنا قتيبة، عن سفيان، عن عبد الله، - يعني ابن ابي بكر - قال على اثره قال ابو عبد الرحمن ولم اتقنه عن عروة، عن بسرة، قالت قال رسول الله صلى الله عليه وسلم \" من مس فرجه فليتوضا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-444-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-4-444-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"

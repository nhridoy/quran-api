    {
      "id": "69b6c6d6dd1a4c9c86f0b16c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5578,
      "bookHadithIndex": 40,
      "text": "ইয়াকূব ইবন ইবরাহীম (রহঃ) ... ইবন উমর (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি উমর (রাঃ)-কে মিম্বরে খুতবা দিতে শুনি। তিনি বলেন, ওহে লোকসকল! যেদিন মদ হারাম করা হয়েছিল, তখন পাঁচ বস্তু দ্বারা মদ তৈরি হতোঃ আঙুর, খেজুর, মধু, গম ও যব। আর তাই মদ যা দ্বারা জ্ঞান আচ্ছন্ন করে।",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5578-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5578-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },

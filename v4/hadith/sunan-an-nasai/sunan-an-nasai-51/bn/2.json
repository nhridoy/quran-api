      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b190",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5614,
      "bookHadithIndex": 76,
      "text": "যে সকল পাত্রে নবীয তৈরি নিষেধ এবং যে সব পাত্রে নিষেধ নয় ৫৬১৪. সুওয়ায়দ ইবন নাসর (রহঃ) ... তাউস (রহঃ) থেকে বর্ণিত। তিনি বলেন, এক ব্যক্তি ইবন উমর (রাঃ)-কে বললো, রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কি মাটির পাত্রে নবীয তৈরি করতে নিষেধ করেছেন? তিনি বললেনঃ হ্যাঁ। তাউস (রহঃ) বলেন, আল্লাহর শপথ! আমি তাঁর নিকট এটা শুনেছি।",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5614-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },

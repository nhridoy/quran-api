          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b179",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5591,
      "bookHadithIndex": 53,
      "text": "ইসহাক ইবন ইবরাহীম ও কুতায়বা (রহঃ) ... আয়েশা (রাঃ) থেকে বর্ণিত যে, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ প্রত্যেক পানীয়, যা মাদকতা সৃষ্টি করে, হারাম।",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5591-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5591-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5591-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b17a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5592,
      "bookHadithIndex": 54,
      "text": "কুতায়বা ও সুওয়ায়দ (রহঃ) ... আয়েশা (রাঃ) থেকে বর্ণিত যে, রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লামএর নিকট মধুর তৈরি শরাব সম্বন্ধে জিজ্ঞাসা করা হলে তিনি বললেনঃ প্রত্যেক নেশাযুক্ত পানীয়ই হারাম।",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5592-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5592-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5592-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b17b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5593,
      "bookHadithIndex": 55,
      "text": "সুওয়ায়দ (রহঃ) ... আয়েশা (রাঃ) থেকে বর্ণিত যে, রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-কে মধুর শরাব সম্বন্ধে জিজ্ঞাসা করা হলে তিনি বললেনঃ প্রত্যেক পানীয় যাতে মাদকতা রয়েছে, তা হারাম। আর মধুর শরাবকে 'বিত' বলা হয়।",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5593-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5593-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5593-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b17c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5594,
      "bookHadithIndex": 56,
      "text": "আলী ইবন মায়মূন (রহঃ) ... আয়েশা (রাঃ) থেকে বর্ণিত যে, রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-কে মধুর তৈরি শরাব সম্পর্কে জিজ্ঞাসা করা হলে তিনি বললেনঃ যে বস্তুই মাদকতা আনে তা হারাম। আর 'বিত' হলো মধুর তৈরি শরাব।",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5594-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5594-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5594-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b17d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5595,
      "bookHadithIndex": 57,
      "text": "আহমদ ইবন আবদুল্লাহ ইবন সুওয়ায়দ ইবন মানজুফ ও আবদুল্লাহ ইবন হায়সাম (রহঃ) ... আবূ মূসা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ প্রত্যেক মাদকদ্রব্যই হারাম।",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5595-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5595-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5595-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b17e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5596,
      "bookHadithIndex": 58,
      "text": "আহমাদ ইবন আবদুল্লাহ ইবন আলী (রহঃ) ... আবূ বুরদা (রহঃ) তাঁর পিতা থেকে বর্ণনা করেছেন, তিনি বলেন, রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমাকে এবং মু'আয (রাঃ)-কে ইয়ামনে পাঠান। মুআয (রাঃ) বললেনঃ ইয়া রাসূলাল্লাহ! আপনি আমাদেরকে এমন এক দেশে পাঠাচ্ছেন, যেখানকার অধিবাসীগণ নানারকমের পানীয় ব্যবহার করে থাকে। আমরা কী পান করবাে? তিনি বললেনঃ তোমরা পানীয় পান করবে কিন্তু ঐ পানীয় যাতে মাদকতা থাকে, তা পান করবে না।",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5596-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5596-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5596-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b17f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5597,
      "bookHadithIndex": 59,
      "text": "ইয়াহইয়া ইবন মূসা বালখী (রহঃ) ... আবূ মূসা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ প্রত্যেক মাদকদ্রব্য হারাম।",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5597-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5597-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5597-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b180",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5598,
      "bookHadithIndex": 60,
      "text": "সুওয়ায়দ (রহঃ) ... আসওয়াদ ইবন শায়বান সাদুসী (রহঃ) থেকে বর্ণিত যে, এক ব্যক্তি আতা (রহঃ) এর নিকট জিজ্ঞাসা করলোঃ আমরা বিভিন্ন সফরে যাই। তখন বাজারে নানা রকম পানীয় দেখি; কিন্তু ঐ পানীয় কোন পাত্রে বানানো হয়েছে, তা জানি না। আতা (রহঃ) বললেনঃ প্রত্যেক নেশাকরবস্তু হারাম। ঐ ব্যক্তি তার প্রশ্নের পুনরাবৃত্তি করল। তিনি বললেন, প্রত্যেক নেশাকর বস্তু হারাম। লোকটি আবারও সেই প্রশ্ন করল। তিনি বললেনঃ আমি তোমাকে যা বলেছি, তা-ই ঠিক।",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5598-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad Maqtu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5598-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad Maqtu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5598-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {

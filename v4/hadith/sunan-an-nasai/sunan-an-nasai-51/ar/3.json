      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b1c6",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5668,
      "bookHadithIndex": 130,
      "text": "اخبرنا ابو بكر بن علي، قال حدثنا سريج بن يونس، قال حدثنا يحيى بن عبد الملك، عن العلاء، - وهو ابن المسيب - عن فضيل، عن مجاهد، عن ابن عمر، قال من شرب الخمر فلم ينتش لم تقبل له صلاة مادام في جوفه او عروقه منها شىء وان مات مات كافرا وان انتشى لم تقبل له صلاة اربعين ليلة وان مات فيها مات كافرا . خالفه يزيد بن ابي زياد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5668-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5668-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5668-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b1c7",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5669,
      "bookHadithIndex": 131,
      "text": "اخبرني محمد بن ادم بن سليمان، عن عبد الرحيم، عن يزيد، ح وانبانا واصل بن عبد الاعلى، حدثنا ابن فضيل، عن يزيد بن ابي زياد، عن مجاهد، عن عبد الله بن عمرو، عن النبي صلى الله عليه وسلم وقال محمد بن ادم عن رسول الله صلى الله عليه وسلم قال \" من شرب الخمر فجعلها في بطنه لم يقبل الله منه صلاة سبعا ان مات فيها \" . وقال ابن ادم \" فيهن مات كافرا فان اذهبت عقله عن شىء من الفرايض \" . وقال ابن ادم \" القران لم تقبل له صلاة اربعين يوما ان مات فيها \" . وقال ابن ادم \" فيهن مات كافرا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5669-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5669-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5669-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1c8",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5670,
      "bookHadithIndex": 132,
      "text": "اخبرنا القاسم بن زكريا بن دينار، قال حدثنا معاوية بن عمرو، حدثنا ابو اسحاق، قال حدثنا الاوزاعي، قال حدثني ربيعة بن يزيد، ح واخبرني عمرو بن عثمان بن سعيد، عن بقية، عن ابي عمرو، - وهو الاوزاعي - عن ربيعة بن يزيد، عن عبد الله بن الديلمي، قال دخلت على عبد الله بن عمرو بن العاص وهو في حايط له بالطايف يقال له الوهط وهو مخاصر فتى من قريش يزن ذلك الفتى بشرب الخمر فقال سمعت رسول الله صلى الله عليه وسلم يقول \" من شرب الخمر شربة لم تقبل له توبة اربعين صباحا فان تاب تاب الله عليه فان عاد لم تقبل توبته اربعين صباحا فان تاب تاب الله عليه فان عاد كان حقا على الله ان يسقيه من طينة الخبال يوم القيامة \" . اللفظ لعمرو",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5670-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5670-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5670-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1c9",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5671,
      "bookHadithIndex": 133,
      "text": "اخبرنا قتيبة، عن مالك، والحارث بن مسكين، قراءة عليه وانا اسمع، - واللفظ له - عن ابن القاسم، قال حدثني مالك، عن نافع، عن ابن عمر، ان رسول الله صلى الله عليه وسلم قال \" من شرب الخمر في الدنيا ثم لم يتب منها حرمها في الاخرة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5671-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5671-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5671-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1ca",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5672,
      "bookHadithIndex": 134,
      "text": "اخبرنا محمد بن بشار، عن محمد، قال حدثنا شعبة، عن منصور، عن سالم بن ابي الجعد، عن نبيط، عن جابان، عن عبد الله بن عمرو، عن النبي صلى الله عليه وسلم قال \" لا يدخل الجنة منان ولا عاق ولا مدمن خمر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5672-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5672-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5672-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1cb",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5673,
      "bookHadithIndex": 135,
      "text": "اخبرنا سويد، قال انبانا عبد الله، عن حماد بن زيد، قال حدثنا ايوب، عن نافع، عن ابن عمر، عن النبي صلى الله عليه وسلم قال \" من شرب الخمر في الدنيا فمات وهو يدمنها لم يتب منها لم يشربها في الاخرة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5673-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5673-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5673-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1cc",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5674,
      "bookHadithIndex": 136,
      "text": "اخبرنا يحيى بن درست، قال حدثنا حماد، عن ايوب، عن نافع، عن ابن عمر، رضى الله عنهما قال قال رسول الله صلى الله عليه وسلم \" من شرب الخمر في الدنيا فمات وهو يدمنها لم يشربها في الاخرة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5674-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5674-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5674-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1cd",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5675,
      "bookHadithIndex": 137,
      "text": "اخبرنا سويد، قال انبانا عبد الله، عن الحسن بن يحيى، عن الضحاك، قال من مات مدمنا للخمر نضح في وجهه بالحميم حين يفارق الدنيا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5675-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5675-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5675-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1ce",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5676,
      "bookHadithIndex": 138,
      "text": "اخبرنا زكريا بن يحيى، قال حدثنا عبد الاعلى بن حماد، قال حدثنا معتمر بن سليمان، قال حدثني عبد الرزاق، عن معمر، عن الزهري، عن سعيد بن المسيب، قال غرب عمر رضى الله عنه ربيعة بن امية في الخمر الى خيبر فلحق بهرقل فتنصر فقال عمر رضي الله عنه لا اغرب بعده مسلما",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5676-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5676-alalbani",
          "name": "Al-Albani",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5676-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1cf",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5677,
      "bookHadithIndex": 139,
      "text": "اخبرنا هناد بن السري، عن ابي الاحوص، عن سماك، عن القاسم بن عبد الرحمن، عن ابيه، عن ابي بردة بن نيار، قال قال رسول الله صلى الله عليه وسلم \" اشربوا في الظروف ولا تسكروا \" . قال ابو عبد الرحمن وهذا حديث منكر غلط فيه ابو الاحوص سلام بن سليم لا نعلم ان احدا تابعه عليه من اصحاب سماك بن حرب وسماك ليس بالقوي وكان يقبل التلقين . قال احمد بن حنبل كان ابو الاحوص يخطي في هذا الحديث . خالفه شريك في اسناده وفي لفظه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5677-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5677-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5677-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1d0",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5678,
      "bookHadithIndex": 140,
      "text": "اخبرنا محمد بن اسماعيل، قال حدثنا يزيد، قال انبانا شريك، عن سماك بن حرب، عن ابن بريدة، عن ابيه، ان رسول الله صلى الله عليه وسلم نهى عن الدباء والحنتم والنقير والمزفت . خالفه ابو عوانة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5678-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5678-alalbani",
          "name": "Al-Albani",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5678-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1d1",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5679,
      "bookHadithIndex": 141,
      "text": "اخبرنا ابو بكر بن علي، قال انبانا ابراهيم بن حجاج، قال حدثنا ابو عوانة، عن سماك، عن قرصافة، - امراة منهم - عن عايشة، قالت اشربوا ولا تسكروا . قال ابو عبد الرحمن وهذا ايضا غير ثابت وقرصافة هذه لا ندري من هي والمشهور عن عايشة خلاف ما روت عنها قرصافة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5679-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5679-alalbani",
          "name": "Al-Albani",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5679-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1d2",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5680,
      "bookHadithIndex": 142,
      "text": "اخبرنا سويد بن نصر، قال اخبرنا عبد الله، عن قدامة العامري، ان جسرة بنت دجاجة العامرية، حدثته قالت، سمعت عايشة، سالها اناس كلهم يسال عن النبيذ، يقول ننبذ التمر غدوة ونشربه عشيا وننبذه عشيا ونشربه غدوة . قالت لا احل مسكرا وان كان خبزا وان كانت ماء . قالتها ثلاث مرات",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5680-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5680-alalbani",
          "name": "Al-Albani",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5680-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1d3",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5681,
      "bookHadithIndex": 143,
      "text": "اخبرنا سويد بن نصر، قال انبانا عبد الله، عن علي بن المبارك، قال حدثتنا كريمة بنت همام، انها سمعت عايشة ام المومنين، تقول نهيتم عن الدباء، نهيتم عن الحنتم، نهيتم عن المزفت، . ثم اقبلت على النساء فقالت اياكن والجر الاخضر وان اسكركن ماء حبكن فلا تشربنه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5681-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5681-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5681-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1d4",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5682,
      "bookHadithIndex": 144,
      "text": "اخبرنا اسماعيل بن مسعود، قال حدثنا خالد، قال حدثنا ابان بن صمعة، قال حدثتني والدتي، عن عايشة، انها سيلت عن الاشربة، فقالت كان رسول الله صلى الله عليه وسلم ينهى عن كل مسكر . واعتلوا بحديث عبد الله بن شداد عن عبد الله بن عباس",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5682-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5682-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5682-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1d5",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5683,
      "bookHadithIndex": 145,
      "text": "اخبرنا ابو بكر بن علي، قال انبانا القواريري، قال حدثنا عبد الوارث، قال سمعت ابن شبرمة، يذكره عن عبد الله بن شداد بن الهاد، عن ابن عباس، قال حرمت الخمر قليلها وكثيرها والسكر من كل شراب . ابن شبرمة لم يسمعه من عبد الله بن شداد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5683-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Muquf"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5683-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Muquf"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5683-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1d6",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5684,
      "bookHadithIndex": 146,
      "text": "اخبرنا ابو بكر بن علي، قال حدثنا سريج بن يونس، قال حدثنا هشيم، عن ابن شبرمة، قال حدثني الثقة، عن عبد الله بن شداد، عن ابن عباس، قال حرمت الخمر بعينها قليلها وكثيرها والسكر من كل شراب . خالفه ابو عون محمد بن عبيد الله الثقفي",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5684-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5684-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5684-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1d7",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5685,
      "bookHadithIndex": 147,
      "text": "اخبرنا احمد بن عبد الله بن الحكم، قال حدثنا محمد، ح وانبانا الحسين بن منصور، قال حدثنا احمد بن حنبل، قال حدثنا محمد بن جعفر، قال حدثنا شعبة، عن مسعر، عن ابي عون، عن عبد الله بن شداد، عن ابن عباس، قال حرمت الخمر بعينها قليلها وكثيرها والسكر من كل شراب . لم يذكر ابن الحكم قليلها وكثيرها",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5685-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5685-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5685-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1d8",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5686,
      "bookHadithIndex": 148,
      "text": "اخبرنا الحسين بن منصور، قال حدثنا احمد بن حنبل، قال حدثنا ابراهيم بن ابي العباس، قال حدثنا شريك، عن عباس بن ذريح، عن ابي عون، عن عبد الله بن شداد، عن ابن عباس، قال حرمت الخمر قليلها وكثيرها وما اسكر من كل شراب . قال ابو عبد الرحمن وهذا اولى بالصواب من حديث ابن شبرمة وهشيم بن بشير كان يدلس وليس في حديثه ذكر السماع من ابن شبرمة ورواية ابي عون اشبه بما رواه الثقات عن ابن عباس",

          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5656-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b1bb",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5657,
      "bookHadithIndex": 119,
      "text": "اخبرنا سويد، قال انبانا عبد الله، عن يونس، عن الزهري، عن سعيد بن المسيب، عن ابي هريرة، قال اتي رسول الله صلى الله عليه وسلم ليلة اسري به بقدحين من خمر ولبن فنظر اليهما فاخذ اللبن فقال له جبريل عليه السلام الحمد لله الذي هداك للفطرة لو اخذت الخمر غوت امتك",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5657-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5657-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5657-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b1bc",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5658,
      "bookHadithIndex": 120,
      "text": "اخبرنا محمد بن عبد الاعلى، عن خالد، - وهو ابن الحارث - عن شعبة، قال سمعت ابا بكر بن حفص، يقول سمعت ابن محيريز، يحدث عن رجل، من اصحاب النبي صلى الله عليه وسلم عن النبي صلى الله عليه وسلم قال \" يشرب ناس من امتي الخمر يسمونها بغير اسمها",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5658-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5658-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5658-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b1bd",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5659,
      "bookHadithIndex": 121,
      "text": "اخبرنا عيسى بن حماد، قال انبانا الليث، عن عقيل، عن ابن شهاب، عن ابي بكر بن عبد الرحمن بن الحارث، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" لا يزني الزاني حين يزني وهو مومن ولا يشرب الخمر شاربها حين يشربها وهو مومن ولا يسرق السارق حين يسرق وهو مومن ولا ينتهب نهبة يرفع الناس اليه فيها ابصارهم حين ينتهبها وهو مومن",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5659-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5659-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5659-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b1be",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5660,
      "bookHadithIndex": 122,
      "text": "اخبرنا اسحاق بن ابراهيم، قال حدثنا الوليد بن مسلم، عن الاوزاعي، عن الزهري، قال حدثني سعيد بن المسيب، وابو سلمة بن عبد الرحمن وابو بكر بن عبد الرحمن كلهم حدثوني عن ابي هريرة، عن النبي صلى الله عليه وسلم قال \" لا يزني الزاني حين يزني وهو مومن ولا يسرق السارق حين يسرق وهو مومن ولا يشرب الخمر حين يشربها وهو مومن ولا ينتهب نهبة ذات شرف يرفع المسلمون اليه ابصارهم وهو مومن",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5660-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5660-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5660-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b1bf",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5661,
      "bookHadithIndex": 123,
      "text": "اخبرنا اسحاق بن ابراهيم، قال انبانا جرير، عن مغيرة، عن عبد الرحمن بن ابي نعم، عن ابن عمر، ونفر، من اصحاب محمد صلى الله عليه وسلم قالوا قال رسول الله صلى الله عليه وسلم \" من شرب الخمر فاجلدوه ثم ان شرب فاجلدوه ثم ان شرب فاجلدوه ثم ان شرب فاقتلوه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5661-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5661-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5661-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b1c0",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5662,
      "bookHadithIndex": 124,
      "text": "اخبرنا اسحاق بن ابراهيم، قال حدثنا شبابة، قال حدثنا ابن ابي ذيب، عن خاله الحارث بن عبد الرحمن، عن ابي سلمة، عن ابي هريرة، عن رسول الله صلى الله عليه وسلم قال \" اذا سكر فاجلدوه ثم ان سكر فاجلدوه ثم ان سكر فاجلدوه \" . ثم قال في الرابعة \" فاضربوا عنقه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5662-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5662-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5662-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b1c1",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5663,
      "bookHadithIndex": 125,
      "text": "اخبرنا واصل بن عبد الاعلى، عن ابن فضيل، عن وايل ابي بكر، عن ابي بردة بن ابي موسى، عن ابيه، رضى الله عنه انه كان يقول ما ابالي شربت الخمر او عبدت هذه السارية من دون الله عز وجل",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5663-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5663-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5663-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b1c2",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5664,
      "bookHadithIndex": 126,
      "text": "اخبرنا علي بن حجر، قال انبانا عثمان بن حصن بن علاق، - دمشقي - قال حدثنا عروة بن، رويم ان ابن الديلمي ركب يطلب عبد الله بن عمرو بن العاص قال ابن الديلمي فدخلت عليه فقلت هل سمعت يا عبد الله بن عمرو، رسول الله صلى الله عليه وسلم ذكر شان الخمر بشىء فقال نعم سمعت رسول الله صلى الله عليه وسلم يقول \" لا يشرب الخمر رجل من امتي فيقبل الله منه صلاة اربعين يوما",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5664-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5664-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5664-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b1c3",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5665,
      "bookHadithIndex": 127,
      "text": "اخبرنا قتيبة، وعلي بن حجر، قالا حدثنا خلف، - يعني ابن خليفة - عن منصور بن زاذان، عن الحكم بن عتيبة، عن ابي وايل، عن مسروق، قال القاضي اذا اكل الهدية فقد اكل السحت واذا قبل الرشوة بلغت به الكفر . وقال مسروق من شرب الخمر فقد كفر وكفره ان ليس له صلاة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5665-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Daif Isnaad Maqtu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5665-alalbani",
          "name": "Al-Albani",
          "grade": "Daif Isnaad Maqtu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5665-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b1c4",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5666,
      "bookHadithIndex": 128,
      "text": "اخبرنا سويد، قال انبانا عبد الله، عن معمر، عن الزهري، عن ابي بكر بن عبد الرحمن بن الحارث، عن ابيه، قال سمعت عثمان، رضى الله عنه يقول اجتنبوا الخمر فانها ام الخبايث انه كان رجل ممن خلا قبلكم تعبد فعلقته امراة غوية فارسلت اليه جاريتها فقالت له انا ندعوك للشهادة فانطلق مع جاريتها فطفقت كلما دخل بابا اغلقته دونه حتى افضى الى امراة وضيية عندها غلام وباطية خمر فقالت اني والله ما دعوتك للشهادة ولكن دعوتك لتقع على او تشرب من هذه الخمرة كاسا او تقتل هذا الغلام . قال فاسقيني من هذا الخمر كاسا فسقته كاسا . قال زيدوني فلم يرم حتى وقع عليها وقتل النفس فاجتنبوا الخمر فانها والله لا يجتمع الايمان وادمان الخمر الا ليوشك ان يخرج احدهما صاحبه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5666-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Muquf"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5666-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Muquf"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5666-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b1c5",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5667,
      "bookHadithIndex": 129,
      "text": "اخبرنا سويد، قال انبانا عبد الله، - يعني ابن المبارك - عن يونس، عن الزهري، قال حدثني ابو بكر بن عبد الرحمن بن الحارث، ان اباه، قال سمعت عثمان، يقول اجتنبوا الخمر فانها ام الخبايث فانه كان رجل ممن خلا قبلكم يتعبد ويعتزل الناس فذكر مثله قال فاجتنبوا الخمر فانه والله لا يجتمع والايمان ابدا الا يوشك احدهما ان يخرج صاحبه",
      "grades": [

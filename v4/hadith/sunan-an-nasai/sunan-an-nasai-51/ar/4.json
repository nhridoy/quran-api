      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b203",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5729,
      "bookHadithIndex": 191,
      "text": "اخبرنا سويد، قال انبانا عبد الله، عن ابي يعفور السلمي، عن ابي ثابت الثعلبي، قال كنت عند ابن عباس فجاءه رجل فساله عن العصير، فقال اشربه ما كان طريا . قال اني طبخت شرابا وفي نفسي منه . قال اكنت شاربه قبل ان تطبخه قال لا . قال فان النار لا تحل شييا قد حرم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5729-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad Mauquf"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5729-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad Mauquf"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5729-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b204",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5730,
      "bookHadithIndex": 192,
      "text": "اخبرنا سويد، قال انبانا عبد الله، عن ابن جريج، قراءة اخبرني عطاء، قال سمعت ابن عباس، يقول والله ما تحل النار شييا ولا تحرمه . قال ثم فسر لي قوله لا تحل شييا لقولهم في الطلاء ولا تحرمه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5730-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5730-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5730-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b205",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5731,
      "bookHadithIndex": 193,
      "text": "اخبرنا سويد، قال انبانا عبد الله، عن حيوة بن شريح، قال اخبرني عقيل، عن ابن شهاب، عن سعيد بن المسيب، قال اشرب العصير ما لم يزبد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5731-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad Maqtu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5731-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad Maqtu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5731-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b206",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5732,
      "bookHadithIndex": 194,
      "text": "اخبرنا سويد، قال انبانا عبد الله، عن هشام بن عايذ الاسدي، قال سالت ابراهيم عن العصير، قال اشربه حتى يغلي ما لم يتغير",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5732-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad Maqtu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5732-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad Maqtu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5732-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b207",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5733,
      "bookHadithIndex": 195,
      "text": "اخبرنا سويد، قال انبانا عبد الله، عن عبد الملك، عن عطاء، في العصير قال اشربه حتى يغلي",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5733-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad Maqtu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5733-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad Maqtu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5733-zubairalizai",
          "name": "Zubair Ali Zai",

    },
    {
      "id": "69b6c702dd1a4c9c86f0b1e5",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5699,
      "bookHadithIndex": 161,
      "text": "قال الحارث بن مسكين قراءة عليه وانا اسمع، عن ابن القاسم، اخبرني مالك، عن نافع، عن ابن عمر، قال كل مسكر خمر وكل مسكر حرام",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5699-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad Mauquf"
        },
        {

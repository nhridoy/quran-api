          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1e6",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5700,
      "bookHadithIndex": 162,
      "text": "اخبرنا محمد بن عبد الاعلى، قال حدثنا المعتمر، قال سمعت شبيبا، - وهو ابن عبد الملك - يقول حدثني مقاتل بن حيان، عن سالم بن عبد الله، عن ابيه، عن رسول الله صلى الله عليه وسلم قال \" حرم الله الخمر وكل مسكر حرام",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5700-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5700-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5700-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1e7",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5701,
      "bookHadithIndex": 163,
      "text": "اخبرنا الحسين بن منصور، - يعني ابن جعفر النيسابوري - قال حدثنا يزيد بن هارون، قال انبانا محمد بن عمرو، عن ابي سلمة، عن ابن عمر، قال قال رسول الله صلى الله عليه وسلم \" كل مسكر حرام وكل مسكر خمر \" . قال ابو عبد الرحمن وهولاء اهل الثبت والعدالة مشهورون بصحة النقل وعبد الملك لا يقوم مقام واحد منهم ولو عاضده من اشكاله جماعة وبالله التوفيق",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5701-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5701-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5701-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1e8",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5702,
      "bookHadithIndex": 164,
      "text": "اخبرنا سويد، قال انبانا عبد الله، عن عبيد الله بن عمر السعيدي، قال حدثتني رقية بنت عمرو بن سعيد، قالت كنت في حجر ابن عمر فكان ينقع له الزبيب فيشربه من الغد ثم يجفف الزبيب ويلقى عليه زبيب اخر ويجعل فيه ماء فيشربه من الغد حتى اذا كان بعد الغد طرحه . واحتجوا بحديث ابي مسعود عقبة بن عمرو",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5702-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5702-alalbani",
          "name": "Al-Albani",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5702-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1e9",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5703,
      "bookHadithIndex": 165,
      "text": "اخبرنا الحسن بن اسماعيل بن سليمان، قال انبانا يحيى بن يمان، عن سفيان، عن منصور، عن خالد بن سعد، عن ابي مسعود، قال عطش النبي صلى الله عليه وسلم حول الكعبة فاستسقى فاتي بنبيذ من السقاية فشمه فقطب فقال \" على بذنوب من زمزم \" . فصب عليه ثم شرب فقال رجل احرام هو يا رسول الله قال \" لا \" . وهذا خبر ضعيف لان يحيى بن يمان انفرد به دون اصحاب سفيان ويحيى بن يمان لا يحتج بحديثه لسوء حفظه وكثرة خطيه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5703-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5703-alalbani",
          "name": "Al-Albani",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5703-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1ea",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5704,
      "bookHadithIndex": 166,
      "text": "اخبرنا علي بن حجر، قال حدثنا عثمان بن حصن، قال حدثنا زيد بن واقد، عن خالد بن حسين، قال سمعت ابا هريرة، يقول علمت ان رسول الله صلى الله عليه وسلم كان يصوم في بعض الايام التي كان يصومها فتحينت فطره بنبيذ صنعته في دباء فلما كان المساء جيته احملها اليه فقلت يا رسول الله اني قد علمت انك تصوم في هذا اليوم فتحينت فطرك بهذا النبيذ . فقال \" ادنه مني يا ابا هريرة \" . فرفعته اليه فاذا هو ينش فقال \" خذ هذه فاضرب بها الحايط فان هذا شراب من لا يومن بالله ولا باليوم الاخر \" . ومما احتجوا به فعل عمر بن الخطاب رضى الله عنه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5704-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5704-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5704-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1eb",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5705,
      "bookHadithIndex": 167,
      "text": "اخبرنا سويد، قال انبانا عبد الله، عن السري بن يحيى، قال حدثنا ابو حفص، - امام لنا وكان من اسنان الحسن - عن ابي رافع ان عمر بن الخطاب رضى الله عنه قال اذا خشيتم من نبيذ شدته فاكسروه بالماء - قال عبد الله - من قبل ان يشتد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5705-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5705-alalbani",
          "name": "Al-Albani",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5705-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1ec",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5706,
      "bookHadithIndex": 168,
      "text": "اخبرنا زكريا بن يحيى، قال حدثنا عبد الاعلى، قال حدثنا سفيان، عن يحيى بن سعيد، سمع سعيد بن المسيب، يقول تلقت ثقيف عمر بشراب فدعا به فلما قربه الى فيه كرهه فدعا به فكسره بالماء فقال هكذا فافعلوا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5706-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5706-alalbani",
          "name": "Al-Albani",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5706-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1ed",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5707,
      "bookHadithIndex": 169,
      "text": "اخبرنا ابو بكر بن علي، قال حدثنا ابو خيثمة، قال حدثنا عبد الصمد، { قال حدثنا ابي، } عن محمد بن جحادة، عن اسماعيل بن ابي خالد، عن قيس بن ابي حازم، عن عتبة بن فرقد، قال كان النبيذ الذي يشربه عمر بن الخطاب قد خلل . ومما يدل على صحة هذا حديث السايب",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5707-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5707-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5707-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1ee",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5708,
      "bookHadithIndex": 170,
      "text": "قال الحارث بن مسكين قراءة عليه وانا اسمع، عن ابن القاسم، قال حدثني مالك، عن ابن شهاب، عن السايب بن يزيد، انه اخبره ان عمر بن الخطاب خرج عليهم فقال اني وجدت من فلان ريح شراب فزعم انه شراب الطلاء وانا سايل عما شرب فان كان مسكرا جلدته فجلده عمر بن الخطاب رضى الله عنه الحد تاما",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5708-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5708-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5708-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1ef",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5709,
      "bookHadithIndex": 171,
      "text": "اخبرنا قتيبة، قال حدثنا عبد العزيز، عن عمارة بن غزية، عن ابي الزبير، عن جابر، ان رجلا، من جيشان - وجيشان من اليمن - قدم فسال رسول الله صلى الله عليه وسلم عن شراب يشربونه بارضهم من الذرة يقال له المزر فقال النبي صلى الله عليه وسلم \" امسكر هو \" . قال نعم . قال رسول الله صلى الله عليه وسلم \" كل مسكر حرام ان الله عز وجل عهد لمن شرب المسكر ان يسقيه من طينة الخبال \" . قالوا يا رسول الله وما طينة الخبال قال \" عرق اهل النار او قال عصارة اهل النار",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5709-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5709-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5709-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1f0",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5710,
      "bookHadithIndex": 172,
      "text": "اخبرنا حميد بن مسعدة، عن يزيد، - وهو ابن زريع - عن ابن عون، عن الشعبي، عن النعمان بن بشير، قال سمعت رسول الله صلى الله عليه وسلم يقول \" ان الحلال بين وان الحرام بين وان بين ذلك امورا مشتبهات \" . وربما قال \" وان بين ذلك امورا مشتبهة وساضرب في ذلك مثلا ان الله عز وجل حمى حمى وان حمى الله ما حرم وانه من يرع حول الحمى يوشك ان يخالط الحمى \" . وربما قال \" يوشك ان يرتع وان من خالط الريبة يوشك ان يجسر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5710-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5710-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5710-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1f1",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5711,
      "bookHadithIndex": 173,
      "text": "اخبرنا محمد بن ابان، قال حدثنا عبد الله بن ادريس، قال انبانا شعبة، عن بريد بن ابي مريم، عن ابي الحوراء السعدي، قال قلت للحسن بن علي رضى الله عنهما ما حفظت من رسول الله صلى الله عليه وسلم قال حفظت منه \" دع ما يريبك الى ما لا يريبك",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5711-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5711-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5711-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1f2",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5712,
      "bookHadithIndex": 174,
      "text": "اخبرنا الجارود بن معاذ، - هو باوردي - قال حدثنا ابو سفيان، محمد بن حميد عن معمر، عن ابن طاوس، عن ابيه، انه كان يكره ان يبيع الزبيب، لمن يتخذه نبيذا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5712-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad Maqtu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5712-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad Maqtu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5712-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1f3",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5713,
      "bookHadithIndex": 175,
      "text": "اخبرنا سويد، قال انبانا عبد الله، عن سفيان بن دينار، عن مصعب بن سعد، قال كان لسعد كروم واعناب كثيرة وكان له فيها امين فحملت عنبا كثيرا فكتب اليه اني اخاف على الاعناب الضيعة فان رايت ان اعصره عصرته فكتب اليه سعد اذا جاءك كتابي هذا فاعتزل ضيعتي فوالله لا ايتمنك على شىء بعده ابدا . فعزله عن ضيعته",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5713-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad Mauquf"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5713-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad Mauquf"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5713-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1f4",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5714,
      "bookHadithIndex": 176,
      "text": "اخبرنا سويد، قال انبانا عبد الله، عن هارون بن ابراهيم، عن ابن سيرين، قال بعه عصيرا ممن يتخذه طلاء ولا يتخذه خمرا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5714-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad Maqtu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5714-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad Maqtu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5714-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1f5",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5715,
      "bookHadithIndex": 177,
      "text": "اخبرنا محمد بن عبد الاعلى، قال حدثنا المعتمر، قال سمعت منصورا، عن ابراهيم، عن نباتة، عن سويد بن غفلة، قال كتب عمر بن الخطاب الى بعض عماله ان ارزق، المسلمين من الطلاء ما ذهب ثلثاه وبقي ثلثه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5715-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Muquf"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5715-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Muquf"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5715-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1f6",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5716,
      "bookHadithIndex": 178,
      "text": "اخبرنا سويد، قال انبانا عبد الله، عن سليمان التيمي، عن ابي مجلز، عن عامر بن عبد الله، انه قال قرات كتاب عمر بن الخطاب الى ابي موسى اما بعد فانها قدمت على عير من الشام تحمل شرابا غليظا اسود كطلاء الابل واني سالتهم على كم يطبخونه فاخبروني انهم يطبخونه على الثلثين ذهب ثلثاه الاخبثان ثلث ببغيه وثلث بريحه فمر من قبلك يشربونه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5716-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5716-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5716-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1f7",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5717,
      "bookHadithIndex": 179,
      "text": "اخبرنا سويد، قال انبانا عبد الله، عن هشام، عن ابن سيرين، ان عبد الله بن يزيد الخطمي، قال كتب الينا عمر بن الخطاب رضى الله عنه اما بعد فاطبخوا شرابكم حتى يذهب منه نصيب الشيطان فان له اثنين ولكم واحد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5717-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5717-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5717-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1f8",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5718,
      "bookHadithIndex": 180,
      "text": "اخبرنا سويد، قال انبانا عبد الله، عن جرير، عن مغيرة، عن الشعبي، قال كان علي رضى الله عنه يرزق الناس الطلاء يقع فيه الذباب ولا يستطيع ان يخرج منه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5718-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad Mauquf"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5718-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad Mauquf"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5718-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1f9",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5719,
      "bookHadithIndex": 181,
      "text": "اخبرنا محمد بن المثنى، قال حدثنا ابن ابي عدي، عن داود، قال سالت سعيدا ما الشراب الذي احله عمر رضى الله عنه قال الذي يطبخ حتى يذهب ثلثاه ويبقى ثلثه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5719-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5719-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5719-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1fa",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5720,
      "bookHadithIndex": 182,
      "text": "اخبرنا زكريا بن يحيى، قال حدثنا عبد الاعلى، قال حدثنا حماد بن سلمة، عن داود، عن سعيد بن المسيب، ان ابا الدرداء، كان يشرب ما ذهب ثلثاه وبقي ثلثه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5720-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad Mauquf"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5720-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad Mauquf"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5720-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b1fb",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5721,
      "bookHadithIndex": 183,
      "text": "اخبرنا سويد، قال انبانا عبد الله، عن هشيم، قال انبانا اسماعيل بن ابي خالد، عن قيس بن ابي حازم، عن ابي موسى الاشعري، انه كان يشرب من الطلاء ما ذهب ثلثاه وبقي ثلثه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5721-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Muquf"
        },
        {

      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b208",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5734,
      "bookHadithIndex": 196,
      "text": "اخبرنا سويد، قال انبانا عبد الله، عن حماد بن سلمة، عن داود، عن الشعبي، قال اشربه ثلاثة ايام الا ان يغلي",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5734-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad Maqtu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5734-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad Maqtu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5734-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b209",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5735,
      "bookHadithIndex": 197,
      "text": "اخبرني عمرو بن عثمان بن سعيد بن كثير، قال حدثنا بقية، قال حدثني الاوزاعي، عن يحيى بن ابي عمرو، عن عبد الله بن الديلمي، عن ابيه، فيروز قال قدمت على رسول الله صلى الله عليه وسلم فقلت يا رسول الله انا اصحاب كرم وقد انزل الله عز وجل تحريم الخمر فماذا نصنع قال \" تتخذونه زبيبا \" . قلت فنصنع بالزبيب ماذا قال \" تنقعونه على غدايكم وتشربونه على عشايكم وتنقعونه على عشايكم وتشربونه على غدايكم \" . قلت افلا نوخره حتى يشتد قال \" لا تجعلوه في القلل واجعلوه في الشنان فانه ان تاخر صار خلا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5735-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5735-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5735-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b20a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5736,
      "bookHadithIndex": 198,
      "text": "اخبرنا عيسى بن محمد ابو عمير بن النحاس، عن ضمرة، عن الشيباني، عن ابن الديلمي، عن ابيه، قال قلنا يا رسول الله ان لنا اعنابا فماذا نصنع بها قال \" زببوها \" . قلنا فما نصنع بالزبيب قال \" انبذوه على غدايكم واشربوه على عشايكم وانبذوه على عشايكم واشربوه على غدايكم وانبذوه في الشنان ولا تنبذوه في القلال فانه ان تاخر صار خلا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5736-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5736-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5736-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b20b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5737,
      "bookHadithIndex": 199,
      "text": "اخبرنا ابو داود الحراني، قال حدثنا يعلى بن عبيد، قال حدثنا مطيع، عن ابي عمر، عن ابن عباس، قال كان ينبذ لرسول الله صلى الله عليه وسلم فيشربه من الغد ومن بعد الغد فاذا كان مساء الثالثة فان بقي في الاناء شىء لم يشربوه اهريق",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5737-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5737-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5737-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b20c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5738,
      "bookHadithIndex": 200,
      "text": "اخبرنا اسحاق بن ابراهيم، قال حدثنا يحيى بن ادم، قال حدثنا شريك، عن ابي اسحاق، عن يحيى بن عبيد البهراني، عن ابن عباس، ان رسول الله صلى الله عليه وسلم كان ينقع له الزبيب فيشربه يومه والغد وبعد الغد",
      "grades": [
        {

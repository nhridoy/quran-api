          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b201",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5727,
      "bookHadithIndex": 189,
      "text": "اخبرنا سويد، قال انبانا عبد الله، عن عبد الملك بن طفيل الجزري، قال كتب الينا عمر بن عبد العزيز ان لا، تشربوا من الطلاء حتى يذهب ثلثاه ويبقى ثلثه وكل مسكر حرام",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5727-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Daif Isnaad"
        },
        {

          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b202",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 51,
      "hadithIndex": 5728,
      "bookHadithIndex": 190,
      "text": "اخبرنا اسحاق بن ابراهيم، قال حدثنا المعتمر، عن برد، عن مكحول، قال كل مسكر حرام",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5728-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad Maqtu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5728-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad Maqtu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-51-5728-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"

    {
      "id": "69b6c611dd1a4c9c86f0a147",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 15,
      "hadithIndex": 1450,
      "bookHadithIndex": 18,
      "text": "اخبرنا عبيد الله بن سعيد، قال انبانا يحيى، عن عبيد الله، عن نافع، عن ابن عمر، قال صليت مع النبي صلى الله عليه وسلم بمنى ركعتين ومع ابي بكر - رضى الله عنه - ركعتين ومع عمر - رضى الله عنه - ركعتين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1450-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1450-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1450-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a148",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 15,
      "hadithIndex": 1451,
      "bookHadithIndex": 19,
      "text": "اخبرنا محمد بن سلمة، قال حدثنا ابن وهب، عن يونس، عن ابن شهاب، قال اخبرني عبيد الله بن عبد الله بن عمر، عن ابيه، قال صلى رسول الله صلى الله عليه وسلم بمنى ركعتين وصلاها ابو بكر ركعتين وصلاها عمر ركعتين وصلاها عثمان صدرا من خلافته",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1451-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1451-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1451-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a149",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 15,
      "hadithIndex": 1452,
      "bookHadithIndex": 20,
      "text": "اخبرنا حميد بن مسعدة، قال حدثنا يزيد، قال انبانا يحيى بن ابي اسحاق، عن انس بن مالك، قال خرجنا مع رسول الله صلى الله عليه وسلم من المدينة الى مكة فكان يصلي بنا ركعتين حتى رجعنا . قلت هل اقام بمكة قال نعم اقمنا بها عشرا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1452-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1452-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1452-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a14a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 15,
      "hadithIndex": 1453,
      "bookHadithIndex": 21,
      "text": "اخبرنا عبد الرحمن بن الاسود البصري، قال حدثنا محمد بن ربيعة، عن عبد الحميد بن جعفر، عن يزيد بن ابي حبيب، عن عراك بن مالك، عن عبيد الله بن عبد الله، عن ابن عباس، ان رسول الله صلى الله عليه وسلم اقام بمكة خمسة عشر يصلي ركعتين ركعتين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1453-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1453-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1453-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a14b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 15,
      "hadithIndex": 1454,
      "bookHadithIndex": 22,
      "text": "اخبرنا محمد بن عبد الملك بن زنجويه، عن عبد الرزاق، عن ابن جريج، قال اخبرني اسماعيل بن محمد بن سعد، ان حميد بن عبد الرحمن، اخبره ان السايب بن يزيد اخبره انه، سمع العلاء بن الحضرمي، يقول قال رسول الله صلى الله عليه وسلم \" يمكث المهاجر بعد قضاء نسكه ثلاثا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1454-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1454-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1454-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a14c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 15,
      "hadithIndex": 1455,
      "bookHadithIndex": 23,
      "text": "اخبرنا ابو عبد الرحمن، قال الحارث بن مسكين قراءة عليه وانا اسمع، في حديثه عن سفيان، عن عبد الرحمن بن حميد، عن السايب بن يزيد، عن العلاء بن الحضرمي، قال قال النبي صلى الله عليه وسلم \" يمكث المهاجر بمكة بعد نسكه ثلاثا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1455-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1455-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1455-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a14d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 15,
      "hadithIndex": 1456,
      "bookHadithIndex": 24,
      "text": "اخبرني احمد بن يحيى الصوفي، قال حدثنا ابو نعيم، قال حدثنا العلاء بن زهير الازدي، قال حدثنا عبد الرحمن بن الاسود، عن عايشة، انها اعتمرت مع رسول الله صلى الله عليه وسلم من المدينة الى مكة حتى اذا قدمت مكة قالت يا رسول الله بابي انت وامي قصرت واتممت وافطرت وصمت . قال \" احسنت يا عايشة \" . وما عاب على",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1456-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Munkar"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1456-alalbani",
          "name": "Al-Albani",
          "grade": "Munkar"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1456-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a14e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 15,
      "hadithIndex": 1457,
      "bookHadithIndex": 25,
      "text": "اخبرني احمد بن يحيى، قال حدثنا ابو نعيم، قال حدثنا العلاء بن زهير، قال حدثنا وبرة بن عبد الرحمن، قال كان ابن عمر لا يزيد في السفر على ركعتين لا يصلي قبلها ولا بعدها . فقيل له ما هذا قال هكذا رايت رسول الله صلى الله عليه وسلم يصنع",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1457-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1457-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1457-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a14f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 15,
      "hadithIndex": 1458,
      "bookHadithIndex": 26,
      "text": "اخبرني نوح بن حبيب، قال حدثنا يحيى بن سعيد، قال حدثنا عيسى بن حفص بن عاصم، قال حدثني ابي قال، كنت مع ابن عمر في سفر فصلى الظهر والعصر ركعتين ثم انصرف الى طنفسة له فراى قوما يسبحون قال ما يصنع هولاء قلت يسبحون . قال لو كنت مصليا قبلها او بعدها لاتممتها صحبت رسول الله صلى الله عليه وسلم فكان لا يزيد في السفر على الركعتين وابا بكر حتى قبض وعمر وعثمان - رضى الله عنهم - كذلك",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1458-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1458-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-15-1458-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    }
  ]
}
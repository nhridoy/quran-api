      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0aa3f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 34,
      "hadithIndex": 3742,
      "bookHadithIndex": 24,
      "text": "Rapporté par une autre chaîne, d'après Al-Awza'i, d'après Az-Zuhri, d'après 'Urwah et Abu Salamah, de Jabir, qui a dit : Le Messager d'Allah ﷺ a dit : \"L''Umra (un don à vie) appartient à celui à qui elle a été donnée ; cela lui appartient ainsi qu'à ses descendants, et cela est hérité par ceux qui héritent de lui",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-34-3742-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"

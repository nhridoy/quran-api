      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0aa4b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 34,
      "hadithIndex": 3754,
      "bookHadithIndex": 36,
      "text": "Rapporté par Bashir bin Nahik : Abu Hurairah a rapporté que le Prophète ﷺ a dit : « Le don à vie (‘Umra) est permis. »",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-34-3754-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-34-3754-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-34-3754-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0aa4c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 34,
      "hadithIndex": 3755,
      "bookHadithIndex": 37,
      "text": "Rapporté par Qatadah : « Sulaiman bin Hisham m’a interrogé à propos d’un don à vie. J’ai dit : Muhammad bin Sirin a rapporté que Shuraih a dit : “Le Prophète d’Allah ﷺ a statué que le don à vie est permis.” » Qatadah a dit : « J’ai dit : Et An-Nadr bin Anas m’a rapporté, de Bashir bin Nahik, d’Abu Hurairah, que le Prophète d’Allah ﷺ a dit : “Le don à vie est permis.” » Qatadah a dit : « J’ai dit : Al-Hasan disait : “Le don à vie est permis.” » Qatadah a dit : « Az-Zuhri a dit : ‘Le don à vie, c’est quand il est précisé que c’est pour celui à qui il est donné et ses descendants, mais si les descendants ne sont pas mentionnés, la condition est valable (et cela revient à celui qui a donné).’ » Qatadah a dit : « On a interrogé ‘Ata’ bin Abi Rabah, et il a dit : ‘Jabir bin Abdullah m’a rapporté que le Messager d’Allah ﷺ a dit : “L’Umra est permise.”’ » Qatadah a dit : « Az-Zuhri a dit : ‘Les califes n’ont pas jugé selon cela.’ » ‘Ata’ a dit : « Abdul-Malik bin Marwan a jugé selon cela. »",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-34-3755-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-34-3755-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-34-3755-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0aa4d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 34,
      "hadithIndex": 3756,
      "bookHadithIndex": 38,
      "text": "Rapporté par ‘Amr bin Shu’aib, de son père, de son grand-père : Le Messager d’Allah ﷺ a dit : « Il n’est pas permis à une femme de faire un don de ses biens, une fois que son mari a autorité sur elle. » Ceci est la formulation de Muhammad",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-34-3756-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-34-3756-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-34-3756-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0aa4e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 34,
      "hadithIndex": 3757,
      "bookHadithIndex": 39,
      "text": "Rapporté par ‘Amr bin Shu’aib, de son père, que son grand-père a dit : « Lorsque le Messager d’Allah ﷺ a conquis La Mecque, il s’est levé pour s’adresser aux gens et a dit dans son sermon : “Il n’est pas permis à une femme de faire un don, sauf avec la permission de son mari.” »",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-34-3757-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan Sahih"

      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4c5",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2344,
      "bookHadithIndex": 255,
      "text": "اخبرنا قتيبة، قال حدثنا سفيان، عن عمرو بن دينار، عن عمرو بن اوس، انه سمع عبد الله بن عمرو بن العاص، يقول قال رسول الله صلى الله عليه وسلم \" احب الصيام الى الله عز وجل صيام داود عليه السلام كان يصوم يوما ويفطر يوما واحب الصلاة الى الله عز وجل صلاة داود عليه السلام كان ينام نصف الليل ويقوم ثلثه وينام سدسه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2344-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2344-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2344-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4c6",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2345,
      "bookHadithIndex": 256,
      "text": "اخبرنا القاسم بن زكريا، قال حدثنا عبيد الله، قال حدثنا يعقوب، عن جعفر، عن سعيد، عن ابن عباس، قال كان رسول الله صلى الله عليه وسلم لا يفطر ايام البيض في حضر ولا سفر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2345-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2345-alalbani",
          "name": "Al-Albani",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2345-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4c7",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2346,
      "bookHadithIndex": 257,
      "text": "اخبرنا محمد بن بشار، قال حدثنا محمد، قال حدثنا شعبة، عن ابي بشر، عن سعيد بن جبير، عن ابن عباس، قال كان رسول الله صلى الله عليه وسلم يصوم حتى نقول لا يفطر ويفطر حتى نقول ما يريد ان يصوم وما صام شهرا متتابعا غير رمضان منذ قدم المدينة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2346-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2346-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2346-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4c8",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2347,
      "bookHadithIndex": 258,
      "text": "اخبرنا محمد بن النضر بن مساور المروزي، قال حدثنا حماد، عن مروان ابي لبابة، عن عايشة، قالت كان رسول الله صلى الله عليه وسلم يصوم حتى نقول ما يريد ان يفطر ويفطر حتى نقول ما يريد ان يصوم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2347-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2347-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2347-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4c9",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2348,
      "bookHadithIndex": 259,
      "text": "اخبرنا اسماعيل بن مسعود، عن خالد، قال حدثنا سعيد، قال حدثنا قتادة، عن زرارة بن اوفى، عن سعد بن هشام، عن عايشة، قالت لا اعلم نبي الله صلى الله عليه وسلم قرا القران كله في ليلة ولا قام ليلة حتى الصباح ولا صام شهرا قط كاملا غير رمضان",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2348-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2348-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2348-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4ca",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2349,
      "bookHadithIndex": 260,
      "text": "اخبرنا قتيبة، قال حدثنا حماد، عن ايوب، عن عبد الله بن شقيق، قال سالت عايشة عن صيام النبي، صلى الله عليه وسلم قالت كان يصوم حتى نقول قد صام ويفطر حتى نقول قد افطر وما صام رسول الله صلى الله عليه وسلم شهرا كاملا منذ قدم المدينة الا رمضان",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2349-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2349-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2349-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4cb",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2350,
      "bookHadithIndex": 261,
      "text": "اخبرنا الربيع بن سليمان، قال حدثنا ابن وهب، قال حدثنا معاوية بن صالح، ان عبد الله بن ابي قيس، حدثه انه، سمع عايشة، تقول كان احب الشهور الى رسول الله صلى الله عليه وسلم ان يصومه شعبان بل كان يصله برمضان",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2350-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2350-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2350-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4cc",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2351,
      "bookHadithIndex": 262,
      "text": "اخبرنا الربيع بن سليمان بن داود، قال حدثنا ابن وهب، قال اخبرني مالك، وعمرو بن الحارث، وذكر، اخر قبلهما ان ابا النضر، حدثهم عن ابي سلمة، عن عايشة، قالت كان رسول الله صلى الله عليه وسلم يصوم حتى نقول ما يفطر ويفطر حتى نقول ما يصوم وما رايت رسول الله صلى الله عليه وسلم في شهر اكثر صياما منه في شعبان",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2351-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2351-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2351-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4cd",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2352,
      "bookHadithIndex": 263,
      "text": "اخبرنا محمود بن غيلان، قال حدثنا ابو داود، قال انبانا شعبة، عن منصور، قال سمعت سالم بن ابي الجعد، عن ابي سلمة، عن ام سلمة، ان رسول الله صلى الله عليه وسلم كان لا يصوم شهرين متتابعين الا شعبان ورمضان",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2352-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2352-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2352-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4ce",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2353,
      "bookHadithIndex": 264,
      "text": "اخبرنا محمد بن الوليد، قال حدثنا محمد، قال حدثنا شعبة، عن توبة، عن محمد بن ابراهيم، عن ابي سلمة، عن ام سلمة، عن النبي صلى الله عليه وسلم انه لم يكن يصوم من السنة شهرا تاما الا شعبان ويصل به رمضان",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2353-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2353-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2353-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4cf",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2354,
      "bookHadithIndex": 265,
      "text": "اخبرنا عبيد الله بن سعد بن ابراهيم، قال حدثنا عمي، قال حدثنا ابي، عن ابن اسحاق، قال حدثني محمد بن ابراهيم، عن ابي سلمة، عن عايشة، قالت لم يكن رسول الله صلى الله عليه وسلم لشهر اكثر صياما منه لشعبان كان يصومه او عامته",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2354-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2354-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2354-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4d0",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2355,
      "bookHadithIndex": 266,
      "text": "اخبرني عمرو بن هشام، قال حدثنا محمد بن سلمة، عن ابن اسحاق، عن يحيى بن سعيد، عن ابي سلمة، عن عايشة، قالت كان رسول الله صلى الله عليه وسلم يصوم شعبان الا قليلا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2355-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2355-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2355-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4d1",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2356,
      "bookHadithIndex": 267,
      "text": "اخبرنا عمرو بن عثمان، قال حدثنا بقية، قال حدثنا بحير، عن خالد بن معدان، عن جبير بن نفير، ان عايشة، قالت ان رسول الله صلى الله عليه وسلم كان يصوم شعبان كله",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2356-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2356-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2356-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4d2",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2357,
      "bookHadithIndex": 268,
      "text": "اخبرنا عمرو بن علي، عن عبد الرحمن، قال حدثنا ثابت بن قيس ابو الغصن، - شيخ من اهل المدينة - قال حدثني ابو سعيد المقبري، قال حدثني اسامة بن زيد، قال قلت يا رسول الله لم ارك تصوم شهرا من الشهور ما تصوم من شعبان . قال \" ذلك شهر يغفل الناس عنه بين رجب ورمضان وهو شهر ترفع فيه الاعمال الى رب العالمين فاحب ان يرفع عملي وانا صايم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2357-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan"
        },
        {

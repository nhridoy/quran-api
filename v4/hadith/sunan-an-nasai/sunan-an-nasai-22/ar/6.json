    },
    {
      "id": "69b6c648dd1a4c9c86f0a4d3",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2358,
      "bookHadithIndex": 269,
      "text": "اخبرنا عمرو بن علي، عن عبد الرحمن، قال حدثنا ثابت بن قيس ابو الغصن، - شيخ من اهل المدينة - قال حدثني ابو سعيد المقبري، قال حدثني اسامة بن زيد، قال قلت يا رسول الله انك تصوم حتى لا تكاد تفطر وتفطر حتى لا تكاد ان تصوم الا يومين ان دخلا في صيامك والا صمتهما . قال \" اى يومين \" . قلت يوم الاثنين ويوم الخميس . قال \" ذانك يومان تعرض فيهما الاعمال على رب العالمين فاحب ان يعرض عملي وانا صايم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2358-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2358-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2358-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4d4",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2359,
      "bookHadithIndex": 270,
      "text": "اخبرنا احمد بن سليمان، قال حدثنا زيد بن الحباب، قال اخبرني ثابت بن قيس الغفاري، قال حدثني ابو سعيد المقبري، قال حدثني ابو هريرة، عن اسامة بن زيد، ان رسول الله صلى الله عليه وسلم كان يسرد الصوم فيقال لا يفطر ويفطر فيقال لا يصوم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2359-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2359-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2359-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4d5",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2360,
      "bookHadithIndex": 271,
      "text": "اخبرنا عمرو بن عثمان، عن بقية، قال حدثنا بحير، عن خالد بن معدان، عن جبير بن نفير، ان عايشة، قالت ان رسول الله صلى الله عليه وسلم كان يتحرى صيام الاثنين والخميس",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2360-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2360-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2360-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4d6",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2361,
      "bookHadithIndex": 272,
      "text": "اخبرنا عمرو بن علي، قال حدثنا عبد الله بن داود، قال اخبرني ثور، عن خالد بن معدان، عن ربيعة الجرشي، عن عايشة، قالت كان رسول الله صلى الله عليه وسلم يتحرى يوم الاثنين والخميس",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2361-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2361-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2361-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4d7",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2362,
      "bookHadithIndex": 273,
      "text": "اخبرنا اسحاق بن ابراهيم، قال انبانا عبيد الله بن سعيد الاموي، قال حدثنا سفيان، عن ثور، عن خالد بن معدان، عن عايشة، قالت كان رسول الله صلى الله عليه وسلم يتحرى الاثنين والخميس",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2362-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2362-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2362-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4d8",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2363,
      "bookHadithIndex": 274,
      "text": "اخبرنا احمد بن سليمان، قال حدثنا ابو داود، عن سفيان، عن منصور، عن خالد بن سعد، عن عايشة، قالت كان رسول الله صلى الله عليه وسلم يتحرى يوم الاثنين والخميس",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2363-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2363-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2363-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4d9",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2364,
      "bookHadithIndex": 275,
      "text": "اخبرنا اسحاق بن ابراهيم بن حبيب بن الشهيد، قال حدثنا يحيى بن يمان، عن سفيان، عن عاصم، عن المسيب بن رافع، عن سواء الخزاعي، عن عايشة، قالت كان النبي صلى الله عليه وسلم يصوم الاثنين والخميس",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2364-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2364-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2364-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4da",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2365,
      "bookHadithIndex": 276,
      "text": "اخبرني ابو بكر بن علي، قال حدثنا ابو نصر التمار، قال حدثنا حماد بن سلمة، عن عاصم، عن سواء، عن ام سلمة، قالت كان رسول الله صلى الله عليه وسلم يصوم من كل شهر ثلاثة ايام الاثنين والخميس من هذه الجمعة والاثنين من المقبلة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2365-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2365-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2365-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4db",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2366,
      "bookHadithIndex": 277,
      "text": "اخبرني زكريا بن يحيى، قال حدثنا اسحاق، قال انبانا النضر، قال انبانا حماد، عن عاصم بن ابي النجود، عن سواء، عن حفصة، قالت كان رسول الله صلى الله عليه وسلم يصوم من كل شهر يوم الخميس ويوم الاثنين ومن الجمعة الثانية يوم الاثنين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2366-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2366-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2366-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4dc",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2367,
      "bookHadithIndex": 278,
      "text": "اخبرنا القاسم بن زكريا بن دينار، قال حدثنا حسين، عن زايدة، عن عاصم، عن المسيب، عن حفصة، قالت كان رسول الله صلى الله عليه وسلم اذا اخذ مضجعه جعل كفه اليمنى تحت خده الايمن وكان يصوم الاثنين والخميس",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2367-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2367-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2367-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4dd",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2368,
      "bookHadithIndex": 279,
      "text": "اخبرنا محمد بن علي بن الحسن بن شقيق، قال ابي انبانا ابو حمزة، عن عاصم، عن زر، عن عبد الله بن مسعود، قال كان رسول الله صلى الله عليه وسلم يصوم ثلاثة ايام من غرة كل شهر وقلما يفطر يوم الجمعة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2368-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2368-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2368-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4de",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2369,
      "bookHadithIndex": 280,
      "text": "اخبرنا زكريا بن يحيى، قال حدثنا ابو كامل، قال حدثنا ابو عوانة، عن عاصم بن بهدلة، عن رجل، عن الاسود بن هلال، عن ابي هريرة، قال امرني رسول الله صلى الله عليه وسلم بركعتى الضحى وان لا انام الا على وتر وصيام ثلاثة ايام من الشهر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2369-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2369-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2369-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4df",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2370,
      "bookHadithIndex": 281,
      "text": "اخبرنا قتيبة، قال حدثنا سفيان، عن عبيد الله، انه سمع ابن عباس، وسيل، عن صيام، عاشوراء قال ما علمت النبي صلى الله عليه وسلم صام يوما يتحرى فضله على الايام الا هذا اليوم يعني شهر رمضان ويوم عاشوراء",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2370-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2370-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2370-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4e0",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2371,
      "bookHadithIndex": 282,
      "text": "اخبرنا قتيبة، عن سفيان، عن الزهري، عن حميد بن عبد الرحمن بن عوف، قال سمعت معاوية، يوم عاشوراء وهو على المنبر يقول يا اهل المدينة اين علماوكم سمعت رسول الله صلى الله عليه وسلم يقول في هذا اليوم \" اني صايم فمن شاء ان يصوم فليصم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2371-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2371-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2371-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4e1",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2372,
      "bookHadithIndex": 283,
      "text": "اخبرني زكريا بن يحيى، قال حدثنا شيبان، قال حدثنا ابو عوانة، عن الحر بن صياح، عن هنيدة بن خالد، عن امراته، قالت حدثتني بعض، نساء النبي صلى الله عليه وسلم ان النبي صلى الله عليه وسلم كان يصوم يوم عاشوراء وتسعا من ذي الحجة وثلاثة ايام من الشهر اول اثنين من الشهر وخميسين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2372-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2372-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2372-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4e2",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2373,
      "bookHadithIndex": 284,
      "text": "اخبرني حاجب بن سليمان، قال حدثنا الحارث بن عطية، قال حدثنا الاوزاعي، عن عطاء بن ابي رباح، عن عبد الله بن عمر، قال قال رسول الله صلى الله عليه وسلم \" من صام الابد فلا صام",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2373-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2373-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2373-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4e3",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2374,
      "bookHadithIndex": 285,
      "text": "حدثنا عيسى بن مساور، عن الوليد، قال حدثنا الاوزاعي، قال اخبرني عطاء، عن عبد الله، ح وانبانا محمد بن عبد الله، قال حدثني الوليد، عن الاوزاعي، قال حدثنا عطاء، عن عبد الله بن عمر، قال قال رسول الله صلى الله عليه وسلم \" من صام الابد فلا صام ولا افطر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2374-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2374-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2374-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4e4",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2375,
      "bookHadithIndex": 286,
      "text": "اخبرنا العباس بن الوليد، قال حدثنا ابي وعقبة، عن الاوزاعي، قال حدثني عطاء، قال حدثني من، سمع ابن عمر، يقول قال النبي صلى الله عليه وسلم \" من صام الابد فلا صام",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2375-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2375-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2375-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4e5",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2376,
      "bookHadithIndex": 287,
      "text": "اخبرنا اسماعيل بن يعقوب، قال حدثنا محمد بن موسى، قال حدثنا ابي، عن الاوزاعي، عن عطاء، قال حدثني من، سمع ابن عمر، ان النبي صلى الله عليه وسلم قال \" من صام الابد فلا صام",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2376-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2376-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2376-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4e6",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2377,
      "bookHadithIndex": 288,
      "text": "اخبرنا احمد بن ابراهيم بن محمد، قال حدثنا ابن عايذ، قال حدثنا يحيى، عن الاوزاعي، عن عطاء، انه حدثه قال حدثني من، سمع عبد الله بن عمرو بن العاص، قال قال رسول الله صلى الله عليه وسلم \" من صام الابد فلا صام ولا افطر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2377-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2377-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2377-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4e7",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2378,
      "bookHadithIndex": 289,
      "text": "اخبرني ابراهيم بن الحسن، قال حدثنا حجاج بن محمد، قال قال ابن جريج سمعت عطاء، ان ابا العباس الشاعر، اخبره انه، سمع عبد الله بن عمرو بن العاص، قال بلغ النبي صلى الله عليه وسلم اني اصوم اسرد الصوم وساق الحديث . قال قال عطاء لا ادري كيف ذكر صيام الابد لا صام من صام الابد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2378-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2378-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2378-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4e8",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2379,
      "bookHadithIndex": 290,
      "text": "اخبرنا علي بن حجر، قال انبانا اسماعيل، عن الجريري، عن يزيد بن عبد الله بن الشخير، عن اخيه، مطرف عن عمران، قال قيل يا رسول الله ان فلانا لا يفطر نهارا الدهر . قال \" لا صام ولا افطر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2379-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2379-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2379-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4e9",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2380,
      "bookHadithIndex": 291,
      "text": "اخبرني عمرو بن هشام، قال حدثنا مخلد، عن الاوزاعي، عن قتادة، عن مطرف بن عبد الله بن الشخير، اخبرني ابي انه، سمع رسول الله صلى الله عليه وسلم وذكر عنده رجل يصوم الدهر قال \" لا صام ولا افطر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2380-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2380-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2380-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4ea",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2381,
      "bookHadithIndex": 292,
      "text": "اخبرنا محمد بن المثنى، قال حدثنا ابو داود، قال حدثنا شعبة، عن قتادة، قال سمعت مطرف بن عبد الله بن الشخير، يحدث عن ابيه، ان رسول الله صلى الله عليه وسلم قال في صوم الدهر \" لا صام ولا افطر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2381-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2381-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2381-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4eb",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2382,
      "bookHadithIndex": 293,
      "text": "اخبرني هارون بن عبد الله، قال حدثنا الحسن بن موسى، قال انبانا ابو هلال، قال حدثنا غيلان، - وهو ابن جرير - قال حدثنا عبد الله، - وهو ابن معبد الزماني - عن ابي قتادة، عن عمر، قال كنا مع رسول الله صلى الله عليه وسلم فمررنا برجل فقالوا يا نبي الله هذا لا يفطر منذ كذا وكذا . فقال \" لا صام ولا افطر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2382-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2382-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2382-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4ec",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2383,
      "bookHadithIndex": 294,
      "text": "اخبرنا محمد بن بشار، قال حدثنا محمد، قال حدثنا شعبة، عن غيلان، انه سمع عبد الله بن معبد الزماني، عن ابي قتادة، ان رسول الله صلى الله عليه وسلم سيل عن صومه فغضب فقال عمر رضينا بالله ربا وبالاسلام دينا وبمحمد رسولا . وسيل عمن صام الدهر فقال \" لا صام ولا افطر او ما صام وما افطر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2383-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "-"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2383-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2383-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4ed",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2384,
      "bookHadithIndex": 295,
      "text": "اخبرنا يحيى بن حبيب بن عربي، قال حدثنا حماد، عن هشام، عن ابيه، عن عايشة، ان حمزة بن عمرو الاسلمي، سال رسول الله صلى الله عليه وسلم فقال يا رسول الله اني رجل اسرد الصوم افاصوم في السفر قال \" صم ان شيت او افطر ان شيت",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2384-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2384-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2384-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4ee",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2385,
      "bookHadithIndex": 296,
      "text": "اخبرنا محمد بن بشار، قال حدثنا عبد الرحمن، قال حدثنا سفيان، عن الاعمش، عن ابي عمار، عن عمرو بن شرحبيل، عن رجل، من اصحاب النبي صلى الله عليه وسلم قال قيل للنبي صلى الله عليه وسلم رجل يصوم الدهر . قال \" وددت انه لم يطعم الدهر \" . قالوا فثلثيه قال \" اكثر \" . قالوا فنصفه قال \" اكثر \" . ثم قال \" الا اخبركم بما يذهب وحر الصدر صوم ثلاثة ايام من كل شهر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2385-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2385-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2385-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4ef",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2386,
      "bookHadithIndex": 297,
      "text": "اخبرنا محمد بن العلاء، قال حدثنا ابو معاوية، قال حدثنا الاعمش، عن ابي عمار، عن عمرو بن شرحبيل، قال اتى رسول الله صلى الله عليه وسلم رجل فقال يا رسول الله ما تقول في رجل صام الدهر كله فقال رسول الله صلى الله عليه وسلم \" وددت انه لم يطعم الدهر شييا \" . قال فثلثيه قال \" اكثر \" . قال فنصفه قال \" اكثر \" . قال \" افلا اخبركم بما يذهب وحر الصدر \" . قالوا بلى . قال \" صيام ثلاثة ايام من كل شهر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2386-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2386-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2386-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4f0",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2387,
      "bookHadithIndex": 298,
      "text": "اخبرنا قتيبة، قال حدثنا حماد، عن غيلان بن جرير، عن عبد الله بن معبد الزماني، عن ابي قتادة، قال قال عمر يا رسول الله كيف بمن يصوم الدهر كله قال \" لا صام ولا افطر او لم يصم ولم يفطر \" . قال يا رسول الله كيف بمن يصوم يومين ويفطر يوما قال \" اويطيق ذلك احد \" . قال فكيف بمن يصوم يوما ويفطر يوما قال \" ذلك صوم داود عليه السلام \" . قال فكيف بمن يصوم يوما ويفطر يومين قال \" وددت اني اطيق ذلك \" . قال ثم قال \" ثلاث من كل شهر ورمضان الى رمضان هذا صيام الدهر كله",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2387-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2387-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2387-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4f1",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2388,
      "bookHadithIndex": 299,
      "text": "قال وفيما قرا علينا احمد بن منيع قال حدثنا هشيم، قال انبانا حصين، ومغيرة، عن مجاهد، عن عبد الله بن عمرو، قال قال رسول الله صلى الله عليه وسلم \" افضل الصيام صيام داود عليه السلام كان يصوم يوما ويفطر يوما",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2388-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2388-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2388-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4f2",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2389,
      "bookHadithIndex": 300,
      "text": "اخبرنا محمد بن معمر، قال حدثنا يحيى بن حماد، قال حدثنا ابو عوانة، عن مغيرة، عن مجاهد، قال قال لي عبد الله بن عمرو انكحني ابي امراة ذات حسب فكان ياتيها فيسالها عن بعلها، فقالت نعم الرجل من رجل لم يطا لنا فراشا ولم يفتش لنا كنفا منذ اتيناه . فذكر ذلك للنبي صلى الله عليه وسلم فقال \" ايتني به \" . فاتيته معه فقال \" كيف تصوم \" . قلت كل يوم . قال \" صم من كل جمعة ثلاثة ايام \" . قلت اني اطيق افضل من ذلك . قال \" صم يومين وافطر يوما \" . قال اني اطيق افضل من ذلك . قال \" صم افضل الصيام صيام داود عليه السلام صوم يوم وفطر يوم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2389-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2389-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2389-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    }
  ]
}
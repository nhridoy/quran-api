          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4d0",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2355,
      "bookHadithIndex": 266,
      "text": "Rapporté par ‘Aïcha رضي الله عنها : Le Messager d’Allah jeûnait tout Cha’ban sauf un petit peu",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2355-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {

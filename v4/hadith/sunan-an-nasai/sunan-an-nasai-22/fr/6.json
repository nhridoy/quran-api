      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4d1",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2356,
      "bookHadithIndex": 267,
      "text": "Rapporté par Jubair bin Nufair : ‘Aïcha رضي الله عنها a dit : Le Messager d’Allah jeûnait tout le mois de Cha’ban",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2356-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2356-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2356-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4d2",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2357,
      "bookHadithIndex": 268,
      "text": "Rapporté par Oussama bin Zaid : J’ai dit : « Ô Messager d’Allah, je ne te vois pas jeûner un mois autant que Cha’ban. » Il a répondu : « C’est un mois auquel les gens ne prêtent pas attention, entre Rajab et Ramadan. C’est un mois où les actions sont présentées au Seigneur des mondes, et j’aime que mes actions soient présentées pendant que je jeûne. »",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2357-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2357-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2357-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4d3",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2358,
      "bookHadithIndex": 269,
      "text": "Rapporté par Oussama bin Zaid : J’ai dit : « Ô Messager d’Allah, parfois tu jeûnes et tu ne romps presque jamais ton jeûne, sauf deux jours que, si tu jeûnes, tu les inclus dans ton jeûne, et si tu ne jeûnes pas, tu les jeûnes séparément. » Il a dit : « Quels sont ces deux jours ? » J’ai répondu : « Le lundi et le jeudi. » Il a dit : « Ce sont deux jours où les actions sont présentées au Seigneur des mondes, et j’aime que mes actions soient présentées pendant que je jeûne. »",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2358-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2358-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2358-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4d4",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2359,
      "bookHadithIndex": 270,
      "text": "Il a été rapporté d’après Usâmah ibn Zayd : « Le Messager d’Allah ﷺ jeûnait de manière continue, au point que l’on disait : “Il ne rompt jamais son jeûne !” Et parfois, il ne jeûnait pas, au point que l’on disait : “Il ne jeûne jamais !” »",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2359-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2359-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2359-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a4d5",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 22,
      "hadithIndex": 2360,
      "bookHadithIndex": 271,
      "text": "Rapporté par Jubair bin Nufair : ‘Aïcha رضي الله عنها a dit : Le Messager d’Allah tenait beaucoup à jeûner les lundis et les jeudis",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-22-2360-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"

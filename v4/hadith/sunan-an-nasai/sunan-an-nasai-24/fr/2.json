      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a616",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2681,
      "bookHadithIndex": 63,
      "text": "Rapporté par Ibn 'Umar : Un homme s'est levé et a dit : « Ô Messager d'Allah ! Quels vêtements nous ordonnes-tu de porter en état d'Ihram ? » Le Messager d'Allah ﷺ a dit : « Ne portez pas de chemises, de pantalons ni de khuffs, sauf si quelqu'un n'a pas de sandales, alors il peut porter des khuffs qui descendent sous les chevilles. Et ne portez aucun vêtement qui a été touché ou teint au safran ou au wars. Et une femme en état d'Ihram ne doit pas couvrir son visage ni porter de gants. »",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2681-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2681-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2681-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a617",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2682,
      "bookHadithIndex": 64,
      "text": "Rapporté par 'Abdullah bin 'Umar : Sa sœur Hafsah a dit : « J'ai demandé au Prophète ﷺ : \"Ô Messager d'Allah ! Pourquoi les gens sont-ils sortis de l'état d'Ihram alors que toi, tu n'es pas sorti de l'état d'Ihram après ta 'Umrah ?\" Il a répondu : \"J'ai attaché mes cheveux et mis un collier à mon animal de sacrifice, donc je ne sortirai de l'état d'Ihram qu'après le Hajj.\" »",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2682-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2682-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2682-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a618",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2683,
      "bookHadithIndex": 65,
      "text": "Rapporté par Salim, d'après son père : J'ai vu le Messager d'Allah ﷺ entrer en état d'Ihram avec les cheveux attachés",
      "grades": [
        {

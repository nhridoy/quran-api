          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2696-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a626",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2697,
      "bookHadithIndex": 79,
      "text": "It was narrated that 'Aishah said:\"It is as if I can see the glistening of the perfume in the parting on the head of the Messenger of Allah when he was in Ihram.(Shah)",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2697-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {

      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6c3",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2853,
      "bookHadithIndex": 236,
      "text": "اخبرنا يعقوب بن ابراهيم، قال حدثنا هشيم، قال انبانا ابو بشر، عن سعيد بن جبير، عن ابن عباس، ان رجلا، كان مع النبي صلى الله عليه وسلم فوقصته ناقته وهو محرم فمات فقال رسول الله صلى الله عليه وسلم \" اغسلوه بماء وسدر وكفنوه في ثوبيه ولا تمسوه بطيب ولا تخمروا راسه فانه يبعث يوم القيامة ملبيا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2853-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2853-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2853-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6c4",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2854,
      "bookHadithIndex": 237,
      "text": "اخبرنا محمد بن عبد الاعلى، قال حدثنا خالد، قال حدثنا شعبة، عن ابي بشر، عن سعيد بن جبير، عن ابن عباس، ان رجلا، محرما صرع عن ناقته، فاوقص ذكر انه قد مات فقال النبي صلى الله عليه وسلم \" اغسلوه بماء وسدر وكفنوه في ثوبين \" . ثم قال على اثره \" خارجا راسه \" . قال \" ولا تمسوه طيبا فانه يبعث يوم القيامة ملبيا \" . قال شعبة فسالته بعد عشر سنين فجاء بالحديث كما كان يجيء به الا انه قال \" ولا تخمروا وجهه وراسه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2854-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2854-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2854-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6c5",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2855,
      "bookHadithIndex": 238,
      "text": "اخبرنا قتيبة، قال حدثنا حماد، عن ايوب، عن سعيد بن جبير، عن ابن عباس، قال بينا رجل واقف بعرفة مع رسول الله صلى الله عليه وسلم اذ وقع من راحلته فاقعصه - او قال فاقعصته - فقال رسول الله صلى الله عليه وسلم \" اغسلوه بماء وسدر وكفنوه في ثوبين ولا تحنطوه ولا تخمروا راسه فان الله عز وجل يبعثه يوم القيامة ملبيا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2855-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2855-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2855-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6c6",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2856,
      "bookHadithIndex": 239,
      "text": "اخبرني محمد بن قدامة، قال حدثنا جرير، عن منصور، عن الحكم، عن سعيد بن جبير، عن ابن عباس، قال وقصت رجلا محرما ناقته فقتلته فاتي رسول الله صلى الله عليه وسلم فقال \" اغسلوه وكفنوه ولا تغطوا راسه ولا تقربوه طيبا فانه يبعث يهل",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2856-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2856-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2856-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6c7",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2857,
      "bookHadithIndex": 240,
      "text": "اخبرنا محمد بن معاوية، قال حدثنا خلف، - يعني ابن خليفة - عن ابي بشر، عن سعيد بن جبير، عن ابن عباس، ان رجلا، كان حاجا مع رسول الله صلى الله عليه وسلم وانه لفظه بعيره فمات فقال رسول الله صلى الله عليه وسلم \" يغسل ويكفن في ثوبين ولا يغطى راسه ووجهه فانه يقوم يوم القيامة ملبيا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2857-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2857-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2857-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6c8",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2858,
      "bookHadithIndex": 241,
      "text": "اخبرنا عمران بن يزيد، قال حدثنا شعيب بن اسحاق، قال اخبرني ابن جريج، قال اخبرني عمرو بن دينار، ان سعيد بن جبير، اخبره ان ابن عباس اخبره قال اقبل رجل حراما مع رسول الله صلى الله عليه وسلم فخر من فوق بعيره فوقص وقصا فمات فقال رسول الله صلى الله عليه وسلم \" اغسلوه بماء وسدر والبسوه ثوبيه ولا تخمروا راسه فانه ياتي يوم القيامة يلبي",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2858-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2858-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2858-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6c9",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2859,
      "bookHadithIndex": 242,
      "text": "اخبرنا محمد بن عبد الله بن يزيد المقري، قال حدثنا ابي قال، حدثنا جويرية، عن نافع، ان عبد الله بن عبد الله، وسالم بن عبد الله، اخبراه انهما، كلما عبد الله بن عمر لما نزل الجيش بابن الزبير قبل ان يقتل فقالا لا يضرك ان لا تحج العام انا نخاف ان يحال بينك وبين البيت . قال خرجنا مع رسول الله صلى الله عليه وسلم فحال كفار قريش دون البيت فنحر رسول الله صلى الله عليه وسلم هديه وحلق راسه واشهدكم اني قد اوجبت عمرة ان شاء الله انطلق فان خلي بيني وبين البيت طفت وان حيل بيني وبين البيت فعلت ما فعل رسول الله صلى الله عليه وسلم وانا معه . ثم سار ساعة ثم قال فانما شانهما واحد اشهدكم اني قد اوجبت حجة مع عمرتي . فلم يحلل منهما حتى احل يوم النحر واهدى",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2859-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2859-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2859-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6ca",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2860,
      "bookHadithIndex": 243,
      "text": "اخبرنا حميد بن مسعدة البصري، قال حدثنا سفيان، - وهو ابن حبيب - عن الحجاج الصواف، عن يحيى بن ابي كثير، عن عكرمة، عن الحجاج بن عمرو الانصاري، انه سمع رسول الله صلى الله عليه وسلم يقول \" من عرج او كسر فقد حل وعليه حجة اخرى \" . فسالت ابن عباس وابا هريرة عن ذلك فقالا صدق",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2860-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2860-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2860-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6cb",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2861,
      "bookHadithIndex": 244,
      "text": "اخبرنا شعيب بن يوسف، ومحمد بن المثنى، قالا حدثنا يحيى بن سعيد، عن حجاج بن الصواف، قال حدثنا يحيى بن ابي كثير، عن عكرمة، عن الحجاج بن عمرو، عن النبي صلى الله عليه وسلم قال \" من كسر او عرج فقد حل وعليه حجة اخرى \" . وسالت ابن عباس وابا هريرة فقالا صدق . وقال شعيب في حديثه وعليه الحج من قابل",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2861-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2861-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2861-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6cc",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2862,
      "bookHadithIndex": 245,
      "text": "اخبرنا عبدة بن عبد الله، قال انبانا سويد، قال حدثنا زهير، قال حدثنا موسى بن عقبة، قال حدثني نافع، ان عبد الله بن عمر، حدثه ان رسول الله صلى الله عليه وسلم كان ينزل بذي طوى يبيت به حتى يصلي صلاة الصبح حين يقدم الى مكة ومصلى رسول الله صلى الله عليه وسلم ذلك على اكمة غليظة ليس في المسجد الذي بني ثم ولكن اسفل من ذلك على اكمة خشنة غليظة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2862-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2862-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2862-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6cd",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2863,
      "bookHadithIndex": 246,
      "text": "اخبرني عمران بن يزيد، عن شعيب، قال حدثنا ابن جريج، قال اخبرني مزاحم بن ابي مزاحم، عن عبد العزيز بن عبد الله، عن محرش الكعبي، ان النبي صلى الله عليه وسلم خرج ليلا من الجعرانة حين مشى معتمرا فاصبح بالجعرانة كبايت حتى اذا زالت الشمس خرج عن الجعرانة في بطن سرف حتى جامع الطريق طريق المدينة من سرف",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2863-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2863-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2863-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6ce",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2864,
      "bookHadithIndex": 247,
      "text": "اخبرنا هناد بن السري، عن سفيان، عن اسماعيل بن امية، عن مزاحم، عن عبد العزيز بن عبد الله بن خالد بن اسيد، عن محرش الكعبي، ان النبي صلى الله عليه وسلم خرج من الجعرانة ليلا كانه سبيكة فضة فاعتمر ثم اصبح بها كبايت",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2864-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {

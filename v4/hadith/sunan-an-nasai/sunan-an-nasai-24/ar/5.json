          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6b0",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2834,
      "bookHadithIndex": 217,
      "text": "اخبرنا يعقوب بن ابراهيم، قال حدثنا هشيم، قال حدثنا يحيى بن سعيد، عن نافع، عن ابن عمر، ان النبي صلى الله عليه وسلم سيل ما يقتل المحرم قال \" يقتل العقرب والفويسقة والحداة والغراب والكلب العقور",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2834-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2834-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2834-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6b1",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2835,
      "bookHadithIndex": 218,
      "text": "اخبرنا محمد بن عبد الله بن يزيد المقري، قال حدثنا سفيان، عن الزهري، عن سالم، عن ابيه، قال قال النبي صلى الله عليه وسلم \" خمس من الدواب لا جناح في قتلهن على من قتلهن في الحرم والاحرام الفارة والحداة والغراب والعقرب والكلب العقور",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2835-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2835-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2835-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6b2",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2836,
      "bookHadithIndex": 219,
      "text": "اخبرنا محمد بن منصور، قال حدثنا سفيان، قال حدثنا ابن جريج، عن عبد الله بن عبيد بن عمير، عن ابن ابي عمار، قال سالت جابر بن عبد الله عن الضبع، فامرني باكلها . قلت اصيد هي قال نعم . قلت اسمعته من رسول الله صلى الله عليه وسلم قال نعم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2836-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2836-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6b3",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2837,
      "bookHadithIndex": 220,
      "text": "اخبرنا قتيبة، قال حدثنا داود، - وهو ابن عبد الرحمن العطار - عن عمرو، - وهو ابن دينار - قال سمعت ابا الشعثاء، يحدث عن ابن عباس، قال تزوج النبي صلى الله عليه وسلم ميمونة وهو محرم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2837-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Shadh"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2837-alalbani",
          "name": "Al-Albani",
          "grade": "Shadh"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2837-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6b4",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2838,
      "bookHadithIndex": 221,
      "text": "اخبرنا عمرو بن علي، قال حدثنا يحيى، قال حدثنا ابن جريج، قال حدثنا عمرو بن دينار، ان ابا الشعثاء، حدثه عن ابن عباس، ان رسول الله صلى الله عليه وسلم نكح حراما",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2838-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "-"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2838-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6b5",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2839,
      "bookHadithIndex": 222,
      "text": "اخبرني ابراهيم بن يونس بن محمد، قال حدثنا ابي قال، حدثنا حماد بن سلمة، عن حميد، عن مجاهد، عن ابن عباس، ان رسول الله صلى الله عليه وسلم تزوج ميمونة وهما محرمان",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2839-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Shadh"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2839-alalbani",
          "name": "Al-Albani",
          "grade": "Shadh"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2839-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6b6",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2840,
      "bookHadithIndex": 223,
      "text": "اخبرنا محمد بن اسحاق الصاغاني، قال حدثنا احمد بن اسحاق، قال حدثنا حماد بن سلمة، عن حميد، عن عكرمة، عن ابن عباس، ان رسول الله صلى الله عليه وسلم تزوج ميمونة وهو محرم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2840-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Shadh"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2840-alalbani",
          "name": "Al-Albani",
          "grade": "Shadh"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2840-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6b7",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2841,
      "bookHadithIndex": 224,
      "text": "اخبرني شعيب بن شعيب بن اسحاق، وصفوان بن عمرو الحمصي، قالا حدثنا ابو المغيرة، قال حدثنا الاوزاعي، عن عطاء بن ابي رباح، عن ابن عباس، ان النبي صلى الله عليه وسلم تزوج ميمونة وهو محرم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2841-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Shadh"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2841-alalbani",
          "name": "Al-Albani",
          "grade": "Shadh"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2841-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6b8",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2842,
      "bookHadithIndex": 225,
      "text": "اخبرنا قتيبة، عن مالك، عن نافع، عن نبيه بن وهب، ان ابان بن عثمان، قال سمعت عثمان بن عفان، يقول قال رسول الله صلى الله عليه وسلم \" لا ينكح المحرم ولا يخطب ولا ينكح",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2842-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2842-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2842-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6b9",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2843,
      "bookHadithIndex": 226,
      "text": "اخبرنا عبيد الله بن سعيد، قال حدثنا يحيى، عن مالك، اخبرني نافع، عن نبيه بن وهب، عن ابان بن عثمان، عن ابيه، عن النبي صلى الله عليه وسلم انه نهى ان ينكح المحرم او ينكح او يخطب",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2843-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2843-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2843-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6ba",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2844,
      "bookHadithIndex": 227,
      "text": "اخبرنا محمد بن عبد الله بن يزيد، عن سفيان، عن ايوب بن موسى، عن نبيه بن وهب، قال ارسل عمر بن عبيد الله بن معمر الى ابان بن عثمان يساله اينكح المحرم فقال ابان ان عثمان بن عفان حدث ان النبي صلى الله عليه وسلم قال \" لا ينكح المحرم ولا يخطب",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2844-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2844-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2844-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6bb",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2845,
      "bookHadithIndex": 228,
      "text": "اخبرنا قتيبة، قال حدثنا الليث، عن ابي الزبير، عن عطاء، عن ابن عباس، ان رسول الله صلى الله عليه وسلم احتجم وهو محرم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2845-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2845-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2845-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6bc",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2846,
      "bookHadithIndex": 229,
      "text": "اخبرنا قتيبة، قال حدثنا سفيان، عن عمرو، عن طاوس، وعطاء، عن ابن عباس، ان النبي صلى الله عليه وسلم احتجم وهو محرم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2846-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2846-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2846-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6bd",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2847,
      "bookHadithIndex": 230,
      "text": "اخبرنا محمد بن منصور، عن سفيان، قال انبانا عمرو بن دينار، قال سمعت عطاء، قال سمعت ابن عباس، يقول احتجم النبي صلى الله عليه وسلم وهو محرم . ثم قال بعد اخبرني طاوس عن ابن عباس يقول احتجم النبي صلى الله عليه وسلم وهو محرم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2847-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2847-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2847-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6be",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2848,
      "bookHadithIndex": 231,
      "text": "اخبرنا محمد بن عبد الله بن المبارك، قال حدثنا ابو الوليد، قال حدثنا يزيد بن ابراهيم، قال حدثنا ابو الزبير، عن جابر، ان النبي صلى الله عليه وسلم احتجم وهو محرم من وثء كان به",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2848-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2848-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2848-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6bf",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2849,
      "bookHadithIndex": 232,
      "text": "اخبرنا اسحاق بن ابراهيم، قال انبانا عبد الرزاق، قال حدثنا معمر، عن قتادة، عن انس، ان رسول الله صلى الله عليه وسلم احتجم وهو محرم على ظهر القدم من وثء كان به",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2849-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2849-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2849-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6c0",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2850,
      "bookHadithIndex": 233,
      "text": "اخبرني هلال بن بشر، قال حدثنا محمد بن خالد، - وهو ابن عثمة - قال حدثنا سليمان بن بلال، قال قال علقمة بن ابي علقمة انه سمع الاعرج، قال سمعت عبد الله ابن بحينة، يحدث ان رسول الله صلى الله عليه وسلم احتجم وسط راسه وهو محرم بلحى جمل من طريق مكة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2850-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2850-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2850-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6c1",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2851,
      "bookHadithIndex": 234,
      "text": "اخبرنا محمد بن سلمة، والحارث بن مسكين، قراءة عليه وانا اسمع، عن ابن القاسم، قال حدثني مالك، عن عبد الكريم بن مالك الجزري، عن مجاهد، عن عبد الرحمن بن ابي ليلى، عن كعب بن عجرة، انه كان مع رسول الله صلى الله عليه وسلم محرما فاذاه القمل في راسه فامره رسول الله صلى الله عليه وسلم ان يحلق راسه وقال \" صم ثلاثة ايام او اطعم ستة مساكين مدين مدين او انسك شاة اى ذلك فعلت اجزا عنك",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2851-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2851-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2851-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c677dd1a4c9c86f0a6c2",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 24,
      "hadithIndex": 2852,
      "bookHadithIndex": 235,
      "text": "اخبرني احمد بن سعيد الرباطي، قال انبانا عبد الرحمن بن عبد الله، - وهو الدشتكي - قال انبانا عمرو، - وهو ابن ابي قيس - عن الزبير، - وهو ابن عدي - عن ابي وايل، عن كعب بن عجرة، قال احرمت فكثر قمل راسي فبلغ ذلك النبي صلى الله عليه وسلم فاتاني وانا اطبخ قدرا لاصحابي فمس راسي باصبعه فقال \" انطلق فاحلقه وتصدق على ستة مساكين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-24-2852-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"

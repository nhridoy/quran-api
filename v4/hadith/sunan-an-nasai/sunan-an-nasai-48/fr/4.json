      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0afee",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5197,
      "bookHadithIndex": 158,
      "text": "Rapporté par Anas bin Malik : Le Messager d'Allah ﷺ avait une bague en argent qu'il portait à la main droite. Elle avait une pierre éthiopienne (Fass), et il portait la pierre tournée vers la paume",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5197-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Lighairihi"
        },
        {

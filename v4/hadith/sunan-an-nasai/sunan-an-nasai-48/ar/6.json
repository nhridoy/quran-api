          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b05a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5305,
      "bookHadithIndex": 266,
      "text": "اخبرنا محمود بن غيلان، قال انبانا النضر بن شميل، قال انبانا شعبة، قال حدثنا خليفة، قال سمعت عبد الله بن الزبير، قال لا تلبسوا نساءكم الحرير فاني سمعت عمر بن الخطاب يقول قال رسول الله صلى الله عليه وسلم \" من لبسه في الدنيا لم يلبسه في الاخرة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5305-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5305-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5305-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b05b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5306,
      "bookHadithIndex": 267,
      "text": "اخبرنا عمرو بن منصور، قال حدثنا عبد الله بن رجاء، قال انبانا حرب، عن يحيى بن ابي كثير، قال حدثني عمران بن حطان، انه سال عبد الله بن عباس عن لبس الحرير، فقال سل عايشة . فسالت عايشة قالت سل عبد الله بن عمر . فسالت ابن عمر فقال حدثني ابو حفص ان رسول الله صلى الله عليه وسلم قال \" من لبس الحرير في الدنيا فلا خلاق له في الاخرة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5306-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5306-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5306-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b05c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5307,
      "bookHadithIndex": 268,
      "text": "اخبرنا سليمان بن سلم، قال انبانا النضر، قال حدثنا شعبة، عن قتادة، عن بكر بن عبد الله، وبشر بن المحتفز، عن ابن عمر، عن رسول الله صلى الله عليه وسلم قال \" انما يلبس الحرير من لا خلاق له",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5307-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5307-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5307-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b05d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5308,
      "bookHadithIndex": 269,
      "text": "اخبرني ابراهيم بن يعقوب، قال حدثنا ابو النعمان، سنة سبع ومايتين قال حدثنا الصعق بن حزن، عن قتادة، عن علي البارقي، قال اتتني امراة تستفتيني فقلت لها هذا ابن عمر . فاتبعته تساله واتبعتها اسمع ما يقول . قالت افتني في الحرير . قال نهى عنه رسول الله صلى الله عليه وسلم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5308-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5308-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5308-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b05e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5309,
      "bookHadithIndex": 270,
      "text": "اخبرنا سليمان بن منصور، قال حدثنا ابو الاحوص، عن اشعث بن ابي الشعثاء، عن معاوية بن سويد، عن البراء بن عازب، قال امرنا رسول الله صلى الله عليه وسلم بسبع ونهانا عن سبع نهانا عن خواتيم الذهب وعن انية الفضة وعن المياثر والقسية والاستبرق والديباج والحرير",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5309-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5309-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5309-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b05f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5310,
      "bookHadithIndex": 271,
      "text": "اخبرنا اسحاق بن ابراهيم، قال انبانا عيسى بن يونس، قال حدثنا سعيد، عن قتادة، عن انس، ان رسول الله صلى الله عليه وسلم ارخص لعبد الرحمن بن عوف والزبير بن العوام في قمص حرير من حكة كانت بهما",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5310-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5310-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5310-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b060",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5311,
      "bookHadithIndex": 272,
      "text": "اخبرنا نصر بن علي، قال حدثنا خالد، قال حدثنا سعيد، عن قتادة، عن انس، ان النبي صلى الله عليه وسلم رخص لعبد الرحمن والزبير في قمص حرير كانت بهما يعني لحكة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5311-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5311-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5311-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b061",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5312,
      "bookHadithIndex": 273,
      "text": "اخبرنا اسحاق بن ابراهيم، قال انبانا جرير، عن سليمان التيمي، عن ابي عثمان النهدي، قال كنا مع عتبة بن فرقد فجاء كتاب عمر ان رسول الله صلى الله عليه وسلم قال \" لا يلبس الحرير الا من ليس له منه شىء في الاخرة الا هكذا \" . وقال ابو عثمان باصبعيه اللتين تليان الابهام فرايتهما ازرار الطيالسة حتى رايت الطيالسة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5312-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5312-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5312-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b062",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5313,
      "bookHadithIndex": 274,
      "text": "اخبرنا عبد الحميد بن محمد، قال حدثنا مخلد، قال حدثنا مسعر، عن وبرة، عن الشعبي، عن سويد بن غفلة، ح واخبرنا احمد بن سليمان، قال حدثنا عبيد الله، قال حدثنا اسراييل، عن ابي حصين، عن ابراهيم، عن سويد بن غفلة، عن عمر، انه لم يرخص في الديباج الا موضع اربع اصابع",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5313-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5313-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5313-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b063",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5314,
      "bookHadithIndex": 275,
      "text": "اخبرنا يعقوب بن ابراهيم، قال حدثنا هشيم، قال حدثنا شعبة، عن ابي اسحاق، عن البراء، قال رايت النبي صلى الله عليه وسلم وعليه حلة حمراء مترجلا لم ار قبله ولا بعده احدا هو اجمل منه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5314-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5314-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5314-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b064",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5315,
      "bookHadithIndex": 276,
      "text": "اخبرنا عبد الله بن سعيد، قال حدثنا معاذ بن هشام، قال حدثني ابي، عن قتادة، عن انس، قال كان احب الثياب الى نبي الله صلى الله عليه وسلم الحبرة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5315-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5315-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5315-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b065",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5316,
      "bookHadithIndex": 277,
      "text": "اخبرنا اسماعيل بن مسعود، قال حدثنا خالد، - وهو ابن الحارث - قال حدثنا هشام، عن يحيى بن ابي كثير، عن محمد بن ابراهيم، ان خالد بن معدان، اخبره ان جبير بن نفير اخبره ان عبد الله بن عمرو اخبره انه، راه رسول الله صلى الله عليه وسلم وعليه ثوبان معصفران فقال \" هذه ثياب الكفار فلا تلبسها",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5316-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5316-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5316-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b066",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5317,
      "bookHadithIndex": 278,
      "text": "اخبرني حاجب بن سليمان، عن ابن ابي رواد، قال حدثنا ابن جريج، عن ابن طاوس، عن ابيه، عن عبد الله بن عمرو، انه اتى النبي صلى الله عليه وسلم وعليه ثوبان معصفران فغضب النبي صلى الله عليه وسلم وقال \" اذهب فاطرحهما عنك \" . قال اين يا رسول الله قال \" في النار",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5317-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5317-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5317-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b067",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5318,
      "bookHadithIndex": 279,
      "text": "اخبرنا عيسى بن حماد، قال انبانا الليث، عن يزيد بن ابي حبيب، ان ابراهيم بن عبد الله بن حنين، اخبره ان اباه حدثه انه، سمع عليا، يقول نهاني رسول الله صلى الله عليه وسلم عن خاتم الذهب وعن لبوس القسي والمعصفر وقراءة القران وانا راكع",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5318-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5318-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5318-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b068",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5319,
      "bookHadithIndex": 280,
      "text": "اخبرنا العباس بن محمد، قال انبانا ابو نوح، قال حدثنا جرير بن حازم، عن عبد الملك بن عمير، عن اياد بن لقيط، عن ابي رمثة، قال خرج علينا رسول الله صلى الله عليه وسلم وعليه ثوبان اخضران",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5319-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5319-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5319-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b069",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5320,
      "bookHadithIndex": 281,
      "text": "اخبرنا يعقوب بن ابراهيم، ومحمد بن المثنى، عن يحيى، عن اسماعيل، قال حدثنا قيس، عن خباب بن الارت، قال شكونا الى رسول الله صلى الله عليه وسلم وهو متوسد بردة له في ظل الكعبة فقلنا الا تستنصر لنا الا تدعو الله لنا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5320-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5320-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5320-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b06a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5321,
      "bookHadithIndex": 282,
      "text": "اخبرنا قتيبة، قال انبانا يعقوب، عن ابي حازم، عن سهل بن سعد، قال جاءت امراة ببردة - قال سهل - هل تدرون ما البردة قالوا نعم هذه الشملة منسوج في حاشيتها . فقالت يا رسول الله اني نسجت هذه بيدي اكسوكها فاخذها رسول الله صلى الله عليه وسلم محتاجا اليها فخرج الينا وانها لازاره",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5321-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5321-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5321-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b06b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5322,
      "bookHadithIndex": 283,
      "text": "اخبرنا عمرو بن علي، قال حدثنا يحيى بن سعيد، قال سمعت سعيد بن ابي عروبة، يحدث عن ايوب، عن ابي قلابة، عن ابي المهلب، عن سمرة، عن النبي صلى الله عليه وسلم قال \" البسوا من ثيابكم البياض فانها اطهر واطيب وكفنوا فيها موتاكم \" . قال يحيى لم اكتبه . قلت لم قال استغنيت بحديث ميمون بن ابي شبيب عن سمرة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5322-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5322-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5322-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b06c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5323,
      "bookHadithIndex": 284,
      "text": "اخبرنا قتيبة، قال حدثنا حماد، عن ايوب، عن ابي قلابة، عن سمرة، قال قال رسول الله صلى الله عليه وسلم \" عليكم بالبياض من الثياب فليلبسها احياوكم وكفنوا فيها موتاكم فانها من خير ثيابكم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5323-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5323-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5323-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b06d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5324,
      "bookHadithIndex": 285,
      "text": "اخبرنا قتيبة بن سعيد، قال حدثنا الليث، عن ابن ابي مليكة، عن المسور بن مخرمة، قال قسم رسول الله صلى الله عليه وسلم اقبية ولم يعط مخرمة شييا فقال مخرمة يا بنى انطلق بنا الى رسول الله صلى الله عليه وسلم . فانطلقت معه قال ادخل فادعه لي . قال فدعوته فخرج اليه وعليه قباء منها فقال \" خبات هذا لك \" . فنظر اليه فلبسه مخرمة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5324-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5324-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5324-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b06e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5325,
      "bookHadithIndex": 286,
      "text": "حدثنا محمد بن بشار، قال حدثنا محمد، قال حدثنا شعبة، عن عمرو بن دينار، عن جابر بن زيد، عن ابن عباس، انه سمع النبي صلى الله عليه وسلم يقول بعرفات فقال \" من لم يجد ازارا فليلبس السراويل ومن لم يجد نعلين فليلبس خفين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5325-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5325-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5325-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b06f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5326,
      "bookHadithIndex": 287,
      "text": "اخبرنا وهب بن بيان، قال حدثنا ابن وهب، قال اخبرني يونس، عن ابن شهاب، ان سالما، اخبره ان عبد الله بن عمر حدثه ان رسول الله صلى الله عليه وسلم قال \" بينا رجل يجر ازاره من الخيلاء خسف به فهو يتجلجل في الارض الى يوم القيامة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5326-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5326-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5326-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b070",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5327,
      "bookHadithIndex": 288,
      "text": "اخبرنا قتيبة بن سعيد، قال حدثنا الليث، عن نافع، ح وانبانا اسماعيل بن مسعود، قال حدثنا بشر، قال حدثنا عبيد الله، عن نافع، عن عبد الله، قال قال رسول الله صلى الله عليه وسلم \" من جر ثوبه - او قال ان الذي يجر ثوبه - من الخيلاء لم ينظر الله اليه يوم القيامة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5327-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5327-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5327-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b071",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5328,
      "bookHadithIndex": 289,
      "text": "اخبرنا محمد بن عبد الاعلى، قال حدثنا خالد، قال حدثنا شعبة، عن محارب، قال سمعت ابن عمر، يحدث ان رسول الله صلى الله عليه وسلم قال \" من جر ثوبه من مخيلة فان الله عز وجل لم ينظر اليه يوم القيامة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5328-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5328-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5328-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b072",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5329,
      "bookHadithIndex": 290,
      "text": "اخبرنا اسحاق بن ابراهيم، ومحمد بن قدامة، عن جرير، عن الاعمش، عن ابي اسحاق، عن مسلم بن نذير، عن حذيفة، قال قال رسول الله صلى الله عليه وسلم \" موضع الازار الى انصاف الساقين والعضلة فان ابيت فاسفل فان ابيت فمن وراء الساق ولا حق للكعبين في الازار \" . واللفظ لمحمد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5329-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5329-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5329-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b073",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5330,
      "bookHadithIndex": 291,
      "text": "اخبرنا اسماعيل بن مسعود، قال حدثنا خالد، - وهو ابن الحارث - قال حدثنا هشام، عن يحيى، عن محمد بن ابراهيم، قال حدثني ابو يعقوب، انه سمع ابا هريرة، يقول قال رسول الله صلى الله عليه وسلم \" ما تحت الكعبين من الازار ففي النار",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5330-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5330-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5330-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b074",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5331,
      "bookHadithIndex": 292,
      "text": "اخبرنا محمود بن غيلان، قال حدثنا ابو داود، قال حدثنا شعبة، قال اخبرني سعيد المقبري، وقد كان يخبر عن ابي هريرة، عن النبي صلى الله عليه وسلم قال \" ما اسفل من الكعبين من الازار ففي النار",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5331-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5331-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5331-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b075",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5332,
      "bookHadithIndex": 293,
      "text": "اخبرنا محمد بن عبد الله بن عبيد بن عقيل، قال حدثني جدي، قال حدثنا شعبة، عن اشعث، قال سمعت سعيد بن جبير، عن ابن عباس، عن النبي صلى الله عليه وسلم قال \" ان الله عز وجل لا ينظر الى مسبل الازار",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5332-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5332-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5332-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b076",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5333,
      "bookHadithIndex": 294,
      "text": "اخبرنا بشر بن خالد، قال حدثنا غندر، عن شعبة، قال سمعت سليمان بن مهران الاعمش، عن سليمان بن مسهر، عن خرشة بن الحر، عن ابي ذر، قال قال رسول الله صلى الله عليه وسلم \" ثلاثة لا يكلمهم الله عز وجل يوم القيامة ولا يزكيهم ولهم عذاب اليم المنان بما اعطى والمسبل ازاره والمنفق سلعته بالحلف الكاذب",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5333-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5333-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5333-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b077",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5334,
      "bookHadithIndex": 295,
      "text": "اخبرنا محمد بن رافع، قال حدثنا حسين بن علي، عن عبد العزيز بن ابي رواد، عن سالم، عن ابن عمر، قال قال رسول الله صلى الله عليه وسلم \" الاسبال في الازار والقميص والعمامة من جر منها شييا خيلاء لا ينظر الله اليه يوم القيامة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5334-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5334-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5334-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b078",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5335,
      "bookHadithIndex": 296,
      "text": "اخبرنا علي بن حجر، قال حدثنا اسماعيل، قال حدثنا موسى بن عقبة، عن سالم، عن ابيه، ان رسول الله صلى الله عليه وسلم قال \" من جر ثوبه من الخيلاء لا ينظر الله اليه يوم القيامة \" . قال ابو بكر يا رسول الله ان احد شقى ازاري يسترخي الا ان اتعاهد ذلك منه . فقال النبي صلى الله عليه وسلم \" انك لست ممن يصنع ذلك خيلاء",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5335-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5335-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5335-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b079",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5336,
      "bookHadithIndex": 297,
      "text": "اخبرنا نوح بن حبيب، قال حدثنا عبد الرزاق، قال حدثنا معمر، عن ايوب، عن نافع، عن ابن عمر، قال قال رسول الله صلى الله عليه وسلم \" من جر ثوبه من الخيلاء لم ينظر الله اليه \" . قالت ام سلمة يا رسول الله فكيف تصنع النساء بذيولهن قال \" ترخينه شبرا \" . قالت اذا تنكشف اقدامهن . قال \" ترخينه ذراعا لا تزدن عليه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5336-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5336-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5336-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b07a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5337,
      "bookHadithIndex": 298,
      "text": "حدثنا العباس بن الوليد بن مزيد، قال اخبرني ابي قال، حدثنا الاوزاعي، قال حدثنا يحيى بن ابي كثير، عن نافع، عن ام سلمة، انها ذكرت لرسول الله صلى الله عليه وسلم ذيول النساء فقال رسول الله صلى الله عليه وسلم \" يرخين شبرا \" . قالت ام سلمة اذا ينكشف عنها . قال \" ترخي ذراعا لا تزيد عليه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5337-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5337-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5337-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b07b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5338,
      "bookHadithIndex": 299,
      "text": "اخبرنا عبد الجبار بن العلاء بن عبد الجبار، عن سفيان، قال حدثني ايوب بن موسى، عن نافع، عن صفية، عن ام سلمة، ان النبي صلى الله عليه وسلم لما ذكر في الازار ما ذكر قالت ام سلمة فكيف بالنساء قال \" يرخين شبرا \" . قالت اذا تبدو اقدامهن . قال \" فذراعا لا يزدن عليه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5338-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5338-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {

        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b07f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5342,
      "bookHadithIndex": 303,
      "text": "حدثنا قتيبة، قال حدثنا الليث، عن ابي الزبير، عن جابر، ان رسول الله صلى الله عليه وسلم نهى عن اشتمال الصماء وان يحتبي في ثوب واحد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5342-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5342-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5342-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b080",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5343,
      "bookHadithIndex": 304,
      "text": "اخبرنا عبد الله بن محمد بن عبد الرحمن، قال حدثنا سفيان، عن مساور الوراق، عن جعفر بن عمرو بن حريث، عن ابيه، قال رايت على النبي صلى الله عليه وسلم عمامة حرقانية",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5343-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5343-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5343-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b081",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5344,
      "bookHadithIndex": 305,
      "text": "اخبرنا قتيبة، قال حدثنا معاوية بن عمار، قال حدثنا ابو الزبير، عن جابر، ان رسول الله صلى الله عليه وسلم دخل يوم فتح مكة وعليه عمامة سوداء بغير احرام",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5344-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5344-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5344-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b082",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5345,
      "bookHadithIndex": 306,
      "text": "اخبرنا عمرو بن منصور، قال حدثنا الفضل بن دكين، عن شريك، عن عمار الدهني، عن ابي الزبير، عن جابر، قال دخل النبي صلى الله عليه وسلم يوم الفتح وعليه عمامة سوداء",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5345-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5345-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5345-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b083",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5346,
      "bookHadithIndex": 307,
      "text": "اخبرنا محمد بن ابان، قال حدثنا ابو اسامة، عن مساور الوراق، عن جعفر بن عمرو بن امية، عن ابيه، قال كاني انظر الساعة الى رسول الله صلى الله عليه وسلم على المنبر وعليه عمامة سوداء قد ارخى طرفها بين كتفيه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5346-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5346-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5346-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b084",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5347,
      "bookHadithIndex": 308,
      "text": "اخبرنا قتيبة، قال حدثنا سفيان، عن الزهري، عن عبيد الله بن عبد الله، عن ابن عباس، عن ابي طلحة، ان النبي صلى الله عليه وسلم قال \" لا تدخل الملايكة بيتا فيه كلب ولا صورة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5347-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5347-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5347-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b085",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5348,
      "bookHadithIndex": 309,
      "text": "انبانا محمد بن عبد الملك بن ابي الشوارب، قال حدثنا يزيد، قال حدثنا معمر، عن الزهري، عن عبيد الله بن عبد الله، عن ابن عباس، عن ابي طلحة، قال سمعت رسول الله صلى الله عليه وسلم يقول \" لا تدخل الملايكة بيتا فيه كلب ولا صورة تماثيل",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5348-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5348-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5348-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b086",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5349,
      "bookHadithIndex": 310,
      "text": "اخبرنا علي بن شعيب، قال حدثنا معن، قال حدثنا مالك، عن ابي النضر، عن عبيد الله بن عبد الله، انه دخل على ابي طلحة الانصاري يعوده فوجد عنده سهل بن حنيف فامر ابو طلحة انسانا ينزع نمطا تحته فقال له سهل لم تنزع قال لان فيه تصاوير وقد قال فيها رسول الله صلى الله عليه وسلم ما قد علمت . قال الم يقل \" الا ما كان رقما في ثوب \" . قال بلى ولكنه اطيب لنفسي",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5349-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5349-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5349-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b087",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5350,
      "bookHadithIndex": 311,
      "text": "اخبرنا عيسى بن حماد، قال حدثنا الليث، قال حدثني بكير، عن بسر بن سعيد، عن زيد بن خالد، عن ابي طلحة، ان رسول الله صلى الله عليه وسلم قال \" لا تدخل الملايكة بيتا فيه صورة \" . قال بسر ثم اشتكى زيد فعدناه فاذا على بابه ستر فيه صورة قلت لعبيد الله الخولاني الم يخبرنا زيد عن الصورة يوم الاول قال قال عبيد الله الم تسمعه يقول \" الا رقما في ثوب",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5350-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5350-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5350-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b088",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5351,
      "bookHadithIndex": 312,
      "text": "حدثنا مسعود بن جويرية، قال حدثنا وكيع، عن هشام، عن قتادة، عن سعيد بن المسيب، عن علي، قال صنعت طعاما فدعوت النبي صلى الله عليه وسلم فجاء فدخل فراى سترا فيه تصاوير فخرج وقال \" ان الملايكة لا تدخل بيتا فيه تصاوير",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5351-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5351-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5351-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b089",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5352,
      "bookHadithIndex": 313,
      "text": "اخبرنا اسحاق بن ابراهيم، قال حدثنا ابو معاوية، قال حدثنا هشام بن عروة، عن ابيه، عن عايشة، قالت خرج رسول الله صلى الله عليه وسلم خرجة ثم دخل وقد علقت قراما فيه الخيل اولات الاجنحة - قالت - فلما راه قال \" انزعيه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5352-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5352-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5352-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b08a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5353,
      "bookHadithIndex": 314,
      "text": "اخبرنا محمد بن عبد الله بن بزيع، قال حدثنا يزيد بن زريع، قال حدثنا داود بن ابي هند، قال حدثنا عزرة، عن حميد بن عبد الرحمن، عن سعد بن هشام، عن عايشة، زوج النبي صلى الله عليه وسلم قالت كان لنا ستر فيه تمثال طير مستقبل البيت اذا دخل الداخل فقال رسول الله صلى الله عليه وسلم \" يا عايشة حوليه فاني كلما دخلت فرايته ذكرت الدنيا \" . قالت وكان لنا قطيفة لها علم فكنا نلبسها فلم نقطعه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5353-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5353-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5353-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b08b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5354,
      "bookHadithIndex": 315,
      "text": "اخبرنا محمد بن عبد الاعلى، قال حدثنا خالد، قال حدثنا شعبة، عن عبد الرحمن بن القاسم، عن القاسم، يحدث عن عايشة، قالت كان في بيتي ثوب فيه تصاوير فجعلته الى سهوة في البيت فكان رسول الله صلى الله عليه وسلم يصلي اليه ثم قال \" يا عايشة اخريه عني \" . فنزعته فجعلته وسايد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5354-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5354-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5354-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b08c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5355,
      "bookHadithIndex": 316,
      "text": "اخبرنا وهب بن بيان، قال حدثنا ابن وهب، قال حدثنا عمرو، قال حدثنا بكير، قال حدثني عبد الرحمن بن القاسم، ان اباه، حدثه عن عايشة، انها نصبت سترا فيه تصاوير فدخل رسول الله صلى الله عليه وسلم فنزعه فقطعته وسادتين . قال رجل في المجلس حينيذ يقال له ربيعة بن عطاء انا سمعت ابا محمد - يعني القاسم - عن عايشة قالت كان رسول الله صلى الله عليه وسلم يرتفق عليهما",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5355-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5355-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5355-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b08d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5356,
      "bookHadithIndex": 317,
      "text": "اخبرنا قتيبة، قال حدثنا سفيان، عن عبد الرحمن بن القاسم، عن ابيه، عن عايشة، قالت قدم رسول الله صلى الله عليه وسلم من سفر وقد سترت بقرام على سهوة لي فيه تصاوير فنزعه وقال \" اشد الناس عذابا يوم القيامة الذين يضاهون بخلق الله",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5356-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"

    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b091",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5360,
      "bookHadithIndex": 321,
      "text": "اخبرنا عمرو بن علي، قال حدثنا عفان، قال حدثنا همام، عن قتادة، عن عكرمة، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" من صور صورة كلف يوم القيامة ان ينفخ فيها الروح وليس بنافخ",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5360-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5360-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5360-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b092",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5361,
      "bookHadithIndex": 322,
      "text": "اخبرنا قتيبة، قال حدثنا حماد، عن ايوب، عن نافع، عن ابن عمر، ان النبي صلى الله عليه وسلم قال \" ان اصحاب هذه الصور الذين يصنعونها يعذبون يوم القيامة يقال لهم احيوا ما خلقتم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5361-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5361-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5361-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b093",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5362,
      "bookHadithIndex": 323,
      "text": "اخبرنا قتيبة، قال حدثنا الليث، عن نافع، عن القاسم، عن عايشة، زوج النبي صلى الله عليه وسلم ان رسول الله صلى الله عليه وسلم قال \" ان اصحاب هذه الصور يعذبون يوم القيامة ويقال لهم احيوا ما خلقتم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5362-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5362-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5362-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b094",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5363,
      "bookHadithIndex": 324,
      "text": "اخبرنا قتيبة، قال حدثنا ابو عوانة، عن سماك، عن القاسم بن محمد، عن عايشة، زوج النبي صلى الله عليه وسلم انها قالت ان اشد الناس عذابا يوم القيامة الذين يضاهون الله في خلقه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5363-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5363-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5363-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b095",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5364,
      "bookHadithIndex": 325,
      "text": "اخبرنا احمد بن حرب، قال حدثنا ابو معاوية، عن الاعمش، عن مسلم، ح وانبانا محمد بن يحيى بن محمد، قال حدثنا محمد بن الصباح، قال حدثنا اسماعيل بن زكريا، قال حدثنا حصين بن عبد الرحمن، عن مسلم بن صبيح، عن مسروق، عن عبد الله، قال قال رسول الله صلى الله عليه وسلم \" ان من اشد الناس عذابا يوم القيامة المصورون \" . وقال احمد \" المصورين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5364-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5364-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5364-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b096",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5365,
      "bookHadithIndex": 326,
      "text": "اخبرنا هناد بن السري، عن ابي بكر، عن ابي اسحاق، عن مجاهد، عن ابي هريرة، قال استاذن جبريل عليه السلام على النبي صلى الله عليه وسلم فقال \" ادخل \" . فقال كيف ادخل وفي بيتك ستر فيه تصاوير فاما ان تقطع رءوسها او تجعل بساطا يوطا فانا معشر الملايكة لا ندخل بيتا فيه تصاوير",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5365-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5365-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5365-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b097",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5366,
      "bookHadithIndex": 327,
      "text": "اخبرنا الحسن بن قزعة، عن سفيان بن حبيب، ومعتمر بن سليمان، عن اشعث، عن محمد بن سيرين، عن عبد الله بن شقيق، عن عايشة، قالت كان رسول الله صلى الله عليه وسلم لا يصلي في لحفنا . قال سفيان ملاحفنا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5366-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5366-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5366-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b098",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5367,
      "bookHadithIndex": 328,
      "text": "اخبرنا محمد بن معمر، قال حدثنا حبان، قال حدثنا همام، قال حدثنا قتادة، قال حدثنا انس، ان نعل، رسول الله صلى الله عليه وسلم كان لها قبالان",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5367-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5367-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5367-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b099",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5368,
      "bookHadithIndex": 329,
      "text": "اخبرنا عمرو بن علي، قال حدثنا صفوان بن عيسى، قال حدثنا هشام، عن محمد، عن عمرو بن اوس، قال كان لنعل رسول الله صلى الله عليه وسلم قبالان",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5368-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5368-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5368-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b09a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5369,
      "bookHadithIndex": 330,
      "text": "اخبرنا اسحاق بن ابراهيم، قال حدثنا محمد بن عبيد، قال حدثنا الاعمش، عن ابي صالح، عن ابي هريرة، عن النبي صلى الله عليه وسلم قال \" اذا انقطع شسع نعل احدكم فلا يمش في نعل واحدة حتى يصلحها",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5369-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5369-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5369-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b09b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5370,
      "bookHadithIndex": 331,
      "text": "اخبرنا اسحاق بن ابراهيم، قال اخبرنا ابو معاوية، قال حدثنا الاعمش، عن ابي رزين، قال رايت ابا هريرة يضرب بيده على جبهته يقول يا اهل العراق تزعمون اني اكذب على رسول الله صلى الله عليه وسلم اشهد لسمعت رسول الله صلى الله عليه وسلم يقول \" اذا انقطع شسع نعل احدكم فلا يمش في الاخرى حتى يصلحها",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5370-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5370-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5370-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b09c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5371,
      "bookHadithIndex": 332,
      "text": "اخبرنا محمد بن معمر، قال حدثنا محمد بن عمر بن ابي الوزير ابو مطرف، قال حدثنا محمد بن موسى، عن عبد الله بن ابي طلحة، عن انس بن مالك، ان النبي صلى الله عليه وسلم اضطجع على نطع فعرق فقامت ام سليم الى عرقه فنشفته فجعلته في قارورة فراها النبي صلى الله عليه وسلم قال \" ما هذا الذي تصنعين يا ام سليم \" . قالت اجعل عرقك في طيبي فضحك النبي صلى الله عليه وسلم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5371-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5371-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5371-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b09d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5372,
      "bookHadithIndex": 333,
      "text": "اخبرنا محمد بن قدامة، عن جرير، عن منصور، عن ابي وايل، عن سمرة بن سهم، - رجل من قومه - قال نزلت على ابي هاشم بن عتبة وهو طعين فاتاه معاوية يعوده فبكى ابو هاشم فقال معاوية ما يبكيك اوجع يشيزك ام على الدنيا فقد ذهب صفوها قال كل لا ولكن رسول الله صلى الله عليه وسلم عهد الى عهدا وددت اني كنت تبعته قال \" انه لعلك تدرك اموالا تقسم بين اقوام وانما يكفيك من ذلك خادم ومركب في سبيل الله \" . فادركت فجمعت",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5372-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5372-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5372-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b09e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5373,
      "bookHadithIndex": 334,
      "text": "اخبرنا عمران بن يزيد، قال حدثنا عيسى بن يونس، قال حدثنا عثمان بن حكيم، عن ابي امامة بن سهل، قال كانت قبيعة سيف رسول الله صلى الله عليه وسلم من فضة",
      "grades": [

        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b08e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5357,
      "bookHadithIndex": 318,
      "text": "اخبرنا اسحاق بن ابراهيم، وقتيبة بن سعيد، عن سفيان، عن الزهري، انه سمع القاسم بن محمد، يخبر عن عايشة، زوج النبي صلى الله عليه وسلم قالت دخل على رسول الله صلى الله عليه وسلم وقد سترت بقرام فيه تماثيل فلما راه تلون وجهه ثم هتكه بيده وقال \" ان اشد الناس عذابا يوم القيامة الذين يشبهون بخلق الله",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5357-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5357-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5357-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b08f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5358,
      "bookHadithIndex": 319,
      "text": "اخبرنا عمرو بن علي، قال حدثنا خالد، - وهو ابن الحارث - قال حدثنا سعيد بن ابي عروبة، عن النضر بن انس، قال كنت جالسا عند ابن عباس اتاه رجل من اهل العراق فقال اني اصور هذه التصاوير فما تقول فيها فقال ادنه ادنه سمعت محمدا صلى الله عليه وسلم يقول \" من صور صورة في الدنيا كلف يوم القيامة ان ينفخ فيها الروح وليس بنافخه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5358-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"

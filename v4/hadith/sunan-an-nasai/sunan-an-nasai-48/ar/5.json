        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b029",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5256,
      "bookHadithIndex": 217,
      "text": "اخبرنا اسحاق بن ابراهيم، عن اسماعيل، عن عبد العزيز، عن انس، قال نهى رسول الله صلى الله عليه وسلم ان يتزعفر الرجل",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5256-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5256-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5256-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b02a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5257,
      "bookHadithIndex": 218,
      "text": "اخبرنا محمد بن عمر بن علي بن مقدم، قال حدثنا زكريا بن يحيى بن عمارة الانصاري، عن عبد العزيز بن صهيب، عن انس، قال نهى رسول الله صلى الله عليه وسلم ان يزعفر الرجل جلده",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5257-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5257-alalbani",
          "name": "Al-Albani",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5257-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b02b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5258,
      "bookHadithIndex": 219,
      "text": "اخبرنا اسحاق، قال انبانا وكيع، قال حدثنا عزرة بن ثابت، عن ثمامة بن عبد الله بن انس، عن انس بن مالك، قال كان النبي صلى الله عليه وسلم اذا اتي بطيب لم يرده",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5258-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5258-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5258-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b02c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5259,
      "bookHadithIndex": 220,
      "text": "اخبرني عبيد الله بن فضالة بن ابراهيم، قال انبانا عبد الله بن يزيد المقري، قال حدثنا سعيد، قال حدثني عبيد الله بن ابي جعفر، عن الاعرج، عن ابي هريرة، عن رسول الله صلى الله عليه وسلم قال \" من عرض عليه طيب فلا يرده فانه خفيف المحمل طيب الرايحة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5259-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5259-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5259-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b02d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5260,
      "bookHadithIndex": 221,
      "text": "اخبرنا اسحاق بن ابراهيم، قال انبانا جرير، عن ابن عجلان، عن بكير، ح وانبانا عبيد الله بن سعيد، قال حدثنا يحيى، عن ابن عجلان، قال حدثني بكير بن عبد الله بن الاشج، عن بسر بن سعيد، عن زينب، امراة عبد الله قالت قال رسول الله صلى الله عليه وسلم \" اذا شهدت احداكن العشاء فلا تمس طيبا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5260-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5260-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5260-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b02e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5261,
      "bookHadithIndex": 222,
      "text": "اخبرنا احمد بن سعيد، قال حدثنا يعقوب بن ابراهيم، قال حدثنا ابي، عن صالح، عن محمد بن عبد الله بن عمرو بن هشام، عن بكير بن عبد الله بن الاشج، عن بسر بن سعيد، اخبرتني زينب الثقفية، امراة عبد الله ان رسول الله صلى الله عليه وسلم قال لها \" اذا خرجت الى العشاء فلا تمس طيبا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5261-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5261-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5261-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b02f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5262,
      "bookHadithIndex": 223,
      "text": "وحدثنا قتيبة، قال حدثنا الليث، عن ابن ابي جعفر، عن بكير بن عبد الله بن الاشج، عن بسر بن سعيد، عن زينب الثقفية، ان النبي صلى الله عليه وسلم قال \" ايتكن خرجت الى المسجد فلا تقربن طيبا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5262-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5262-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5262-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b030",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5263,
      "bookHadithIndex": 224,
      "text": "اخبرنا محمد بن هشام بن عيسى، قال حدثنا ابو علقمة الفروي عبد الله بن محمد، قال حدثني يزيد بن خصيفة، عن بسر بن سعيد، عن ابي هريرة، ان رسول الله صلى الله عليه وسلم قال \" ايما امراة اصابت بخورا فلا تشهد معنا العشاء الاخرة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5263-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5263-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5263-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b031",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5264,
      "bookHadithIndex": 225,
      "text": "اخبرنا ابو بكر بن اسحاق، قال حدثنا عبد الرحمن بن غزوان، قال انبانا شعبة، عن خليد بن جعفر، والمستمر، عن ابي نضرة، عن ابي سعيد، قال ذكر النبي صلى الله عليه وسلم امراة حشت خاتمها بالمسك فقال \" وهو اطيب الطيب",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5264-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5264-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5264-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b032",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5265,
      "bookHadithIndex": 226,
      "text": "اخبرنا عمرو بن علي، قال حدثنا يحيى، ويزيد، ومعتمر، وبشر بن المفضل، قالوا حدثنا عبيد الله، عن نافع، عن سعيد بن ابي هند، عن ابي موسى، ان رسول الله صلى الله عليه وسلم قال \" ان الله عز وجل احل لاناث امتي الحرير والذهب وحرمه على ذكورها",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5265-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5265-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5265-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b033",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5266,
      "bookHadithIndex": 227,
      "text": "اخبرنا محمد بن الوليد، قال حدثنا محمد، قال حدثنا شعبة، عن ابي بكر بن حفص، عن عبد الله بن حنين، عن ابن عباس، قال نهيت عن الثوب الاحمر، وخاتم الذهب، وان اقرا وانا راكع،",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5266-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5266-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5266-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b034",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5267,
      "bookHadithIndex": 228,
      "text": "اخبرنا يعقوب بن ابراهيم، قال حدثنا يحيى، عن ابن عجلان، قال اخبرني ابراهيم بن عبد الله بن حنين، عن ابيه، عن ابن عباس، عن علي، قال نهاني النبي صلى الله عليه وسلم عن خاتم الذهب وان اقرا القران وانا راكع وعن القسي وعن المعصفر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5267-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5267-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5267-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b035",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5268,
      "bookHadithIndex": 229,
      "text": "اخبرنا عيسى بن حماد، عن الليث، عن يزيد بن ابي حبيب، عن ابراهيم بن عبد الله بن حنين، ان اباه، حدثه انه، سمع عليا، يقول نهاني رسول الله صلى الله عليه وسلم عن خاتم الذهب وعن لبوس القسي والمعصفر وقراءة القران وانا راكع",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5268-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5268-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5268-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b036",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5269,
      "bookHadithIndex": 230,
      "text": "قال الحارث بن مسكين قراءة عليه وانا اسمع، عن ابن القاسم، حدثني مالك، عن نافع، عن ابراهيم بن عبد الله بن حنين، عن ابيه، عن علي، قال نهاني رسول الله صلى الله عليه وسلم عن القراءة في الركوع",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5269-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5269-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5269-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b037",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5270,
      "bookHadithIndex": 231,
      "text": "اخبرني هارون بن عبد الله، قال حدثنا عبد الصمد بن عبد الوارث، قال حدثنا حرب، عن يحيى، حدثني عمرو بن سعد الفدكي، ان نافعا، اخبره حدثني ابن حنين، ان عليا، حدثه قال نهاني رسول الله صلى الله عليه وسلم عن ثياب المعصفر وعن خاتم الذهب ولبس القسي وان اقرا وانا راكع",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5270-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5270-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5270-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b038",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5271,
      "bookHadithIndex": 232,
      "text": "اخبرنا يحيى بن درست، قال حدثنا ابو اسماعيل، قال حدثنا يحيى بن ابي كثير، ان محمد بن ابراهيم، حدثه عن ابن حنين، عن علي، قال نهاني رسول الله صلى الله عليه وسلم عن اربع عن لبس ثوب معصفر وعن التختم بخاتم الذهب وعن لبس القسية وان اقرا القران وانا راكع",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5271-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5271-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5271-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b039",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5272,
      "bookHadithIndex": 233,
      "text": "اخبرني ابراهيم بن يعقوب، قال حدثنا الحسن بن موسى، قال حدثنا شيبان، عن يحيى، اخبرني خالد بن معدان، ان ابن حنين، حدثه ان عليا قال ان رسول الله صلى الله عليه وسلم نهى عن ثياب المعصفر وعن الحرير وان يقرا وهو راكع وعن خاتم الذهب",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5272-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5272-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5272-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b03a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5273,
      "bookHadithIndex": 234,
      "text": "اخبرنا محمد بن المثنى، قال حدثنا محمد، قال حدثنا شعبة، عن قتادة، قال سمعت النضر بن انس، عن بشير بن نهيك، عن ابي هريرة، عن النبي صلى الله عليه وسلم انه نهى عن خاتم الذهب",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5273-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5273-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5273-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b03b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5274,
      "bookHadithIndex": 235,
      "text": "اخبرنا احمد بن حفص بن عبد الله، حدثني ابي قال، حدثني ابراهيم بن طهمان، عن الحجاج، - وهو ابن الحجاج - عن قتادة، عن عبد الملك بن عبيد، عن بشير بن نهيك، عن ابي هريرة، قال نهى رسول الله صلى الله عليه وسلم عن تختم الذهب",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5274-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5274-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5274-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b03c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5275,
      "bookHadithIndex": 236,
      "text": "اخبرنا علي بن حجر، عن اسماعيل، عن عبد الله بن دينار، عن ابن عمر، قال اتخذ رسول الله صلى الله عليه وسلم خاتم الذهب فلبسه رسول الله صلى الله عليه وسلم فاتخذ الناس خواتيم الذهب فقال رسول الله صلى الله عليه وسلم \" اني كنت البس هذا الخاتم واني لن البسه ابدا \" . فنبذه فنبذ الناس خواتيمهم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5275-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5275-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b03d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5276,
      "bookHadithIndex": 237,
      "text": "اخبرنا اسحاق بن ابراهيم، قال انبانا محمد بن بشر، قال حدثنا عبيد الله، عن نافع، عن ابن عمر، قال كان نقش خاتم رسول الله صلى الله عليه وسلم محمد رسول الله",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5276-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5276-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5276-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b03e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5277,
      "bookHadithIndex": 238,
      "text": "اخبرنا العباس بن عبد العظيم، قال حدثنا عثمان بن عمر، قال انبانا يونس، عن الزهري، عن انس، ان النبي صلى الله عليه وسلم اتخذ خاتما من ورق وفصه حبشي ونقشه محمد رسول الله",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5277-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5277-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5277-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b03f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5278,
      "bookHadithIndex": 239,
      "text": "اخبرنا حميد بن مسعدة، عن بشر، - وهو ابن المفضل - قال حدثنا شعبة، عن قتادة، عن انس، قال اراد رسول الله صلى الله عليه وسلم ان يكتب الى الروم فقالوا انهم لا يقرءون كتابا الا مختوما . فاتخذ خاتما من فضة كاني انظر الى بياضه في يده ونقش فيه محمد رسول الله",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5278-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5278-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b040",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5279,
      "bookHadithIndex": 240,
      "text": "اخبرنا قتيبة، قال حدثنا ابن وهب، عن يونس، عن الزهري، عن انس، ان رسول الله صلى الله عليه وسلم اتخذ خاتما من ورق وفصه حبشي",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5279-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5279-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5279-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b041",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5280,
      "bookHadithIndex": 241,
      "text": "اخبرنا القاسم بن زكريا، قال حدثنا عبيد الله، عن الحسن، - وهو ابن صالح - عن عاصم، عن حميد، عن انس، قال كان خاتم النبي صلى الله عليه وسلم من فضة وفصه منه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5280-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5280-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5280-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b042",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5281,
      "bookHadithIndex": 242,
      "text": "اخبرنا اسحاق بن ابراهيم، وعلي بن حجر، - واللفظ له - قالا حدثنا اسماعيل، عن عبد العزيز بن صهيب، عن انس، قال قال رسول الله صلى الله عليه وسلم \" قد اصطنعنا خاتما ونقشنا عليه نقشا فلا ينقش عليه احد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5281-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5281-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5281-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b043",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5282,
      "bookHadithIndex": 243,
      "text": "اخبرنا عمران بن موسى، قال حدثنا عبد الوارث، عن عبد العزيز، عن انس، ان النبي صلى الله عليه وسلم اصطنع خاتما فقال \" انا قد اتخذنا خاتما ونقشنا عليه نقشا فلا ينقش عليه احد \" . واني لارى بريقه في خنصر رسول الله صلى الله عليه وسلم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5282-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5282-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5282-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b044",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5283,
      "bookHadithIndex": 244,
      "text": "اخبرنا محمد بن عامر، قال حدثنا محمد بن عيسى، قال حدثنا عباد بن العوام، عن سعيد، عن قتادة، عن انس، ان النبي صلى الله عليه وسلم كان يتختم في يمينه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5283-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5283-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5283-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b045",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5284,
      "bookHadithIndex": 245,
      "text": "اخبرنا الحسين بن عيسى البسطامي، قال حدثنا سلم بن قتيبة، عن شعبة، عن قتادة، عن انس، قال كاني انظر الى بياض خاتم النبي صلى الله عليه وسلم في اصبعه اليسرى",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5284-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5284-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5284-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b046",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5285,
      "bookHadithIndex": 246,
      "text": "اخبرنا ابو بكر بن نافع، قال حدثنا بهز بن اسد، قال حدثنا حماد، قال حدثنا ثابت، انهم سالوا انسا عن خاتم، رسول الله صلى الله عليه وسلم قال كاني انظر الى وبيص خاتمه من فضة . ورفع اصبعه اليسرى الخنصر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5285-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5285-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5285-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b047",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5286,
      "bookHadithIndex": 247,
      "text": "اخبرنا محمد بن بشار، قال حدثنا محمد، قال حدثنا شعبة، عن عاصم بن كليب، عن ابي بردة، قال سمعت عليا، يقول نهاني نبي الله صلى الله عليه وسلم عن الخاتم في السبابة والوسطى",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5286-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5286-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5286-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b048",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5287,
      "bookHadithIndex": 248,
      "text": "اخبرنا هناد بن السري، عن ابي الاحوص، عن عاصم بن كليب، عن ابي بردة، عن علي، قال نهاني رسول الله صلى الله عليه وسلم ان البس في اصبعي هذه وفي الوسطى والتي تليها",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5287-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5287-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5287-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b049",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5288,
      "bookHadithIndex": 249,
      "text": "اخبرنا محمد بن عبد الله بن يزيد، قال حدثنا سفيان، عن ايوب بن موسى، عن نافع، عن ابن عمر، قال كان النبي صلى الله عليه وسلم يتختم بخاتم من ذهب ثم طرحه ولبس خاتما من ورق ونقش عليه محمد رسول الله ثم قال \" لا ينبغي لاحد ان ينقش على نقش خاتمي هذا \" . وجعل فصه في بطن كفه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5288-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5288-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5288-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b04a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5289,
      "bookHadithIndex": 250,
      "text": "اخبرنا محمد بن علي بن حرب، قال حدثنا عثمان بن عمر، قال حدثنا مالك بن مغول، عن سليمان الشيباني، عن سعيد بن جبير، عن ابن عباس، ان رسول الله صلى الله عليه وسلم اتخذ خاتما فلبسه قال \" شغلني هذا عنكم منذ اليوم اليه نظرة واليكم نظرة \" . ثم القاه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5289-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad"

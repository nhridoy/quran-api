          "name": "Al-Albani",
          "grade": "Sahih Muquf"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5184-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0afe2",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5185,
      "bookHadithIndex": 146,
      "text": "It was narrated that 'Abidah said:\"He forbade red Al-Mayathir, and gold rings",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5185-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Maqtu"
        },
        {

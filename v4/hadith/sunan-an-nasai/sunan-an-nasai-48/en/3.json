    },
    {
      "id": "69b6c6d6dd1a4c9c86f0afdf",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5182,
      "bookHadithIndex": 143,
      "text": "It was narrated that 'Ali said:\"The Messenger of Allah [SAW] forbade\" and he quoted the same Hadith",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5182-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "-"

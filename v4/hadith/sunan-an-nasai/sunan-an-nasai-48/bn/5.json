        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b043",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5282,
      "bookHadithIndex": 243,
      "text": "ইমরান ইবন মূসা (রহঃ) ... আনাস (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম একটি আংটি তৈরি করালেন এবং বললেনঃ আমি একটি আংটি তৈরি করিয়েছি এবং তার উপর নকশাও করিয়েছি; অতএব কেউ যেন ঐরূপ নকশা না করায়। আর আমি এখনও যেন ঐ আংটির ঔজ্জ্বল্য তাঁর কনিষ্ঠা আঙ্গুলে দেখছি।",
      "grades": [

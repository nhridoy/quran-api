      "bookIndex": 48,
      "hadithIndex": 5249,
      "bookHadithIndex": 210,
      "text": "উবায়দুল্লাহ ইবন সাঈদ (রহঃ) ... ইবন উমর (রাঃ) থেকে বর্ণিত যে, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম চুলে (পরচুলা) যোজনা করে এমন মহিলার উপর লা'নত করেছেন।",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5249-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {

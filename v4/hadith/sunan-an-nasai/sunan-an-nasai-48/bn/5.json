      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 48,
      "hadithIndex": 5241,
      "bookHadithIndex": 202,
      "text": "ইসহাক ইবন ইবরাহীম (রহঃ) ... আবু সালামা এবং সুলায়মান ইবন ইয়াসার (রহঃ), তাঁরা উভয়ে আবু হুরায়রা (রাঃ)-কে বলতে শুনেছেন, রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ ইয়াহুদী-নাসারা চুলে রং করে না, অতএব তোমরা তাদের বিরোধিতা করবে।",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-48-5241-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },

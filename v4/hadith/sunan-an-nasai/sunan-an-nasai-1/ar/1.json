    },
    {
      "id": "69b6c5dbdd1a4c9c86f09b9d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 2,
      "bookHadithIndex": 2,
      "text": "اخبرنا اسحاق بن ابراهيم، وقتيبة بن سعيد، عن جرير، عن منصور، عن ابي وايل، عن حذيفة، قال كان رسول الله صلى الله عليه وسلم اذا قام من الليل يشوص فاه بالسواك",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-2-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-2-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-2-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09b9e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 3,
      "bookHadithIndex": 3,
      "text": "اخبرنا احمد بن عبدة، قال حدثنا حماد بن زيد، قال اخبرنا غيلان بن جرير، عن ابي بردة، عن ابي موسى، قال دخلت على رسول الله صلى الله عليه وسلم وهو يستن وطرف السواك على لسانه وهو يقول \" عاعا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-3-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-3-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-3-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09b9f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 4,
      "bookHadithIndex": 4,
      "text": "اخبرنا عمرو بن علي، حدثنا يحيى، - وهو ابن سعيد - قال حدثنا قرة بن خالد، قال حدثنا حميد بن هلال، قال حدثني ابو بردة، عن ابي موسى، قال اقبلت الى النبي صلى الله عليه وسلم ومعي رجلان من الاشعريين احدهما عن يميني والاخر عن يساري ورسول الله صلى الله عليه وسلم يستاك فكلاهما سال العمل قلت والذي بعثك بالحق نبيا ما اطلعاني على ما في انفسهما وما شعرت انهما يطلبان العمل فكاني انظر الى سواكه تحت شفته قلصت فقال \" انا لا - او لن - نستعين على العمل من اراده ولكن اذهب انت \" . فبعثه على اليمن ثم اردفه معاذ بن جبل رضى الله عنهما",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-4-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-4-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-4-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09ba0",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 5,
      "bookHadithIndex": 5,
      "text": "اخبرنا حميد بن مسعدة، ومحمد بن عبد الاعلى، عن يزيد، - وهو ابن زريع - قال حدثني عبد الرحمن بن ابي عتيق، قال حدثني ابي قال، سمعت عايشة، عن النبي صلى الله عليه وسلم قال \" السواك مطهرة للفم مرضاة للرب",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-5-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-5-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-5-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09ba1",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 6,
      "bookHadithIndex": 6,
      "text": "اخبرنا حميد بن مسعدة، وعمران بن موسى، قالا حدثنا عبد الوارث، قال حدثنا شعيب بن الحبحاب، عن انس بن مالك، قال قال رسول الله صلى الله عليه وسلم \" قد اكثرت عليكم في السواك",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-6-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-6-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-6-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09ba2",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 7,
      "bookHadithIndex": 7,
      "text": "اخبرنا قتيبة بن سعيد، عن مالك، عن ابي الزناد، عن الاعرج، عن ابي هريرة، ان رسول الله صلى الله عليه وسلم قال \" لولا ان اشق على امتي لامرتهم بالسواك عند كل صلاة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-7-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-7-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-7-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09ba3",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 8,
      "bookHadithIndex": 8,
      "text": "اخبرنا علي بن خشرم، قال حدثنا عيسى، - وهو ابن يونس - عن مسعر، عن المقدام، - وهو ابن شريح - عن ابيه، قال قلت لعايشة باى شىء كان يبدا النبي صلى الله عليه وسلم اذا دخل بيته قالت بالسواك",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-8-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-8-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-8-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09ba4",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 9,
      "bookHadithIndex": 9,
      "text": "اخبرنا الحارث بن مسكين، قراءة عليه وانا اسمع، عن ابن وهب، عن يونس، عن ابن شهاب، عن سعيد بن المسيب، عن ابي هريرة، عن رسول الله صلى الله عليه وسلم قال \" الفطرة خمس الاختتان والاستحداد وقص الشارب وتقليم الاظفار ونتف الابط",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-9-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-9-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-9-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09ba5",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 10,
      "bookHadithIndex": 10,
      "text": "اخبرنا محمد بن عبد الاعلى، قال حدثنا المعتمر، قال سمعت معمرا، عن الزهري، عن سعيد بن المسيب، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" خمس من الفطرة قص الشارب ونتف الابط وتقليم الاظفار والاستحداد والختان",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-10-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },

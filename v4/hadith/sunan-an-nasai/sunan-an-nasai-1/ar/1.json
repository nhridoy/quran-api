      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09ba8",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 13,
      "bookHadithIndex": 13,
      "text": "اخبرنا علي بن حجر، قال انبانا عبيدة بن حميد، عن يوسف بن صهيب، عن حبيب بن يسار، عن زيد بن ارقم، قال قال رسول الله صلى الله عليه وسلم \" من لم ياخذ شاربه فليس منا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-13-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-13-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-13-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09ba9",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 14,
      "bookHadithIndex": 14,
      "text": "اخبرنا قتيبة، قال حدثنا جعفر، - هو ابن سليمان - عن ابي عمران الجوني، عن انس بن مالك، قال وقت لنا رسول الله صلى الله عليه وسلم في قص الشارب وتقليم الاظفار وحلق العانة ونتف الابط ان لا نترك اكثر من اربعين يوما . وقال مرة اخرى اربعين ليلة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-14-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-14-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-14-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09baa",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 15,
      "bookHadithIndex": 15,
      "text": "اخبرنا عبيد الله بن سعيد، قال حدثنا يحيى، - هو ابن سعيد - عن عبيد الله، اخبرني نافع، عن ابن عمر، عن النبي صلى الله عليه وسلم قال \" احفوا الشوارب واعفوا اللحى",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-15-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-15-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-15-zubairalizai",

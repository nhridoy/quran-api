          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09bc0",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 37,
      "bookHadithIndex": 37,
      "text": "اخبرنا محمود بن غيلان، حدثنا زيد بن الحباب، وقبيصة، قالا انبانا سفيان، عن الضحاك بن عثمان، عن نافع، عن ابن عمر، قال مر رجل على النبي صلى الله عليه وسلم وهو يبول فسلم عليه فلم يرد عليه السلام",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-37-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-37-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-37-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09bc1",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 38,
      "bookHadithIndex": 38,
      "text": "اخبرنا محمد بن بشار، قال حدثنا معاذ بن معاذ، قال انبانا سعيد، عن قتادة، عن الحسن، عن حضين ابي ساسان، عن المهاجر بن قنفذ، انه سلم على النبي صلى الله عليه وسلم وهو يبول فلم يرد عليه السلام حتى توضا فلما توضا رد عليه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-38-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-38-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-38-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09bc2",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 39,
      "bookHadithIndex": 39,
      "text": "اخبرنا احمد بن عمرو بن السرح، قال انبانا ابن وهب، قال اخبرني يونس، عن ابن شهاب، عن ابي عثمان بن سنة الخزاعي، عن عبد الله بن مسعود، ان رسول الله صلى الله عليه وسلم نهى ان يستطيب احدكم بعظم او روث",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-39-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-39-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-39-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09bc3",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 40,
      "bookHadithIndex": 40,
      "text": "اخبرنا يعقوب بن ابراهيم، قال حدثنا يحيى، - يعني ابن سعيد - عن محمد بن عجلان، قال اخبرني القعقاع، عن ابي صالح، عن ابي هريرة، عن النبي صلى الله عليه وسلم قال \" انما انا لكم مثل الوالد اعلمكم اذا ذهب احدكم الى الخلاء فلا يستقبل القبلة ولا يستدبرها ولا يستنج بيمينه \" وكان يامر بثلاثة احجار ونهى عن الروث والرمة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-40-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-40-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-40-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09bc4",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 41,
      "bookHadithIndex": 41,
      "text": "اخبرنا اسحاق بن ابراهيم، قال انبانا ابو معاوية، قال حدثنا الاعمش، عن ابراهيم، عن عبد الرحمن بن يزيد، عن سلمان، قال قال له رجل ان صاحبكم ليعلمكم حتى الخراءة . قال اجل نهانا ان نستقبل القبلة بغايط او بول او نستنجي بايماننا او نكتفي باقل من ثلاثة احجار",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-41-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-41-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-41-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09bc5",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 42,
      "bookHadithIndex": 42,
      "text": "اخبرنا احمد بن سليمان، قال حدثنا ابو نعيم، عن زهير، عن ابي اسحاق، قال ليس ابو عبيدة ذكره ولكن عبد الرحمن بن الاسود عن ابيه، انه سمع عبد الله، يقول اتى النبي صلى الله عليه وسلم الغايط وامرني ان اتيه بثلاثة احجار فوجدت حجرين والتمست الثالث فلم اجده فاخذت روثة فاتيت بهن النبي صلى الله عليه وسلم فاخذ الحجرين والقى الروثة وقال \" هذه ركس \" . قال ابو عبد الرحمن الركس طعام الجن",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-42-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-42-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-42-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09bc6",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 43,
      "bookHadithIndex": 43,
      "text": "اخبرنا اسحاق بن ابراهيم، قال انبانا جرير، عن منصور، عن هلال بن يساف، عن سلمة بن قيس، عن رسول الله صلى الله عليه وسلم قال \" اذا استجمرت فاوتر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-43-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-43-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-43-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09bc7",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 44,
      "bookHadithIndex": 44,
      "text": "اخبرنا قتيبة، قال حدثنا عبد العزيز بن ابي حازم، عن ابيه، عن مسلم بن قرط، عن عروة، عن عايشة، ان رسول الله صلى الله عليه وسلم قال \" اذا ذهب احدكم الى الغايط فليذهب معه بثلاثة احجار فليستطب بها فانها تجزي عنه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-44-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-44-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-44-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09bc8",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 45,
      "bookHadithIndex": 45,
      "text": "اخبرنا اسحاق بن ابراهيم، قال انبانا النضر، قال انبانا شعبة، عن عطاء بن ابي ميمونة، قال سمعت انس بن مالك، يقول كان رسول الله صلى الله عليه وسلم اذا دخل الخلاء احمل انا وغلام معي نحوي اداوة من ماء فيستنجي بالماء",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-45-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-45-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-45-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09bc9",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 46,
      "bookHadithIndex": 46,
      "text": "اخبرنا قتيبة، قال حدثنا ابو عوانة، عن قتادة، عن معاذة، عن عايشة، انها قالت مرن ازواجكن ان يستطيبوا بالماء فاني استحييهم منه ان رسول الله صلى الله عليه وسلم كان يفعله",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-46-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-46-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-46-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09bca",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 47,
      "bookHadithIndex": 47,
      "text": "اخبرنا اسماعيل بن مسعود، قال حدثنا خالد، قال انبانا هشام، عن يحيى، عن عبد الله بن ابي قتادة، عن ابي قتادة، ان رسول الله صلى الله عليه وسلم قال \" اذا شرب احدكم فلا يتنفس في انايه واذا اتى الخلاء فلا يمس ذكره بيمينه ولا يتمسح بيمينه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-47-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-47-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-47-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09bcb",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 48,
      "bookHadithIndex": 48,
      "text": "اخبرنا عبد الله بن محمد بن عبد الرحمن، قال حدثنا عبد الوهاب، عن ايوب، عن يحيى بن ابي كثير، عن ابن ابي قتادة، عن ابيه، ان النبي صلى الله عليه وسلم نهى ان يتنفس في الاناء وان يمس ذكره بيمينه وان يستطيب بيمينه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-48-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-48-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-48-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09bcc",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 49,
      "bookHadithIndex": 49,
      "text": "اخبرنا عمرو بن علي، وشعيب بن يوسف، واللفظ، له عن عبد الرحمن بن مهدي، عن سفيان، عن منصور، والاعمش، عن ابراهيم، عن عبد الرحمن بن يزيد، عن سلمان، قال قال المشركون انا لنرى صاحبكم يعلمكم الخراءة . قال اجل نهانا ان يستنجي احدنا بيمينه ويستقبل القبلة وقال \" لا يستنجي احدكم بدون ثلاثة احجار",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-49-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"

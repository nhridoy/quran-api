    {
      "id": "69b6c5dbdd1a4c9c86f09bbf",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 36,
      "bookHadithIndex": 36,
      "text": "اخبرنا علي بن حجر، قال انبانا ابن المبارك، عن معمر، عن الاشعث بن عبد الله، عن الحسن، عن عبد الله بن مغفل، عن النبي صلى الله عليه وسلم قال \" لا يبولن احدكم في مستحمه فان عامة الوسواس منه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-36-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {

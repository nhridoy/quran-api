    {
      "id": "69b6c5dbdd1a4c9c86f09bae",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 19,
      "bookHadithIndex": 19,
      "text": "اخبرنا اسحاق بن ابراهيم، قال انبانا اسماعيل، عن عبد العزيز بن صهيب، عن انس بن مالك، قال كان رسول الله صلى الله عليه وسلم اذا دخل الخلاء قال \" اللهم اني اعوذ بك من الخبث والخبايث",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-19-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-19-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {

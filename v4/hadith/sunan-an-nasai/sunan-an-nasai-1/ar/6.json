    },
    {
      "id": "69b6c5dbdd1a4c9c86f09ca7",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 268,
      "bookHadithIndex": 269,
      "text": "اخبرنا اسحاق بن منصور، قال اخبرنا يحيى، قال حدثنا مسعر، قال حدثني واصل، عن ابي وايل، عن حذيفة، ان النبي صلى الله ع��يه وسلم لقيه وهو جنب . فاهوى الى فقلت اني جنب فقال \" ان المسلم لا ينجس",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-268-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-268-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-268-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09ca8",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 269,
      "bookHadithIndex": 270,
      "text": "اخبرنا حميد بن مسعدة، قال حدثنا بشر، - وهو ابن المفضل - قال حدثنا حميد، عن بكر، عن ابي رافع، عن ابي هريرة، ان النبي صلى الله عليه وسلم لقيه في طريق من طرق المدينة وهو جنب فانسل عنه فاغتسل ففقده النبي صلى الله عليه وسلم فلما جاء قال \" اين كنت يا ابا هريرة \" . قال يا رسول الله انك لقيتني وانا جنب فكرهت ان اجالسك حتى اغتسل . فقال \" سبحان الله ان المومن لا ينجس",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-269-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-269-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-269-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09ca9",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 270,
      "bookHadithIndex": 271,
      "text": "اخبرنا محمد بن المثنى، قال حدثنا يحيى بن سعيد، عن يزيد بن كيسان، قال حدثني ابو حازم، قال قال ابو هريرة بينما رسول الله صلى الله عليه وسلم في المسجد اذ قال \" يا عايشة ناوليني الثوب \" . فقالت اني لا اصلي . قال \" انه ليس في يدك \" . فناولته",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-270-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-270-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-270-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09caa",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 271,
      "bookHadithIndex": 272,
      "text": "اخبرنا قتيبة بن سعيد، عن عبيدة، عن الاعمش، ح واخبرنا اسحاق بن ابراهيم، قال حدثنا جرير، عن الاعمش، عن ثابت بن عبيد، عن القاسم بن محمد، عن عايشة، - رضى الله عنها - قالت قال رسول الله صلى الله عليه وسلم \" ناوليني الخمرة من المسجد \" . قالت اني حايض . فقال رسول الله صلى الله عليه وسلم \" ليست حيضتك في يدك",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-271-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-271-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-271-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cab",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 272,
      "bookHadithIndex": 273,
      "text": "اخبرنا اسحاق بن ابراهيم، قال حدثنا ابو معاوية، عن الاعمش، بهذا الاسناد مثله",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-272-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-272-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cac",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 273,
      "bookHadithIndex": 274,
      "text": "اخبرنا محمد بن منصور، عن سفيان، عن منبوذ، عن امه، ان ميمونة، قالت كان رسول الله صلى الله عليه وسلم يضع راسه في حجر احدانا فيتلو القران وهي حايض وتقوم احدانا بالخمرة الى المسجد فتبسطها وهي حايض",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-273-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-273-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-273-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cad",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 274,
      "bookHadithIndex": 275,
      "text": "اخبرنا اسحاق بن ابراهيم، وعلي بن حجر، - واللفظ له - انبانا سفيان، عن منصور، عن امه، عن عايشة، - رضى الله عنها - قالت كان راس رسول الله صلى الله عليه وسلم في حجر احدانا وهي حايض وهو يتلو القران",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-274-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-274-alalbani",

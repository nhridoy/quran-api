      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cb8",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 285,
      "bookHadithIndex": 286,
      "text": "اخبرنا قتيبة، قال حدثنا ابو الاحوص، عن ابي اسحاق، عن عمرو بن شرحبيل، عن عايشة، قالت كان رسول الله صلى الله عليه وسلم يامر احدانا اذا كانت حايضا ان تشد ازارها ثم يباشرها",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-285-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-285-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cb9",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 286,
      "bookHadithIndex": 287,
      "text": "اخبرنا اسحاق بن ابراهيم، قال انبانا جرير، عن منصور، عن ابراهيم، عن الاسود، عن عايشة، قالت كانت احدانا اذا حاضت امرها رسول الله صلى الله عليه وسلم ان تتزر ثم يباشرها",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-286-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-286-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cba",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 287,
      "bookHadithIndex": 288,
      "text": "اخبرنا الحارث بن مسكين، قراءة عليه وانا اسمع، عن ابن وهب، عن يونس، والليث، عن ابن شهاب، عن حبيب، مولى عروة عن بدية، - وكان الليث يقول ندبة - مولاة ميمونة عن ميمونة قالت كان رسول الله صلى الله عليه وسلم يباشر المراة من نسايه وهي حايض اذا كان عليها ازار يبلغ انصاف الفخذين والركبتين . في حديث الليث محتجزة به",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-287-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-287-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-287-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cbb",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 288,
      "bookHadithIndex": 289,
      "text": "اخبرنا اسحاق بن ابراهيم، قال حدثنا سليمان بن حرب، قال حدثنا حماد بن سلمة، عن ثابت، عن انس، قال كانت اليهود اذا حاضت المراة منهم لم يواكلوهن ولم يشاربوهن ولم يجامعوهن في البيوت فسالوا نبي الله صلى الله عليه وسلم عن ذلك فانزل الله عز وجل { ويسالونك عن المحيض قل هو اذى } الاية فامرهم رسول الله صلى الله عليه وسلم ان يواكلوهن ويشاربوهن ويجامعوهن في البيوت وان يصنعوا بهن كل شىء ما خلا الجماع",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-288-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-288-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cbc",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 289,
      "bookHadithIndex": 290,
      "text": "اخبرنا عمرو بن علي، قال حدثنا يحيى، عن شعبة، عن الحكم، عن عبد الحميد، عن مقسم، عن ابن عباس، عن النبي صلى الله عليه وسلم في الرجل ياتي امراته وهي حايض يتصدق بدينار او بنصف دينار",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-289-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-289-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-289-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cbd",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 290,
      "bookHadithIndex": 291,
      "text": "اخبرنا اسحاق بن ابراهيم، قال انبانا سفيان، عن عبد الرحمن بن القاسم، عن ابيه، عن عايشة، قالت خرجنا مع رسول الله صلى الله عليه وسلم لا نرى الا الحج فلما كان بسرف حضت فدخل على رسول الله صلى الله عليه وسلم وانا ابكي فقال \" ما لك انفست \" . فقلت نعم . قال \" هذا امر كتبه الله عز وجل على بنات ادم فاقضي ما يقضي الحاج غير ان لا تطوفي بالبيت \" . وضحى رسول الله صلى الله عليه وسلم عن نسايه بالبقر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-290-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-290-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-290-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cbe",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 291,
      "bookHadithIndex": 292,
      "text": "اخبرنا عمرو بن علي، ومحمد بن المثنى، ويعقوب بن ابراهيم، - واللفظ له - قالوا حدثنا يحيى بن سعيد، قال حدثنا جعفر بن محمد، قال حدثني ابي قال، اتينا جابر بن عبد الله فسالناه عن حجة النبي، صلى الله عليه وسلم فحدثنا ان رسول الله صلى الله عليه وسلم خرج لخمس بقين من ذي القعدة وخرجنا معه حتى اذا اتى ذا الحليفة ولدت اسماء بنت عميس محمد بن ابي بكر فارسلت الى رسول الله صلى الله عليه وسلم كيف اصنع قال \" اغتسلي واستثفري ثم اهلي",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-291-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-291-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-291-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cbf",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 292,
      "bookHadithIndex": 293,
      "text": "اخبرنا عبيد الله بن سعيد، قال حدثنا يحيى بن سعيد، عن سفيان، قال حدثني ابو المقدام، ثابت الحداد عن عدي بن دينار، قال سمعت ام قيس بنت محصن، انها سالت رسول الله صلى الله عليه وسلم عن دم الحيض يصيب الثوب قال \" حكيه بضلع واغسليه بماء وسدر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-292-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-292-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-292-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cc0",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 293,
      "bookHadithIndex": 294,
      "text": "اخبرنا يحيى بن حبيب بن عربي، عن حماد بن زيد، عن هشام بن عروة، عن فاطمة بنت المنذر، عن اسماء بنت ابي بكر، وكانت، تكون في حجرها ان امراة استفتت النبي صلى الله عليه وسلم عن دم الحيض يصيب الثوب فقال \" حتيه ثم اقرصيه بالماء ثم انضحيه وصلي فيه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-293-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-293-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-293-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cc1",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 294,
      "bookHadithIndex": 295,
      "text": "اخبرنا عيسى بن حماد، قال حدثنا الليث، عن يزيد بن ابي حبيب، عن سويد بن قيس، عن معاوية بن حديج، عن معاوية بن ابي سفيان، انه سال ام حبيبة زوج النبي صلى الله عليه وسلم هل كان رسول الله صلى الله عليه وسلم يصلي في الثوب الذي كان يجامع فيه قالت نعم اذا لم ير فيه اذى",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-294-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-294-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-294-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cc2",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 295,
      "bookHadithIndex": 296,
      "text": "اخبرنا سويد بن نصر، قال انبانا عبد الله، عن عمرو بن ميمون الجزري، عن سليمان بن يسار، عن عايشة، قالت كنت اغسل الجنابة من ثوب رسول الله صلى الله عليه وسلم فيخرج الى الصلاة وان بقع الماء لفي ثوبه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-295-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-295-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-295-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cc3",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 296,
      "bookHadithIndex": 297,
      "text": "اخبرنا قتيبة، قال حدثنا حماد، عن ابي هاشم، عن ابي مجلز، عن الحارث بن نوفل، عن عايشة، قالت كنت افرك الجنابة - وقالت مرة اخرى المني - من ثوب رسول الله صلى الله عليه وسلم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-296-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-296-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-296-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cc4",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 297,
      "bookHadithIndex": 298,
      "text": "اخبرنا عمرو بن يزيد، قال حدثنا بهز، قال حدثنا شعبة، قال الحكم اخبرني عن ابراهيم، عن همام بن الحارث، ان عايشة، قالت لقد رايتني وما ازيد على ان افركه من ثوب رسول الله صلى الله عليه وسلم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-297-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-297-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-297-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cc5",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 298,
      "bookHadithIndex": 299,
      "text": "اخبرنا الحسين بن حريث، انبانا سفيان، عن منصور، عن ابراهيم، عن همام، عن عايشة، قالت كنت افركه من ثوب النبي صلى الله عليه وسلم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-298-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-298-alalbani",

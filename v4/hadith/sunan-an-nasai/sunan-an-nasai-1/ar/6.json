      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09ca6",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 267,
      "bookHadithIndex": 268,
      "text": "اخبرنا اسحاق بن ابراهيم، قال انبانا جرير، عن الشيباني، عن ابي بردة، عن حذيفة، قال كان رسول الله صلى الله عليه وسلم اذا لقي الرجل من اصحابه ماسحه ودعا له - قال - فرايته يوما بكرة فحدت عنه ثم اتيته حين ارتفع النهار فقال \" اني رايتك فحدت عني \" . فقلت اني كنت جنبا فخشيت ان تمسني . فقال رسول الله صلى الله عليه وسلم \" ان المسلم لا ينجس",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-267-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-267-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-267-zubairalizai",

          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-298-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cc6",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 299,
      "bookHadithIndex": 300,
      "text": "اخبرنا شعيب بن يوسف، عن يحيى بن سعيد، عن الاعمش، عن ابراهيم، عن همام، عن عايشة، قالت كنت اراه في ثوب رسول الله صلى الله عليه وسلم فاحكه",
      "grades": [
        {

      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09caf",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 276,
      "bookHadithIndex": 277,
      "text": "اخبرنا محمد بن سلمة، قال حدثنا ابن وهب، عن عمرو بن الحارث، وذكر، اخر عن ابي الاسود، عن عروة، عن عايشة، - رضى الله عنها - قالت كان رسول الله صلى الله عليه وسلم يخرج الى راسه من المسجد وهو مجاور فاغسله وانا حايض",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-276-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-276-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-276-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cb0",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 277,
      "bookHadithIndex": 278,
      "text": "اخبرنا قتيبة بن سعيد، عن مالك، عن هشام بن عروة، عن ابيه، عن عايشة، - رضى الله عنها - قالت كنت ارجل راس رسول الله صلى الله عليه وسلم وانا حايض",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-277-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-277-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-277-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cb1",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 278,
      "bookHadithIndex": 279,
      "text": "اخبرنا قتيبة بن سعيد، عن مالك، ح وانبانا علي بن شعيب، قال حدثنا معن، قال حدثنا مالك، عن الزهري، عن عروة، عن عايشة، - رضى الله عنها - مثل ذلك",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-278-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cb2",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 279,
      "bookHadithIndex": 280,
      "text": "اخبرنا قتيبة، قال حدثنا يزيد، - وهو ابن المقدام بن شريح بن هاني - عن ابيه، عن شريح، عن عايشة، رضى الله عنها سالتها هل تاكل المراة مع زوجها وهي طامث قالت نعم كان رسول الله صلى الله عليه وسلم يدعوني فاكل معه وانا عارك وكان ياخذ العرق فيقسم على فيه فاعترق منه ثم اضعه فياخذه فيعترق منه ويضع فمه حيث وضعت فمي من العرق ويدعو بالشراب فيقسم على فيه قبل ان يشرب منه فاخذه فاشرب منه ثم اضعه فياخذه فيشرب منه ويضع فمه حيث وضعت فمي من القدح",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-279-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-279-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-279-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cb3",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 280,
      "bookHadithIndex": 281,
      "text": "اخبرنا ايوب بن محمد الوزان، قال حدثنا عبد الله بن جعفر، قال حدثنا عبيد الله بن عمرو، عن الاعمش، عن المقدام بن شريح، عن ابيه، عن عايشة، - رضى الله عنها - قالت كان رسول الله صلى الله عليه وسلم يضع فاه على الموضع الذي اشرب منه فيشرب من فضل سوري وانا حايض",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-280-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-280-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-280-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cb4",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 281,
      "bookHadithIndex": 282,
      "text": "اخبرنا محمد بن منصور، قال حدثنا سفيان، عن مسعر، عن المقدام بن شريح، عن ابيه، قال سمعت عايشة، - رضى الله عنها - تقول كان رسول الله صلى الله عليه وسلم يناولني الاناء فاشرب منه وانا حايض ثم اعطيه فيتحرى موضع فمي فيضعه على فيه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-281-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-281-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-281-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cb5",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 282,
      "bookHadithIndex": 283,
      "text": "اخبرنا محمود بن غيلان، قال حدثنا وكيع، قال حدثنا مسعر، وسفيان، عن المقدام بن شريح، عن ابيه، عن عايشة، - رضى الله عنها - قالت كنت اشرب وانا حايض واناوله النبي صلى الله عليه وسلم فيضع فاه على موضع في فيشرب واتعرق العرق وانا حايض واناوله النبي صلى الله عليه وسلم فيضع فاه على موضع في",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-282-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-282-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-282-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cb6",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 283,
      "bookHadithIndex": 284,
      "text": "اخبرنا اسماعيل بن مسعود، قال حدثنا خالد، قال حدثنا هشام، ح وانبانا عبيد الله بن سعيد، واسحاق بن ابراهيم، قالا حدثنا معاذ بن هشام، - واللفظ له - قال حدثني ابي، عن يحيى، قال حدثنا ابو سلمة، ان زينب بنت ابي سلمة، حدثته ان ام سلمة حدثتها قالت، بينما انا مضطجعة، مع رسول الله صلى الله عليه وسلم في الخميلة اذ حضت فانسللت فاخذت ثياب حيضتي فقال رسول الله صلى الله عليه وسلم \" انفست \" . قلت نعم فدعاني فاضطجعت معه في الخميلة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-283-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-283-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-1-283-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c5dbdd1a4c9c86f09cb7",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 1,
      "hadithIndex": 284,
      "bookHadithIndex": 285,
      "text": "اخبرنا محمد بن المثنى، قال حدثنا يحيى بن سعيد، عن جابر بن صبح، قال سمعت خلاسا، يحدث عن عايشة، قالت كنت انا ورسول الله، صلى الله عليه وسلم نبيت في الشعار الواحد وانا طامث او حايض فان اصابه مني شىء غسل مكانه ولم يعده وصلى فيه ثم يعود فان اصابه مني شىء فعل مثل ذلك ولم يعده وصلى فيه",
      "grades": [

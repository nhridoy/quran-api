      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b129",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5512,
      "bookHadithIndex": 85,
      "text": "اخبرنا قتيبة، عن مالك، عن ابي الزبير، عن طاوس، عن عبد الله بن عباس، ان رسول الله صلى الله عليه وسلم كان يعلمهم هذا الدعاء كما يعلم السورة من القران \" قولوا اللهم انا نعوذ بك من عذاب جهنم واعوذ بك من عذاب القبر واعوذ بك من فتنة المسيح الدجال واعوذ بك من فتنة المحيا والممات",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5512-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5512-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5512-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b12a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5513,
      "bookHadithIndex": 86,
      "text": "اخبرنا محمد بن ميمون، عن سفيان، عن عمرو، عن طاوس، عن ابي هريرة، وابي الزناد، عن الاعرج، عن ابي هريرة، عن النبي صلى الله عليه وسلم قال \" عوذوا بالله عز وجل من عذاب الله عوذوا بالله من فتنة المحيا والممات ومن عذاب القبر ومن فتنة المسيح الدجال",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5513-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5513-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5513-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b12b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5514,
      "bookHadithIndex": 87,
      "text": "قال الحارث بن مسكين قراءة عليه وانا اسمع، عن ابن القاسم، عن مالك، عن ابي الزناد، عن الاعرج، عن ابي هريرة، ان رسول الله صلى الله عليه وسلم كان يدعو يقول في دعايه \" اللهم اني اعوذ بك من عذاب جهنم واعوذ بك من عذاب القبر واعوذ بك من فتنة المسيح الدجال واعوذ بك من فتنة المحيا والممات",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5514-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5514-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5514-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b12c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5515,
      "bookHadithIndex": 88,
      "text": "اخبرنا ابو عاصم، قال حدثنا القاسم بن كثير المقري، عن الليث بن سعد، عن يزيد بن ابي حبيب، عن سليمان بن يسار، انه سمع ابا هريرة، يقول سمعت رسول الله صلى الله عليه وسلم يقول في دعايه \" اللهم اني اعوذ بك من فتنة القبر وفتنة الدجال وفتنة المحيا والممات \" . قال ابو عبد الرحمن هذا خطا والصواب سليمان بن سنان",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5515-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5515-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5515-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b12d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5516,
      "bookHadithIndex": 89,
      "text": "اخبرنا محمد بن منصور، قال حدثنا سفيان، عن ابي الزناد، عن الاعرج، عن ابي هريرة، عن النبي صلى الله عليه وسلم قال \" عوذوا بالله من عذاب الله عوذوا بالله من عذاب القبر عوذوا بالله من فتنة المحيا والممات عوذوا بالله من فتنة المسيح الدجال",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5516-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5516-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5516-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b12e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5517,
      "bookHadithIndex": 90,
      "text": "اخبرنا اسحاق بن ابراهيم، قال انبانا ابو عامر العقدي، قال حدثنا شعبة، عن بديل بن ميسرة، عن عبد الله بن شقيق، عن ابي هريرة، قال كان رسول الله صلى الله عليه وسلم يتعوذ من عذاب جهنم وعذاب القبر والمسيح الدجال",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5517-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5517-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5517-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b12f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5518,
      "bookHadithIndex": 91,
      "text": "اخبرنا محمود بن خالد، قال حدثنا الوليد، قال حدثنا ابو عمرو، عن يحيى، انه حدثه قال اخبرني ابو سلمة، قال حدثني ابو هريرة، قال قال رسول الله صلى الله عليه وسلم \" تعوذوا بالله من عذاب النار وعذاب القبر ومن فتنة المحيا والممات ومن شر المسيح الدجال",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5518-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5518-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5518-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b130",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5519,
      "bookHadithIndex": 92,
      "text": "اخبرنا احمد بن حفص، قال حدثني ابي قال، حدثني ابراهيم، عن سفيان بن سعيد، عن ابي حسان، عن جسرة، عن عايشة، انها قالت قال رسول الله صلى الله عليه وسلم \" اللهم رب جبراييل وميكاييل ورب اسرافيل اعوذ بك من حر النار ومن عذاب القبر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5519-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5519-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5519-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b131",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5520,
      "bookHadithIndex": 93,
      "text": "اخبرنا عمرو بن سواد، قال حدثنا ابن وهب، قال حدثنا عمرو بن الحارث، عن يزيد بن ابي حبيب، عن سليمان بن سنان المزني، انه سمع ابا هريرة، يقول سمعت ابا القاسم، صلى الله عليه وسلم يقول في صلاته \" اللهم اني اعوذ بك من فتنة القبر ومن فتنة الدجال ومن فتنة المحيا والممات ومن حر جهنم \" . قال ابو عبد الرحمن هذا الصواب",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5520-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5520-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5520-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b132",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5521,
      "bookHadithIndex": 94,
      "text": "اخبرنا قتيبة، قال حدثنا ابو الاحوص، عن ابي اسحاق، عن بريد بن ابي مريم، عن انس بن مالك، قال قال رسول الله صلى الله عليه وسلم \" من سال الله الجنة ثلاث مرات قالت الجنة اللهم ادخله الجنة ومن استجار من النار ثلاث مرات قالت النار اللهم اجره من النار",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5521-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5521-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5521-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b133",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5522,
      "bookHadithIndex": 95,
      "text": "اخبرنا عمرو بن علي، قال حدثنا يزيد، - وهو ابن زريع - قال حدثنا حسين المعلم، عن عبد الله بن بريدة، عن بشير بن كعب، عن شداد بن اوس، عن النبي صلى الله عليه وسلم قال \" ان سيد الاستغفار ان يقول العبد اللهم انت ربي لا اله الا انت خلقتني وانا عبدك وانا على عهدك ووعدك ما استطعت اعوذ بك من شر ما صنعت ابوء لك بذنبي وابوء لك بنعمتك على فاغفر لي فانه لا يغفر الذنوب الا انت فان قالها حين يصبح موقنا بها فمات دخل الجنة وان قالها حين يمسي موقنا بها دخل الجنة \" . خالفه الوليد بن ثعلبة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5522-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5522-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5522-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b134",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5523,
      "bookHadithIndex": 96,
      "text": "اخبرنا يونس بن عبد الاعلى، عن ابن وهب، قال اخبرني موسى بن شيبة، عن الاوزاعي، عن عبدة بن ابي لبابة، ان ابن يساف، حدثه انه، سال عايشة زوج النبي صلى الله عليه وسلم ما كان اكثر ما يدعو به رسول الله صلى الله عليه وسلم قبل موته قالت كان اكثر ما كان يدعو به \" اللهم اني اعوذ بك من شر ما عملت ومن شر ما لم اعمل",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5523-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5523-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5523-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b135",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5524,
      "bookHadithIndex": 97,
      "text": "اخبرني عمران بن بكار، قال حدثنا ابو المغيرة، قال حدثنا الاوزاعي، قال حدثني عبدة، قال حدثني ابن يساف، قال سيلت عايشة ما كان اكثر ما كان يدعو به النبي صلى الله عليه وسلم قالت كان اكثر دعايه ان يقول \" اللهم اني اعوذ بك من شر ما عملت ومن شر ما لم اعمل بعد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5524-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5524-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5524-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b136",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5525,
      "bookHadithIndex": 98,
      "text": "اخبرني محمد بن قدامة، عن جرير، عن منصور، عن هلال بن يساف، عن فروة بن نوفل، قال سالت ام المومنين عايشة عما كان رسول الله صلى الله عليه وسلم يدعو قالت كان يقول \" اعوذ بك من شر ما عملت ومن شر ما لم اعمل",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5525-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5525-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5525-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b137",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5526,
      "bookHadithIndex": 99,
      "text": "اخبرنا هناد، عن ابي الاحوص، عن حصين، عن هلال، عن فروة بن نوفل، عن عايشة، قالت كان رسول الله صلى الله عليه وسلم يقول \" اللهم اني ا عوذ بك من شر ما عملت ومن شر ما لم اعمل",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5526-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5526-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5526-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b138",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5527,
      "bookHadithIndex": 100,
      "text": "اخبرنا محمد بن عبد الاعلى، قال حدثنا المعتمر، عن ابيه، عن حصين، عن هلال بن يساف، عن فروة بن نوفل، قال سالت عايشة فقلت حدثيني بشىء، كان رسول الله صلى الله عليه وسلم يدعو به قالت كان رسول الله صلى الله عليه وسلم يقول \" اللهم اني اعوذ بك من شر ما عملت ومن شر ما لم اعمل",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5527-abughuddah",
          "name": "Abu Ghuddah",

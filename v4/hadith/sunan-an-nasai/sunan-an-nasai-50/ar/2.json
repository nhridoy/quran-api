          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b108",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5479,
      "bookHadithIndex": 52,
      "text": "اخبرني هلال بن العلاء، قال حدثنا ابي قال، حدثنا عبيد الله، عن اسراييل، عن عبد الملك بن عمير، عن مصعب بن سعد، وعمرو بن ميمون الاودي، قالا كان سعد يعلم بنيه هولاء الكلمات كما يعلم المكتب الغلمان ويقول ان رسول الله صلى الله عليه وسلم كان يتعوذ بهن في دبر كل صلاة \" اللهم اني اعوذ بك من البخل واعوذ بك من الجبن واعوذ بك من ان ارد الى ارذل العمر واعوذ بك من فتنة الدنيا وعذاب القبر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5479-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5479-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5479-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b109",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5480,
      "bookHadithIndex": 53,
      "text": "اخبرنا احمد بن فضالة، عن عبيد الله، قال انبانا اسراييل، عن ابي اسحاق، عن عمرو بن ميمون، عن عمر، ان النبي صلى الله عليه وسلم كان يتعوذ من الجبن والبخل وسوء العمر وفتنة الصدر وعذاب القبر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5480-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5480-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5480-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b10a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5481,
      "bookHadithIndex": 54,
      "text": "اخبرنا سليمان بن سلم البلخي، - هو ابو داود المصاحفي - قال انبانا النضر، قال انبانا يونس، عن ابي اسحاق، عن عمرو بن ميمون، قال سمعت عمر بن الخطاب، يقول كان رسول الله صلى الله عليه وسلم يتعوذ من خمس \" اللهم اني اعوذ بك من الجبن والبخل وسوء العمر وفتنة الصدر وعذاب القبر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5481-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5481-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5481-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b10b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5482,
      "bookHadithIndex": 55,
      "text": "اخبرني هلال بن العلاء، قال حدثنا حسين، قال حدثنا زهير، قال حدثنا ابو اسحاق، عن عمرو بن ميمون، قال حدثني اصحاب، محمد صلى الله عليه وسلم ان رسول الله صلى الله عليه وسلم كان يتعوذ من الشح والجبن وفتنة الصدر وعذاب القبر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5482-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5482-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5482-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b10c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5483,
      "bookHadithIndex": 56,
      "text": "اخبرنا احمد بن سليمان، قال حدثنا ابو داود، عن سفيان، عن ابي اسحاق، عن عمرو بن ميمون، قال كان النبي صلى الله عليه وسلم يتعوذ مرسل",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5483-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "-"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5483-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b10d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5484,
      "bookHadithIndex": 57,
      "text": "اخبرني عبيد بن وكيع، قال حدثنا ابي، عن سعد بن اوس، عن بلال بن يحيى، عن شتير بن شكل بن حميد، عن ابيه، قال قلت يا رسول الله علمني دعاء انتفع به . قال \" قل اللهم عافني من شر سمعي وبصري ولساني وقلبي وشر منيي \" . يعني ذكره",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5484-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5484-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5484-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b10e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5485,
      "bookHadithIndex": 58,
      "text": "اخبرنا احمد بن عمرو بن السرح، قال حدثنا ابن وهب، قال اخبرني سالم بن غيلان، عن دراج ابي السمح، عن ابي الهيثم، عن ابي سعيد الخدري، عن رسول الله صلى الله عليه وسلم انه كان يقول \" اللهم اني اعوذ بك من الكفر والفقر \" . فقال رجل ويعدلان قال \" نعم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5485-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5485-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5485-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b10f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5486,
      "bookHadithIndex": 59,
      "text": "اخبرني محمد بن قدامة، قال حدثنا جرير، عن منصور، عن الشعبي، عن ام سلمة، ان النبي صلى الله عليه وسلم كان اذا خرج من بيته قال \" بسم الله رب اعوذ بك من ان ازل او اضل او اظلم او اظلم او اجهل او يجهل على",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5486-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5486-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5486-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b110",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5487,
      "bookHadithIndex": 60,
      "text": "اخبرنا احمد بن عمرو بن السرح، قال حدثني ابن وهب، قال اخبرني حيى بن عبد الله، قال حدثني ابو عبد الرحمن الحبلي، عن عبد الله بن عمرو بن العاص، ان رسول الله صلى الله عليه وسلم كان يدعو بهولاء الكلمات \" اللهم اني اعوذ بك من غلبة الدين وغلبة العدو وشماتة الاعداء",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5487-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5487-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5487-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b111",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5488,
      "bookHadithIndex": 61,
      "text": "اخبرنا يونس بن عبد الاعلى، قال انبانا ابن وهب، قال قال حيى حدثني ابو عبد الرحمن الحبلي، عن عبد الله بن عمرو، ان رسول الله صلى الله عليه وسلم كان يدعو بهولاء الكلمات \" اللهم اني اعوذ بك من غلبة الدين وشماتة الاعداء",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5488-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5488-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5488-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b112",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5489,
      "bookHadithIndex": 62,
      "text": "اخبرنا عبد الله بن محمد بن عبد الرحمن، قال حدثنا حماد بن مسعدة، عن هارون بن ابراهيم، عن محمد، عن عثمان بن ابي العاص، ان النبي صلى الله عليه وسلم كان يدعو بهذه الدعوات \" اللهم اني اعوذ بك من الكسل والهرم والجبن والعجز ومن فتنة المحيا والممات",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5489-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5489-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5489-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b113",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5490,
      "bookHadithIndex": 63,
      "text": "اخبرنا محمد بن عبد الله بن عبد الحكم، عن شعيب، عن الليث، عن يزيد بن الهاد، عن عمرو بن شعيب، عن ابيه، عن جده، قال سمعت رسول الله صلى الله عليه وسلم يقول \" اللهم اني اعوذ بك من الكسل والهرم والمغرم والماثم واعوذ بك من شر المسيح الدجال واعوذ بك من عذاب القبر واعوذ بك من عذاب النار",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5490-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5490-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5490-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b114",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5491,
      "bookHadithIndex": 64,
      "text": "اخبرنا اسحاق بن ابراهيم، قال انبانا سفيان، عن سمى، عن ابي صالح، ان شاء الله عن ابي هريرة، قال كان النبي صلى الله عليه وسلم يتعوذ من هذه الثلاثة من درك الشقاء وشماتة الاعداء وسوء القضاء وجهد البلاء . قال سفيان هو ثلاثة فذكرت اربعة لاني لا احفظ الواحد الذي ليس فيه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5491-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5491-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5491-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b115",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5492,
      "bookHadithIndex": 65,
      "text": "اخبرنا قتيبة، قال حدثنا سفيان، عن سمى، عن ابي صالح، عن ابي هريرة، ان النبي صلى الله عليه وسلم كان يستعيذ من سوء القضاء وشماتة الاعداء ودرك الشقاء وجهد البلاء",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5492-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5492-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5492-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b116",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5493,
      "bookHadithIndex": 66,
      "text": "اخبرنا محمد بن المثنى، قال حدثنا ابو داود، قال حدثنا همام، عن قتادة، عن انس، ان النبي صلى الله عليه وسلم كان يقول \" اللهم اني اعوذ بك من الجنون والجذام والبرص وسييء الاسقام",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5493-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5493-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5493-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c6d6dd1a4c9c86f0b117",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 50,
      "hadithIndex": 5494,
      "bookHadithIndex": 67,
      "text": "اخبرنا هلال بن العلاء، قال حدثنا سعيد بن سليمان، قال حدثنا عباد، عن الجريري، عن ابي نضرة، عن ابي سعيد، قال كان رسول الله صلى الله عليه وسلم يتعوذ من عين الجان وعين الانس فلما نزلت المعوذتان اخذ بهما وترك ما سوى ذلك",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-50-5494-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"

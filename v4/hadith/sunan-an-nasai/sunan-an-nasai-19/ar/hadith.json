    },
    {
      "id": "69b6c611dd1a4c9c86f0a1c2",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 19,
      "hadithIndex": 1573,
      "bookHadithIndex": 18,
      "text": "اخبرنا يعقوب بن ابراهيم، قال حدثنا ابن ابي زايدة، قال اخبرني اسماعيل بن ابي خالد، عن اخيه، عن ابي كاهل الاحمسي، قال رايت النبي صلى الله عليه وسلم يخطب على ناقة وحبشي اخذ بخطام الناقة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1573-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1573-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1573-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a1c3",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 19,
      "hadithIndex": 1574,
      "bookHadithIndex": 19,
      "text": "اخبرنا اسماعيل بن مسعود، قال حدثنا خالد، قال حدثنا شعبة، عن سماك، قال سالت جابرا اكان رسول الله صلى الله عليه وسلم يخطب قايما قال كان رسول الله صلى الله عليه وسلم يخطب قايما ثم يقعد قعدة ثم يقوم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1574-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1574-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1574-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a1c4",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 19,
      "hadithIndex": 1575,
      "bookHadithIndex": 20,
      "text": "اخبرنا عمرو بن علي، قال حدثنا يحيى بن سعيد، قال حدثنا عبد الملك بن ابي سليمان، قال حدثنا عطاء، عن جابر، قال شهدت الصلاة مع رسول الله صلى الله عليه وسلم في يوم عيد فبدا بالصلاة قبل الخطبة بغير اذان ولا اقامة فلما قضى الصلاة قام متوكيا على بلال فحمد الله واثنى عليه ووعظ الناس وذكرهم وحثهم على طاعته ثم مال ومضى الى النساء ومعه بلال فامرهن بتقوى الله ووعظهن وذكرهن وحمد الله واثنى عليه ثم حثهن على طاعته ثم قال \" تصدقن فان اكثركن حطب جهنم \" . فقالت امراة من سفلة النساء سفعاء الخدين بم يا رسول الله قال \" تكثرن الشكاة وتكفرن العشير \" . فجعلن ينزعن قلايدهن واقرطهن وخواتيمهن يقذفنه في ثوب بلال يتصدقن به",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1575-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1575-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1575-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a1c5",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 19,
      "hadithIndex": 1576,
      "bookHadithIndex": 21,
      "text": "اخبرنا قتيبة، قال حدثنا عبد العزيز، عن داود، عن عياض بن عبد الله، عن ابي سعيد الخدري، ان رسول الله صلى الله عليه وسلم كان يخرج يوم الفطر ويوم الاضحى الى المصلى فيصلي بالناس فاذا جلس في الثانية وسلم قام فاستقبل الناس بوجهه والناس جلوس فان كانت له حاجة يريد ان يبعث بعثا ذكره للناس والا امر الناس بالصدقة قال \" تصدقوا \" . ثلاث مرات فكان من اكثر من يتصدق النساء",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1576-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1576-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1576-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a1c6",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 19,
      "hadithIndex": 1577,
      "bookHadithIndex": 22,
      "text": "اخبرنا محمد بن سلمة، والحارث بن مسكين، قراءة عليه وانا اسمع، - واللفظ له - عن ابن القاسم، قال حدثني مالك، عن ابن شهاب، عن ابن المسيب، عن ابي هريرة، ان رسول الله صلى الله عليه وسلم قال \" اذا قلت لصاحبك انصت والامام يخطب فقد لغوت",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1577-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1577-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1577-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a1c7",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 19,
      "hadithIndex": 1578,
      "bookHadithIndex": 23,
      "text": "اخبرنا عتبة بن عبد الله، قال انبانا ابن المبارك، عن سفيان، عن جعفر بن محمد، عن ابيه، عن جابر بن عبد الله، قال كان رسول الله صلى الله عليه وسلم يقول في خطبته يحمد الله ويثني عليه بما هو اهله ثم يقول \" من يهده الله فلا مضل له ومن يضلله فلا هادي له ان اصدق الحديث كتاب الله واحسن الهدى هدى محمد وشر الامور محدثاتها وكل محدثة بدعة وكل بدعة ضلالة وكل ضلالة في النار \" . ثم يقول \" بعثت انا والساعة كهاتين \" . وكان اذا ذكر الساعة احمرت وجنتاه وعلا صوته واشتد غضبه كانه نذير جيش يقول \" صبحكم مساكم \" . ثم قال \" من ترك مالا فلاهله ومن ترك دينا او ضياعا فالى او على وانا اولى بالمومنين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1578-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1578-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1578-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a1c8",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 19,
      "hadithIndex": 1579,
      "bookHadithIndex": 24,
      "text": "اخبرنا عمرو بن علي، قال حدثنا يحيى، قال حدثنا داود بن قيس، قال حدثني عياض، عن ابي سعيد، ان رسول الله صلى الله عليه وسلم كان يخرج يوم العيد فيصلي ركعتين ثم يخطب فيامر بالصدقة فيكون اكثر من يتصدق النساء فان كانت له حاجة او اراد ان يبعث بعثا تكلم والا رجع",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1579-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1579-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1579-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a1c9",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 19,
      "hadithIndex": 1580,
      "bookHadithIndex": 25,
      "text": "اخبرنا علي بن حجر، قال حدثنا يزيد، - وهو ابن هارون - قال انبانا حميد، عن الحسن، ان ابن عباس، خطب بالبصرة فقال ادوا زكاة صومكم فجعل الناس ينظر بعضهم الى بعض فقال من ها هنا من اهل المدينة قوموا الى اخوانكم فعلموهم فانهم لا يعلمون ان رسول الله صلى الله عليه وسلم فرض صدقة الفطر على الصغير والكبير والحر والعبد والذكر والانثى نصف صاع من بر او صاعا من تمر او شعير",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1580-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1580-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1580-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a1ca",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 19,
      "hadithIndex": 1581,
      "bookHadithIndex": 26,
      "text": "اخبرنا قتيبة، قال حدثنا ابو الاحوص، عن منصور، عن الشعبي، عن البراء، قال خطبنا رسول الله صلى الله عليه وسلم يوم النحر بعد الصلاة ثم قال \" من صلى صلاتنا ونسك نسكنا فقد اصاب النسك ومن نسك قبل الصلاة فتلك شاة لحم \" . فقال ابو بردة بن نيار يا رسول الله والله لقد نسكت قبل ان اخرج الى الصلاة عرفت ان اليوم يوم اكل وشرب فتعجلت فاكلت واطعمت اهلي وجيراني . فقال رسول الله صلى الله عليه وسلم \" تلك شاة لحم \" . قال فان عندي جذعة خير من شاتى لحم فهل تجزي عني قال \" نعم ولن تجزي عن احد بعدك",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1581-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1581-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1581-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a1cb",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 19,
      "hadithIndex": 1582,
      "bookHadithIndex": 27,
      "text": "اخبرنا قتيبة، قال حدثنا ابو الاحوص، عن سماك، عن جابر بن سمرة، قال كنت اصلي مع النبي صلى الله عليه وسلم فكانت صلاته قصدا وخطبته قصدا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1582-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1582-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1582-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a1cc",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 19,
      "hadithIndex": 1583,
      "bookHadithIndex": 28,
      "text": "اخبرنا قتيبة، قال حدثنا ابو عوانة، عن سماك، عن جابر بن سمرة، قال رايت رسول الله صلى الله عليه وسلم يخطب قايما ثم يقعد قعدة لا يتكلم فيها ثم قام فخطب خطبة اخرى فمن خبرك ان النبي صلى الله عليه وسلم خطب قاعدا فلا تصدقه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1583-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1583-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1583-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a1cd",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 19,
      "hadithIndex": 1584,
      "bookHadithIndex": 29,
      "text": "اخبرنا محمد بن بشار، قال حدثنا عبد الرحمن، قال حدثنا سفيان، عن سماك، عن جابر بن سمرة، قال كان النبي صلى الله عليه وسلم يخطب قايما ثم يجلس ثم يقوم ويقرا ايات ويذكر الله وكانت خطبته قصدا وصلاته قصدا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1584-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1584-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1584-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a1ce",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 19,
      "hadithIndex": 1585,
      "bookHadithIndex": 30,
      "text": "اخبرنا يعقوب بن ابراهيم، قال حدثنا ابو تميلة، عن الحسين بن واقد، عن ابن بريدة، عن ابيه، قال بينا رسول الله صلى الله عليه وسلم على المنبر يخطب اذ اقبل الحسن والحسين عليهما السلام عليهما قميصان احمران يمشيان ويعثران فنزل وحملهما فقال \" صدق الله { انما اموالكم واولادكم فتنة } رايت هذين يمشيان ويعثران في قميصيهما فلم اصبر حتى نزلت فحملتهما",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1585-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1585-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1585-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a1cf",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 19,
      "hadithIndex": 1586,
      "bookHadithIndex": 31,
      "text": "اخبرنا عمرو بن علي، قال حدثنا يحيى، قال حدثنا سفيان، قال حدثنا عبد الرحمن بن عابس، قال سمعت ابن عباس، قال له رجل شهدت الخروج مع رسول الله صلى الله عليه وسلم قال نعم ولولا مكاني منه ما شهدته يعني من صغره اتى العلم الذي عند دار كثير بن الصلت فصلى ثم خطب ثم اتى النساء فوعظهن وذكرهن وامرهن ان يتصدقن فجعلت المراة تهوي بيدها الى حلقها تلقي في ثوب بلال",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1586-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {

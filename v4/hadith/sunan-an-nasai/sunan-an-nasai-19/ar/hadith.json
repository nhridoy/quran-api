      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a1d1",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 19,
      "hadithIndex": 1588,
      "bookHadithIndex": 33,
      "text": "اخبرنا اسماعيل بن مسعود، قال حدثنا حاتم بن وردان، عن ايوب، عن محمد بن سيرين، عن انس بن مالك، قال خطبنا رسول الله صلى الله عليه وسلم يوم اضحى وانكفا الى كبشين املحين فذبحهما",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1588-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1588-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1588-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a1d2",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 19,
      "hadithIndex": 1589,
      "bookHadithIndex": 34,
      "text": "اخبرنا محمد بن عبد الله بن عبد الحكم، عن شعيب، عن الليث، عن كثير بن فرقد، عن نافع، ان عبد الله بن عمر، اخبره ان رسول الله صلى الله عليه وسلم كان يذبح او ينحر بالمصلى",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1589-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1589-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1589-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a1d3",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 19,
      "hadithIndex": 1590,
      "bookHadithIndex": 35,
      "text": "اخبرني محمد بن قدامة، عن جرير، عن ابراهيم بن محمد بن المنتشر، قلت عن ابيه، قال نعم عن حبيب بن سالم، عن النعمان بن بشير، قال كان رسول الله صلى الله عليه وسلم يقرا في الجمعة والعيد ب { سبح اسم ربك الاعلى } و { هل اتاك حديث الغاشية } واذا اجتمع الجمعة والعيد في يوم قرا بهما",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1590-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1590-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1590-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a1d4",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 19,
      "hadithIndex": 1591,
      "bookHadithIndex": 36,
      "text": "اخبرنا عمرو بن علي، قال حدثنا عبد الرحمن بن مهدي، قال حدثنا اسراييل، عن عثمان بن المغيرة، عن اياس بن ابي رملة، قال سمعت معاوية، سال زيد بن ارقم اشهدت مع رسول الله صلى الله عليه وسلم عيدين قال نعم صلى العيد من اول النهار ثم رخص في الجمعة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1591-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1591-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1591-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a1d5",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 19,
      "hadithIndex": 1592,
      "bookHadithIndex": 37,
      "text": "اخبرنا محمد بن بشار، قال حدثنا يحيى، قال حدثنا عبد الحميد بن جعفر، قال حدثني وهب بن كيسان، قال اجتمع عيدان على عهد ابن الزبير فاخر الخروج حتى تعالى النهار ثم خرج فخطب فاطال الخطبة ثم نزل فصلى ولم يصل للناس يوميذ الجمعة . فذكر ذلك لابن عباس فقال اصاب السنة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1592-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1592-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1592-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a1d6",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 19,
      "hadithIndex": 1593,
      "bookHadithIndex": 38,
      "text": "اخبرنا قتيبة بن سعيد، قال حدثنا محمد بن جعفر، عن معمر، عن الزهري، عن عروة، عن عايشة، ان رسول الله صلى الله عليه وسلم دخل عليها وعندها جاريتان تضربان بدفين فانتهرهما ابو بكر فقال النبي صلى الله عليه وسلم \" دعهن فان لكل قوم عيدا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1593-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1593-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1593-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a1d7",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 19,
      "hadithIndex": 1594,
      "bookHadithIndex": 39,
      "text": "اخبرنا محمد بن ادم، عن عبدة، عن هشام، عن ابيه، عن عايشة، قالت جاء السودان يلعبون بين يدى النبي صلى الله عليه وسلم في يوم عيد فدعاني فكنت اطلع اليهم من فوق عاتقه فما زلت انظر اليهم حتى كنت انا التي انصرفت",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1594-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1594-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1594-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a1d8",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 19,
      "hadithIndex": 1595,
      "bookHadithIndex": 40,
      "text": "اخبرنا علي بن خشرم، قال حدثنا الوليد، قال حدثنا الاوزاعي، عن الزهري، عن عروة، عن عايشة، قالت رايت رسول الله صلى الله عليه وسلم يسترني بردايه وانا انظر الى الحبشة يلعبون في المسجد حتى اكون انا اسام فاقدروا قدر الجارية الحديثة السن الحريصة على اللهو",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1595-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1595-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1595-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a1d9",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 19,
      "hadithIndex": 1596,
      "bookHadithIndex": 41,
      "text": "اخبرنا اسحاق بن موسى، قال حدثنا الوليد بن مسلم، قال حدثنا الاوزاعي، قال حدثني الزهري، عن سعيد بن المسيب، عن ابي هريرة، قال دخل عمر والحبشة يلعبون في المسجد فزجرهم عمر رضى الله عنه فقال رسول الله صلى الله عليه وسلم \" دعهم يا عمر فانما هم بنو ارفدة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1596-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1596-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1596-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a1da",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 19,
      "hadithIndex": 1597,
      "bookHadithIndex": 42,
      "text": "اخبرنا احمد بن حفص بن عبد الله، قال حدثني ابي قال، حدثني ابراهيم بن طهمان، عن مالك بن انس، عن الزهري، عن عروة، انه حدثه ان عايشة حدثته ان ابا بكر الصديق دخل عليها وعندها جاريتان تضربان بالدف وتغنيان ورسول الله صلى الله عليه وسلم مسجى بثوبه - وقال مرة اخرى متسج ثوبه - فكشف عن وجهه فقال \" دعهما يا ابا بكر انها ايام عيد \" . وهن ايام منى ورسول الله صلى الله عليه وسلم يوميذ بالمدينة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1597-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-19-1597-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {

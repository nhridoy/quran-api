    {
      "id": "69b6c648dd1a4c9c86f0a276",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1753,
      "bookHadithIndex": 156,
      "text": "Rapporté par Sa'eed bin Abdur-Rahman bin Abza : Le Messager d'Allah (ﷺ) récitait dans la prière du witr : \"Glorifie le nom de ton Seigneur, le Très-Haut\", puis \"Dis : Ô vous les mécréants !\" et \"Dis : Il est Allah, l'Unique\". Après avoir terminé la prière avec le salam, il disait trois fois : \"Subhanal-Malikil-Quddus\" (Gloire au Souverain, le Très Saint), en prolongeant les mots la troisième fois, puis en élevant la voix",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1753-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"

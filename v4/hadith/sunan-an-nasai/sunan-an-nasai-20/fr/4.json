    },
    {
      "id": "69b6c648dd1a4c9c86f0a279",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1756,
      "bookHadithIndex": 159,
      "text": "Rapporté par Abu Salamah bin Abdur-Rahman : Il a demandé à Aïcha au sujet de la prière du Messager d'Allah (ﷺ) pendant la nuit. Elle a dit : \"Il priait treize unités : neuf debout, dont une était le witr, et deux assis. Quand il voulait s'incliner, il se levait, puis s'inclinait et se prosternait, et il faisait cela après le witr. Ensuite, quand il entendait l'appel à la prière du matin, il se levait et priait deux unités courtes",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1756-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1756-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1756-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a27a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1757,
      "bookHadithIndex": 160,
      "text": "Rapporté par Aïcha : Le Prophète (ﷺ) ne manquait jamais de faire quatre unités avant la prière du Zuhr et deux unités avant la prière du Fajr",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1757-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1757-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1757-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a27b",

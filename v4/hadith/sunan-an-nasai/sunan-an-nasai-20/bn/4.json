      "hadithIndex": 1755,
      "bookHadithIndex": 158,
      "text": "। মুহাম্মদ ইবনু ইসমাঈল (রহঃ) ... সাঈদ ইবনু আব্দুর রহমান (রাঃ) থেকে বর্ণিত যে, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বিতরের সালাত আদায় করতেন। রাবী হাদীসটি শেষ পর্যন্ত বর্ণনা করেছেন।",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1755-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "-"

    },
    {
      "id": "69b6c648dd1a4c9c86f0a2a6",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1801,
      "bookHadithIndex": 204,
      "text": "It was narrated from Umm Habibah that:The Messenger of Allah (ﷺ) said: \"Twelve rak'ahs, whoever prays them Allah will build for him a house in Paradise: four rak'ahs before Zuhr and two rak'ahs after Zuhr, two rak'ahs before Asr, two rak'ahs after Maghrib and two rak'ahs before Subh prayer",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1801-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1801-alalbani",
          "name": "Al-Albani",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1801-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a2a7",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1802,
      "bookHadithIndex": 205,
      "text": "It was narrated that Umm Habibah said:\"The Messenger of Allah (ﷺ) said: 'Whoever prays twelve rak'ahs, Allah (SWT) will build for him a house in paradise: four before Zuhr and two after, two before Asr, two after Maghrib, and two before Subh",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1802-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Daif Isnaad"
        },
        {

          "name": "Al-Albani",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1802-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a2a8",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1803,
      "bookHadithIndex": 206,
      "text": "It was narrated that Umm Habibah said:\"Whoever prays twelve rak'ahs during the night and day other than the prescribed prayers, a house will be built for him in Paradise: four before Zuhr and two rak'ahs afterward, two before Asr, two after Maghrib and two before Fajr",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1803-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Daif Isnaad"
        },
        {

      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a2b0",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1811,
      "bookHadithIndex": 214,
      "text": "It was narrated from Abu Hurairah that:The Prophet (ﷺ) said: \"Whoever prays twelve rak'ahs in a day apart from the obligatory prayers, Allah (SWT) will build for him a house in Paradise",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1811-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1811-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1811-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a2b1",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1812,
      "bookHadithIndex": 215,
      "text": "It was narrated that Hassan bin 'Atiyyah said:\"When 'Anbasah was dying, he started to groan in pain. The people spoke to him and he said: 'I heard Umm Habibah, the wife of the Prophet (ﷺ) narrating that the Prophet (ﷺ) said: Whoever prays four rak'ahs before Zuhr and four after, Allah, the Mighty and Sublime, will forbid his flesh for the Fire. And I never stopped praying them from the time I heard that",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1812-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1812-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1812-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a2b2",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1813,
      "bookHadithIndex": 216,
      "text": "It was narrated that 'Anbasah bin Abi Sufyan said:\"My sister Umm Habibah, the wife of the Prophet (ﷺ), told me that her beloved Abu Al-Qasim (ﷺ) told her: 'There is no believing slave who prays four rak'ahs after Zuhr whose face will ever be touched by the Fire, if Allah, the Mighty and Sublime, wills",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1813-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1813-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1813-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a2b3",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1814,
      "bookHadithIndex": 217,
      "text": "It was narrated from Umm Habibah that:The Messenger of Allah (ﷺ) used to say: \"Whoever prays four rak'ahs before Zuhr and four after, Allah, the Mighty and Sublime, will forbid him from the Fire",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1814-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1814-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1814-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a2b4",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1815,
      "bookHadithIndex": 218,
      "text": "It was narrated from Umm Habibah-and when this was narrated to Sa'eed from Umm Habibah from the Prophet (ﷺ), he would approve it and not deny it but when he narrated it to us, he did not attribute it to the Prophet (ﷺ)- she said:\"Whoever prays four rak'ahs before Zuhr and four after it, Allah (SWT) will forbid him from the Fire",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1815-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1815-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1815-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a2b5",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1816,
      "bookHadithIndex": 219,
      "text": "Sulaiman bin Musa narrated that:When Muhammad bin Abi Sufyan was dying, he was greatly distressed and said: \"My sister Umm Habibah bint Abi Sufyan said: 'The Messenger of Allah (ﷺ) said: Whoever maintains four rak'ahs before Zuhr and four after, Allah (SWT) will forbid him from the Fire",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1816-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1816-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1816-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a2b6",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1817,
      "bookHadithIndex": 220,
      "text": "It was narrated from Umm Habibah that:The Prophet (ﷺ) said: \"Whoever prays four rak'ahs before Zuhr and four after, the Fire will not touch him",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1817-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1817-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1817-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    }
  ]
}
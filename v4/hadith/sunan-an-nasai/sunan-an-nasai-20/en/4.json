  "items": [
    {
      "id": "69b6c648dd1a4c9c86f0a271",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1748,
      "bookHadithIndex": 151,
      "text": "It was narrated that Anas said:\"The Prophet (ﷺ) would not raise his hands in any of his supplications except when praying for rain (Al-Istisqa').\" (One of the narrators) Shu'bah said: \"I said to Thabit: 'Did you hear it from Anas?' He said: 'Subhan Allah!' I said: 'Did you hear it?' He said: 'Subhan Allah",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1748-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1748-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1748-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a272",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1749,
      "bookHadithIndex": 152,
      "text": "It was narrated that Aishah said:\"The Messenger of Allah (ﷺ) used to pray eleven rak'ahs at night between finishing Isha' prayer and Fajr, apart from the two rak'ahs of Fajr, and he would prostrate for as long as it takes one of you to recite fifty verses",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1749-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1749-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1749-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a273",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1750,
      "bookHadithIndex": 153,
      "text": "It was narrated from Ibn Abdur-Rahman bin Abza from his father that:The Messenger of Allah (ﷺ) used to recite in witr: \"Glorify the Name of Your Lord, the Most High;' and \"Say: O you disbelievers!'; and 'Say: He is Allah, (the) One.\" And after he had said the salam, he would say: Subhanal-Malikil-Quddus (Glory be to the Sovereign, the Most Holy) raising his voice the third time",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1750-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1750-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1750-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a274",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1751,
      "bookHadithIndex": 154,
      "text": "It was narrated from Sa'eed bin Abdur-Rahman bin Abza that:His father said: \"The Messenger of Allah (ﷺ) used to recite in witr: Glorify the Name of Your Lord, the Most High;' and \"Say: O you disbelievers!'; and 'Say: He is Allah, (the) One.\" And after he had said the salam, he would say: Subhanal-Malikil-Quddus (Glory be to the Sovereign, the Most Holy) three times, raising his voice with it",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1751-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1751-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1751-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a275",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1752,
      "bookHadithIndex": 155,
      "text": "It was narrated from Ibn Abdur-Rahman bin Abza that his father said:\"The Messenger of Allah (ﷺ) used to recite in witr: Glorify the Name of Your Lord, the Most High;' and \"Say: O you disbelievers!'; and 'Say: He is Allah, (the) One.\" And after he had said the salam, he would say: Subhanal-Malikil-Quddus (Glory be to the Sovereign, the Most Holy) three times, raising his voice with it",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1752-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1752-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1752-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a276",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1753,
      "bookHadithIndex": 156,
      "text": "It was narrated from Sa'eed bin Abdur-Rahman bin Abza that his father said:\"The Messenger of Allah (ﷺ) used to recite in witr: Glorify the Name of Your Lord, the Most High;' and \"Say: O you disbelievers!'; and 'Say: He is Allah, (the) One.\" And after he had said the salam, he would say: Subhanal-Malikil-Quddus (Glory be to the Sovereign, the Most Holy) three times, elongating the words the third time, then raising it",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1753-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1753-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1753-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a277",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1754,
      "bookHadithIndex": 157,
      "text": "It was narrated from Ibn Abdur-Rahman bin Abza from his father that:The Messenger of Allah (ﷺ) used to recite in witr: Glorify the Name of Your Lord, the Most High;' and \"Say: O you disbelievers!'; and 'Say: He is Allah, (the) One.\" And after he had said the salam, he would say: Subhanal-Malikil-Quddus (Glory be to the Sovereign, the Most Holy)",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1754-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1754-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1754-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a278",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1755,
      "bookHadithIndex": 158,
      "text": "It was narrated from Sa'eed bin Abdur-Rahman bin Abza that:The Prophet (ﷺ) used to recite in witr and he quoted the same hadith",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1755-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "-"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1755-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a279",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1756,
      "bookHadithIndex": 159,
      "text": "Abu Salamah bin Abdur-Rahman narrated that :He asked Aishah about the prayer of the Messenger of Allah (ﷺ) at night. She said: \"He used to pray thirteen rak'ahs: nine rak'ahs standing, one of which was witr, and two rak'ahs sitting. When he wanted to bow he would stand up, and bow and prostrate, and he did that after witr. Then when he heard the call for Subh, he stood up and prayed two brief rak'ahs",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1756-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1756-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1756-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a27a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1757,
      "bookHadithIndex": 160,
      "text": "It was narrated from Aishah that:The Prophet (ﷺ) would not omit four rak'ahs before Zuhr and two rak'ahs before Fajr",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1757-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1757-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1757-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a27b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1758,
      "bookHadithIndex": 161,
      "text": "It was narrated from Ibrahim bin Muhammad that:He heard his father narrating that he heard Aishah say: \"The Messenger of Allah (ﷺ) would not omit four rak'ahs before Zuhr and two rak'ahs before Fajr",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1758-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1758-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1758-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a27c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1759,
      "bookHadithIndex": 162,
      "text": "It was narrated from Aishah that :The Prophet (ﷺ) said: \"The two rak'ahs (before) Fajr are better than this world and everything in it",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1759-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1759-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1759-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a27d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1760,
      "bookHadithIndex": 163,
      "text": "It was narrated from Hafsah that:When the call for Subh prayer was given, the Messenger of Allah (ﷺ) would pray two brief rak'ahs before going to the prayer",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1760-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1760-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1760-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a27e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1761,
      "bookHadithIndex": 164,
      "text": "It was narrated that Ibn Umar said:\"Hafsah told me that when dawn glowed, the Prophet (ﷺ) would pray two rak'ahs",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1761-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1761-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1761-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a27f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1762,
      "bookHadithIndex": 165,
      "text": "It was narrated that Aishah said:\"When the Muaddhin fell silent after the Adhan for the beginning of Fajr, he would pray two brief rak'ahs, then he would lie down on his right side",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1762-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1762-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1762-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a280",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1763,
      "bookHadithIndex": 166,
      "text": "It was narrated that Abdullah bin 'Amr said:\"The Messenger of Allah (ﷺ) said to me: 'Do not be like so-and-so; he used to pray Qiyam Al-Lail then he stopped",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1763-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1763-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1763-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a281",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1764,
      "bookHadithIndex": 167,
      "text": "It was narrated that 'Abdullah bin 'Amr said:\"The Messenger of Allah (ﷺ) said to me: 'O Abdullah do not be like so-and-so; he used to pray Qiyam Al-Lail and then he stopped",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1764-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1764-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1764-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a282",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1765,
      "bookHadithIndex": 168,
      "text": "It was narrated from Hafsah that:The Prophet (ﷺ) used to pray the two rak'ahs of Fajr, two brief rak'ahs",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1765-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1765-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1765-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a283",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1766,
      "bookHadithIndex": 169,
      "text": "Ibn 'Umar said:\"Hafsah told me that The Messenger of Allah (ﷺ) used to pray two brief rak'ahs between the call (the Adhan) and the Iqamah for Fajr prayer",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1766-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1766-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1766-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a284",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1767,
      "bookHadithIndex": 170,
      "text": "It was narrated from Ibn 'Umar that Hafsah said:\"The Messenger of Allah (ﷺ) used to pray two brief rak'ahs between the call (the Adhan) and the prayer",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1767-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1767-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1767-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a285",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1768,
      "bookHadithIndex": 171,
      "text": "It was narrated from Abu Salamah and Nafi', from Ibn Umar, from Hafsah that:The Prophet (ﷺ) used to pray two brief rak'ahs between the call (The adhan) and the Iqamah, the two rak'ahs of Fajr",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1768-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1768-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1768-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a286",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1769,
      "bookHadithIndex": 172,
      "text": "Ibn Umar narrated that Hafsah had told him that the:Messenger of Allah (ﷺ) used to pray two brief rak'ahs between the adhan and the Iqamah of Subh prayer",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1769-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1769-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1769-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a287",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1770,
      "bookHadithIndex": 173,
      "text": "It was narrated that Ibn 'Umar said:\"Hafsah told me that the Messenger of Allah (ﷺ) used to pray two rak'ahs beore Subh",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1770-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1770-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1770-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a288",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1771,
      "bookHadithIndex": 174,
      "text": "It was narrated from Ibn 'Umar that Hafsah told him:\"When he was called to Subh prayer, the Messenger of Allah (ﷺ) would do two prostrations before Subh prayer",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1771-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1771-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1771-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a289",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1772,
      "bookHadithIndex": 175,
      "text": "It was narrated from Ibn 'Umar that Hafsah, the Mother of the Believers, :Told him that when the Muaddhin fell silent, Allah's Messenger (ﷺ) would pray two brief rak'ahs",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1772-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1772-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1772-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a28a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1773,
      "bookHadithIndex": 176,
      "text": "It was narrated from 'Abdullah bin Umar that Hafsah, the Mother of the Believers, told him:that when the Muaddhin fell silent following the call to Subh prayer and dawn had broken, he would pray two brief rak'ahs before getting up to pray",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1773-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1773-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1773-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a28b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1774,
      "bookHadithIndex": 177,
      "text": "It was narrated that Abdullah said:\"My sister Hafsah told me that he used to pray two brief rak'ahs before Fajr",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1774-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1774-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1774-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a28c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1775,
      "bookHadithIndex": 178,
      "text": "It was narrated from Abdullah bin Umar, from Hafsah, that:The Messenger of Allah (ﷺ) used to pray two rak'ahs when dawn had broken",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1775-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1775-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1775-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a28d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1776,
      "bookHadithIndex": 179,
      "text": "It was narrated from Ibn Umar that Hafsah said:\"When dawn came, the Messenger of Allah (ﷺ) would not pray anything but two brief rak'ahs",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1776-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1776-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a28e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1777,
      "bookHadithIndex": 180,
      "text": "It was narrated from Ibn Umar, from Hafsah, that:When the call to Subh prayer was given, the Messenger of Allah (ﷺ) would pray two brief rak'ahs before going to pray",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1777-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1777-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1777-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a28f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1778,
      "bookHadithIndex": 181,
      "text": "Ibn Umar said:\"Hafsah told me that the Messenger of Allah (ﷺ) used to pray two brief rak'ahs before Fajr, and that was after dawn had broken",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1778-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1778-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1778-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a290",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1779,
      "bookHadithIndex": 182,
      "text": "It was narrated from Salim that his father said:\"Hafsah told me that when dawn glowed, the Messenger of Allah (ﷺ) would pray two rak'ahs",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1779-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1779-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1779-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a291",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1780,
      "bookHadithIndex": 183,
      "text": "It was narrated from Aishah that:The Messenger of Allah (ﷺ) used to pray two brief rak'ahs between the Adhan and Iqamah for Fajr prayer",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1780-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1780-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1780-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a292",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1781,
      "bookHadithIndex": 184,
      "text": "It was narrated from Abu Salamah that :He asked Aishah about the prayer of the Messenger of Allah (ﷺ) at night. She said: \"He used to pray thirteen rak'ahs. He would pray eight rak'ahs then pray witr, then pray two rak'ahs sitting down. When he wanted to bow he would stand and bow, and he prayed two rak'ahs between the adhan and iqamah of subh prayer",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1781-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1781-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1781-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a293",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1782,
      "bookHadithIndex": 185,
      "text": "It was narrated that Ibn 'Abbas said:\"The Prophet (ﷺ) used to pray two rak'ahs of Fajr when he heard the Adhan and he made them brief",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1782-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1782-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1782-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a294",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1783,
      "bookHadithIndex": 186,
      "text": "It was narrated that Az-Zuhri said:\"As-Sa'ib bin Yazid told me that Shuraih Al-Hadrami was mentioned in the presence of the Messenger of Allah (ﷺ), and the Messenger of Allah (ﷺ) said: \"He does not sleep on the Qur'an",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1783-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1783-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1783-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a295",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1784,
      "bookHadithIndex": 187,
      "text": "It was narrated from Sa'eed bin Jubair, from a man who he thought was good, that :Aishah, may Allah (SWT) be pleased with her, told him that the Messenger of Allah (ﷺ) said: \"There is no man who habitually prays at night, then sleep overwhelms him, but Allah (SWT) will record for him the reward of his prayer, and his sleep is a charity given to him",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1784-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1784-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1784-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a296",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1785,
      "bookHadithIndex": 188,
      "text": "It was narrated from Sa'd bin Jubair, from Al-Aswad bin Yazid, that Aishah said:\"The Messenger of Allah (ﷺ) said: 'Whoever has the habit of praying at night but he sleeps and misses it, that is a charity that Allah (SWT) has given to him, and the reward of his prayer will be recorded for him",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1785-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1785-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1785-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a297",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1786,
      "bookHadithIndex": 189,
      "text": "It was narrated from Sa'eed bin Jubair, from Aishah, that:The Messenger of Allah (ﷺ) said: and he mentioned something similar",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1786-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1786-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a298",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1787,
      "bookHadithIndex": 190,
      "text": "It was narrated from Abu Ad-Darda' who attributed it to the Prophet (ﷺ):\"Whoever goes to his bed intending to get up and pray qiyam at night, then sleep overwhelms him until morning, will have recorded that which he intended and his sleep is a charity given to him by his Lord, the Mighty and Sublime",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1787-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1787-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1787-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a299",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1788,
      "bookHadithIndex": 191,
      "text": "It was narrated from Sufyan, that 'Abdah said:\"I heard Suwaid bin Ghaflah (narrate it) from Abu Dharr and Abu Ad-Darda",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1788-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1788-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Muquf"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1788-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a29a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1789,
      "bookHadithIndex": 192,
      "text": "It was narrated from Aishah that:When the Messenger of Allah (ﷺ) did not pray at night because he was prevented from doing so by sleep- meaning, sleep overwhelmed him- or by pain, he would pray twelve rak'ahs during the day",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1789-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1789-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1789-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a29b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1790,
      "bookHadithIndex": 193,
      "text": "Abdur-Rahman bin Abdul-Qari said:\"I heard Umar bin Al-Khattab say: 'The Messenger of Allah (ﷺ) said: Whoever sleeps and misses his portion (of Qur'an) or part of it, and then reads it between Fajr and Zuhr prayers, it will be recorded for him as if he had read it at night.'\" (Sahih)",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1790-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1790-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1790-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a29c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1791,
      "bookHadithIndex": 194,
      "text": "It was narrated from Abdur-Rahman bin Abdul-Qari that:Umar bin Al-Khattab said: \"(The Messenger of Allah (ﷺ) said): \"Whoever sleeps and misses his nightly portion, and reads it between Subh and Zuhr prayers, it is as if he read it at night",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1791-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1791-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1791-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a29d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1792,
      "bookHadithIndex": 195,
      "text": "It was narrated from Abdur-Rahman bin Abdul-Qari that Umar bin Al-Khattab said:\"Whoever misses his nightly portion and recites it from the time when the sun passes its zenith until Zuhr prayer, then he did not miss it, or it is as if he caught up with it",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1792-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1792-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Muquf"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1792-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a29e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1793,
      "bookHadithIndex": 196,
      "text": "It was narrated that Humaid bin Abdur-Rahman said:\"Whoever misses his Wird at night, let him recite it during prayer before Zuhr, and that will be equivalent to night prayers",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1793-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Maqtu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1793-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Maqtu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1793-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a29f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1794,
      "bookHadithIndex": 197,
      "text": "It was narrated that Aishah said:\"The Messenger of Allah (ﷺ) said: 'Whoever persists in praying twelve rak'ahs each day and night will enter Paradise: Four before Zuhr and two after, two rak'ahs after Maghrib, two rak'ahs after Isha' and two rak'ahs before Fajr",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1794-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1794-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1794-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a2a0",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1795,
      "bookHadithIndex": 198,
      "text": "It was narrated from Aishah that:The Messenger of Allah (ﷺ) said: \"Whoever persists in praying twelve rak'ahs each day and night, Allah, the Mighty and Sublime, will build for him a house in Paradise: Four before Zuhr and two after Zuhr, two rak'ahs after Maghrib, two rak'ahs after Isha' and two rak'ahs of Fajr",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1795-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1795-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1795-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a2a1",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1796,
      "bookHadithIndex": 199,
      "text": "It was narrated that 'Ata said:\"I was told that Umm Habibah bin Abi Sufyan said: \"I heard the Messenger of Allah (ﷺ) say: 'Whoever prays twelve rak'ahs during the day and night, apart from the prescribed prayers, Allah (SWT) will build for him a house in Paradise",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1796-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1796-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1796-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a2a2",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1797,
      "bookHadithIndex": 200,
      "text": "Ibn Juraij said:\"I said to Ata: 'I heard that you pray twelve rak'ahs before Jumu'ah. What did you hear concerning that?' He said: 'I was told that Umm Habibah bin Abi Sufyan said: \"I heard the Messenger of Allah (ﷺ) say: 'Whoever prays twelve rak'ahs during the day and night, apart from the prescribed prayers, Allah (SWT), the Mighty and Sublime, will build for him a house in Paradise",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1797-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1797-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1797-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    }
  ]

      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a293",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1782,
      "bookHadithIndex": 185,
      "text": "اخبرنا احمد بن نصر، قال حدثنا عمرو بن محمد، قال حدثنا عثام بن علي، قال حدثنا الاعمش، عن حبيب بن ابي ثابت، عن سعيد بن جبير، عن ابن عباس، قال كان النبي صلى الله عليه وسلم يصلي ركعتى الفجر اذا سمع الاذان ويخففهما . قال ابو عبد الرحمن هذا حديث منكر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1782-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1782-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1782-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a294",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1783,
      "bookHadithIndex": 186,
      "text": "اخبرنا سويد بن نصر، قال حدثنا عبد الله، قال انبانا يونس، عن الزهري، قال اخبرني السايب بن يزيد، ان شريحا الحضرمي، ذكر عند رسول الله صلى الله عليه وسلم فقال رسول الله صلى الله عليه وسلم \" ذاك رجل لا يتوسد القران",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1783-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1783-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1783-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a295",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1784,
      "bookHadithIndex": 187,
      "text": "اخبرنا قتيبة بن سعيد، عن مالك، عن محمد بن المنكدر، عن سعيد بن جبير، عن رجل، عنده رضا اخبره ان عايشة رضى الله عنها اخبرته ان رسول الله صلى الله عليه وسلم قال \" ما من امري تكون له صلاة بليل فغلبه عليها نوم الا كتب الله له اجر صلاته وكان نومه صدقة عليه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1784-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1784-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1784-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a296",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1785,
      "bookHadithIndex": 188,
      "text": "اخبرنا ابو داود، قال حدثنا محمد بن سليمان، قال حدثنا ابو جعفر الرازي، عن محمد بن المنكدر، عن سعيد بن جبير، عن الاسود بن يزيد، عن عايشة، قالت قال رسول الله صلى الله عليه وسلم \" من كانت له صلاة صلاها من الليل فنام عنها كان ذلك صدقة تصدق الله عز وجل عليه وكتب له اجر صلاته",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1785-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1785-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1785-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a297",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1786,
      "bookHadithIndex": 189,
      "text": "اخبرنا احمد بن نصر، قال حدثنا يحيى بن ابي بكير، قال حدثنا ابو جعفر الرازي، عن محمد بن المنكدر، عن سعيد بن جبير، عن عايشة، ان رسول الله صلى الله عليه وسلم قال فذكر نحوه . قال ابو عبد الرحمن ابو جعفر الرازي ليس بالقوي في الحديث",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1786-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1786-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a298",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1787,
      "bookHadithIndex": 190,
      "text": "اخبرنا هارون بن عبد الله، قال حدثنا حسين بن علي، عن زايدة، عن سليمان، عن حبيب بن ابي ثابت، عن عبدة بن ابي لبابة، عن سويد بن غفلة، عن ابي الدرداء، يبلغ به النبي صلى الله عليه وسلم قال \" من اتى فراشه وهو ينوي ان يقوم يصلي من الليل فغلبته عيناه حتى اصبح كتب له ما نوى وكان نومه صدقة عليه من ربه عز وجل \" . خالفه سفيان",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1787-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1787-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1787-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a299",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1788,
      "bookHadithIndex": 191,
      "text": "اخبرنا سويد بن نصر، قال حدثنا عبد الله، عن سفيان الثوري، عن عبدة، قال سمعت سويد بن غفلة، عن ابي ذر، وابي الدرداء، موقوفا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1788-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1788-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Muquf"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1788-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a29a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1789,
      "bookHadithIndex": 192,
      "text": "اخبرنا قتيبة بن سعيد، قال حدثنا ابو عوانة، عن قتادة، عن زرارة، عن سعد بن هشام، عن عايشة، ان رسول الله صلى الله عليه وسلم كان اذا لم يصل من الليل منعه من ذلك نوم او وجع صلى من النهار ثنتى عشرة ركعة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1789-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1789-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1789-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a29b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1790,
      "bookHadithIndex": 193,
      "text": "اخبرنا قتيبة بن سعيد، قال حدثنا ابو صفوان عبد الله بن سعيد بن عبد الملك بن مروان، عن يونس، عن ابن شهاب، ان السايب بن يزيد، وعبيد الله، اخبراه ان عبد الرحمن بن عبد القاري قال سمعت عمر بن الخطاب، يقول قال رسول الله صلى الله عليه وسلم \" من نام عن حزبه او عن شىء منه فقراه فيما بين صلاة الفجر وصلاة الظهر كتب له كانما قراه من الليل",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1790-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1790-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1790-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a29c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1791,
      "bookHadithIndex": 194,
      "text": "اخبرنا محمد بن رافع، قال حدثنا عبد الرزاق، قال انبانا معمر، عن الزهري، عن عروة، عن عبد الرحمن بن عبد القاري، ان عمر بن الخطاب، يقول قال رسول الله صلى الله عليه وسلم \" من نام عن حزبه - او قال جزيه - من الليل فقراه فيما بين صلاة الصبح الى صلاة الظهر فكانما قراه من الليل",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1791-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1791-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1791-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a29d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1792,
      "bookHadithIndex": 195,
      "text": "اخبرنا قتيبة بن سعيد، عن مالك، عن داود بن الحصين، عن الاعرج، عن عبد الرحمن بن عبد القاري، ان عمر بن الخطاب، قال من فاته حزبه من الليل فقراه حين تزول الشمس الى صلاة الظهر فانه لم يفته او كانه ادركه . رواه حميد بن عبد الرحمن بن عوف موقوفا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1792-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1792-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Muquf"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1792-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a29e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1793,
      "bookHadithIndex": 196,
      "text": "اخبرنا سويد بن نصر، قال حدثنا عبد الله، عن شعبة، عن سعد بن ابراهيم، عن حميد بن عبد الرحمن، عن عمر، قال من فاته ورده من الليل فليقراه في صلاة قبل الظهر فانها تعدل صلاة الليل",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1793-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Maqtu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1793-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Maqtu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1793-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a29f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1794,
      "bookHadithIndex": 197,
      "text": "اخبرنا الحسين بن منصور بن جعفر النيسابوري، قال حدثنا اسحاق بن سليمان، قال حدثنا مغيرة بن زياد، عن عطاء، عن عايشة، قالت قال رسول الله صلى الله عليه وسلم \" من ثابر على اثنتى عشرة ركعة في اليوم والليلة دخل الجنة اربعا قبل الظهر وركعتين بعدها وركعتين بعد المغرب وركعتين بعد العشاء وركعتين قبل الفجر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1794-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1794-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1794-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a2a0",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1795,
      "bookHadithIndex": 198,
      "text": "اخبرنا احمد بن يحيى، قال حدثنا محمد بن بشر، قال حدثنا ابو يحيى، اسحاق بن سليمان الرازي عن المغيرة بن زياد، عن عطاء بن ابي رباح، عن عايشة، رضى الله عنها عن النبي صلى الله عليه وسلم قال \" من ثابر على اثنتى عشرة ركعة بنى الله عز وجل له بيتا في الجنة اربعا قبل الظهر وركعتين بعد الظهر وركعتين بعد المغرب وركعتين بعد العشاء وركعتين قبل الفجر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1795-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1795-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1795-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a2a1",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1796,
      "bookHadithIndex": 199,
      "text": "اخبرنا محمد بن معدان بن عيسى، قال حدثنا الحسن بن اعين، قال حدثنا معقل، عن عطاء، قال اخبرت ان ام حبيبة بنت ابي سفيان قالت سمعت رسول الله صلى الله عليه وسلم يقول \" من ركع ثنتى عشرة ركعة في يومه وليلته سوى المكتوبة بنى الله له بها بيتا في الجنة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1796-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1796-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1796-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a2a2",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1797,
      "bookHadithIndex": 200,
      "text": "اخبرني ابراهيم بن الحسن، قال حدثنا حجاج بن محمد، قال قال ابن جريج قلت لعطاء بلغني انك تركع قبل الجمعة اثنتى عشرة ركعة ما بلغك في ذلك قال اخبرت ام حبيبة عنبسة بن ابي سفيان ان النبي صلى الله عليه وسلم قال \" من ركع اثنتى عشرة ركعة في اليوم والليلة سوى المكتوبة بنى الله عز وجل له بيتا في الجنة",
      "grades": [
        {

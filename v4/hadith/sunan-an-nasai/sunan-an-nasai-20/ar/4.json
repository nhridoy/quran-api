      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a281",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1764,
      "bookHadithIndex": 167,
      "text": "اخبرنا الحارث بن اسد، قال حدثنا بشر بن بكر، قال حدثني الاوزاعي، قال حدثني يحيى بن ابي كثير، عن عمر بن الحكم بن ثوبان، قال حدثني ابو سلمة بن عبد الرحمن، عن عبد الله بن عمرو، قال قال رسول الله صلى الله عليه وسلم \" لا تكن يا عبد الله مثل فلان كان يقوم الليل فترك قيام الليل",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1764-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1764-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1764-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a282",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1765,
      "bookHadithIndex": 168,
      "text": "اخبرنا محمد بن ابراهيم البصري، قال حدثنا خالد بن الحارث، قال قرات على عبد الحميد بن جعفر عن نافع، عن صفية، عن حفصة، عن النبي صلى الله عليه وسلم انه كان يصلي ركعتى الفجر ركعتين خفيفتين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1765-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1765-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1765-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a283",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1766,
      "bookHadithIndex": 169,
      "text": "اخبرنا شعيب بن شعيب بن اسحاق، قال حدثنا عبد الوهاب، قال انبانا شعيب، قال حدثنا الاوزاعي، قال حدثني يحيى، قال حدثني نافع، قال حدثني ابن عمر، قال حدثتني حفصة، ان رسول الله صلى الله عليه وسلم كان يركع ركعتين خفيفتين بين النداء والاقامة من صلاة الفجر . قال ابو عبد الرحمن كلا الحديثين عندنا خطا والله تعالى اعلم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1766-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1766-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1766-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a284",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1767,
      "bookHadithIndex": 170,
      "text": "اخبرنا اسحاق بن منصور، قال انبانا يحيى، قال حدثنا الاوزاعي، قال حدثني يحيى، عن نافع، عن ابن عمر، عن حفصة، قالت كان رسول الله صلى الله عليه وسلم يركع بين النداء والصلاة ركعتين خفيفتين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1767-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1767-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1767-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a285",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1768,
      "bookHadithIndex": 171,
      "text": "اخبرنا هشام بن عمار، قال حدثنا يحيى، - يعني ابن حمزة - قال حدثنا الاوزاعي، عن يحيى، عن ابي سلمة، قال هو ونافع عن ابن عمر، عن حفصة، ان النبي صلى الله عليه وسلم كان يصلي بين النداء والاقامة ركعتين خفيفتين ركعتى الفجر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1768-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1768-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1768-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a286",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1769,
      "bookHadithIndex": 172,
      "text": "اخبرنا اسحاق بن منصور، قال حدثنا معاذ بن هشام، قال حدثني ابي، عن يحيى بن ابي كثير، قال حدثني نافع، ان ابن عمر، حدثه ان حفصة حدثته ان رسول الله صلى الله عليه وسلم كان يصلي ركعتين خفيفتين بين النداء والاقامة من صلاة الصبح",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1769-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1769-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1769-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a287",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1770,
      "bookHadithIndex": 173,
      "text": "اخبرنا يحيى بن محمد، قال حدثنا محمد بن جهضم، قال اسماعيل حدثنا عن عمر بن نافع، عن ابيه، عن ابن عمر، قال اخبرتني حفصة، ان رسول الله صلى الله عليه وسلم كان يصلي قبل الصبح ركعتين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1770-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1770-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1770-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a288",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1771,
      "bookHadithIndex": 174,
      "text": "اخبرنا محمد بن عبد الله بن عبد الحكم، قال انبانا اسحاق بن الفرات، عن يحيى بن ايوب، قال حدثني يحيى بن سعيد، قال انبانا نافع، عن ابن عمر، عن حفصة، انها اخبرته ان رسول الله صلى الله عليه وسلم كان اذا نودي لصلاة الصبح سجد سجدتين قبل صلاة الصبح",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1771-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1771-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1771-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a289",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1772,
      "bookHadithIndex": 175,
      "text": "اخبرنا عبد الله بن اسحاق، عن ابي عاصم، عن ابن جريج، قال اخبرني موسى بن عقبة، عن نافع، عن ابن عمر، عن حفصة ام المومنين، انها اخبرته ان رسول الله صلى الله عليه وسلم كان اذا سكت الموذن صلى ركعتين خفيفتين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1772-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1772-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1772-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a28a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1773,
      "bookHadithIndex": 176,
      "text": "اخبرنا محمد بن سلمة، قال انبانا ابن القاسم، عن مالك، قال حدثني نافع، عن عبد الله بن عمر، ان حفصة ام المومنين، اخبرته ان رسول الله صلى الله عليه وسلم كان اذا سكت الموذن من الاذان لصلاة الصبح وبدا الصبح صلى ركعتين خفيفتين قبل ان تقام الصلاة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1773-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1773-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1773-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a28b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1774,
      "bookHadithIndex": 177,
      "text": "اخبرنا اسماعيل بن مسعود، قال حدثنا خالد بن الحارث، قال حدثنا عبيد الله، عن نافع، عن عبد الله، قال حدثتني اختي، حفصة انه كان يصلي قبل الفجر ركعتين خفيفتين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1774-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1774-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1774-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a28c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1775,
      "bookHadithIndex": 178,
      "text": "اخبرنا محمد بن عبد الله بن يزيد، قال حدثنا ابي قال، حدثنا جويرية بن اسماء، عن نافع، عن عبد الله بن عمر، عن حفصة، ان رسول الله صلى الله عليه وسلم كان يصلي ركعتين اذا طلع الفجر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1775-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1775-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1775-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a28d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1776,
      "bookHadithIndex": 179,
      "text": "اخبرنا احمد بن عبد الله بن الحكم، قال حدثنا محمد بن جعفر، قال حدثنا شعبة، عن زيد بن محمد، قال سمعت نافعا، عن ابن عمر، عن حفصة، انها قالت كان رسول الله صلى الله عليه وسلم اذا طلع الفجر لا يصلي الا ركعتين خفيفتين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1776-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1776-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a28e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1777,
      "bookHadithIndex": 180,
      "text": "اخبرنا قتيبة بن سعيد، قال حدثنا الليث، عن نافع، عن ابن عمر، عن حفصة، عن رسول الله صلى الله عليه وسلم انه كان اذا نودي لصلاة الصبح ركع ركعتين خفيفتين قبل ان يقوم الى الصلاة . وروى سالم عن ابن عمر عن حفصة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1777-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1777-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1777-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a28f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1778,
      "bookHadithIndex": 181,
      "text": "اخبرنا اسحاق بن ابراهيم، قال انبانا عبد الرزاق، قال حدثنا معمر، عن الزهري، عن سالم، قال ابن عمر اخبرتني حفصة، ان رسول الله صلى الله عليه وسلم كان يركع ركعتين قبل الفجر وذلك بعد ما يطلع الفجر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1778-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1778-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1778-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a290",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1779,
      "bookHadithIndex": 182,
      "text": "اخبرنا الحسين بن عيسى، قال حدثنا سفيان، عن عمرو، عن الزهري، عن سالم، عن ابيه، قال اخبرتني حفصة، ان رسول الله صلى الله عليه وسلم كان اذا اضاء له الفجر صلى ركعتين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1779-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1779-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1779-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a291",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1780,
      "bookHadithIndex": 183,
      "text": "اخبرنا محمود بن خالد، قال حدثنا الوليد، عن ابي عمرو، عن يحيى، قال حدثني ابو سلمة، عن عايشة، ان رسول الله صلى الله عليه وسلم كان يصلي ركعتين خفيفتين بين النداء والاقامة من صلاة الفجر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1780-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1780-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1780-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a292",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1781,
      "bookHadithIndex": 184,
      "text": "اخبرنا اسماعيل بن مسعود، قال حدثنا خالد، قال حدثنا هشام، قال حدثنا يحيى، عن ابي سلمة، انه سال عايشة عن صلاة، رسول الله صلى الله عليه وسلم بالليل قالت كان يصلي ثلاث عشرة ركعة يصلي ثمان ركعات ثم يوتر ثم يصلي ركعتين وهو جالس فاذا اراد ان يركع قام فركع ويصلي ركعتين بين الاذان والاقامة في صلاة الصبح",
      "grades": [

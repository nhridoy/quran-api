        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a211",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1652,
      "bookHadithIndex": 55,
      "text": "اخبرنا عمرو بن علي، عن حديث ابي عاصم، قال حدثنا عمر بن ابي زايدة، قال حدثني ابو اسحاق، عن الاسود، عن عايشة، قالت ما كان رسول الله صلى الله عليه وسلم يمتنع من وجهي وهو صايم وما مات حتى كان اكثر صلاته قاعدا ثم ذكرت كلمة معناها الا المكتوبة وكان احب العمل اليه ما دام عليه الانسان وان كان يسيرا . خالفه يونس رواه عن ابي اسحاق عن الاسود عن ام سلمة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1652-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1652-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1652-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a212",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1653,
      "bookHadithIndex": 56,
      "text": "اخبرنا سليمان بن سلم البلخي، قال حدثنا النضر، قال انبانا يونس، عن ابي اسحاق، عن الاسود، عن ام سلمة، قالت ما قبض رسول الله صلى الله عليه وسلم حتى كان اكثر صلاته جالسا الا المكتوبة . خالفه شعبة وسفيان وقالا عن ابي اسحاق عن ابي سلمة عن ام سلمة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1653-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1653-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1653-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a213",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1654,
      "bookHadithIndex": 57,
      "text": "اخبرنا اسماعيل بن مسعود، حدثنا خالد، عن شعبة، عن ابي اسحاق، قال سمعت ابا سلمة، عن ام سلمة، قالت ما مات رسول الله صلى الله عليه وسلم حتى كان اكثر صلاته قاعدا الا الفريضة وكان احب العمل اليه ادومه وان قل",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1654-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1654-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1654-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a214",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1655,
      "bookHadithIndex": 58,
      "text": "اخبرنا عبد الله بن عبد الصمد، قال حدثنا يزيد، قال حدثنا سفيان، عن ابي اسحاق، عن ابي سلمة، عن ام سلمة، قالت والذي نفسي بيده ما مات رسول الله صلى الله عليه وسلم حتى كان اكثر صلاته قاعدا الا المكتوبة وكان احب العمل اليه ما داوم عليه وان قل . خالفه عثمان بن ابي سليمان فرواه عن ابي سلمة عن عايشة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1655-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1655-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1655-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a215",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1656,
      "bookHadithIndex": 59,
      "text": "اخبرنا الحسن بن محمد، عن حجاج، عن ابن جريج، قال اخبرني عثمان بن ابي سليمان، ان ابا سلمة، اخبره ان عايشة اخبرته ان النبي صلى الله عليه وسلم لم يمت حتى كان يصلي كثيرا من صلاته وهو جالس",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1656-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1656-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1656-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a216",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1657,
      "bookHadithIndex": 60,
      "text": "اخبرنا ابو الاشعث، عن يزيد بن زريع، قال انبانا الجريري، عن عبد الله بن شقيق، قال قلت لعايشة هل كان رسول الله صلى الله عليه وسلم يصلي وهو قاعد قالت نعم بعد ما حطمه الناس",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1657-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1657-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1657-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a217",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1658,
      "bookHadithIndex": 61,
      "text": "اخبرنا قتيبة، عن مالك، عن ابن شهاب، عن السايب بن يزيد، عن المطلب بن ابي وداعة، عن حفصة، قالت ما رايت رسول الله صلى الله عليه وسلم صلى في سبحته قاعدا قط حتى كان قبل وفاته بعام فكان يصلي قاعدا يقرا بالسورة فيرتلها حتى تكون اطول من اطول منها",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1658-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1658-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1658-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a218",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1659,
      "bookHadithIndex": 62,
      "text": "اخبرنا عبيد الله بن سعيد، قال حدثنا يحيى، عن سفيان، قال حدثنا منصور، عن هلال بن يساف، عن ابي يحيى، عن عبد الله بن عمرو، قال رايت النبي صلى الله عليه وسلم يصلي جالسا فقلت حدثت انك قلت \" ان صلاة القاعد على النصف من صلاة القايم \" . وانت تصلي قاعدا . قال \" اجل ولكني لست كاحد منكم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1659-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1659-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1659-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a219",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1660,
      "bookHadithIndex": 63,
      "text": "اخبرنا حميد بن مسعدة، عن سفيان بن حبيب، عن حسين المعلم، عن عبد الله بن بريدة، عن عمران بن حصين، قال سالت النبي صلى الله عليه وسلم عن الذي يصلي قاعدا قال \" من صلى قايما فهو افضل ومن صلى قاعدا فله نصف اجر القايم ومن صلى نايما فله نصف اجر القاعد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1660-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1660-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1660-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a21a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1661,
      "bookHadithIndex": 64,
      "text": "اخبرنا هارون بن عبد الله، قال حدثنا ابو داود الحفري، عن حفص، عن حميد، عن عبد الله بن شقيق، عن عايشة، قالت رايت النبي صلى الله عليه وسلم يصلي متربعا . قال ابو عبد الرحمن لا اعلم احدا روى هذا الحديث غير ابي داود وهو ثقة ولا احسب هذا الحديث الا خطا والله تعالى اعلم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1661-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1661-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1661-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a21b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1662,
      "bookHadithIndex": 65,
      "text": "اخبرنا شعيب بن يوسف، قال حدثنا عبد الرحمن، عن معاوية بن صالح، عن عبد الله بن ابي قيس، قال سالت عايشة كيف كانت قراءة رسول الله صلى الله عليه وسلم بالليل يجهر ام يسر قالت كل ذلك قد كان يفعل ربما جهر وربما اسر",
      "grades": [

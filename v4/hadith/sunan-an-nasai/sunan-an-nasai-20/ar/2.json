      ]
    },
    {
      "id": "69b6c611dd1a4c9c86f0a20e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1649,
      "bookHadithIndex": 52,
      "text": "اخبرنا اسحاق بن ابراهيم، قال انبانا عيسى بن يونس، قال حدثنا هشام بن عروة، عن ابيه، عن عايشة، قالت ما رايت رسول الله صلى الله عليه وسلم صلى جالسا حتى دخل في السن فكان يصلي وهو جالس يقرا فاذا غبر من السورة ثلاثون او اربعون اية قام فقرا بها ثم ركع",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1649-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"

          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1680-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a22e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1681,
      "bookHadithIndex": 84,
      "text": "اخبرنا اسحاق بن منصور، قال حدثنا عبد الرحمن، عن سفيان، عن ابي حصين، عن يحيى بن وثاب، عن مسروق، عن عايشة، قالت اوتر رسول الله صلى الله عليه وسلم من اوله واخره واوسطه وانتهى وتره الى السحر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1681-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1681-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1681-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a22f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1682,
      "bookHadithIndex": 85,
      "text": "اخبرنا قتيبة، قال حدثنا الليث، عن نافع، ان ابن عمر، قال من صلى من الليل فليجعل اخر صلاته وترا فان رسول الله صلى الله عليه وسلم كان يامر بذلك",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1682-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1682-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1682-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a230",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1683,
      "bookHadithIndex": 86,
      "text": "اخبرنا عبيد الله بن فضالة بن ابراهيم، قال انبانا محمد، - وهو ابن المبارك - قال حدثنا معاوية، - وهو ابن سلام بن ابي سلام - عن يحيى بن ابي كثير، قال اخبرني ابو نضرة العوقي، انه سمع ابا سعيد الخدري، يقول سيل رسول الله صلى الله عليه وسلم عن الوتر فقال \" اوتروا قبل الصبح",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1683-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1683-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1683-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a231",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1684,
      "bookHadithIndex": 87,
      "text": "اخبرنا يحيى بن درست، قال حدثنا ابو اسماعيل القناد، قال حدثنا يحيى، - وهو ابن ابي كثير - عن ابي نضرة، عن ابي سعيد، عن النبي صلى الله عليه وسلم قال \" اوتروا قبل الفجر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1684-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1684-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1684-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a232",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1685,
      "bookHadithIndex": 88,
      "text": "اخبرنا يحيى بن حكيم، قال حدثنا ابن ابي عدي، عن شعبة، عن ابراهيم بن محمد بن المنتشر، عن ابيه، انه كان في مسجد عمرو بن شرحبيل فاقيمت الصلاة فجعلوا ينتظرونه فجاء فقال اني كنت اوتر . قال وسيل عبد الله هل بعد الاذان وتر قال نعم وبعد الاقامة . وحدث عن النبي صلى الله عليه وسلم انه نام عن الصلاة حتى طلعت الشمس ثم صلى",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1685-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1685-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1685-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a233",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1686,
      "bookHadithIndex": 89,
      "text": "اخبرنا عبيد الله بن سعيد، قال حدثنا يحيى بن سعيد، عن عبيد الله بن الاخنس، عن نافع، عن ابن عمر، ان رسول الله صلى الله عليه وسلم كان يوتر على الراحلة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1686-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1686-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1686-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a234",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1687,
      "bookHadithIndex": 90,
      "text": "اخبرنا ابراهيم بن يعقوب، قال اخبرني عبد الله بن محمد بن علي، قال حدثنا زهير، عن الحسن بن الحر، عن نافع، ان ابن عمر، كان يوتر على بعيره ويذكر ان النبي صلى الله عليه وسلم كان يفعل ذلك",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1687-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1687-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1687-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a235",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1688,
      "bookHadithIndex": 91,
      "text": "اخبرنا قتيبة، قال حدثنا مالك، عن ابي بكر بن عمر بن عبد الرحمن بن عبد الله بن عمر بن الخطاب، عن سعيد بن يسار، قال قال لي ابن عمر ان رسول الله صلى الله عليه وسلم كان يوتر على البعير",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1688-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1688-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1688-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a236",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1689,
      "bookHadithIndex": 92,
      "text": "اخبرنا محمد بن يحيى بن عبد الله، قال حدثنا وهب بن جرير، قال حدثنا شعبة، عن ابي التياح، عن ابي مجلز، عن ابن عمر، ان النبي صلى الله عليه وسلم قال \" الوتر ركعة من اخر الليل",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1689-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1689-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1689-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a237",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1690,
      "bookHadithIndex": 93,
      "text": "اخبرنا محمد بن بشار، قال حدثنا يحيى، ومحمد، قالا حدثنا ثم، ذكر كلمة معناها شعبة عن قتادة، عن ابي مجلز، عن ابن عمر، عن النبي صلى الله عليه وسلم قال \" الوتر ركعة من اخر الليل",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1690-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1690-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1690-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a238",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1691,
      "bookHadithIndex": 94,
      "text": "اخبرنا الحسن بن محمد، عن عفان، قال حدثنا همام، قال حدثنا قتادة، عن عبد الله بن شقيق، عن ابن عمر، ان رجلا، من اهل البادية سال رسول الله صلى الله عليه وسلم عن صلاة الليل قال \" مثنى مثنى والوتر ركعة من اخر الليل",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1691-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1691-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1691-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a239",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1692,
      "bookHadithIndex": 95,
      "text": "اخبرنا الربيع بن سليمان، قال حدثنا حجاج بن ابراهيم، قال حدثنا ابن وهب، عن عمرو بن الحارث، عن عبد الرحمن بن القاسم، حدثه عن ابيه، عن عبد الله بن عمر، عن رسول الله صلى الله عليه وسلم قال \" صلاة الليل مثنى مثنى فاذا اردت ان تنصرف فاركع بواحدة توتر لك ما قد صليت",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1692-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1692-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1692-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a23a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1693,
      "bookHadithIndex": 96,
      "text": "اخبرنا قتيبة، قال حدثنا خالد بن زياد، عن نافع، عن ابن عمر، قال قال رسول الله صلى الله عليه وسلم \" صلاة الليل مثنى مثنى والوتر ركعة واحدة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1693-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1693-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1693-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c648dd1a4c9c86f0a23b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 20,
      "hadithIndex": 1694,
      "bookHadithIndex": 97,
      "text": "اخبرنا محمد بن سلمة، والحارث بن مسكين، قراءة عليه وانا اسمع، - واللفظ له - عن ابن القاسم، قال حدثني مالك، عن نافع، وعبد الله بن دينار، عن عبد الله بن عمر، ان رجلا، سال رسول الله صلى الله عليه وسلم عن صلاة الليل فقال رسول الله صلى الله عليه وسلم \" صلاة الليل مثنى مثنى فاذا خشي احدكم الصبح صلى ركعة واحدة توتر له ما قد صلى",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-20-1694-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {

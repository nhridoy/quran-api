    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad24",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4483,
      "bookHadithIndex": 35,
      "text": "اخبرنا قتيبة بن سعيد، قال انبانا الليث، عن ابن عجلان، عن عمرو بن شعيب، عن ابيه، عن جده، ان النبي صلى الله عليه وسلم قال \" المتبايعان بالخيار ما لم يتفرقا الا ان يكون صفقة خيار ولا يحل له ان يفارق صاحبه خشية ان يستقيله",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4483-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4483-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4483-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad25",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4484,
      "bookHadithIndex": 36,
      "text": "اخبرنا قتيبة بن سعيد، عن مالك، عن عبد الله بن دينار، عن ابن عمر، ان رجلا، ذكر لرسول الله صلى الله عليه وسلم انه يخدع في البيع فقال له رسول الله صلى الله عليه وسلم \" اذا بعت فقل لا خلابة \" . فكان الرجل اذا باع يقول لا خلابة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4484-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4484-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Hadith"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4484-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad26",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4485,
      "bookHadithIndex": 37,
      "text": "اخبرنا يوسف بن حماد، قال حدثنا عبد الاعلى، عن سعيد، عن قتادة، عن انس، ان رجلا، كان في عقدته ضعف كان يبايع وان اهله اتوا النبي صلى الله عليه وسلم فقالوا يا نبي الله احجر عليه . فدعاه نبي الله صلى الله عليه وسلم فنهاه فقال يا نبي الله اني لا اصبر عن البيع . قال \" اذا بعت فقل لا خلابة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4485-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4485-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4485-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad27",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4486,
      "bookHadithIndex": 38,
      "text": "اخبرنا اسحاق بن ابراهيم، قال انبانا عبد الرزاق، حدثنا معمر، عن يحيى بن ابي كثير، قال حدثني ابو كثير، انه سمع ابا هريرة، يقول قال رسول الله صلى الله عليه وسلم \" اذا باع احدكم الشاة او اللقحة فلا يحفلها",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4486-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4486-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Hadith"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4486-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad28",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4487,
      "bookHadithIndex": 39,
      "text": "اخبرنا محمد بن منصور، قال حدثنا سفيان، عن ابي الزناد، عن الاعرج، عن ابي هريرة، عن النبي صلى الله عليه وسلم قال \" لا تلقوا الركبان للبيع ولا تصروا الابل والغنم من ابتاع من ذلك شييا فهو بخير النظرين فان شاء امسكها وان شاء ان يردها ردها ومعها صاع تمر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4487-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4487-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4487-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad29",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4488,
      "bookHadithIndex": 40,
      "text": "اخبرنا اسحاق بن ابراهيم، قال حدثنا عبد الله بن الحارث، قال حدثني داود بن قيس، عن ابن يسار، عن ابي هريرة، عن رسول الله صلى الله عليه وسلم قال \" من اشترى مصراة فان رضيها اذا حلبها فليمسكها وان كرهها فليردها ومعها صاع من تمر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4488-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4488-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Hadith"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4488-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad2a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4489,
      "bookHadithIndex": 41,
      "text": "اخبرنا محمد بن منصور، قال حدثنا سفيان، عن ايوب، عن محمد، قال سمعت ابا هريرة، يقول قال ابو القاسم صلى الله عليه وسلم \" من ابتاع محفلة او مصراة فهو بالخيار ثلاثة ايام ان شاء ان يمسكها امسكها وان شاء ان يردها ردها وصاعا من تمر لا سمراء",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4489-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4489-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Hadith"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4489-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad2b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4490,
      "bookHadithIndex": 42,
      "text": "اخبرنا اسحاق بن ابراهيم، قال حدثنا عيسى بن يونس، ووكيع، قالا حدثنا ابن ابي ذيب، عن مخلد بن خفاف، عن عروة، عن عايشة، قالت قضى رسول الله صلى الله عليه وسلم ان الخراج بالضمان",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4490-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4490-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4490-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad2c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4491,
      "bookHadithIndex": 43,
      "text": "اخبرني عبد الله بن محمد بن تميم، قال حدثنا حجاج، قال حدثني شعبة، عن عدي بن ثابت، عن ابي حازم، عن ابي هريرة، قال نهى رسول الله صلى الله عليه وسلم عن التلقي وان يبيع مهاجر للاعرابي وعن التصرية والنجش وان يستام الرجل على سوم اخيه وان تسال المراة طلاق اختها",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4491-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4491-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Hadith"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4491-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad2d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4492,
      "bookHadithIndex": 44,
      "text": "اخبرنا محمد بن بشار، قال حدثني محمد بن الزبرقان، قال حدثنا يونس بن عبيد، عن الحسن، عن انس، ان النبي صلى الله عليه وسلم نهى ان يبيع حاضر لباد وان كان اباه او اخاه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4492-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4492-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Hadith"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4492-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad2e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4493,
      "bookHadithIndex": 45,
      "text": "اخبرنا محمد بن المثنى، قال حدثني سالم بن نوح، قال انبانا يونس، عن محمد بن سيرين، عن انس بن مالك، قال نهينا ان يبيع، حاضر لباد وان كان اخاه او اباه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4493-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4493-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4493-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad2f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4494,
      "bookHadithIndex": 46,
      "text": "اخبرنا محمد بن عبد الاعلى، قال حدثنا خالد، قال حدثنا ابن عون، عن محمد، عن انس، قال نهينا ان يبيع، حاضر لباد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4494-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4494-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4494-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad30",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4495,
      "bookHadithIndex": 47,
      "text": "اخبرنا ابراهيم بن الحسن، قال حدثنا حجاج، قال قال ابن جريج اخبرني ابو الزبير، انه سمع جابرا، يقول قال رسول الله صلى الله عليه وسلم \" لا يبيع حاضر لباد دعوا الناس يرزق الله بعضهم من بعض",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4495-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4495-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4495-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad31",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4496,
      "bookHadithIndex": 48,
      "text": "اخبرنا قتيبة، عن مالك، عن ابي الزناد، عن الاعرج، عن ابي هريرة، ان رسول الله صلى الله عليه وسلم قال \" لا تلقوا الركبان للبيع ولا يبع بعضكم على بيع بعض - ولا تناجشوا - ولا يبيع حاضر لباد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4496-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4496-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Hadith"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4496-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad32",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4497,
      "bookHadithIndex": 49,
      "text": "اخبرنا عبد الرحمن بن عبد الله بن عبد الحكم بن اعين، قال حدثنا شعيب بن الليث، عن ابيه، عن كثير بن فرقد، عن نافع، عن عبد الله، عن رسول الله صلى الله عليه وسلم انه نهى عن النجش والتلقي وان يبيع حاضر لباد",
      "grades": [

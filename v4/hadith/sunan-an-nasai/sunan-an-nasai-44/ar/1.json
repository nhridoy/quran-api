        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad19",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4472,
      "bookHadithIndex": 24,
      "text": "اخبرنا قتيبة، قال حدثنا الليث، عن نافع، عن ابن عمر، عن رسول الله صلى الله عليه وسلم قال \" اذا تبايع الرجلان فكل واحد منهما بالخيار حتى يفترقا \" . وقال مرة اخرى \" ما لم يتفرقا وكانا جميعا او يخير احدهما الاخر فان خير احدهما الاخر فتبايعا على ذلك فقد وجب البيع فان تفرقا بعد ان تبايعا ولم يترك واحد منهما البيع فقد وجب البيع",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4472-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"

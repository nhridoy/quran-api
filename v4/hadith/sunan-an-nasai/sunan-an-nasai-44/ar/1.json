          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad16",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4469,
      "bookHadithIndex": 21,
      "text": "اخبرنا عمرو بن علي، قال حدثنا عبد الاعلى، قال حدثنا سعيد، عن ايوب، عن نافع، عن ابن عمر، ان رسول الله صلى الله عليه وسلم قال \" البيعان بالخيار ما لم يفترقا او يقول احدهما للاخر اختر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4469-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4469-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4469-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad17",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4470,
      "bookHadithIndex": 22,
      "text": "اخبرنا زياد بن ايوب، قال حدثنا ابن علية، قال انبانا ايوب، عن نافع، عن ابن عمر، قال قال رسول الله صلى الله عليه وسلم \" البيعان بالخيار حتى يفترقا او يكون بيع خيار \" . وربما قال نافع \" او يقول احدهما للاخر اختر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4470-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {

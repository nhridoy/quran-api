        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad18",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4471,
      "bookHadithIndex": 23,
      "text": "اخبرنا قتيبة، قال حدثنا الليث، عن نافع، عن ابن عمر، قال قال رسول الله صلى الله عليه وسلم \" البيعان بالخيار حتى يفترقا او يكون بيع خيار \" . وربما قال نافع \" او يقول احدهما للاخر اختر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4471-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4471-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },

    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad58",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4535,
      "bookHadithIndex": 87,
      "text": "اخبرنا قتيبة بن سعيد، قال حدثنا ابو الاحوص، عن طارق، عن سعيد بن المسيب، عن رافع بن خديج، قال نهى رسول الله صلى الله عليه وسلم عن المحاقلة والمزابنة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4535-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4535-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {

        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad45",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4516,
      "bookHadithIndex": 68,
      "text": "اخبرنا هارون بن زيد بن ابي الزرقاء، قال حدثنا ابي قال، حدثنا جعفر بن برقان، قال بلغني عن الزهري، عن سالم، عن ابيه، قال نهى رسول الله صلى الله عليه وسلم عن لبستين ونهانا رسول الله صلى الله عليه وسلم عن بيعتين عن المنابذة والملامسة وهي بيوع كانوا يتبايعون بها في الجاهلية",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4516-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4516-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4516-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad46",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4517,
      "bookHadithIndex": 69,
      "text": "اخبرنا محمد بن عبد الاعلى، قال حدثنا المعتمر، قال سمعت عبيد الله، عن خبيب، عن حفص بن عاصم، عن ابي هريرة، عن النبي صلى الله عليه وسلم انه نهى عن بيعتين اما البيعتان فالمنابذة والملامسة وزعم ان الملامسة ان يقول الرجل للرجل ابيعك ثوبي بثوبك ولا ينظر واحد منهما الى ثوب الاخر ولكن يلمسه لمسا واما المنابذة ان يقول انبذ ما معي وتنبذ ما معك ليشتري احدهما من الاخر ولا يدري كل واحد منهما كم مع الاخر ونحوا من هذا الوصف",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4517-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4517-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4517-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad47",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4518,
      "bookHadithIndex": 70,
      "text": "اخبرنا عبيد الله بن سعيد، قال حدثنا يحيى، عن عبيد الله، قال اخبرني ابو الزناد، عن الاعرج، عن ابي هريرة، قال نهى رسول الله صلى الله عليه وسلم عن بيع الحصاة وعن بيع الغرر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4518-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4518-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4518-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad48",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4519,
      "bookHadithIndex": 71,
      "text": "اخبرنا قتيبة، قال حدثنا الليث، عن نافع، عن ابن عمر، عن رسول الله صلى الله عليه وسلم قال \" لا تبيعوا الثمر حتى يبدو صلاحه \" . نهى البايع والمشتري",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4519-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4519-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4519-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad49",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4520,
      "bookHadithIndex": 72,
      "text": "اخبرنا قتيبة بن سعيد، قال حدثنا سفيان، عن الزهري، عن سالم، عن ابيه، ان رسول الله صلى الله عليه وسلم نهى عن بيع الثمر حتى يبدو صلاحه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4520-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4520-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4520-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad4a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4521,
      "bookHadithIndex": 73,
      "text": "اخبرني يونس بن عبد الاعلى، والحارث بن مسكين، قراءة عليه وانا اسمع، عن ابن وهب، اخبرني يونس، عن ابن شهاب، قال حدثني سعيد، وابو سلمة ان ابا هريرة، قال قال رسول الله صلى الله عليه وسلم \" لا تبيعوا الثمر حتى يبدو صلاحه ولا تبتاعوا الثمر بالتمر \" . قال ابن شهاب حدثني سالم بن عبد الله عن ابيه ان رسول الله صلى الله عليه وسلم نهى عن مثله سواء",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4521-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4521-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4521-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad4b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4522,
      "bookHadithIndex": 74,
      "text": "اخبرنا عبد الحميد بن محمد، قال حدثنا مخلد بن يزيد، قال حدثنا حنظلة، قال سمعت طاوسا، يقول سمعت عبد الله بن عمر، يقول قام فينا رسول الله صلى الله عليه وسلم فقال \" لا تبيعوا الثمر حتى يبدو صلاحه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4522-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4522-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4522-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad4c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4523,
      "bookHadithIndex": 75,
      "text": "حدثنا محمد بن منصور، قال حدثنا سفيان، عن ابن جريج، عن عطاء، سمعت جابر بن عبد الله، عن النبي صلى الله عليه وسلم انه نهى عن المخابرة والمزابنة والمحاقلة وان يباع الثمر حتى يبدو صلاحه وان لا يباع الا بالدنانير والدراهم ورخص في العرايا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4523-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4523-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Hadith"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4523-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad4d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4524,
      "bookHadithIndex": 76,
      "text": "اخبرنا قتيبة، قال حدثنا المفضل، عن ابن جريج، عن عطاء، وابي الزبير، عن جابر، ان النبي صلى الله عليه وسلم نهى عن المخابرة والمزابنة والمحاقلة وبيع الثمر حتى يطعم الا العرايا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4524-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4524-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Hadith"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4524-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad4e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4525,
      "bookHadithIndex": 77,
      "text": "اخبرنا محمد بن عبد الاعلى، قال حدثنا خالد، قال حدثنا هشام، عن ابي الزبير، عن جابر، قال نهى رسول الله صلى الله عليه وسلم عن بيع النخل حتى يطعم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4525-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4525-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4525-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad4f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4526,
      "bookHadithIndex": 78,
      "text": "اخبرنا محمد بن سلمة، والحارث بن مسكين، قراءة عليه وانا اسمع، - واللفظ له - عن ابن القاسم، قال حدثني مالك، عن حميد الطويل، عن انس بن مالك، ان رسول الله صلى الله عليه وسلم نهى عن بيع الثمار حتى تزهي . قيل يا رسول الله وما تزهي قال \" حتى تحمر \" . وقال رسول الله صلى الله عليه وسلم \" ارايت ان منع الله الثمرة فبم ياخذ احدكم مال اخيه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4526-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4526-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Hadith"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4526-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad50",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4527,
      "bookHadithIndex": 79,
      "text": "اخبرنا ابراهيم بن الحسن، قال حدثنا حجاج، قال قال ابن جريج اخبرني ابو الزبير، انه سمع جابرا، يقول قال رسول الله صلى الله عليه وسلم \" ان بعت من اخيك ثمرا فاصابته جايحة فلا يحل لك ان تاخذ منه شييا بم تاخذ مال اخيك بغير حق",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4527-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4527-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4527-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad51",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4528,
      "bookHadithIndex": 80,
      "text": "اخبرنا هشام بن عمار، قال حدثنا يحيى بن حمزة، قال حدثنا ثور بن يزيد، انه سمع ابن جريج، يحدث عن ابي الزبير المكي، عن جابر بن عبد الله، ان رسول الله صلى الله عليه وسلم قال \" من باع ثمرا فاصابته جايحة فلا ياخذ من اخيه - وذكر شييا - على ما ياكل احدكم مال اخيه المسلم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4528-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4528-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4528-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad52",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4529,
      "bookHadithIndex": 81,
      "text": "اخبرنا محمد بن عبد الله بن يزيد، قال حدثنا سفيان، عن حميد، - وهو الاعرج - عن سليمان بن عتيق، عن جابر، ان النبي صلى الله عليه وسلم وضع الجوايح",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4529-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4529-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4529-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad53",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4530,
      "bookHadithIndex": 82,
      "text": "اخبرنا قتيبة بن سعيد، قال حدثنا الليث، عن بكير، عن عياض بن عبد الله، عن ابي سعيد الخدري، قال اصيب رجل في عهد رسول الله صلى الله عليه وسلم في ثمار ابتاعها فكثر دينه فقال رسول الله صلى الله عليه وسلم \" تصدقوا عليه \" . فتصدق الناس عليه فلم يبلغ ذلك وفاء دينه فقال رسول الله صلى الله عليه وسلم \" خذوا ما وجدتم وليس لكم الا ذلك",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4530-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4530-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4530-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad54",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4531,
      "bookHadithIndex": 83,
      "text": "اخبرنا قتيبة بن سعيد، قال حدثنا سفيان، عن حميد الاعرج، عن سليمان بن عتيك، - قال قتيبة عتيك بالكاف والصواب عتيق - عن جابر عن النبي صلى الله عليه وسلم نهى عن بيع الثمر سنين",
      "grades": [

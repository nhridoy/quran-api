          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad59",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4536,
      "bookHadithIndex": 88,
      "text": "اخبرنا قتيبة بن سعيد، قال حدثنا سفيان، عن الزهري، عن سالم، عن ابيه، قال حدثني زيد بن ثابت، ان رسول الله صلى الله عليه وسلم رخص في العرايا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4536-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4536-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4536-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad5a",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4537,
      "bookHadithIndex": 89,
      "text": "قال الحارث بن مسكين قراءة عليه وانا اسمع، عن ابن وهب، قال اخبرني يونس، عن ابن شهاب، قال حدثني خارجة بن زيد بن ثابت، عن ابيه، ان رسول الله صلى الله عليه وسلم رخص في العرايا بالتمر والرطب",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4537-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4537-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4537-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad5b",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4538,
      "bookHadithIndex": 90,
      "text": "اخبرنا عبيد الله بن سعيد، قال حدثنا يحيى، عن عبيد الله، قال اخبرني نافع، عن عبد الله، عن زيد بن ثابت، ان رسول الله صلى الله عليه وسلم رخص في بيع العرايا تباع بخرصها",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4538-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4538-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4538-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad5c",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4539,
      "bookHadithIndex": 91,
      "text": "حدثنا عيسى بن حماد، قال حدثنا الليث، عن يحيى بن سعيد، عن نافع، عن ابن عمر، قال حدثني زيد بن ثابت، ان رسول الله صلى الله عليه وسلم رخص في بيع العرية بخرصها تمرا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4539-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4539-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4539-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad5d",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4540,
      "bookHadithIndex": 92,
      "text": "اخبرنا ابو داود، قال حدثنا يعقوب بن ابراهيم، قال حدثنا ابي، عن صالح، عن ابن شهاب، ان سالما، اخبره انه، سمع عبد الله بن عمر، يقول ان زيد بن ثابت اخبره ان رسول الله صلى الله عليه وسلم رخص في بيع العرايا بالرطب وبالتمر ولم يرخص في غير ذلك",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4540-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4540-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Hadith"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4540-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad5e",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4541,
      "bookHadithIndex": 93,
      "text": "اخبرنا اسحاق بن منصور، ويعقوب بن ابراهيم، - واللفظ له - عن عبد الرحمن، عن مالك، عن داود بن الحصين، عن ابي سفيان، عن ابي هريرة، ان النبي صلى الله عليه وسلم رخص في العرايا ان تباع بخرصها في خمسة اوسق او ما دون خمسة اوسق",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4541-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4541-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Hadith"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4541-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad5f",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4542,
      "bookHadithIndex": 94,
      "text": "اخبرنا عبد الله بن محمد بن عبد الرحمن، قال حدثنا سفيان، عن يحيى، عن بشير بن يسار، عن سهل بن ابي حثمة، ان النبي صلى الله عليه وسلم نهى عن بيع الثمر حتى يبدو صلاحه ورخص في العرايا ان تباع بخرصها ياكلها اهلها رطبا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4542-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4542-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Hadith"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4542-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad60",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4543,
      "bookHadithIndex": 95,
      "text": "اخبرنا الحسين بن عيسى، قال حدثنا ابو اسامة، قال حدثني الوليد بن كثير، قال اخبرني بشير بن يسار، ان رافع بن خديج، وسهل بن ابي حثمة، حدثاه ان رسول الله صلى الله عليه وسلم نهى عن المزابنة بيع الثمر بالتمر الا لاصحاب العرايا فانه اذن لهم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4543-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4543-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4543-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad61",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4544,
      "bookHadithIndex": 96,
      "text": "اخبرنا قتيبة بن سعيد، قال حدثنا الليث، عن يحيى، عن بشير بن يسار، عن اصحاب، رسول الله صلى الله عليه وسلم انهم قالوا رخص رسول الله صلى الله عليه وسلم في بيع العرايا بخرصها",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4544-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4544-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4544-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad62",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4545,
      "bookHadithIndex": 97,
      "text": "اخبرنا عمرو بن علي، قال حدثنا يحيى، قال حدثنا مالك، قال حدثني عبد الله بن يزيد، عن زيد بن عياش، عن سعد، قال سيل رسول الله صلى الله عليه وسلم عن التمر بالرطب فقال لمن حوله \" اينقص الرطب اذا يبس \" . قالوا نعم . فنهى عنه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4545-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4545-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4545-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad63",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4546,
      "bookHadithIndex": 98,
      "text": "اخبرنا محمد بن علي بن ميمون، قال حدثنا محمد بن يوسف الفريابي، قال حدثنا سفيان، عن اسماعيل بن امية، عن عبد الله بن يزيد، عن زيد، عن سعد بن مالك، قال سيل رسول الله صلى الله عليه وسلم عن الرطب بالتمر فقال \" اينقص اذا يبس \" . قالوا نعم . فنهى عنه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4546-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4546-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4546-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad64",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4547,
      "bookHadithIndex": 99,
      "text": "اخبرنا ابراهيم بن الحسن، قال حدثنا حجاج، قال ابن جريج اخبرني ابو الزبير، انه سمع جابر بن عبد الله، يقول نهى رسول الله صلى الله عليه وسلم عن بيع الصبرة من التمر لا يعلم مكيلها بالكيل المسمى من التمر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4547-abughuddah",
          "name": "Abu Ghuddah",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4547-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Hadith"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1321-44-4547-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c6aadd1a4c9c86f0ad65",
      "editionId": "69b55e8d6f42ba7ccb2a1321",
      "bookIndex": 44,
      "hadithIndex": 4548,
      "bookHadithIndex": 100,
      "text": "اخبرنا ابراهيم بن الحسن، قال حدثنا حجاج، قال ابن جريج اخبرني ابو الزبير، انه سمع جابر بن عبد الله، يقول قال النبي صلى الله عليه وسلم \" لا تباع الصبرة من الطعام بالصبرة من الطعام ولا الصبرة من الطعام بالكيل المسمى من الطعام",
      "grades": [
        {

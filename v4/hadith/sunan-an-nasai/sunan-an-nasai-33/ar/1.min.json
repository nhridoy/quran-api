{"total":14,"totalPage":1,"page":1,"pageSize":50,"items":[{"id":"69b6c6aadd1a4c9c86f0aa1a","editionId":"69b55e8d6f42ba7ccb2a1321","bookIndex":33,"hadithIndex":3706,"bookHadithIndex":1,"text":"اخبرنا هلال بن العلاء، قال حدثنا ابي قال، حدثنا عبيد الله، - وهو ابن عمرو - عن سفيان، عن ابن ابي نجيح، عن طاوس، عن زيد بن ثابت، عن النبي صلى الله عليه وسلم قال \" الرقبى جايزة","grades":[{"id":"69b55e8d6f42ba7ccb2a1321-33-3706-abughuddah","name":"Abu Ghuddah","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3706-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3706-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c6aadd1a4c9c86f0aa1b","editionId":"69b55e8d6f42ba7ccb2a1321","bookIndex":33,"hadithIndex":3707,"bookHadithIndex":2,"text":"اخبرني محمد بن علي بن ميمون، قال حدثنا محمد، - وهو ابن يوسف - قال حدثنا سفيان، عن ابن ابي نجيح، عن طاوس، عن رجل، عن زيد بن ثابت، ان النبي صلى الله عليه وسلم جعل الرقبى للذي ارقبها","grades":[{"id":"69b55e8d6f42ba7ccb2a1321-33-3707-abughuddah","name":"Abu Ghuddah","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3707-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3707-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c6aadd1a4c9c86f0aa1c","editionId":"69b55e8d6f42ba7ccb2a1321","bookIndex":33,"hadithIndex":3708,"bookHadithIndex":3,"text":"اخبرنا زكريا بن يحيى، قال حدثنا عبد الجبار بن العلاء، قال حدثنا سفيان، عن ابن ابي نجيح، عن طاوس، لعله عن ابن عباس، قال لا رقبى فمن ارقب شييا فهو سبيل الميراث","grades":[{"id":"69b55e8d6f42ba7ccb2a1321-33-3708-abughuddah","name":"Abu Ghuddah","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3708-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3708-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c6aadd1a4c9c86f0aa1d","editionId":"69b55e8d6f42ba7ccb2a1321","bookIndex":33,"hadithIndex":3709,"bookHadithIndex":4,"text":"اخبرني محمد بن وهب، قال حدثنا محمد بن سلمة، قال حدثني ابو عبد الرحيم، قال حدثني زيد، عن ابي الزبير، عن طاوس، عن ابن عباس، عن رسول الله صلى الله عليه وسلم قال \" لا ترقبوا اموالكم فمن ارقب شييا فهو لمن ارقبه","grades":[{"id":"69b55e8d6f42ba7ccb2a1321-33-3709-abughuddah","name":"Abu Ghuddah","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3709-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3709-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c6aadd1a4c9c86f0aa1e","editionId":"69b55e8d6f42ba7ccb2a1321","bookIndex":33,"hadithIndex":3710,"bookHadithIndex":5,"text":"اخبرنا احمد بن حرب، قال حدثنا ابو معاوية، عن حجاج، عن ابي الزبير، عن طاوس، عن ابن عباس، قال قال رسول الله صلى الله عليه وسلم \" العمرى جايزة لمن اعمرها والرقبى جايزة لمن ارقبها والعايد في هبته كالعايد في قييه","grades":[{"id":"69b55e8d6f42ba7ccb2a1321-33-3710-abughuddah","name":"Abu Ghuddah","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3710-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3710-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c6aadd1a4c9c86f0aa1f","editionId":"69b55e8d6f42ba7ccb2a1321","bookIndex":33,"hadithIndex":3711,"bookHadithIndex":6,"text":"اخبرنا محمد بن بشار، قال حدثنا يحيى، قال حدثنا سفيان، عن ابي الزبير، عن طاوس، عن ابن عباس، قال العمرى والرقبى سواء","grades":[{"id":"69b55e8d6f42ba7ccb2a1321-33-3711-abughuddah","name":"Abu Ghuddah","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3711-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3711-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c6aadd1a4c9c86f0aa20","editionId":"69b55e8d6f42ba7ccb2a1321","bookIndex":33,"hadithIndex":3712,"bookHadithIndex":7,"text":"اخبرنا احمد بن سليمان، قال حدثنا يعلى، قال حدثنا سفيان، عن ابي الزبير، عن طاوس، عن ابن عباس، قال لا تحل الرقبى ولا العمرى فمن اعمر شييا فهو له ومن ارقب شييا فهو له","grades":[{"id":"69b55e8d6f42ba7ccb2a1321-33-3712-abughuddah","name":"Abu Ghuddah","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3712-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3712-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c6aadd1a4c9c86f0aa21","editionId":"69b55e8d6f42ba7ccb2a1321","bookIndex":33,"hadithIndex":3713,"bookHadithIndex":8,"text":"اخبرنا احمد بن سليمان، قال حدثنا محمد بن بشر، قال حدثنا حجاج، عن ابي الزبير، عن طاوس، عن ابن عباس، قال لا تصلح العمرى ولا الرقبى فمن اعمر شييا او ارقبه فانه لمن اعمره وارقبه حياته وموته . ارسله حنظلة","grades":[{"id":"69b55e8d6f42ba7ccb2a1321-33-3713-abughuddah","name":"Abu Ghuddah","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3713-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3713-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c6aadd1a4c9c86f0aa22","editionId":"69b55e8d6f42ba7ccb2a1321","bookIndex":33,"hadithIndex":3714,"bookHadithIndex":9,"text":"اخبرنا محمد بن حاتم، قال انبانا حبان، قال حدثنا عبد الله، عن حنظلة، انه سمع طاوسا، يقول قال رسول الله صلى الله عليه وسلم \" لا تحل الرقبى فمن ارقب رقبى فهو سبيل الميراث","grades":[{"id":"69b55e8d6f42ba7ccb2a1321-33-3714-abughuddah","name":"Abu Ghuddah","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3714-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3714-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c6aadd1a4c9c86f0aa23","editionId":"69b55e8d6f42ba7ccb2a1321","bookIndex":33,"hadithIndex":3715,"bookHadithIndex":10,"text":"اخبرني عبدة بن عبد الرحيم، عن وكيع، قال حدثنا سفيان، عن ابن ابي نجيح، عن طاوس، عن زيد بن ثابت، قال قال رسول الله صلى الله عليه وسلم \" العمرى ميراث","grades":[{"id":"69b55e8d6f42ba7ccb2a1321-33-3715-abughuddah","name":"Abu Ghuddah","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3715-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3715-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c6aadd1a4c9c86f0aa24","editionId":"69b55e8d6f42ba7ccb2a1321","bookIndex":33,"hadithIndex":3716,"bookHadithIndex":11,"text":"اخبرنا محمد بن عبد الله بن يزيد، قال حدثنا سفيان، عن ابن طاوس، عن ابيه، عن حجر المدري، عن زيد، قال قال رسول الله صلى الله عليه وسلم \" العمرى للوارث","grades":[{"id":"69b55e8d6f42ba7ccb2a1321-33-3716-abughuddah","name":"Abu Ghuddah","grade":"Sahih Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3716-alalbani","name":"Al-Albani","grade":"Sahih Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3716-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c6aadd1a4c9c86f0aa25","editionId":"69b55e8d6f42ba7ccb2a1321","bookIndex":33,"hadithIndex":3717,"bookHadithIndex":12,"text":"اخبرنا محمد بن عبيد، قال حدثنا عبد الله بن المبارك، عن معمر، عن ابن طاوس، عن ابيه، عن حجر المدري، عن زيد بن ثابت، عن النبي صلى الله عليه وسلم قال \" العمرى جايزة","grades":[{"id":"69b55e8d6f42ba7ccb2a1321-33-3717-abughuddah","name":"Abu Ghuddah","grade":"Sahih Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3717-alalbani","name":"Al-Albani","grade":"Sahih Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3717-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c6aadd1a4c9c86f0aa26","editionId":"69b55e8d6f42ba7ccb2a1321","bookIndex":33,"hadithIndex":3718,"bookHadithIndex":13,"text":"اخبرنا محمد بن عبيد، عن ابن المبارك، عن معمر، عن عمرو بن دينار، عن طاوس، عن زيد بن ثابت، عن النبي صلى الله عليه وسلم قال \" العمرى للوارث","grades":[{"id":"69b55e8d6f42ba7ccb2a1321-33-3718-abughuddah","name":"Abu Ghuddah","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3718-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3718-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c6aadd1a4c9c86f0aa27","editionId":"69b55e8d6f42ba7ccb2a1321","bookIndex":33,"hadithIndex":3719,"bookHadithIndex":14,"text":"اخبرنا محمد بن حاتم، قال انبانا حبان، قال انبانا عبد الله، عن معمر، قال سمعت عمرو بن دينار، يحدث عن طاوس، عن حجر المدري، عن زيد بن ثابت، ان رسول الله صلى الله عليه وسلم قال \" العمرى للوارث \" . والله اعلم","grades":[{"id":"69b55e8d6f42ba7ccb2a1321-33-3719-abughuddah","name":"Abu Ghuddah","grade":"Sahih Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3719-alalbani","name":"Al-Albani","grade":"Sahih Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1321-33-3719-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]}]}
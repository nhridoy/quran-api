{"total":54,"totalPage":2,"page":2,"pageSize":50,"items":[{"id":"69b6c788dd1a4c9c86f0ba52","editionId":"69b55e8d6f42ba7ccb2a1322","bookIndex":28,"hadithIndex":2086,"bookHadithIndex":51,"text":"انس بن مالک رضی الله عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”جب مریض صحت یاب اور تندرست ہو جائے تو شفافیت اور رنگ میں اس کی مثال اس اولے کی طرح ہے جو آسمان سے گرتا ہے“۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1322-28-2086-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c788dd1a4c9c86f0ba53","editionId":"69b55e8d6f42ba7ccb2a1322","bookIndex":28,"hadithIndex":2087,"bookHadithIndex":52,"text":"ابو سعید خدری رضی الله عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”جب تم مریض کے پاس جاؤ تو موت کے سلسلے میں اس کا غم دور کرو ۱؎ یہ تقدیر تو نہیں بدلتا ہے لیکن مریض کا دل خوش کر دیتا ہے“۔ امام ترمذی کہتے ہیں: یہ حدیث غریب ہے۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1322-28-2087-ahmadmuhammadshakir","name":"Ahmad Muhammad Shakir","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1322-28-2087-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1322-28-2087-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c788dd1a4c9c86f0ba54","editionId":"69b55e8d6f42ba7ccb2a1322","bookIndex":28,"hadithIndex":2088,"bookHadithIndex":53,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1322-28-2088-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c788dd1a4c9c86f0ba55","editionId":"69b55e8d6f42ba7ccb2a1322","bookIndex":28,"hadithIndex":2089,"bookHadithIndex":54,"text":"","grades":[]}]}
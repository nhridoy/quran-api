      "bookIndex": 9,
      "hadithIndex": 958,
      "bookHadithIndex": 152,
      "text": "Ali narrated:\"They day of Al-Hajj Al-Akbar is the Day of An-Nahr",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1322-9-958-ahmadmuhammadshakir",
          "name": "Ahmad Muhammad Shakir",
          "grade": "Sahih"
        },
        {

      ]
    },
    {
      "id": "69b6c745dd1a4c9c86f0b915",
      "editionId": "69b55e8d6f42ba7ccb2a1322",
      "bookIndex": 24,
      "hadithIndex": 1772,
      "bookHadithIndex": 60,
      "text": "حدثنا محمد بن بشار، حدثنا ابو داود، حدثنا همام، عن قتادة، قال قلت لانس بن مالك كيف كان نعل رسول الله صلى الله عليه وسلم قال لهما قبالان . قال ابو عيسى هذا حديث حسن صحيح",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1772-ahmadmuhammadshakir",
          "name": "Ahmad Muhammad Shakir",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1772-alalbani",

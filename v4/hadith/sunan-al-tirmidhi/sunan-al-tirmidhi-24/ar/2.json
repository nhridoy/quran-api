          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1772-basharawadmaarouf",
          "name": "Bashar Awad Maarouf",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1772-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c745dd1a4c9c86f0b916",
      "editionId": "69b55e8d6f42ba7ccb2a1322",
      "bookIndex": 24,
      "hadithIndex": 1773,
      "bookHadithIndex": 61,
      "text": "حدثنا اسحاق بن منصور، اخبرنا حبان بن هلال، حدثنا همام، حدثنا قتادة، عن انس، ان رسول الله صلى الله عليه وسلم كان نعلاه لهما قبالان . قال ابو عيسى هذا حديث حسن صحيح . قال وفي الباب عن ابن عباس وابي هريرة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1773-ahmadmuhammadshakir",
          "name": "Ahmad Muhammad Shakir",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1773-alalbani",

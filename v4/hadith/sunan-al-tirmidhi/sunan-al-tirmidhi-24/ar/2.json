          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1779-basharawadmaarouf",
          "name": "Bashar Awad Maarouf",
          "grade": "Hasan Sahih"
        },
        {

    {
      "id": "69b6c745dd1a4c9c86f0b91f",
      "editionId": "69b55e8d6f42ba7ccb2a1322",
      "bookIndex": 24,
      "hadithIndex": 1782,
      "bookHadithIndex": 71,
      "text": "حدثنا حميد بن مسعدة، حدثنا محمد بن حمران، عن ابي سعيد، وهو عبد الله بن بسر قال سمعت ابا كبشة الانماري، يقول كانت كمام اصحاب رسول الله صلى الله عليه وسلم بطحا . قال ابو عيسى هذا حديث منكر . وعبد الله بن بسر بصري هو ضعيف عند اهل الحديث ضعفه يحيى بن سعيد وغيره . وبطح يعني واسعة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1782-ahmadmuhammadshakir",
          "name": "Ahmad Muhammad Shakir",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1782-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1782-basharawadmaarouf",
          "name": "Bashar Awad Maarouf",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1782-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c745dd1a4c9c86f0b920",
      "editionId": "69b55e8d6f42ba7ccb2a1322",
      "bookIndex": 24,
      "hadithIndex": 1783,
      "bookHadithIndex": 72,
      "text": "حدثنا قتيبة، حدثنا ابو الاحوص، عن ابي اسحاق، عن مسلم بن نذير، عن حذيفة، قال اخذ رسول الله صلى الله عليه وسلم بعضلة ساقي او ساقه فقال \" هذا موضع الازار فان ابيت فاسفل فان ابيت فلا حق للازار في الكعبين \" . قال ابو عيسى هذا حديث حسن صحيح . رواه الثوري وشعبة عن ابي اسحاق",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1783-ahmadmuhammadshakir",
          "name": "Ahmad Muhammad Shakir",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1783-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1783-basharawadmaarouf",
          "name": "Bashar Awad Maarouf",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1783-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c745dd1a4c9c86f0b921",
      "editionId": "69b55e8d6f42ba7ccb2a1322",
      "bookIndex": 24,
      "hadithIndex": 1784,
      "bookHadithIndex": 73,
      "text": "حدثنا قتيبة، حدثنا محمد بن ربيعة، عن ابي الحسن العسقلاني، عن ابي جعفر بن محمد بن ركانة، عن ابيه، ان ركانة، صارع النبي صلى الله عليه وسلم فصرعه النبي صلى الله عليه وسلم قال ركانة سمعت رسول الله صلى الله عليه وسلم يقول \" ان فرق ما بيننا وبين المشركين العمايم على القلانس \" . قال ابو عيسى هذا حديث غريب واسناده ليس بالقايم . ولا نعرف ابا الحسن العسقلاني ولا ابن ركانة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1784-ahmadmuhammadshakir",
          "name": "Ahmad Muhammad Shakir",
          "grade": "Daif"

    {
      "id": "69b6c745dd1a4c9c86f0b914",
      "editionId": "69b55e8d6f42ba7ccb2a1322",
      "bookIndex": 24,
      "hadithIndex": 1771,
      "bookHadithIndex": 59,
      "text": "حدثنا محمد بن بشار، حدثنا محمد بن جعفر، حدثنا شعبة، عن يزيد الرشك، عن ابي المليح، عن النبي صلى الله عليه وسلم انه نهى عن جلود السباع . وهذا اصح",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1771-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"

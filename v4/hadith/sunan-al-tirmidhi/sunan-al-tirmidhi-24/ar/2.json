          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1773-basharawadmaarouf",
          "name": "Bashar Awad Maarouf",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1773-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c745dd1a4c9c86f0b917",
      "editionId": "69b55e8d6f42ba7ccb2a1322",
      "bookIndex": 24,
      "hadithIndex": 1774,
      "bookHadithIndex": 62,
      "text": "حدثنا قتيبة، عن مالك، ح وحدثنا الانصاري، حدثنا معن، حدثنا مالك، عن ابي الزناد، عن الاعرج، عن ابي هريرة، ان رسول الله صلى الله عليه وسلم قال \" لا يمشي احدكم في نعل واحدة لينعلهما جميعا او ليحفهما جميعا \" . قال ابو عيسى هذا حديث حسن صحيح . قال وفي الباب عن جابر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1774-ahmadmuhammadshakir",
          "name": "Ahmad Muhammad Shakir",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1774-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1774-basharawadmaarouf",
          "name": "Bashar Awad Maarouf",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1774-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c745dd1a4c9c86f0b918",
      "editionId": "69b55e8d6f42ba7ccb2a1322",
      "bookIndex": 24,
      "hadithIndex": 1775,
      "bookHadithIndex": 63,
      "text": "حدثنا ازهر بن مروان البصري، حدثنا الحارث بن نبهان، عن معمر، عن عمار بن ابي عمار، عن ابي هريرة، قال نهى رسول الله صلى الله عليه وسلم ان ينتعل الرجل وهو قايم . قال ابو عيسى هذا حديث غريب . وروى عبيد الله بن عمرو الرقي هذا الحديث عن معمر عن قتادة عن انس وكلا الحديثين لا يصح عند اهل الحديث . والحارث بن نبهان ليس عندهم بالحافظ ولا نعرف لحديث قتادة عن انس اصلا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1775-ahmadmuhammadshakir",
          "name": "Ahmad Muhammad Shakir",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1775-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1775-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c745dd1a4c9c86f0b919",
      "editionId": "69b55e8d6f42ba7ccb2a1322",
      "bookIndex": 24,
      "hadithIndex": 1776,
      "bookHadithIndex": 64,
      "text": "حدثنا ابو جعفر السمناني، حدثنا سليمان بن عبيد الله الرقي، حدثنا عبيد الله بن عمرو الرقي، عن معمر، عن قتادة، عن انس، ان رسول الله صلى الله عليه وسلم نهى ان ينتعل الرجل وهو قايم . قال ابو عيسى هذا حديث غريب . وقال محمد بن اسماعيل ولا يصح هذا الحديث ولا حديث معمر عن عمار بن ابي عمار عن ابي هريرة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1776-ahmadmuhammadshakir",
          "name": "Ahmad Muhammad Shakir",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1776-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1776-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c745dd1a4c9c86f0b91a",
      "editionId": "69b55e8d6f42ba7ccb2a1322",
      "bookIndex": 24,
      "hadithIndex": 1777,
      "bookHadithIndex": 65,
      "text": "حدثنا القاسم بن دينار، حدثنا اسحاق بن منصور السلولي، كوفي حدثنا هريم بن سفيان البجلي الكوفي، عن ليث، عن عبد الرحمن بن القاسم، عن ابيه، عن عايشة، قالت ربما مشى النبي صلى الله عليه وسلم في نعل واحدة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1777-ahmadmuhammadshakir",
          "name": "Ahmad Muhammad Shakir",
          "grade": "Munkar"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1777-alalbani",
          "name": "Al-Albani",
          "grade": "Munkar"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1777-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c745dd1a4c9c86f0b91b",
      "editionId": "69b55e8d6f42ba7ccb2a1322",
      "bookIndex": 24,
      "hadithIndex": 1778,
      "bookHadithIndex": 66,
      "text": "حدثنا احمد بن منيع، حدثنا سفيان بن عيينة، عن عبد الرحمن بن القاسم، عن ابيه، عن عايشة، انها مشت بنعل واحدة . وهذا اصح . قال ابو عيسى وهكذا رواه سفيان الثوري وغير واحد عن عبد الرحمن بن القاسم موقوفا وهذا اصح",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1778-ahmadmuhammadshakir",
          "name": "Ahmad Muhammad Shakir",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1778-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1778-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c745dd1a4c9c86f0b91c",
      "editionId": "69b55e8d6f42ba7ccb2a1322",
      "bookIndex": 24,
      "hadithIndex": 1779,
      "bookHadithIndex": 67,
      "text": "حدثنا الانصاري، حدثنا معن، حدثنا مالك، ح وحدثنا قتيبة، عن مالك، عن ابي الزناد، عن الاعرج، عن ابي هريرة، ان رسول الله صلى الله عليه وسلم قال \" اذا انتعل احدكم فليبدا باليمين واذا نزع فليبدا بالشمال فلتكن اليمنى اولهما تنعل واخرهما تنزع \" . قال ابو عيسى هذا حديث حسن صحيح",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1779-ahmadmuhammadshakir",
          "name": "Ahmad Muhammad Shakir",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-24-1779-alalbani",

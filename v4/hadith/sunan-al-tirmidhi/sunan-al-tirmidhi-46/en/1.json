      ]
    },
    {
      "id": "69b6c7cedd1a4c9c86f0bdb8",
      "editionId": "69b55e8d6f42ba7ccb2a1322",
      "bookIndex": 46,
      "hadithIndex": 2938,
      "bookHadithIndex": 12,
      "text": "Narrated 'Aishah:that the Prophet (ﷺ) would recite: \"Furuhun Wa Raihanun Wa Jannatu Na'im (56:)",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1322-46-2938-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih Isnaad"
        },

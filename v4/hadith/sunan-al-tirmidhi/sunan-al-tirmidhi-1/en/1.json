          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c702dd1a4c9c86f0b24b",
      "editionId": "69b55e8d6f42ba7ccb2a1322",
      "bookIndex": 1,
      "hadithIndex": 43,
      "bookHadithIndex": 43,
      "text": "Abu Hurairah narrated:\"The Prophet performed Wudu two time (for each limb)",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1322-1-43-ahmadmuhammadshakir",
          "name": "Ahmad Muhammad Shakir",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-1-43-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-1-43-basharawadmaarouf",
          "name": "Bashar Awad Maarouf",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-1-43-zubairalizai",

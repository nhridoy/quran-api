      "bookIndex": 1,
      "hadithIndex": 42,
      "bookHadithIndex": 42,
      "text": "Ibn Abbas narrated:\"The Prophet performed Wudu one time (for each limb)",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1322-1-42-ahmadmuhammadshakir",
          "name": "Ahmad Muhammad Shakir",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-1-42-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {

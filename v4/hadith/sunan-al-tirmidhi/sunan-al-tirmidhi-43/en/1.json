          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-43-2759-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c788dd1a4c9c86f0bcfa",
      "editionId": "69b55e8d6f42ba7ccb2a1322",
      "bookIndex": 43,
      "hadithIndex": 2760,
      "bookHadithIndex": 30,
      "text": "Narrated Ibn 'Abbas:\"The Prophet (ﷺ) would pare, or take from his mustache, and Ibrahim Khalilur-Rahman would do it (as well)",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1322-43-2760-ahmadmuhammadshakir",
          "name": "Ahmad Muhammad Shakir",
          "grade": "Daif Isnaad"

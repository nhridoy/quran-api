          "id": "69b55e8d6f42ba7ccb2a1322-43-2760-alalbani",
          "name": "Al-Albani",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-43-2760-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c788dd1a4c9c86f0bcfb",
      "editionId": "69b55e8d6f42ba7ccb2a1322",
      "bookIndex": 43,
      "hadithIndex": 2761,
      "bookHadithIndex": 31,
      "text": "Narrated Zaid bin Arqam:that the Messenger of Allah (ﷺ) said: \"Whoever does not take from his mustache, then he is not from us",

          "id": "69b55e8d6f42ba7ccb2a1322-43-2768-basharawadmaarouf",
          "name": "Bashar Awad Maarouf",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-43-2768-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c788dd1a4c9c86f0bd03",
      "editionId": "69b55e8d6f42ba7ccb2a1322",
      "bookIndex": 43,
      "hadithIndex": 2769,
      "bookHadithIndex": 39,
      "text": "Narrated Bahz bin Hakim:\"My father narrated to me from my grandfather, who said: 'I said: \"O Messenger of Allah! Regarding our 'Awrah, what of it must we cover and what of it may we leave?\" He said: \"Protect your 'Awrah except from your wife or what your right hand possesses.\"' He said: \"What about a man with another man?\" He said: \"If you are able to not let anyone see it, then do so.\" I said: \"What about a man when he is alone?\" He said: \"Allah is most deserving of being shy from Him",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1322-43-2769-ahmadmuhammadshakir",
          "name": "Ahmad Muhammad Shakir",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-43-2769-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-43-2769-basharawadmaarouf",
          "name": "Bashar Awad Maarouf",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-43-2769-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },

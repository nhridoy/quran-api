    {
      "id": "69b6c788dd1a4c9c86f0bd06",
      "editionId": "69b55e8d6f42ba7ccb2a1322",
      "bookIndex": 43,
      "hadithIndex": 2772,
      "bookHadithIndex": 42,
      "text": "Narrated Abu Mas'ud:that the Messenger of Allah (ﷺ) said: \"A man is not lead in his dominion, and his seat of honor in his house is not sat in without his permission",

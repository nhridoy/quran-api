          "name": "Al-Albani",
          "grade": "Mawdu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-43-2762-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c788dd1a4c9c86f0bcfd",
      "editionId": "69b55e8d6f42ba7ccb2a1322",
      "bookIndex": 43,
      "hadithIndex": 2763,
      "bookHadithIndex": 33,
      "text": "Narrated Ibn 'Umar:that the Messenger of Allah (ﷺ) said: \"Trim the mustache and leave the beard to grow",

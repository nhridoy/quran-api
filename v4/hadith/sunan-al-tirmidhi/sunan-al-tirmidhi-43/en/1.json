    },
    {
      "id": "69b6c788dd1a4c9c86f0bd02",
      "editionId": "69b55e8d6f42ba7ccb2a1322",
      "bookIndex": 43,
      "hadithIndex": 2768,
      "bookHadithIndex": 38,
      "text": "Narrated Abu Hurairah:that the Messenger of Allah (ﷺ) saw a man laying on his stomach so he said: \"Indeed such laying is not loved by Allah",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1322-43-2768-ahmadmuhammadshakir",
          "name": "Ahmad Muhammad Shakir",

        {
          "id": "69b55e8d6f42ba7ccb2a1322-43-2761-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-43-2761-basharawadmaarouf",
          "name": "Bashar Awad Maarouf",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-43-2761-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },

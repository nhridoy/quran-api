      "bookIndex": 43,
      "hadithIndex": 2771,
      "bookHadithIndex": 41,
      "text": "Narrated Jabir bin Samurah:\"I saw the Prophet (ﷺ) reclining upon a pillow",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1322-43-2771-ahmadmuhammadshakir",
          "name": "Ahmad Muhammad Shakir",
          "grade": "Sahih"

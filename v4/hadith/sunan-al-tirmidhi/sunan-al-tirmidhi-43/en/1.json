          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-43-2771-basharawadmaarouf",
          "name": "Bashar Awad Maarouf",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1322-43-2771-zubairalizai",
          "name": "Zubair Ali Zai",

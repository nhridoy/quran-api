3,"hadithIndex":2735,"bookHadithIndex":241,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07426","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2736,"bookHadithIndex":242,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07427","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2737,"bookHadithIndex":243,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07428","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2738,"bookHadithIndex":244,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07429","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2739,"bookHadithIndex":245,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0742a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2740,"bookHadithIndex":246,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0742b","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2741,"bookHadithIndex":247,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0742c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2742,"bookHadithIndex":248,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0742d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2743,"bookHadithIndex":249,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0742e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2744,"bookHadithIndex":250,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0742f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2745,"bookHadithIndex":251,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07430","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2746,"bookHadithIndex":252,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07431","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2747,"bookHadithIndex":253,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07432","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2748,"bookHadithIndex":254,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07433","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2749,"bookHadithIndex":255,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07434","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2750,"bookHadithIndex":256,"text":"– Передают со слов Абу Къатады аль-Ансари, да будет доволен им Аллах, о том, что (как-то раз) Посланника Аллаха ﷺ спросили о соблюдении поста в понедельник и он сказал: «В этот день я родился и (в этот) день мне было ниспослано (первое откровение)»","grades":[]},{"id":"69b6c334dd1a4c9c86f07435","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2751,"bookHadithIndex":257,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07436","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2752,"bookHadithIndex":258,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07437","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2753,"bookHadithIndex":259,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07438","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2754,"bookHadithIndex":260,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07439","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2755,"bookHadithIndex":261,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0743a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2756,"bookHadithIndex":262,"text":"– Сообщается, что Абу Хурайра, да будет доволен им Аллах, сказал: «Однажды у Пророка ﷺ спросили: “Какая молитва является наилучшей после предписанной, и какой пост является наилучшим, после поста месяца рамадан?”, и он сказал: “Наилучшей молитвой после предписанной, является молитва, (которая совершается) глубокой ночью, а наилучшим постом, после (поста) месяца рамадана – пост месяца Аллаха мухаррам”»","grades":[]},{"id":"69b6c334dd1a4c9c86f0743b","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2757,"bookHadithIndex":263,"text":"– Рассказал нам Абу Бакр ибн Абу Шейба: Рассказал нам Хусайн ибн ‘Али от Заиды, передавшего от ‘Абдуль-Малика ибн ‘Умайра с этим иснадом в упоминании поста от Пророка ﷺ такой же хадис","grades":[]},{"id":"69b6c334dd1a4c9c86f0743c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2758,"bookHadithIndex":264,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0743d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2759,"bookHadithIndex":265,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0743e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2760,"bookHadithIndex":266,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0743f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2761,"bookHadithIndex":267,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07440","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2762,"bookHadithIndex":268,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07441","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2763,"bookHadithIndex":269,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07442","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2764,"bookHadithIndex":270,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07443","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2765,"bookHadithIndex":271,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07444","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2766,"bookHadithIndex":272,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07445","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2767,"bookHadithIndex":273,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07446","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2768,"bookHadithIndex":274,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07447","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2769,"bookHadit
text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0740a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2708,"bookHadithIndex":214,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0740b","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2709,"bookHadithIndex":215,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0740c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2710,"bookHadithIndex":216,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0740d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2711,"bookHadithIndex":217,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0740e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2712,"bookHadithIndex":218,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0740f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2713,"bookHadithIndex":219,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07410","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2714,"bookHadithIndex":220,"text":"Сообщается, что мать правоверных ‘Аиша, да будет доволен ею Аллах, сказала: «Однажды днём Посланник Аллаха ﷺ спросил меня: “О ‘Аиша, есть ли у вас что-нибудь (поесть)?” Я ответила: “О Посланник Аллаха, у нас нет ничего”. Он сказал: “Тогда буду поститься”».‘Аиша сказала: «И Посланник Аллаха ﷺ вышел, а нам преподнесли подарок (или: к нам пришли гости)».‘Аиша сказала: «Когда Посланник Аллаха ﷺ вернулся, я сказала: “О Посланник Аллаха, нам преподнесли подарок (или: к нам пришли гости) и я для тебя кое-что припрятала”. Он спросил: “А что это?” Я сказала: “Хайс”. Он сказал: “Принеси его”. Я принесла его и он поел, после чего он сказал: “Я с утра постился”».Тальха сказал: «Я пересказал этот хадис Муджахиду, и он сказал: “Это подобно милостыне, которую выделяет человек из своего имущества: если захочет, он может подать её, а может и удержать”»","grades":[]},{"id":"69b6c334dd1a4c9c86f07411","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2715,"bookHadithIndex":221,"text":"Сообщается, что мать правоверных ‘Аиша, да будет доволен ею Аллах, сказала: «Однажды Пророк ﷺ вошёл ко мне и спросил: “Есть ли у вас что-нибудь?” Мы ответили: “Нет”, и он сказал: “Тогда я буду поститься”. Затем он пришёл к нам в другой день, и мы сказали: “О Посланник Аллаха, нам подарили хайс” и он сказал: “Покажи мне его, ибо я с утра соблюдаю пост”, а потом поел»","grades":[]},{"id":"69b6c334dd1a4c9c86f07412","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2716,"bookHadithIndex":222,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07413","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2717,"bookHadithIndex":223,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07414","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2718,"bookHadithIndex":224,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07415","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2719,"bookHadithIndex":225,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07416","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2720,"bookHadithIndex":226,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07417","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2721,"bookHadithIndex":227,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07418","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2722,"bookHadithIndex":228,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07419","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2723,"bookHadithIndex":229,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0741a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2724,"bookHadithIndex":230,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0741b","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":13,"hadithIndex":2725,"bookHadithIndex":231,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0741c","editionId":
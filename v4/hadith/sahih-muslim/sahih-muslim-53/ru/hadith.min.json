{"total":102,"items":[{"id":"69b6c44fdd1a4c9c86f08550","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7130,"bookHadithIndex":1,"text":"Сообщается, что Анас ибн Малик (да будет доволен им Аллах) сказал:«Посланник Аллаха ﷺ сказал: “Рай окружен ненавистным, а (адский) Огонь – страстями”»","grades":[]},{"id":"69b6c44fdd1a4c9c86f08551","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7131,"bookHadithIndex":2,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08552","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7132,"bookHadithIndex":3,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08553","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7133,"bookHadithIndex":4,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08554","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7134,"bookHadithIndex":5,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08555","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7135,"bookHadithIndex":6,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08556","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7136,"bookHadithIndex":7,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08557","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7137,"bookHadithIndex":8,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08559","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7139,"bookHadithIndex":9,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0855a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7140,"bookHadithIndex":10,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0855c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7142,"bookHadithIndex":11,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0855d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7143,"bookHadithIndex":13,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0855f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7145,"bookHadithIndex":14,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08560","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7146,"bookHadithIndex":15,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08561","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7147,"bookHadithIndex":16,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08562","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7148,"bookHadithIndex":17,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08563","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7149,"bookHadithIndex":18,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08564","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7150,"bookHadithIndex":19,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08565","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7151,"bookHadithIndex":20,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08566","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7152,"bookHadithIndex":21,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08567","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7153,"bookHadithIndex":22,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08568","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7154,"bookHadithIndex":23,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08569","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7155,"bookHadithIndex":24,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0856a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7156,"bookHadithIndex":25,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0856b","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7157,"bookHadithIndex":26,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0856c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7158,"bookHadithIndex":27,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0856d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7159,"bookHadithIndex":28,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0856e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7160,"bookHadithIndex":29,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0856f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7161,"bookHadithIndex":30,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08570","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7162,"bookHadithIndex":31,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08571","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7163,"bookHadithIndex":32,"text":"– Передают со слов Абу Хурайры (да будет доволен им Аллах), что Посланник Аллаха ﷺ сказал: «Великий и Всемогущий Аллах создал Адама по Своему образу, рост которого составлял шестьдесят локтей, а когда он (завершил) его сотворение, Он сказал (ему): “Иди и поприветствуй эту группу (ангелов)”, имея в виду нескольких сидящих ангелов “и послушай, как они ответят тебе, и (отныне) это будет приветствием для тебя и твоих потомков”».(Посланник Аллаха ﷺ) сказал: «И он отправился (к ним) и сказал: “Мир вам!” /Ас-саляму ‘алейкум!/, они же (в ответ ему) сказали: “Мир тебе и милость Аллаха!” /Ас-саляму ‘алейка ва рахмату-Ллахи!/»(Посланник Аллаха ﷺ) сказал: «И они добавили (к его приветствию слова) “ … и милость Аллаха!”»(Посланник Аллаха ﷺ) сказал: «И каждый, кто войдёт в рай, будет в образе Адама, рост его будет (составлять) шестьдесят локтей, и с тех пор творения не переставали уменьшаться (в размерах) до нынешнего (времени)»","grades":[]},{"id":"69b6c44fdd1a4c9c86f08572","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7164,"bookHadithIndex":33,"text":"Сообщается, что ‘Абдуллах ибн Мас‘уд (да будет доволен им Аллах) сказал: «Посланник Аллаха ﷺ сказал: “В этот День приведут геенну, на которую (будет накинуто) семьдесят тысяч поводьев, и за каждый повод станут волочить её (за собой) по семьдесят тысяч ангелов”»","grades":[]},{"id":"69b6c44fdd1a4c9c86f08573","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7165,"bookHadithIndex":34,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08574","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7166,"bookHadithIndex":35,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08575","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7167,"bookHadithIndex":36,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08576","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7168,"bookHadithIndex":37,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08577","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7169,"bookHadithIndex":38,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08578","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7170,"bookHadithIndex":39,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08579","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7171,"bookHadithIndex":40,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0857a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7172,"bookHadithIndex":41,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0857b","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7173,"bookHadithIndex":42,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0857c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7174,"bookHadithIndex":43,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0857d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7175,"bookHadithIndex":44,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0857e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7176,"bookHadithIndex":45,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0857f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7177,"bookHadithIndex":46,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08580","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7178,"bookHadithIndex":47,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08581","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7179,"bookHadithIndex":48,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08582","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7180,"bookHadithIndex":49,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08583","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7181,"bookHadithIndex":50,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08584","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7182,"bookHadithIndex":51,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08585","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7183,"bookHadithIndex":52,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08586","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7184,"bookHadithIndex":53,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08587","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7185,"bookHadithIndex":54,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08588","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7186,"bookHadithIndex":55,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08589","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7187,"bookHadithIndex":56,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0858a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7188,"bookHadithIndex":57,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0858b","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7189,"bookHadithIndex":58,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0858c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7190,"bookHadithIndex":59,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0858d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7191,"bookHadithIndex":60,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0858e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7192,"bookHadithIndex":61,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0858f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7193,"bookHadithIndex":62,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08590","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7194,"bookHadithIndex":63,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08591","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7195,"bookHadithIndex":64,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08592","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7196,"bookHadithIndex":65,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08593","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7197,"bookHadithIndex":66,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08594","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7198,"bookHadithIndex":67,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08595","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7199,"bookHadithIndex":68,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08596","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7200,"bookHadithIndex":69,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08597","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7201,"bookHadithIndex":70,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08598","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7202,"bookHadithIndex":71,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08599","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7203,"bookHadithIndex":72,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0859a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7204,"bookHadithIndex":73,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0859b","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7205,"bookHadithIndex":74,"text":"Передают со слов Абу Хурайры (да будет доволен им Аллах), что Посланник Аллаха ﷺ сказал: «В День воскресения люди будут обливаться потом так (сильно), что их пот пропитает собой землю на семьдесят саженей (вглубь). И он будет доходить до ртов (некоторых из) людей или до (уровня) их ушей»","grades":[]},{"id":"69b6c44fdd1a4c9c86f0859c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7206,"bookHadithIndex":75,"text":"Сообщается, что аль-Микъдад (да будет доволен им Аллах) сказал: «Я слышал, как Посланник Аллаха ﷺ говорил: “В День воскресения солнце будет приближено к людям (и окажется от них на расстоянии,) равном миле”».Сулейм ибн ‘Амир, передавший этот хадис со слов аль-Микъдада, сказал: «И клянусь Аллахом, я не знаю, что именно он подразумевает под (словом) “миль” меру длины или палочку для нанесения сурьмы на глаза».(Далее посланник ﷺ сказал): Что же касается людей, то сообразно своим делам они погрузятся в (собственный) пот, и у некоторых из них он будет доходить до щиколоток, (у других) до колен, (у третьих) до поясницы, а некоторых из них он взнуздает, и (сказав это,) Посланник Аллаха ﷺ указал рукой на свой рот","grades":[]},{"id":"69b6c44fdd1a4c9c86f0859d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7207,"bookHadithIndex":76,"text":"– Передают со слов ‘Ияда ибн Химара аль-Муджаши‘и, что однажды во время своей проповеди Посланник Аллаха ﷺ сказал: «Поис­тине, Господь мой велел мне научить вас тому, чего вы не знали и чему Он научил меня сегодня. (Он сказал): “Любое имущество, которое Я даровал рабу, является дозволенным (для него). Поис­тине, Я создал всех Моих рабов ханифами, но к ним стали являться шайтаны, которые отвратили их от их религии, объявили запретным то, что Я разрешил им, и велели им поклоняться наряду со Мной тому, относительно чего Я не приводил никаких доводов”. Всемо­гущий и Великий Аллах посмотрел на (людей), живущих на земле, возненавидел (всех) их, арабов и неарабов, за исключением остав­шихся людей Писания, и сказал: “Я послал тебя (к людям), чтобы испытать тебя и подвергнуть (их) испытанию через тебя, и Я нис­послал тебе Писание, которое не смыть водой и которое ты будешь читать во сне и наяву”. И, поистине, Аллах велел мне сжечь курай­шитов, а я сказал: “Господь мой, в таком случае они разобьют мне голову, (и она уподобится раскрошенному) хлебу!” (На это Аллах) сказал: “Изгони их, как они изгнали тебя, и нападай на них, а Мы поможем тебе, и расходуй (свои средства), а Мы будем расходо­вать на тебя, и пошли (против них) армию, а Мы пошлём пять таких (армий), и сражайся с теми, кто ослушался тебя, (руками) тех, кто повинуется тебе”. (И Аллах) сказал: “Трое станут обитателями Рая: справедливый и раздающий милостыню правитель, которому ока­зано содействие, милосердный человек, сердце которого прояв­ляет мягкость по отношению к каждому родственнику и (каждому) мусульманину, а также обременённый детьми скромный (чело­век), проявляющий воздержание”. (И Аллах) сказал: “Пятеро ста­нут обитателями Огня: слабый, который лишён разума, те из вас, которые будут следовать за всем (без разбора), не стремясь ни (принести пользу) семье, ни (приобрести) богатство, вероломный, который проявляет вероломство (ради удовлетворения любого) желания, даже если дело касается мелочей, и человек, который утром и вечером обманывает тебя в (делах, касающихся) твоей семьи и твоего имущества”. Кроме того, Он упомянул о скупости (или: лживости) и человеке, который отличается дурным характером и говорит мерзкие слова»","grades":[]},{"id":"69b6c44fdd1a4c9c86f0859e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7208,"bookHadithIndex":77,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0859f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7209,"bookHadithIndex":78,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f085a0","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7210,"bookHadithIndex":79,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f085a1","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7211,"bookHadithIndex":80,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f085a2","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7212,"bookHadithIndex":81,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f085a3","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7213,"bookHadithIndex":82,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f085a4","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7214,"bookHadithIndex":83,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f085a5","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7215,"bookHadithIndex":84,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f085a6","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7216,"bookHadithIndex":85,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f085a7","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7217,"bookHadithIndex":86,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f085a8","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7218,"bookHadithIndex":87,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f085a9","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7219,"bookHadithIndex":88,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f085aa","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7220,"bookHadithIndex":89,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f085ab","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7221,"bookHadithIndex":90,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f085ac","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7222,"bookHadithIndex":91,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f085ad","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7223,"bookHadithIndex":92,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f085ae","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7224,"bookHadithIndex":93,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f085af","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7225,"bookHadithIndex":94,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f085b0","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7226,"bookHadithIndex":95,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f085b1","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7227,"bookHadithIndex":96,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f085b2","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7228,"bookHadithIndex":97,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f085b3","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7229,"bookHadithIndex":98,"text":"Передают со слов Абу Суфйана, что Джабир (ибн ‘Абдуллах, да будет доволен Аллах ими обоими,) сказал: «Я слышал, как за три дня до своей смерти Пророк ﷺ говорил: “Пусть никто из вас не встречает смерть иначе, как ожидая от Аллаха (только) хорошего!”»","grades":[]},{"id":"69b6c44fdd1a4c9c86f085b4","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7230,"bookHadithIndex":99,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f085b5","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7231,"bookHadithIndex":100,"text":"Передают со слов Абу аз-Зубайра, что Джабир ибн ‘Абдуллах аль-Ансари (да будет доволен Аллах ими обоими) сказал: «Я слышал, как за три дня до своей смерти Посланник Аллаха ﷺ говорил: “Пусть никто из вас не встречает смерть иначе, как ожидая от Всемогущего и Великого Аллаха (только) хорошего”»","grades":[]},{"id":"69b6c44fdd1a4c9c86f085b6","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7232,"bookHadithIndex":101,"text":"Сообщается, что Джабир, да будет доволен им Аллах, сказал: «Я слышал, как Пророк ﷺ говорил: “Каждый раб (Аллаха) будет воскрешён в том (состоянии), в котором встретит смерть”»","grades":[]},{"id":"69b6c44fdd1a4c9c86f085b7","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7233,"bookHadithIndex":102,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f085b8","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":53,"hadithIndex":7234,"bookHadithIndex":103,"text":"","grades":[]}]}
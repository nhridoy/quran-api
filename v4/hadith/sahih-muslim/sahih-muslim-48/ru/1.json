    },
    {
      "id": "69b6c44fdd1a4c9c86f08430",
      "editionId": "69b55e8d6f42ba7ccb2a131f",
      "bookIndex": 48,
      "hadithIndex": 6842,
      "bookHadithIndex": 38,

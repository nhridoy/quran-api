ionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":25,"hadithIndex":4217,"bookHadithIndex":14,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f079f0","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":25,"hadithIndex":4218,"bookHadithIndex":15,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f079f1","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":25,"hadithIndex":4219,"bookHadithIndex":16,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f079f2","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":25,"hadithIndex":4220,"bookHadithIndex":17,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f079f3","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":25,"hadithIndex":4221,"bookHadithIndex":18,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f079f4","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":25,"hadithIndex":4222,"bookHadithIndex":19,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f079f5","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":25,"hadithIndex":4223,"bookHadithIndex":20,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f079f6","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":25,"hadithIndex":4224,"bookHadithIndex":21,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f079f7","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":25,"hadithIndex":4225,"bookHadithIndex":22,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f079f8","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":25,"hadithIndex":4226,"bookHadithIndex":23,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f079f9","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":25,"hadithIndex":4227,"bookHadithIndex":24,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f079fa","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":25,"hadithIndex":4228,"bookHadithIndex":25,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f079fb","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":25,"hadithIndex":4229,"bookHadithIndex":26,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f079fc","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":25,"hadithIndex":4230,"bookHadithIndex":27,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f079fd","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":25,"hadithIndex":4231,"bookHadithIndex":28,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f079fe","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":25,"hadithIndex":4232,"bookHadithIndex":29,"text":"– Передают, что Са‘ид ибн Джубайр сказал: (Однажды) Ибн ‘Аббас, да будет доволен Аллах ими обоими, воскликнул: «Четверг! Что за день четверг!» а потом заплакал (так сильно), что оросил слёзами мелкие камешки (на земле). Я спросил: «О Ибн ‘Аббас, что это за четверг?» Он сказал: «Когда (состояние) Посланника Аллаха ﷺ (ухудшилось), он сказал: “Принесите мне (при­надлежности для) письма, и я напишу для вас то, благодаря чему вы не собьётесь с правильного пути после моей (смерти)”. После этого они принялись спорить друг с другом, чего в присутствии Пророка ﷺ (делать) не подобало. (Люди стали) говорить: “Что с ним? (Может быть), он (бредит)? Спросите его”. (Тогда Пророк ﷺ) сказал: “Оставьте меня, ибо со мной всё в порядке! Я поручаю вам три (вещи): изгоните многобож­ников с Аравийского полуострова и оказывайте (членам каждой) деле­гации такой же приём, какой оказывал им я”».(Са‘ид ибн Джубайр) сказал: «И он умолчал о третьем (наставле­нии Пророка ﷺ) (или: упомянул о нём, но я забыл его)»","grades":[]},{"id":"69b6c368dd1a4c9c86f079ff","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":25,"hadithIndex":4233,"bookHadithIndex":30,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07a00","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":25,"hadithIndex":4234,"bookHadithIndex":31,"text":"","grades":[]}]}
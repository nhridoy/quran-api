{"total":178,"totalPage":4,"page":1,"pageSize":50,"items":[{"id":"69b6c368dd1a4c9c86f078f0","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3962,"bookHadithIndex":1,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f078f1","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3963,"bookHadithIndex":2,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f078f2","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3964,"bookHadithIndex":3,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f078f3","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3965,"bookHadithIndex":4,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f078f4","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3966,"bookHadithIndex":5,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f078f5","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3967,"bookHadithIndex":6,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f078f6","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3968,"bookHadithIndex":7,"text":"Сообщается, что Джабир (да будет доволен им Аллах) сказал: «Посланник Аллаха ﷺ сказал: “Если мусульманин посадит дерево, то всё то, что будет съедено с него, обязательно (зачтётся) ему как садакъа/милостыня/, и всё, что будет украдено с него, зачтётся ему как садакъа, и все, что съедят с него звери, зачтётся ему как садакъа, и все, что съедят с него птицы, зачтётся ему как садакъа, и если кто-нибудь нанесёт ему урон, это обязательно зачтётся ему как садакъа”»","grades":[]},{"id":"69b6c368dd1a4c9c86f078f7","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3969,"bookHadithIndex":8,"text":"Передают со слов Джабира о том, что (однажды) Пророк ﷺ зашёл в пальмовый сад принадлежавший Умм Мубашшир аль-Ансари и Пророк ﷺ спросил её: «Кто посадил эти пальмы мусульманин или неверный?» Она ответила: «Нет, мусульманин!» Тогда он сказал: «Если мусульманин посадит дерево или засеет поле, а потом (выросшее) поест человек, животное или кто-нибудь ещё, это обязательно зачтётся ему как садакъа»","grades":[]},{"id":"69b6c368dd1a4c9c86f078f8","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3970,"bookHadithIndex":9,"text":"Сообщается, что Джабир ибн ‘Абдуллах, да будет доволен им Аллах, сказал: «Я слышал, как Посланник Аллаха ﷺ говорил: “Если мусульманин посадит дерево или засеет поле, а потом (выросшее) поест зверь, птица или кто-нибудь ещё, то он обязательно получит за это вознаграждение”»","grades":[]},{"id":"69b6c368dd1a4c9c86f078f9","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3971,"bookHadithIndex":10,"text":"Передают со слов ‘Амра ибн Динара о том ,что он слышал, как Джабир ибн ‘Абдуллах говорил: «(Однажды) Пророк ﷺ зашёл в сад принадлежавший Умм Ма‘бад и сказал: “О Умм Ма‘бад, кто посадил эти пальмы мусульманин или неверный?” Она ответила: “Нет, мусульманин!” Тогда он сказал: “Если мусульманин посадит дерево, а потом (выросшее) от него поест человек, животное или птица, это обязательно зачтётся ему как садакъа до Дня воскрешения”»","grades":[]},{"id":"69b6c368dd1a4c9c86f078fa","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3972,"bookHadithIndex":11,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f078fb","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3973,"bookHadithIndex":12,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f078fc","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3974,"bookHadithIndex":13,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f078fd","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3975,"bookHadithIndex":14,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f078fe","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3976,"bookHadithIndex":15,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f078ff","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3977,"bookHadithIndex":16,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07900","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3978,"bookHadithIndex":17,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07901","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3979,"bookHadithIndex":18,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07902","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3980,"bookHadithIndex":19,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07903","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3981,"bookHadithIndex":20,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07904","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3982,"bookHadithIndex":21,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07905","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3983,"bookHadithIndex":22,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07906","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3984,"bookHadithIndex":23,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07907","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3985,"bookHadithIndex":24,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07908","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3986,"bookHadithIndex":25,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07909","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3987,"bookHadithIndex":26,"text":"Абу Хурайра, да будет доволен им Аллах, рассказывал: «Посланник Аллаха ﷺ сказал» или же он сказал: «Я слышал, как Пророк ﷺ говорил: “Тот, кто застал свое имущество в том виде, в котором он отдал его, у человека, ставшего банкротом [и не раздавшего это имущество], имеет больше прав на него [свое имущество] нежели кто-либо другой”»","grades":[]},{"id":"69b6c368dd1a4c9c86f0790a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":3988,"bookHadithIndex":27,"text":"","grades":[]},{"id":"
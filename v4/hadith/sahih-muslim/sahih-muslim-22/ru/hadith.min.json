Index":4002,"bookHadithIndex":41,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07919","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":4003,"bookHadithIndex":42,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0791a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":4004,"bookHadithIndex":43,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0791b","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":4005,"bookHadithIndex":44,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0791c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":4006,"bookHadithIndex":45,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0791d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":4007,"bookHadithIndex":46,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0791e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":4008,"bookHadithIndex":47,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0791f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":4009,"bookHadithIndex":48,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07920","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":4010,"bookHadithIndex":49,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07921","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":4011,"bookHadithIndex":50,"text":"– Сообщается, что Рафи‘ ибн Хадидж (да будет доволен им Аллах) сказал: «Я слышал, как Пророк ﷺговорил: “Худшим заработком (являются деньги,) полученные блудницей (за прелюбодеяние), деньги, (полученные за) собаку, и заработок цирюльника”»","grades":[]},{"id":"69b6c368dd1a4c9c86f07922","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":4012,"bookHadithIndex":51,"text":"– Сообщается, что Рафи‘ ибн Хадидж (да будет доволен им Аллах) сказал: «Я слышал, как Пророк ﷺговорил: “Скверны деньги, (полученные за) собаку, и скверны деньги, (заработанные) блудницей, и скверен заработок цирюльника”»","grades":[]},{"id":"69b6c368dd1a4c9c86f07923","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":4013,"bookHadithIndex":52,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07924","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":4014,"bookHadithIndex":53,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07925","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":4015,"bookHadithIndex":54,"text":"Сообщается, что Абу аз-Зубайр сказал: «Я спросил Джабира о продаже собак и кошек и он сказал: “Пророк ﷺ строго запретил это/заджара/!”»","grades":[]},{"id":"69b6c368dd1a4c9c86f07926","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":4016,"bookHadithIndex":55,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07927","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":4017,"bookHadithIndex":56,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07928","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":4018,"bookHadithIndex":57,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07929","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":4019,"bookHadithIndex":58,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0792a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":4020,"bookHadithIndex":59,"text":"– Передают, что Джабир ибн ‘Абдуллах, да будет доволен Аллах ими обоими, сказал: «(Сначала) Посланник Аллаха ﷺ велел нам убивать собак, и даже когда из пустыни приходила женщина со своей собакой, мы уби­вали её (собаку). А потом Пророк ﷺ запретил нам убивать их и сказал: “Вам следует (убивать только) совершенно чёрных собак с двумя (белыми) пят­нами (над глазами, ибо), поистине, (каждая такая собака) шайтан”»","grades":[]},{"id":"69b6c368dd1a4c9c86f0792b","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"hadithIndex":4021,"bookHadithIndex":60,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0792c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":22,"h
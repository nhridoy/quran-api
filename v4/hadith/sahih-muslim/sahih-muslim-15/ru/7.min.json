4dd1a4c9c86f075b2","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":15,"hadithIndex":3132,"bookHadithIndex":336,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f075b3","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":15,"hadithIndex":3133,"bookHadithIndex":337,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f075b4","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":15,"hadithIndex":3134,"bookHadithIndex":338,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f075b5","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":15,"hadithIndex":3135,"bookHadithIndex":339,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f075b6","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":15,"hadithIndex":3136,"bookHadithIndex":340,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f075b7","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":15,"hadithIndex":3137,"bookHadithIndex":341,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f075b8","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":15,"hadithIndex":3138,"bookHadithIndex":342,"text":"Умм аль-Хусайн рассказывала: «...Посланник Аллаха ﷺ много говорил, и я слышала, как он сказал: “Если поставят над вами правителем черного раба с оторванными частями тела, который будет править вами согласно установлениям Книги Аллаха Всевышнего, слушайте его и повинуйтесь ему”»","grades":[]},{"id":"69b6c334dd1a4c9c86f075b9","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":15,"hadithIndex":3139,"bookHadithIndex":343,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f075ba","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":15,"hadithIndex":3140,"bookHadithIndex":344,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f075bb","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":15,"hadithIndex":3141,"bookHadithIndex":345,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f075bc","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":15,"hadithIndex":3142,"bookHadithIndex":346,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f075bd","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":15,"hadithIndex":3143,"bookHadithIndex":347,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f075be","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":15,"hadithIndex":3144,"bookHadithIndex":348,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f075bf","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":15,"hadithIndex":3145,"bookHadithIndex":349,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f075c0","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":15,"hadithIndex":3146,"bookHadithIndex":350,"text":"Передают со слов Ибн ‘Умара, да будет доволен Аллах ими обоими, о том, что (после завершения обрядов хаджжа) Посланник Аллаха ﷺ сказал: «О Аллах, помилуй сбривших волосы». (Люди) сказали: «(Обратись с мольбой) и за укоротивших, о Посланник Аллаха!» Он (снова) сказал: «О Аллах, помилуй сбривших волосы». (Люди) сказали: «(Обратись с мольбой) и за укоротивших, о Посланник Аллаха!» Он (снова) сказал: «О Аллах, помилуй сбривших волосы». (Люди снова) сказали: «(Обратись с мольбой) и за укоротивших, о Посланник Аллаха!» − (и тогда) он сказал: “И укоротивших”»","grades":[]},{"id":"69b6c334dd1a4c9c86f075c1","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":15,"hadithIndex":3147,"bookHadithIndex":351,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f075c2","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":15,"hadithIndex":3148,"bookHadithIndex":352,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f075c3","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":15,"hadithIndex":3149,"bookHadithIndex":353,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f075c4","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":15,"hadithIndex":3150,"bookHadithIndex":354,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f075c5","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":15,"hadithIndex":3151,"bookHadithIndex":355,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f075c6","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":15,"hadithIndex":3152,"bookHadithIndex":356,"text":"","grades":[]},{"id":"
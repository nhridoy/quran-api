{"total":324,"totalPage":7,"page":1,"pageSize":50,"items":[{"id":"69b6c410dd1a4c9c86f0818f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6169,"bookHadithIndex":1,"text":"Передают со слов Анаса ибн Малика о том, что Абу Бакр ас-Сиддыкъ, рассказывая ему (историю) сказал: «Когда мы (прятались) в пещере, я увидел ноги многобожников у самых наших голов и сказал: “О Посланник Аллаха, если кто-нибудь из них посмотрит себе под ноги, то обязательно увидит нас!” (В ответ мне Пророк ﷺ) сказал: “А что думаешь ты, о Абу Бакр, о двоих, третьим для которых является Аллах?”»","grades":[]},{"id":"69b6c410dd1a4c9c86f08190","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6170,"bookHadithIndex":2,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f08191","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6171,"bookHadithIndex":3,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f08192","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6172,"bookHadithIndex":4,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f08193","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6173,"bookHadithIndex":5,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f08194","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6174,"bookHadithIndex":6,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f08195","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6175,"bookHadithIndex":7,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f08196","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6176,"bookHadithIndex":8,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f08197","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6177,"bookHadithIndex":9,"text":"Передают со слов ‘Амра ибн аль-‘Аса, да будет доволен им Аллах, что (в своё время) Посланник Аллаха ﷺ поставил его во главе отряда, который должен был двинуться на Зат ас-Салясиль. (‘Амр бин аль-‘Ас, да будет доволен им Аллах, сказал): «И я пришёл к нему и спросил: “Кого из людей ты любишь больше всех?” Он ответил: “‘Аишу”. Я спросил: “А из мужчин?” Он ответил: “Её отца”. Я спросил: “А кого потом?” Он ответил: “‘Умара (ибн аль-Хаттаба)”, и назвал ещё несколько человек»","grades":[]},{"id":"69b6c410dd1a4c9c86f08198","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6178,"bookHadithIndex":10,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f0819b","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6181,"bookHadithIndex":12,"text":"Сообщается, что ‘Аиша сказала: «Во время своей болезни, (от которой он впоследствии и умер), Посланник Аллаха ﷺ сказал мне: “Позови мне Абу Бакра и своего брата, чтобы я записал послание, потому что я боюсь, что жаждущий возжелает, и кто-то скажет: “Я более достоин”, хотя Аллах и правоверные не примут никого, кроме Абу Бакра”»","grades":[]},{"id":"69b6c410dd1a4c9c86f0819c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6182,"bookHadithIndex":13,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f0819d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6183,"bookHadithIndex":14,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f0819e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6184,"bookHadithIndex":15,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f0819f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6185,"bookHadithIndex":16,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081a0","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6186,"bookHadithIndex":17,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081a1","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6187,"bookHadithIndex":18,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081a2","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6188,"bookHadithIndex":19,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081a3","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6189,"bookHadithIndex":20,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081a4","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6190,"bookHadithIndex":21,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081a5","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6191,"bookHadithIndex":22,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081a6","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6192,"bookHadithIndex":23,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081a7","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6193,"bookHadithIndex":24,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081a8","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6194,"bookHadithIndex":25,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081a9","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6195,"bookHadithIndex":26,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081aa","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6196,"bookHadithIndex":27,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081ab","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6197,"bookHadithIndex":28,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081ac","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6198,"bookHadithIndex":29,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081ad","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6199,"bookHadithIndex":30,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081b0","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6202,"bookHadithIndex":32,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081b1","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6203,"bookHadithIndex":33,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081b2","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6204,"bookHadithIndex":34,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081b3","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6205,"bookHadithIndex":35,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081b4","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6206,"bookHadithIndex":36,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081b5","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6207,"bookHadithIndex":37,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081b6","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6208,"bookHadithIndex":38,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081b7","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6209,"bookHadithIndex":39,"text":"‘Аиша, да будет доволен ею Аллах, рассказала: «Посланник Аллаха ﷺ лежал в моём доме, и часть его бедра или голени обнажилась. Абу Бакр попросил разрешения войти, и он разрешил ему, оставаясь в таком положении, и они поговорили. Потом ‘Умар попросил разрешения войти, и он разрешил ему, оставаясь в таком положении, и они поговорили. Затем ‘Усман попросил разрешения войти, и Посланник Аллаха ﷺ сел и поправил свою одежду». [Передатчик] Мухаммад сказал: «И я не говорю, что всё это было в один день». Он зашёл, и они поговорили. А когда он ушёл, ‘Аиша спросила: «Абу Бакр вошёл, а ты не изменил своего положения и его присутствие не смутило тебя, потом вошёл ‘Умар, но ты не изменил своего положения и его присутствие не смутило тебя, а когда пришёл ‘Усман, ты сел и поправил свою одежду». [Посланник Аллаха ﷺ] сказал: «Разве не следует мне стесняться человека, которого стесняются ангелы?»","grades":[]},{"id":"69b6c410dd1a4c9c86f081b8","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6210,"bookHadithIndex":40,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081b9","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6211,"bookHadithIndex":41,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081ba","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6212,"bookHadithIndex":42,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081bb","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6213,"bookHadithIndex":43,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081bc","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6214,"bookHadithIndex":44,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081bd","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6215,"bookHadithIndex":45,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081be","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6216,"bookHadithIndex":46,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081bf","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6217,"bookHadithIndex":47,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081c0","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6218,"bookHadithIndex":48,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081c1","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6219,"bookHadithIndex":49,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081c2","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6220,"bookHadithIndex":50,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081c3","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6221,"bookHadithIndex":51,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f081c4","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":44,"hadithIndex":6222,"bookHadithIndex":52,"text":"","grades":[]}]}
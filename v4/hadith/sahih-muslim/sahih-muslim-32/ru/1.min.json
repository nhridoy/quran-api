{"total":178,"totalPage":4,"page":1,"pageSize":50,"items":[{"id":"69b6c3c9dd1a4c9c86f07b1d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":32,"hadithIndex":4519,"bookHadithIndex":1,"text":"","grades":[]},{"id":"69b6c3c9dd1a4c9c86f07b1e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":32,"hadithIndex":4520,"bookHadithIndex":2,"text":"","grades":[]},{"id":"69b6c3c9dd1a4c9c86f07b21","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":32,"hadithIndex":4523,"bookHadithIndex":4,"text":"","grades":[]},{"id":"69b6c3c9dd1a4c9c86f07b22","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":32,"hadithIndex":4524,"bookHadithIndex":5,"text":"","grades":[]},{"id":"69b6c3c9dd1a4c9c86f07b23","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":32,"hadithIndex":4525,"bookHadithIndex":6,"text":"Сообщается, что Абу Муса (аль-Аш‘ари), да будет доволен им Аллах, сказал: «Посылая кого-либо из своих сподвижников с каким-либо поручением, Посланник Аллаха ﷺ говорил: “Приносите радость, а не отпугивайте. Облегчайте, а не обременяйте”»","grades":[]},{"id":"69b6c3c9dd1a4c9c86f07b24","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":32,"hadithIndex":4526,"bookHadithIndex":7,"text":"","grades":[]},{"id":"69b6c3c9dd1a4c9c86f07b25","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":32,"hadithIndex":4527,"bookHadithIndex":8,"text":"","grades":[]},{"id":"69b6c3c9dd1a4c9c86f07b26","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":32,"hadithIndex":4528,"bookHadithIndex":9,"text":"Сообщается, что Абу ат-Таййах сказал: Я слышал, как Анас ибн Малик, да будет доволен им Аллах, говорил: «Посланник Аллаха ﷺ сказал: “Облегчайте, а не создавайте затруднения, успокаивайте (людей), а не внушайте отвращение (к Исламу)”»","grades":[]},{"id":"69b6c3c9dd1a4c9c86f07b27","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":32,"hadithIndex":4529,"bookHadithIndex":10,"text":"Сообщается, что Ибн ‘Умар, да будет доволен Аллах ими обоими, сказал: «Посланник Аллаха ﷺ сказал: “В День воскресения, когда Аллах объединит первых и последних, у каждого вероломного водрузят знамя и будет сказано: “Это вероломство такого-то, сына такого-то”»","grades":[]},{"id":"69b6c3c9dd1a4c9c86f07b28","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":32,"hadithIndex":4530,"bookHadithIndex":11,"text":"","grades":[]},{"id":"69b6c3c9dd1a4c9c86f07b29","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":32,"hadithIndex":4531,"bookHadithIndex":12,"text":"","grades":[]},{"id":"69b6c3c9dd1a4c9c86f07b2a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":32,"hadithIndex":4532,"bookHadithIndex":13,"text":"","grades":[]},{"id":"69b6c3c9dd1a4c9c86f07b2b","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":32,"hadithIndex":4533,"bookHadithIndex":14,"text":"Передают со слов Абдуллаха (ибн Мас‘уда, да будет доволен им Аллах,) что Пророк ﷺ сказал: «В День воскресения у каждого вероломного окажется знамя, и будет сказано: “Это вероломство такого-то”»","grades":[]},{"id":"69b6c3c9dd1a4c9c86f07b2c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":32,"hadithIndex":4534,"bookHadithIndex":15,"text":"","grades":[]},{"id":"69b6c3c9dd1a4c9c86f07b2d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":32,"hadithIndex":4535,"bookHadithIndex":16,"text":"","grades":[]},{"id":"69b6c3c9dd1a4c9c86f07b2e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":32,"hadithIndex":4536,"bookHadithIndex":17,"text":"","grades":[]},{"id":"69b6c3c9dd1a4c9c86f07b2f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":32,"hadithIndex":4537,"bookHadithIndex":18,"text":"","grades":[]},{"id":"69b6c3c9dd1a4c9c86f07b30","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":32,"hadithIndex":4538,"bookHadithIndex":19,"text":"","grades":[]},{"id":"69b6c3c9dd1a4c9c86f07b31","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":32,"hadithIndex":4539,"bookHadithIndex":20,"text":"","grades":[]},{"id":"69b6c3c9dd1a4c9c86f07b32","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":32,"hadithIndex":4540,"bookHadithIndex":21,"text":"","grades":[]},{"id":"69b6c3c9dd1a4c9c86f07
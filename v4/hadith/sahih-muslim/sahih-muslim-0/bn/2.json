    },
    {
      "id": "69b6c2badd1a4c9c86f06cca",
      "editionId": "69b55e8d6f42ba7ccb2a131f",
      "bookIndex": 0,
      "hadithIndex": 852,
      "bookHadithIndex": 0,
      "text": "মুহাম্মাদ ইবনু আবদুল্লাহ ইবনু নুমায়র (রহঃ) ..... তালহাহ ইবনু ইয়াহইয়া তার চাচার সূত্রে বর্ণিত। তিনি বলেন, আমি মুআবিয়াহ ইবনু আবূ সুফইয়ান (রাযিঃ) এর কাছে উপস্থিত ছিলাম। এমন সময় মুওয়াযযিন তাকে সালাতের জন্য ডাকতে আসল। মু'আবিয়াহ (রাযিঃ) বললেন, আমি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়া সাল্লাম কে বলতে শুনেছিঃ কিয়ামতের দিন মুওয়াযযিনদের গর্দান সবচেয়ে বেশি উচু হবে। (ইসলামিক ফাউন্ডেশনঃ ৭৩৬, ইসলামিক সেন্টারঃ)",
      "grades": []
    },
    {
      "id": "69b6c2badd1a4c9c86f06ccb",
      "editionId": "69b55e8d6f42ba7ccb2a131f",
      "bookIndex": 0,
      "hadithIndex": 853,
      "bookHadithIndex": 0,
      "text": "ইসহাক ইবনু মানসূর (রহঃ) ..... ঈসা ইবনু তালহাহ্ (রহঃ) হতে বর্ণিত। তিনি বলেন, আমি মুআবিয়াহ (রাযিঃ) কে বলতে শুনেছি। তিনি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম হতে উপরোক্ত হাদীসের অবিকল বর্ণনা করেছেন। (ইসলামিক ফাউন্ডেশনঃ ৭৩৭, ইসলামিক সেন্টারঃ)",
      "grades": []
    }

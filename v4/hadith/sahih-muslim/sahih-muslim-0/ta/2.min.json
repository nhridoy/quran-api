ccb2a131f","bookIndex":0,"hadithIndex":91,"bookHadithIndex":91,"text":"","grades":[]},{"id":"69b6c260dd1a4c9c86f069d2","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":0,"hadithIndex":92,"bookHadithIndex":92,"text":"","grades":[]},{"id":"69b6c260dd1a4c9c86f069f6","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":0,"hadithIndex":128,"bookHadithIndex":0,"text":"ஜாபிர் (ரலி) அவர்கள் கூறியதாவது: அல்லாஹ்வின் தூதர் (ஸல்) அவர்கள், \"அல்லாஹ்வைத் தவிர வேறு இறைவன் இல்லை (லா இலாஹ இல்லல்லாஹ்) என்று கூறும்வரை இந்த மக்களுடன் போரிடுமாறு எனக்குக் கட்டளையிடப்பட்டுள்ளது. அவர்கள் \"லா இலாஹ இல்லல்லாஹ்\" என்று சொல்லிவிட்டால் (தகுந்த காரணம் இருந்தாலன்றி) என்னிடமிருந்து தம் உயிரையும் உடைமைகளையும் பாதுகாத்துக்கொள்வார்கள். அவர்களது (அந்தரங்கம் குறித்த) விசாரணை அல்லாஹ்வின் பொறுப்பில் உள்ளது\" என்று கூறினார்கள். பிறகு, \"(நபியே!) நிச்சயமாக நீர் நினைவூட்டுபவர்தாம். அவர்கள்மீது ஆதிக்கம் செலுத்துபவர் அல்லர்\" எனும் இறை வசனங்களை (88:21, 22) ஓதிக் காட்டினார்கள். வேறு சில அறிவிப்பாளர்தொடர்கள் வழியாகவும் இந்த ஹதீஸ் வந்துள்ளது. அத்தியாயம் :","grades":[]},{"id":"69b6c260dd1a4c9c86f06a47","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":0,"hadithIndex":209,"bookHadithIndex":0,"text":"","grades":[]},{"id":"69b6c260dd1a4c9c86f06a6e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":0,"hadithIndex":248,"bookHadithIndex":0,"text":"","grades":[]},{"id":"69b6c2badd1a4c9c86f06bf3","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":0,"hadithIndex":637,"bookHadithIndex":0,"text":"பிலால் (ரலி) அவர்கள் கூறியதாவது: அல்லாஹ்வின் தூதர் (ஸல்) அவர்கள் (ஈரக் கையால்) தம்முடைய காலுறைகள் மற்றும் தலைப்பாகையின் மீது தடவி (மஸ்ஹு செய்திடலா)னார்கள். இந்த ஹதீஸ் மூன்று அறிவிப்பாளர் தொடர்களில் வந்துள்ளது. அவற்றில் ஒன்றில், (மேற்கண்டவாறு) அல்லாஹ்வின் தூதர் (ஸல்) அவர்கள் செய்ததை நான் பார்த்தேன் என்று பிலால் (ரலி) அவர்கள் கூறியதாக இடம் பெற்றுள்ளது. அத்தியாயம் :","grades":[]},{"id":"69b6c2badd1a4c9c86f06bf4","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":0,"hadithIndex":638,"bookHadithIndex":0,"text":"","grades":[]},{"id":"69b6c2badd1a4c9c86f06c90","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":0,"hadithIndex":794,"bookHadithIndex":0,"text":"","grades":[]},{"id":"69b6c2badd1a4c9c86f06cca","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":0,"hadithIndex":852,"bookHadithIndex":0,"text":"","grades":[]},{"id":"69b6c2badd1a4c9c86f06ccb","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":0,"hadithIndex":853,"bookHadithIndex":0,"text":"","grades":[]}]}
grades":[]},{"id":"69b6c368dd1a4c9c86f07a3c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4294,"bookHadithIndex":41,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07a3d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4295,"bookHadithIndex":42,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07a3e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4296,"bookHadithIndex":43,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07a3f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4297,"bookHadithIndex":44,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07a40","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4298,"bookHadithIndex":45,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07a41","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4299,"bookHadithIndex":46,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07a42","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4300,"bookHadithIndex":47,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07a43","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4301,"bookHadithIndex":48,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07a44","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4302,"bookHadithIndex":49,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07a45","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4303,"bookHadithIndex":50,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07a46","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4304,"bookHadithIndex":51,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07a47","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4305,"bookHadithIndex":52,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07a48","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4306,"bookHadithIndex":53,"text":"Сообщается, что Абу Мас‘уд аль-Бадри, да будет доволен им Аллах, сказал: «(Как-то раз) избивая своего невольника плетью, я услышал позади себя голос: “Знай, о Абу Мас‘уд …”, но не понял, кому он принадлежит, так как был охвачен гневом. Когда же (человек, говоривший этим) голосом, приблизился ко мне, оказалось, что это был Посланник Аллаха ﷺ который говорил: “Знай, о Абу Мас‘уд! Знай, о Абу Мас‘уд!” И я отбросил плеть (которую держал) в руке, а он сказал: “Знай, о Абу Мас‘уд, что Аллах может сделать с тобой больше, чем ты с этим рабом!”, и тогда я сказал: “После этого я никогда не ударю раба!”»","grades":[]},{"id":"69b6c368dd1a4c9c86f07a49","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4307,"bookHadithIndex":54,"text":"В другой версии этого хадиса сообщается, что Абу Мас‘уд аль-Бадри, да будет доволен им Аллах, сказал: «… и плеть выпала у меня из рук из-за почтительного страха перед ним …»","grades":[]},{"id":"69b6c368dd1a4c9c86f07a4a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4308,"bookHadithIndex":55,"text":"Сообщается, что Абу Мас‘уд аль-Бадри, да будет доволен им Аллах, сказал: «(Как-то раз) избивая своего невольника, я услышал позади себя голос: “Знай, о Абу Мас‘уд, что, поистине, Аллах может сделать с тобой больше, чем ты с ним!” И когда я повернулся, оказалось, что это был Посланник Аллаха ﷺ и тогда я сказал: “О Посланник Аллаха, он свободен ради лика Аллаха!”, (что же касается Пророка ﷺ то) он воскликнул: “Поистине, не сделай ты этого, тебя обязательно опалил бы огонь! (или: … коснулся бы огонь!)”»","grades":[]},{"id":"69b6c368dd1a4c9c86f07a4b","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4309,"bookHadithIndex":56,"text":"Передают со слов Абу Мас‘уда, да будет доволен им Аллах, о том, что как-то, когда он избивал своего невольника, тот стал говорить: «Прибегаю к защите Аллаха!»(Передатчик этого хадиса) сказал: «Но он стал его избивать (и далее), а тот (невольник) сказал: “Прибегаю к защите Посланника Аллаха”. И он оставил его, а Посланник Аллаха ﷺ сказал: “Клянусь Аллахом, поистине, Аллах может сделать с тобой больше, чем ты с ним!” И он освободил его»","grades":[]},{"id":"69b6c368dd1a4c9c86f07a4c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4310,"bookHadithIndex":57,"text":"От Шу‘бы передаётся (хадис) с этим же иснадом, но он не упоминал в нём его слова: «Прибегаю к защите Аллаха! Прибегаю к защите Посланника Аллаха ﷺ»","grades":[]},{"id":"69b6c368dd1a4c9c86f07a4d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4311,"bookHadithIndex":58,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07a4e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4312,"bookHadithIndex":59,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07a4f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4313,"bookHadithIndex":60,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07a50","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4314,"bookHadithIndex":61,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07a51","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4315,"bookHadithIndex":62,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07a52","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4316,"bookHadithIndex":63,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07a53","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4317,"bookHadithIndex":64,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07a54","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4318,"bookHadithIndex":65,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07a55","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4319,"bookHadithIndex":66,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07a56","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":27,"hadithIndex":4320,"bookHadithIndex":67,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07a57","editionId":"69b55e8d6f42ba7ccb2a131f","bo
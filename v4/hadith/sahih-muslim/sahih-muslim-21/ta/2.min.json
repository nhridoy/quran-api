{"total":158,"totalPage":4,"page":2,"pageSize":50,"items":[{"id":"69b6c368dd1a4c9c86f07884","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3854,"bookHadithIndex":53,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07885","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3855,"bookHadithIndex":54,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07886","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3856,"bookHadithIndex":55,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07887","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3857,"bookHadithIndex":56,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07888","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3858,"bookHadithIndex":57,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07889","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3859,"bookHadithIndex":58,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0788a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3860,"bookHadithIndex":59,"text":"இப்னு உமர் (ரலி) அவர்கள் கூறிய தாவது: ஒரு மனிதர் அல்லாஹ்வின் தூதர் (ஸல்) அவர்களிடம், தாம் வியாபாரங்களின்போது ஏமாற்றப்படுவதாகத் தெரிவித்தார். அதற்கு அல்லாஹ்வின் தூதர் (ஸல்) அவர்கள், \"நீ யாரிடம் வியாபாரம் செய்தாலும் \"ஏமாற்றுதல் கூடாது\" என்று கூறிவிடு\" என்று சொன்னார்கள். எனவே, அவர் விற்கவோ வாங்கவோ செய்யும்போது \"ஏமாற்றுதல் கூடாது\" என்று கூறிவந்தார். இந்த ஹதீஸ் நான்கு அறிவிப்பாளர் தொடர்களில் வந்துள்ளது. - மேற்கண்ட ஹதீஸ் மேலும் இரு அறிவிப்பாளர்தொடர்கள் வழியாகவும் வந்துள்ளது. அவற்றில், \"எனவே, அவர் விற்கவோ வாங்கவோ செய்யும்போது \"ஏமாற்றுதல் கூடாது\" என்று கூறிவந்தார்\" எனும் குறிப்பு இடம்பெறவில்லை. அத்தியாயம் :","grades":[]},{"id":"69b6c368dd1a4c9c86f0788b","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3861,"bookHadithIndex":60,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0788c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3862,"bookHadithIndex":6
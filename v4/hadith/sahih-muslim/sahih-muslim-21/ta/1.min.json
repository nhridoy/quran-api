{"total":158,"totalPage":4,"page":1,"pageSize":50,"items":[{"id":"69b6c368dd1a4c9c86f0784f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3801,"bookHadithIndex":1,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07850","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3802,"bookHadithIndex":2,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07851","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3803,"bookHadithIndex":3,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07852","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3804,"bookHadithIndex":4,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07853","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3805,"bookHadithIndex":5,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07854","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3806,"bookHadithIndex":6,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07855","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3807,"bookHadithIndex":7,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07856","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3808,"bookHadithIndex":8,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07857","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3809,"bookHadithIndex":9,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07858","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3810,"bookHadithIndex":10,"text":"அப்துல்லாஹ் பின் உமர் (ரலி) அவர்கள் கூறியதாவது: அறியாமைக் கால மக்கள் ஹபலுல் ஹபலாவுக்காக - சினை ஒட்டகம் குட்டி ஈன்று, அந்தக் குட்டி சினையாகிப் பெறவிருக்கும் குட்டிக்காக - ஒட்டகத்தின் இறைச்சிகளை விற்கவும் வாங்கவும் செய்தனர். அல்லாஹ்வின் தூதர் (ஸல்) அவர்கள் இத்தகைய வியாபாரம் செய்யக் கூடாது என மக்களுக்குத் தடை விதித்தார்கள். இந்த ஹதீஸ் இரு அறிவிப்பாளர்தொடர்களில் வந்துள்ளது. அத்தியாயம் :","grades":[]},{"id":"69b6c368dd1a4c9c86f07859","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3811,"bookHadithIndex":11,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0785a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3812,"bookHadithIndex":12,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0785b","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3813,"bookHadithIndex":13,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0785c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3814,"bookHadithIndex":14,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0785d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3815,"bookHadithIndex":15,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0785e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3816,"bookHadithIndex":16,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0785f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3817,"bookHadithIndex":17,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07860","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3818,"bookHadithIndex":18,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07861","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3819,"bookHadithIndex":19,"text":"இப்னு உமர் (ரலி) அவர்கள் கூறியதாவது: வியாபாரப் பொருட்கள் சந்தைக்கு வந்து சேருவதற்கு முன் வழியிலேயே வியாபாரிகளைச் சந்தித்துச் சரக்குகளை வாங்குவதற்கு அல்லாஹ்வின் தூதர் (ஸல்) அவர்கள் தடை விதித்தார்கள். இந்த ஹதீஸ் மூன்று அறிவிப்பாளர் தொடர்களில் வந்துள்ளது. அவற்றில் இப்னு நுமைர் (ரஹ்) அவர்களது அறிவிப்பில் மட்டுமே \"சந்தைக்கு வந்து சேர்வதற்கு முன்\" எனும் குறிப்பு காணப்படுகிறது. - மேற்கண்ட ஹதீஸ் இப்னு உமர் (ரலி) அவர்களிடமிருந்தே மேலும் இரு அறிவிப்பாளர் தொடர்கள் வழியாகவும் வந்துள்ளது. அத்தியாயம் :","grades":[]},{"id":"69b6c368dd1a4c9c86f07862","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3820,"bookHadithIndex":20,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07863","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3821,"bookHadithIndex":21,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07864","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3822,"bookHadithIndex":22,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07865","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3823,"bookHadithIndex":23,"text":"அல்லாஹ்வின் தூதர் (ஸல்) அவர்கள் கூறினார்கள்: வெளியூரிலிருந்து சரக்குகளைக் கொண்டு வரும் வியாபாரிகளைச் சந்தித்து, சரக்குகளை வாங்காதீர்கள். அவ்வாறு எவரேனும் அவர்களைச் சந்தித்து, சரக்குகளை விலைக்கு வாங்கிய பின் அந்தச் சரக்குகளின் உரிமையாளர் சந்தைக்கு வந்தால், அவருக்கு (அந்த பேரத்திலிருந்து விலகிக்கொள்ள) உரிமை உண்டு. அத்தியாயம் :","grades":[]},{"id":"69b6c368dd1a4c9c86f07866","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3824,"bookHadithIndex":24,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07867","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3825,"bookHadithIndex":25,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07868","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3826,"bookHadithIndex":26,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07869","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3827,"bookHadithIndex":27,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0786a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3828,"bookHadithIndex":28,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0786b","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3829,"bookHadithIndex":29,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0786c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3830,"bookHadithIndex":30,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0786d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3831,"bookHadithIndex":31,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0786e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3832,"bookHadithIndex":32,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0786f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3833,"bookHadithIndex":33,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07870","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3834,"bookHadithIndex":34,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07871","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3835,"bookHadithIndex":35,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07873","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3837,"bookHadithIndex":36,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07874","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3838,"bookHadithIndex":37,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07875","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3839,"bookHadithIndex":38,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07876","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3840,"bookHadithIndex":40,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07877","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3841,"bookHadithIndex":41,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07879","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3843,"bookHadithIndex":43,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0787a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3844,"bookHadithIndex":44,"text":"அல்லாஹ்வின் தூதர் (ஸல்) அவர்கள் கூறினார்கள்: உணவுப் பொருளை விலைக்கு வாங்கிய ஒருவர், அது தமது கைக்கு வந்து சேர்ந்து, அதைக் கைப்பற்றிக்கொள்வதற்கு முன் (மற்றவருக்கு) அதை விற்க வேண்டாம். இதை அப்துல்லாஹ் பின் உமர் (ரலி) அவர்கள் அறிவிக்கிறார்கள். அத்தியாயம் :","grades":[]},{"id":"69b6c368dd1a4c9c86f0787c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3846,"bookHadithIndex":42,"text":"இப்னு உமர் (ரலி) அவர்கள் கூறியதாவது: அல்லாஹ்வின் தூதர் (ஸல்) அவர்களது காலத்தில் குத்துமதிப்பாக உணவுப் பொருட்களை வாங்கிக்கொண்டிருந்த மக்கள், அவற்றை(க் கைப்பற்றி) அங்கிருந்து வேறு இடத்திற்குக் கொண்டுசெல்லாமல் அங்கேயே விற்றதற்காக அடிக்கப்பட்டனர். அத்தியாயம் :","grades":[]},{"id":"69b6c368dd1a4c9c86f0787d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3847,"bookHadithIndex":46,"text":"இப்னு உமர் (ரலி) அவர்கள் கூறியதாவது: அல்லாஹ்வின் தூதர் (ஸல்) அவர்களது காலத்தில் மக்கள் குத்துமதிப்பாக உணவுப் பொருட்களை விலைக்கு வாங்கியபோது, அவற்றைத் தம் இருப்பிடங்களுக்குக் கொண்டு போய்ச் சேர்க்காமல் அதே இடத்தில் விற்றதற்காக அடிக்கப்பட்டதை நான் பார்த்திருக்கிறேன். இதன் அறிவிப்பாளர்களில் ஒருவரான இப்னு ஷிஹாப் அஸ்ஸுஹ்ரீ (ரஹ்) அவர்கள் கூறுகிறார்கள்: உபைதுல்லாஹ் பின் அப்தில்லாஹ் பின் உமர் (ரஹ்) அவர்கள் என்னிடம் பின்வருமாறு தெரிவித்தார்கள்: என் தந்தை அப்துல்லாஹ் பின் உமர் (ரலி) அவர்கள் குத்துமதிப்பாக உணவுப் பொருளை வாங்குவார்கள். பின்னர் அதை (அங்கேயே விற்றுவிடாமல்) தம் வீட்டாரிடம் எடுத்துச் சென்று விடுவார்கள். அத்தியாயம் :","grades":[]},{"id":"69b6c368dd1a4c9c86f0787e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3848,"bookHadithIndex":47,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0787f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3849,"bookHadithIndex":48,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07880","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3850,"bookHadithIndex":49,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07881","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3851,"bookHadithIndex":50,"text":"ஜாபிர் பின் அப்தில்லாஹ் (ரலி) அவர்கள் கூறியதாவது: அளவு தெரிந்த பேரீச்சம் பழத்திற்குப் பகரமாக அளவு தெரியாத பேரீச்சம் பழக் குவியலை விற்பதற்கு அல்லாஹ்வின் தூதர் (ஸல்) அவர்கள் தடை விதித்தார்கள். - மேற்கண்ட ஹதீஸ் ஜாபிர் (ரலி) அவர்களிடமிருந்தே மற்றோர் அறிவிப்பாளர் தொடர் வழியாகவும் வந்துள்ளது. அதில், ஹதீஸின் இறுதியில் \"பேரீச்சம் பழத்திற்கு\" எனும் குறிப்பு இல்லை. (\"அளவு தெரிந்த பொருளுக்கு\" என்று பொதுவாகவே இடம்பெற்றுள்ளது.) அத்தியாயம் :","grades":[]},{"id":"69b6c368dd1a4c9c86f07882","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3852,"bookHadithIndex":51,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07883","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":21,"hadithIndex":3853,"bookHadithIndex":52,"text":"","grades":[]}]}
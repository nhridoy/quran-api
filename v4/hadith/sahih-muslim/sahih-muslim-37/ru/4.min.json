]},{"id":"69b6c410dd1a4c9c86f07f2e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":37,"hadithIndex":5560,"bookHadithIndex":170,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f07f2f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":37,"hadithIndex":5561,"bookHadithIndex":171,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f07f30","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":37,"hadithIndex":5562,"bookHadithIndex":172,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f07f31","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":37,"hadithIndex":5563,"bookHadithIndex":173,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f07f32","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":37,"hadithIndex":5564,"bookHadithIndex":174,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f07f33","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":37,"hadithIndex":5565,"bookHadithIndex":175,"text":"– Сообщается, что Асмаъ бинт Абу Бакр (да будет доволен Аллах ими обоими) сказала: «Одна женщина пришла к Пророку ﷺ и сказала: “О Посланник Аллаха, у меня есть дочь-невеста, переболевшая корью, (от которой) у неё стали выпадать волосы, так не подвязать ли мне (накладные волосы на место выпавших)?” (на что Пророк ﷺ) ска­зал: “Аллах проклял и подвязывающую и ту, которая просит подвязать (ей чужие волосы)”»","grades":[]},{"id":"69b6c410dd1a4c9c86f07f34","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":37,"hadithIndex":5566,"bookHadithIndex":176,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f07f35","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":37,"hadithIndex":5567,"bookHadithIndex":177,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f07f36","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":37,"hadithIndex":5568,"bookHadithIndex":178,"text":"– Передают со слов ‘Аиши (да будет доволен ею Аллах) о том, что «одна девушка из числа ансаров вышла замуж, однако она заболела и у неё (из-за этого) выпали волосы. Тогда она захотели подвязать ей волосы и спросили об этом Посланника Аллаха ﷺ и он проклял подвязывающих (волосы) и ту, которая делает это другим»","grades":[]},{"id":"69b6c410dd1a4c9c86f07f3b","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":37,"hadithIndex":5573,"bookHadithIndex":181,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f07f3c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":37,"hadithIndex":5574,"bookHadithIndex":182,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f07f3d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":37,"hadithIndex":5575,"bookHadithIndex":183,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f07f3e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":37,"hadithIndex":5576,"bookHadithIndex":184,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f07f3f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":37,"hadithIndex":5577,"bookHadithIndex":185,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f07f40","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":37,"hadithIndex":5578,"bookHadithIndex":186,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f07f41","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":37,"hadithIndex":5579,"bookHadithIndex":187,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f07f42","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":37,"hadithIndex":5580,"bookHadithIndex":188,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f07f43","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":37,"hadithIndex":5581,"bookHadithIndex":189,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f07f44","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":37,"hadithIndex":5582,"bookHadithIndex":190,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f07f45","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":37,"hadithIndex":5583,"bookHadithIndex":191,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f07f46","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":37,"hadithIndex":5584,"bookHadithIndex":192,"text":"","grades":[]},{"id":"69b6c410dd1a4c9c86f07f47","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":37,"hadithIndex":5585,"b
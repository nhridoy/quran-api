itionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3464,"bookHadithIndex":66,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f076ff","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3465,"bookHadithIndex":67,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07700","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3466,"bookHadithIndex":68,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07701","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3467,"bookHadithIndex":69,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07702","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3468,"bookHadithIndex":70,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07703","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3469,"bookHadithIndex":71,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07704","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3470,"bookHadithIndex":72,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07705","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3471,"bookHadithIndex":73,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07706","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3472,"bookHadithIndex":74,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07707","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3473,"bookHadithIndex":75,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07708","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3474,"bookHadithIndex":76,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07709","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3475,"bookHadithIndex":77,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0770a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3476,"bookHadithIndex":78,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0770b","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3477,"bookHadithIndex":79,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0770c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3478,"bookHadithIndex":80,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0770d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3479,"bookHadithIndex":81,"text":"– Сообщается, что ‘Аиша (да будет доволен ею Аллах) сказала: «Мой брачный договор с Посланником Аллаха ﷺ был заключён, (когда мне исполнилось) шесть лет, а моя свадьба состоялась, когда мне было девять лет. (Когда) мы приехали в Медину, я в течение месяца болела лихорадкой, (и у меня выпали) волосы, которые (снова) отросли до плеч после (выздоровления. Однажды, когда) я качалась на качелях вместе с моими подругами, Умм Руман пришла ко мне и громко позвала меня, и я подошла к ней, не зная, что ей нужно. Она взяла меня за руку и привела к дверям дома, а когда моё дыхание успокоилось, (Умм Руман) ввела меня в дом, где находились женщины из числа ансаров. Они стали говорить: “(Желаем тебе) блага, благословения (Аллаха) и (счастливого) удела!” Потом мать передала меня (этим женщинам), а они вымыли мне голову и приготовили меня (к свадьбе), и больше ничего неожиданного со мной не случилось, пока утром (не пришёл) Посланник Аллаха ﷺ которому (мать) передала меня»","grades":[]},{"id":"69b6c334dd1a4c9c86f0770e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3480,"bookHadithIndex":82,"text":"– Сообщается, что ‘Аиша (да будет доволен ею Аллах) сказала: «Мой брачный договор с Пророком ﷺ был заключён, когда я была девочкой (в возрасте) шести лет, а моя свадьба состоялась, когда мне было девять лет»","grades":[]},{"id":"69b6c334dd1a4c9c86f0770f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3481,"bookHadithIndex":83,"text":"– Передают со слов ‘Урвы (ибн аз-Зубайра), что ‘Аиша (да будет доволен ею Аллах) сказала: «Пророк ﷺ заключил с ней брак, когда она была девочкой (в возрасте) семи лет, и к нему отвели её (в качестве невесты,) когда ей было девять лет и её игрушки (всё ещё) были с ней, а умер он, когда ей было восемнадцать (лет)»","grades":[]},{"id":"69b6c334dd1a4c9c86f07710","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3482,"bookHadithIndex":84,"text":"– Передают со слов аль-Асвада, что ‘Аиша (да будет доволен ею Аллах) сказала: «Посланник Аллаха ﷺ заключил с ней брак, когда она была девочкой (в возрасте) шести (лет), свадьба её состоялась, когда ей было девять (лет), а умер он, когда ей было восемнадцать (лет)»","grades":[]},{"id":"69b6c334dd1a4c9c86f07711","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3483,"bookHadithIndex":85,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07712","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3484,"bookHadithIndex":86,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07713","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3485,"bookHadithIndex":87,"text":"Сообщается, что Абу Хурайра (да будет доволен им Аллах) сказал: «(Однажды), когда я находился у Пророка ﷺ к нему пришёл какой-то мужчина и сказал, что он женился на женщине из числа ансаров. Посланник Аллаха ﷺ спросил: “А ты посмотрел на неё?” Он ответил: “Нет”. (Пророк ﷺ) сказал: “Пойди и посмотри на неё, ибо в глазах у ансаров есть что-то”»","grades":[]},{"id":"69b6c334dd1a4c9c86f07714","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3486,"bookHadithIndex":88,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07715","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3487,"bookHadithIndex":89,"text":"Сахль ибн Са‘д (да будет доволен им Аллах) рассказывал: «Как-то раз одна женщина предложила себя в жёны Пророку ﷺ тогда кто-то из мужчин сказал ему: “О Посланник Аллаха (если ты не женишься на ней), выдай её замуж за меня!” Пророк ﷺ спросил: “А что у тебя есть (в качестве махра)?” Он ответил: “У меня нет ничего”. Тогда Пророк ﷺ сказал: “Ступай и постарайся найти хотя бы железное кольцо”. Этот человек ушёл, а потом вернулся и сказал: “Клянусь Аллахом, я не нашёл ничего, даже железного кольца. Но вот мой изар, и пусть ей будет половина от него”. А у него не было даже накидки. Выслушав его, Пророк ﷺ сказал: “А что ей делать с твоим изаром? Если его будешь носить ты, ничего не останется ей, а если его будет носить она, ничего не достанется тебе”. Тогда этот человек сел, и, просидев долгое время, поднялся со своего места. Это увидел Пророк ﷺ который подозвал его и спросил: “Что ты знаешь из Корана (наизусть)?” Он ответил: “Такую-то и такую-то суру”. И тогда Пророк ﷺ сказал ему: “Мы выдаем её за тебя замуж за то, что ты знаешь из Корана”»","grades":[]},{"id":"69b6c334dd1a4c9c86f07716","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3488,"bookHadithIndex":90,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07717","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3489,"bookHadithIndex":91,"text":"Передают со слов Мухаммада ибн Ибрахима, что Абу Саляма ибн ‘Абдуррахман сказал: «(Однажды) я спро­сил у ‘Аиши, жены Пророка ﷺ: “Каков был брачный дар Посланника Аллаха ﷺ?” Она сказала: “(В качестве) брачного дара (он давал каждой из) своих жён двенадцать укъий и (один) нашш (серебра)”. (Затем ‘Аиша) спросила: “Зна­ешь ли ты, что такое нашш?” Я ответил: “Нет”. Тогда она сказала: “Поло­вина укъии, в целом же это равнялось пятистам дирхемам. Такой брач­ный дар Посланник Аллаха ﷺ (делал каждой из своих) жён”»","grades":[]},{"id":"69b6c334dd1a4c9c86f07718","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3490,"bookHadithIndex":92,"text":"Передают со слов Анаса ибн Малика (да будет доволен им Аллах), что, увидев на (теле) ‘Абдуррахмана ибн ‘Ауфа (да будет доволен им Аллах) жёлтые следы (благовоний), Пророк ﷺ спросил его: «Что это?» Тот сказал: «О Посланник Аллаха, я женился на одной женщине, (отдав ей в качестве брачного дара) золото весом с кос­точку», и (Пророк ﷺ сказал: «Да благословит же тебя Аллах! /Фа-барака-Ллаху ляка/ (А теперь) устрой угощение хотя бы из одной овцы»","grades":[]},{"id":"69b6c334dd1a4c9c86f07719","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3491,"bookHadithIndex":93,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0771a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3492,"bookHadithIndex":94,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0771b","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3493,"bookHadithIndex":95,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0771c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3494,"bookHadithIndex":96,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0771d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3495,"bookHadithIndex":97,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0771e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3496,"bookHadithIndex":98,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0771f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3497,"bookHadithIndex":99,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07720","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3498,"bookHadithIndex":100,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07722","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3500,"bookHadithIndex":102,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07723","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3501,"bookHadithIndex":104,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07724","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3502,"bookHadithIndex":103,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07725","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3503,"bookHadithIndex":105,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07726","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3504,"bookHadithIndex":106,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07727","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3505,"bookHadithIndex":107,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07728","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3506,"bookHadithIndex":108,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f07729","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3507,"bookHadithIndex":109,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0772a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3508,"bookHadithIndex":110,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0772b","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3509,"bookHadithIndex":112,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0772c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3510,"bookHadithIndex":113,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0772d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3511,"bookHadithIndex":114,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0772e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3512,"bookHadithIndex":115,"text":"","grades":[]},{"id":"69b6c334dd1a4c9c86f0772f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3513,"bookHadithIndex":116,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07730","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3514,"bookHadithIndex":117,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07731","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3515,"bookHadithIndex":118,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07732","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3516,"bookHadithIndex":119,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07733","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3517,"bookHadithIndex":120,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07734","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3518,"bookHadithIndex":121,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07735","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3519,"bookHadithIndex":122,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07736","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3520,"bookHadithIndex":123,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07737","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3521,"bookHadithIndex":124,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07738","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3522,"bookHadithIndex":125,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07739","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3523,"bookHadithIndex":126,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0773a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3524,"bookHadithIndex":127,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0773c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3526,"bookHadithIndex":128,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0773d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3527,"bookHadithIndex":129,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0773e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3528,"bookHadithIndex":130,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0773f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3529,"bookHadithIndex":131,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07740","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3530,"bookHadithIndex":132,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07741","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3531,"bookHadithIndex":133,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07742","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3532,"bookHadithIndex":134,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07743","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3533,"bookHadithIndex":135,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07744","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3534,"bookHadithIndex":136,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07745","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3535,"bookHadithIndex":137,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07746","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3536,"bookHadithIndex":138,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07747","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3537,"bookHadithIndex":139,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07748","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3538,"bookHadithIndex":140,"text":"– Передают со слов Абу Хурайры, да будет доволен им Аллах, что Посланник Аллаха ﷺ сказал: «Если женщина проведёт ночь не на ложе своего мужа, ангелы будут проклинать её до самого утра»","grades":[]},{"id":"69b6c368dd1a4c9c86f07749","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3539,"bookHadithIndex":141,"text":"– И рассказал мне его Яхйа ибн Хабиб:– Рассказал нам Халид, то есть Ибн аль-Харис:– Рассказал нам Шу‘ба (хадис) с этим иснадом, и он сказал: «… пока она не вернётся»","grades":[]},{"id":"69b6c368dd1a4c9c86f0774a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3540,"bookHadithIndex":142,"text":"– Сообщается, что Абу Хурайра (да будет доволен им Аллах) сказал: «Посланник Аллаха ﷺ сказал: “Клянусь Тем, в чьей длани душа моя, если кто-либо из мужчин позовёт свою жену в постель, а она откажет ему, тот, кто пребывает на небесах, не перестанет гневаться на неё до тех пор, пока (муж снова) не будет доволен ею!”»","grades":[]},{"id":"69b6c368dd1a4c9c86f0774b","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3541,"bookHadithIndex":143,"text":"– Сообщается, что Абу Хурайра (да будет доволен им Аллах), сказал: «Посланник Аллаха ﷺ сказал: “Если мужчина позовёт свою жену на своё ложе, а она не придёт к нему, и он заснёт, гневаясь на неё, ангелы будут проклинать её до самого утра”»","grades":[]},{"id":"69b6c368dd1a4c9c86f0774c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3542,"bookHadithIndex":144,"text":"– Сообщается, что Абу Са‘ид аль-Худри (да будет доволен им Аллах) сказал: «Посланник Аллаха ﷺ сказал: “Поистине, в День воскрешения среди людей, которые окажутся в наихудшем положении пред Аллахом, будет (такой) мужчина, который проводит ночь со (своей) женой, а потом разглашающий её тайну”»","grades":[]},{"id":"69b6c368dd1a4c9c86f0774d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3543,"bookHadithIndex":145,"text":"– Сообщается, что Абу Са‘ид аль-Худри (да будет доволен им Аллах) сказал: «Посланник Аллаха ﷺ сказал: “Поистине, в День воскрешения одним из величайших (нарушений) аманата пред Аллахом будет (то, как) мужчина проводит ночь со (своей) женой, а потом разглашает её тайну». А Ибн Нумайр (в своей версии) сказал: «Поистине, величайшим …»","grades":[]},{"id":"69b6c368dd1a4c9c86f0774e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3544,"bookHadithIndex":146,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f0774f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3545,"bookHadithIndex":147,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07750","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3546,"bookHadithIndex":148,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07751","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":16,"hadithIndex":3547,"bookHadithIndex":149,"text":"","grades":[]},{"id":"69b6c368dd1a4c9c86f07752","editionId":"69b55e8d6f42b
{"total":210,"totalPage":5,"page":4,"pageSize":50,"items":[{"id":"69b6c44fdd1a4c9c86f08379","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6659,"bookHadithIndex":156,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0837a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6660,"bookHadithIndex":157,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0837b","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6661,"bookHadithIndex":158,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0837c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6662,"bookHadithIndex":159,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0837d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6663,"bookHadithIndex":160,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0837e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6664,"bookHadithIndex":161,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0837f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6665,"bookHadithIndex":162,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08380","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6666,"bookHadithIndex":163,"text":"Сообщается, что Абу Хурайра рассказывал: «Абу-ль-Касим ﷺ сказал: “Если кто-либо направит на своего брата что-либо железное, ангелы будут проклинать его, пока он не прекратит, даже если это его брат по отцу и матери”»","grades":[]},{"id":"69b6c44fdd1a4c9c86f08381","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6667,"bookHadithIndex":164,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08382","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6668,"bookHadithIndex":165,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08383","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6669,"bookHadithIndex":166,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08384","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6670,"bookHadithIndex":167,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08385","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6671,"bookHadithIndex":168,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08386","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6672,"bookHadithIndex":169,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08387","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6673,"bookHadithIndex":170,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08388","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6674,"bookHadithIndex":171,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08389","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6675,"bookHadithIndex":172,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0838a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6676,"bookHadithIndex":173,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0838b","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6677,"bookHadithIndex":174,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0838c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6678,"bookHadithIndex":175,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0838d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6679,"bookHadithIndex":176,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0838e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6680,"bookHadithIndex":177,"text":"Сообщается со слов Абу Са‘ида аль-Худри и Абу Хурайры, что Посланник Аллаха ﷺ сказал: «(Всемогущий Аллах сказал): “Величие Мой изар, а гордость Моя накидка /ридаъ/, кто станет оспаривать их у Меня, того Я подвергну мучениям!”»","grades":[]},{"id":"69b6c44fdd1a4c9c86f0838f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6681,"bookHadithIndex":178,"text":"– Передают со слов Джундаба ибн ‘Абдуллах, да будет доволен им Аллах, что Посланник Аллаха ﷺ рассказывал: «(Как-то раз) один человек сказал: “Клянусь Аллахом, не простит Аллах такого-то!”, и тогда Всемогущий и Великий сказал: “Кто клянётся Мною, что Я не прощу такого-то? Поистине, Я уже простил такого-то, а твои дела сделал тщетными!”»","grades":[]},{"id":"69b6c44fdd1a4c9c86f08390","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6682,"bookHadithIndex":179,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08391","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6683,"bookHadithIndex":180,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08392","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6684,"bookHadithIndex":181,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08393","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6685,"bookHadithIndex":182,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08394","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6686,"bookHadithIndex":183,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08395","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6687,"bookHadithIndex":184,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08396","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6688,"bookHadithIndex":185,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08397","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6689,"bookHadithIndex":186,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08398","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6690,"bookHadithIndex":187,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f08399","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6691,"bookHadithIndex":188,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0839a","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6692,"bookHadithIndex":189,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0839b","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6693,"bookHadithIndex":190,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0839c","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6694,"bookHadithIndex":191,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0839d","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6695,"bookHadithIndex":192,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f0839e","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6696,"bookHadithIndex":193,"text":"Передают со слов Абу Хурайры, да будет доволен им Аллах, что Посланник Аллаха ﷺ сказал: «Любого из мусульман, у которого умрут трое детей, огонь коснётся только во исполнение клятвы»","grades":[]},{"id":"69b6c44fdd1a4c9c86f0839f","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6697,"bookHadithIndex":194,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f083a0","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6698,"bookHadithIndex":195,"text":"Передают со слов Абу Хурайры, да будет доволен им Аллах, о том, что Посланник Аллаха ﷺ сказал женщинам из числа ансаров: «Любая из вас, у которой умрут трое детей и которая станет проявлять терпение в надежде на награду Аллаха, непременно войдёт в Рай». Одна из этих женщин спросила: «А если (умрут) двое, о Посланник Аллаха?» и (Пророк ﷺ) сказал: «(И если умрут) двое»","grades":[]},{"id":"69b6c44fdd1a4c9c86f083a1","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6699,"bookHadithIndex":196,"text":"Сообщается, что Абу Са‘ид аль-Худри, да будет доволен им Аллах, сказал: «(Как-то раз) одна женщина пришла к Посланнику Аллаха ﷺ и сказала (ему): “О Посланник Аллаха, с тобой разговаривают одни только мужчины, назначь же и для нас какой-нибудь день, когда мы станем приходить к тебе, а ты будешь учить нас тому, чему научил тебя Аллах!” (В ответ ей Пророк ﷺ) сказал: “Соберитесь в такой-то день”, и (женщины) собрались, что же касается Пророка ﷺ то он пришёл к ним и стал учить их тому, чему научил его Аллах, а потом он сказал им: “Любую из вас, которая представит троих (умерших у неё) детей, они обязательно оградят от огня”. Одна женщина спросила: “А (если их будет) двое?”, и Посланник Аллаха ﷺ ответил: “И двое”»","grades":[]},{"id":"69b6c44fdd1a4c9c86f083a2","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6700,"bookHadithIndex":197,"text":"В другой версии этого хадиса сообщается, что (передавая слова Пророка ﷺ) Абу Хурайра сказал: «… трое (детей) не достигших совершеннолетия»","grades":[]},{"id":"69b6c44fdd1a4c9c86f083a5","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6703,"bookHadithIndex":199,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f083a6","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6704,"bookHadithIndex":200,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f083a7","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6705,"bookHadithIndex":201,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f083a8","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6706,"bookHadithIndex":202,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f083a9","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6707,"bookHadithIndex":203,"text":"","grades":[]},{"id":"69b6c44fdd1a4c9c86f083aa","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6708,"bookHadithIndex":204,"text":"Передают со слов Абу Хурайры, да будет доволен им Аллах, что Посланник Аллаха ﷺ сказал: «Души (подобны) призванным в войско воинам, и те из них, которые узнают друг друга, объединяются, те же, которые не узнают, противоречат друг другу»","grades":[]},{"id":"69b6c44fdd1a4c9c86f083ab","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6709,"bookHadithIndex":205,"text":"Сообщается, что Абу Хурайра, да будет доволен им Аллах, передавая слова Посланника Аллаха ﷺ сказал: «Люди являются рудниками, подобными золотым и серебряным рудникам. Те из них, что были лучшими во времена джахилийи, (остались) лучшими и в Исламе, если усвоили (установления) религии. (Что же касается) душ, то они (подобны) воинам, призванным (в войско): те из них, которые узнают друг друга, объединяются, те же, которые не узнают, противоречат друг другу»","grades":[]},{"id":"69b6c44fdd1a4c9c86f083ac","editionId":"69b55e8d6f42ba7ccb2a131f","bookIndex":45,"hadithIndex":6710,"bookHadithIndex":206,"text":"","grades":[]}]}
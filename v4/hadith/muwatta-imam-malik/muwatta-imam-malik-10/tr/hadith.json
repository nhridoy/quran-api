    },
    {
      "id": "69b6bf5add1a4c9c86f0463d",
      "editionId": "69b55e8d6f42ba7ccb2a131d",
      "bookIndex": 10,
      "hadithIndex": 430,
      "bookHadithIndex": 3,
      "text": "İbn Şihab'dan: Resulullah Sallallahu Aleyhi ve Sellem, Kurban ve Ramazan bayramı namazlarını hutbeden önce kılardı. İbn Ömer'den merfu olarak gelmiştir. Buharî, îdeyn; Müslim, Salatu'l-îdeyn BAHSİ GEÇEN BUHARİ HADİS’İ VE İZAH İÇİN BURAYA TIKLAYIN",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a131d-10-430-salimalhilali",
          "name": "Salim al-Hilali",
          "grade": "Sahih Lighairihi"
        }

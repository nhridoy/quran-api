      "hadithIndex": 437,
      "bookHadithIndex": 10,
      "text": "Nafi'den: Abdullah b. Ömer, Ramazan bayramı günü bayram namazından önce ve sonra başka namaz kılmazdı",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a131d-10-437-salimalhilali",
          "name": "Salim al-Hilali",
          "grade": "Mauquf Sahih"

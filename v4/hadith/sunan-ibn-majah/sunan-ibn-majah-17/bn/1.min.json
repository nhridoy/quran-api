{"total":10,"totalPage":1,"page":1,"pageSize":50,"items":[{"id":"69b6c88cdd1a4c9c86f0cba4","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":17,"hadithIndex":2492,"bookHadithIndex":1,"text":"। জাবির (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ কারো খেজুর বাগান বা কৃষিভূমি থাকলে সে যেন তার শরীককে তা ক্রয়ের প্রস্তাব না করা পর্যন্ত বিক্রয় না করে।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-17-2492-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2492-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2492-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2492-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c88cdd1a4c9c86f0cba5","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":17,"hadithIndex":2493,"bookHadithIndex":2,"text":"। ইবনে আব্বাস (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ কারো জমাজমি থাকলে এবং সে তা বিক্রয় করতে চাইলে তার প্রতিবেশীকে (তা ক্রয়ের) প্রস্তাব দিবে।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-17-2493-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2493-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2493-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2493-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c88cdd1a4c9c86f0cba6","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":17,"hadithIndex":2494,"bookHadithIndex":3,"text":"। জাবির (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ প্রতিবেশী তার প্রতিবেশীর শুফ‘আর অধিক হকদার। তাদের উভয়ের যাতায়াতের একই পথ হলে তার অনুপস্থিতিতে তার জন্য অপেক্ষা করতে হবে।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-17-2494-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2494-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2494-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2494-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c88cdd1a4c9c86f0cba7","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":17,"hadithIndex":2495,"bookHadithIndex":4,"text":"। আবূ রাফে (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ নৈকট্যের কারণে প্রতিবেশী (শুফ‘আর) অধিক হকদার।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-17-2495-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2495-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2495-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2495-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari"}]},{"id":"69b6c88cdd1a4c9c86f0cba8","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":17,"hadithIndex":2496,"bookHadithIndex":5,"text":"। শারীদ ইবনে সুওয়াইদ (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি বললাম, ইয়া রাসূলাল্লাহ! এক খন্ড জমি যাতে কারো অংশও নেই এবং কোন শরীকও নেই, কিন্তু প্রতিবেশী আছে। তিনি বলেনঃ নৈকট্যের কারণে প্রতিবেশীই তার অধিক হকদার।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-17-2496-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2496-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2496-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2496-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c88cdd1a4c9c86f0cba9","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":17,"hadithIndex":2497,"bookHadithIndex":6,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-17-2497-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2497-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"}]},{"id":"69b6c88cdd1a4c9c86f0cbaa","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":17,"hadithIndex":2498,"bookHadithIndex":8,"text":"। আবূ রাফে (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ শরীক নিকটতর হওয়ার কারণে শুফ‘আর দাবিতে অগ্রগণ্য।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-17-2498-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2498-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2498-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari"}]},{"id":"69b6c88cdd1a4c9c86f0cbab","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":17,"hadithIndex":2499,"bookHadithIndex":9,"text":"। জাবির ইবনে আবদুল্লাহ (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম প্রত্যেক এজমালী সম্পত্তিতে শুফ‘আর (ক্রয়ে অগ্রাধিকার থাকার) ব্যবস্থা করেছেন। (বণ্টনের পর প্রত্যেকের) সীমানা নির্ধারিত হয়ে গেলে এবং রাস্তা হয়ে গেলে আর শুফ‘আর অধিকার থাকে না।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-17-2499-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2499-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2499-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari"}]},{"id":"69b6c88cdd1a4c9c86f0cbac","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":17,"hadithIndex":2500,"bookHadithIndex":10,"text":"। ইবনে উমার (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ শুফ‘আ হলো উটের বাঁধন খুলে দেয়ার সমতুল্য।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-17-2500-alalbani","name":"Al-Albani","grade":"Very Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2500-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Very Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2500-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Very Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2500-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c88cdd1a4c9c86f0cbad","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":17,"hadithIndex":2501,"bookHadithIndex":11,"text":"। ইবনে উমার (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ কোন শরীক অপর শরীকের আগে ক্রয় করলে সেই ক্ষেত্রে শুফ‘আর দাবি করা যাবে না এবং নাবালেগ ও অনুপস্থিত ব্যক্তির অনুকূলে শুফ‘আর দাবি বর্তায় না।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-17-2501-alalbani","name":"Al-Albani","grade":"Very Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2501-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Very Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2501-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Very Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-17-2501-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]}]}
{"total":56,"totalPage":2,"page":2,"pageSize":50,"items":[{"id":"69b6c88cdd1a4c9c86f0cb9e","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":16,"hadithIndex":2486,"bookHadithIndex":51,"text":"حدثنا الوليد بن عمرو بن سكين، حدثنا محمد بن عبد الله بن المثنى، ح وحدثنا الحسن بن محمد بن الصباح، حدثنا عبد الوهاب بن عطاء، قالا حدثنا اسماعيل المكي، عن الحسن، عن عبد الله بن مغفل، ان النبي صلى الله عليه وسلم قال \" من حفر بيرا فله اربعون ذراعا عطنا لماشيته","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-16-2486-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-16-2486-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-16-2486-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c88cdd1a4c9c86f0cb9f","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":16,"hadithIndex":2487,"bookHadithIndex":52,"text":"حدثنا سهل بن ابي الصغدي، حدثنا منصور بن صقير، حدثنا ثابت بن محمد، عن نافع ابي غالب، عن ابي سعيد الخدري، قال قال رسول الله صلى الله عليه وسلم \" حريم البير مد رشايها","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-16-2487-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-16-2487-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-16-2487-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-16-2487-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c88cdd1a4c9c86f0cba0","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":16,"hadithIndex":2488,"bookHadithIndex":53,"text":"حدثنا عبد ربه بن خالد النميري ابو المغلس، حدثنا الفضيل بن سليمان، حدثنا موسى بن عقبة، اخبرني اسحاق بن يحيى بن الوليد، عن عبادة بن الصامت، ان رسول الله صلى الله عليه وسلم قضى في النخلة والنخلتين والثلاثة للرجل في النخل فيختلفون في حقوق ذلك فقضى ان لكل نخلة من اوليك من الارض مبلغ جريدها حريم لها","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-16-2488-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-16-2488-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-16-2488-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-16-2488-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c88cdd1a4c9c86f0cba1","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":16,"hadithIndex":2489,"bookHadithIndex":54,"text":"حدثنا سهل بن ابي الصغدي، حدثنا منصور بن صقير، حدثنا ثابت بن محمد العبدي، عن ابن عمر، قال قال رسول الله صلى الله عليه وسلم \" حريم النخلة مد جريدها","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-16-2489-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-16-2489-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-16-2489-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-16-2489-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c88cdd1a4c9c86f0cba2","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":16,"hadithIndex":2490,"bookHadithIndex":55,"text":"","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-16-2490-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-16-2490-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"}]},{"id":"69b6c88cdd1a4c9c86f0cba3","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":16,"hadithIndex":2491,"bookHadithIndex":57,"text":"حدثنا هشام بن عمار، وعمرو بن رافع، قالا حدثنا مروان بن معاوية، حدثنا ابو مالك النخعي، عن يوسف بن ميمون، عن ابي عبيدة بن حذيفة، عن ابيه، حذيفة بن اليمان قال قال رسول الله صلى الله عليه وسلم \" من باع دارا ولم يجعل ثمنها في مثلها لم يبارك له فيها","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-16-2491-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-16-2491-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-16-2491-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Very Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-16-2491-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]}]}
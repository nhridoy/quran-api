  "items": [
    {
      "id": "69b6c88cdd1a4c9c86f0cb9e",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 16,
      "hadithIndex": 2486,
      "bookHadithIndex": 51,
      "text": "It was narrated from 'Abdullah bin Mughaffal that the Prophet (ﷺ) said:“Whoever digs a well, is entitled to forty forearms' length surrounding it is as a resting place for his flocks.”",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-16-2486-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-16-2486-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-16-2486-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cb9f",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 16,
      "hadithIndex": 2487,
      "bookHadithIndex": 52,
      "text": "It was narrated from Abu Sa'eed Al-Khudri that the Messenger of Allah (ﷺ) said:“The land around a well (that is considered to be part of it) is the length of the well rope (in all directions).”",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-16-2487-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-16-2487-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-16-2487-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-16-2487-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cba0",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 16,
      "hadithIndex": 2488,
      "bookHadithIndex": 53,
      "text": "It was narrated from 'Ubadah bin Samit that :the Messenger of Allah (ﷺ) ruled concerning one, two or three date palms belonging to a man among other palm trees - when they differ concerning entitlement to the surrounding land. He ruled that the land around each of those trees, as far as their leaves reach, measured from the bottom of the tree, belongs to the owner of the tree",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-16-2488-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-16-2488-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-16-2488-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-16-2488-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cba1",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 16,
      "hadithIndex": 2489,
      "bookHadithIndex": 54,
      "text": "It was narrated from Ibn 'Umar that the Messenger of Allah Said:“The land around a date-palm tree, as far as its branches reach, belongs to the owner of the tree.”",

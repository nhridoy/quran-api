    },
    {
      "id": "69b6c81fdd1a4c9c86f0c2e4",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 0,
      "hadithIndex": 252,
      "bookHadithIndex": 252,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا يونس بن محمد، وسريج بن النعمان، قالا حدثنا فليح بن سليمان، عن عبد الله بن عبد الرحمن بن معمر ابي طوالة، عن سعيد بن يسار، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" من تعلم علما مما يبتغى به وجه الله لا يتعلمه الا ليصيب به عرضا من الدنيا لم يجد عرف الجنة يوم القيامة \" . يعني ريحها . قال ابو الحسن انبانا ابو حاتم، حدثنا سعيد بن منصور، حدثنا فليح بن سليمان، فذكر نحوه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-0-252-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-0-252-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-0-252-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-0-252-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c81fdd1a4c9c86f0c2e5",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 0,
      "hadithIndex": 253,
      "bookHadithIndex": 253,
      "text": "حدثنا هشام بن عمار، حدثنا حماد بن عبد الرحمن، حدثنا ابو كرب الازدي، عن نافع، عن ابن عمر، عن النبي صلى الله عليه وسلم قال \" من طلب العلم ليماري به السفهاء او ليباهي به العلماء او ليصرف وجوه الناس اليه فهو في النار",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-0-253-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-0-253-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-0-253-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Hasan Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-0-253-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c81fdd1a4c9c86f0c2e6",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 0,
      "hadithIndex": 254,
      "bookHadithIndex": 254,
      "text": "حدثنا محمد بن يحيى، حدثنا ابن ابي مريم، انبانا يحيى بن ايوب، عن ابن جريج، عن ابي الزبير، عن جابر بن عبد الله، ان النبي صلى الله عليه وسلم قال \" لا تعلموا العلم لتباهوا به العلماء ولا لتماروا به السفهاء ولا تخيروا به المجالس فمن فعل ذلك فالنار النار",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-0-254-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-0-254-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-0-254-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c81fdd1a4c9c86f0c2e7",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 0,
      "hadithIndex": 255,
      "bookHadithIndex": 255,
      "text": "حدثنا محمد بن الصباح، انبانا الوليد بن مسلم، عن يحيى بن عبد الرحمن الكندي، عن عبيد الله بن ابي بردة، عن ابن عباس، عن النبي صلى الله عليه وسلم قال \" ان اناسا من امتي سيتفقهون في الدين ويقرءون القران ويقولون ناتي الامراء فنصيب من دنياهم ونعتزلهم بديننا . ولا يكون ذلك كما لا يجتنى من القتاد الا الشوك كذلك لا يجتنى من قربهم الا \" . قال محمد بن الصباح كانه يعني الخطايا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-0-255-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-0-255-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-0-255-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-0-255-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c81fdd1a4c9c86f0c2e8",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 0,
      "hadithIndex": 256,
      "bookHadithIndex": 256,
      "text": "حدثنا علي بن محمد، ومحمد بن اسماعيل، قالا حدثنا عبد الرحمن بن محمد المحاربي، حدثنا عمار بن سيف، عن ابي معاذ البصري، ح وحدثنا علي بن محمد، حدثنا اسحاق بن منصور، عن عمار بن سيف، عن ابي معاذ، عن ابن سيرين، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" تعوذوا بالله من جب الحزن \" . قالوا يا رسول الله وما جب الحزن قال \" واد في جهنم يتعوذ منه جهنم كل يوم اربعماية مرة \" . قالوا يا رسول الله ومن يدخله قال \" اعد للقراء المرايين باعمالهم وان من ابغض القراء الى الله الذين يزورون الامراء \" . قال المحاربي الجورة . قال ابو الحسن حدثنا حازم بن يحيى حدثنا ابو بكر بن ابي شيبة ومحمد بن نمير قالا حدثنا ابن نمير عن معاوية النصري وكان ثقة ثم ذكر الحديث نحوه باسناده . حدثنا ابراهيم بن نصر، حدثنا ابو غسان، مالك بن اسماعيل حدثنا عمار بن سيف، عن ابي معاذ، . قال مالك بن اسماعيل قال عمار لا ادري محمد او انس بن سيرين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-0-256-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-0-256-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-0-256-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-0-256-zubairalizai",

    },
    {
      "id": "69b6c81fdd1a4c9c86f0c2ed",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 0,
      "hadithIndex": 261,
      "bookHadithIndex": 261,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا اسود بن عامر، حدثنا عمارة بن زاذان، حدثنا علي بن الحكم، حدثنا عطاء، عن ابي هريرة، عن النبي صلى الله عليه وسلم قال \" ما من رجل يحفظ علما فيكتمه الا اتي به يوم القيامة ملجما بلجام من النار \" . قال ابو الحسن - اى القطان - وحدثنا ابو حاتم، حدثنا ابو الوليد، حدثنا عمارة بن زاذان، فذكر نحوه . قال ابو الحسن ايضا وحدثنا ابراهيم بن نصر، قال حدثنا ابو نعيم، قال حدثنا عمارة بن زاذان، فذكر نحوه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-0-261-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-0-261-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-0-261-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c81fdd1a4c9c86f0c2ee",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 0,
      "hadithIndex": 262,
      "bookHadithIndex": 262,
      "text": "حدثنا ابو مروان العثماني، محمد بن عثمان حدثنا ابراهيم بن سعد، عن الزهري، عن عبد الرحمن بن هرمز الاعرج، انه سمع ابا هريرة، يقول والله لولا ايتان في كتاب الله تعالى ما حدثت عنه - يعني عن النبي صلى الله عليه وسلم - شييا ابدا لولا قول الله {ان الذين يكتمون ما انزل الله من الكتاب} الى اخر الايتين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-0-262-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"

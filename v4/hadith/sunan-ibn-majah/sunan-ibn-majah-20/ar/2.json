          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc0f",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2599,
      "bookHadithIndex": 67,
      "text": "حدثنا سويد بن سعيد، حدثنا علي بن مسهر، ح وحدثنا الحسن بن عرفة، حدثنا ابو حفص الابار، جميعا عن اسماعيل بن مسلم، عن عمرو بن دينار، عن طاوس، عن ابن عباس، ان رسول الله صلى الله عليه وسلم قال \" لا تقام الحدود في المساجد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2599-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2599-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2599-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc10",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2600,
      "bookHadithIndex": 68,
      "text": "حدثنا محمد بن رمح، انبانا عبد الله بن لهيعة، عن محمد بن عجلان، انه سمع عمرو بن شعيب، يحدث عن ابيه، عن جده، ان رسول الله صلى الله عليه وسلم نهى عن جلد الحد في المساجد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2600-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2600-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2600-shuaibalarnaut",

    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc0e",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2598,
      "bookHadithIndex": 66,
      "text": "حدثنا علي بن ميمون الرقي، وايوب بن محمد الوزان، وعبد الله بن سعيد، قالوا حدثنا معمر بن سليمان، انبانا الحجاج بن ارطاة، عن عبد الجبار بن وايل، عن ابيه، قال استكرهت امراة على عهد رسول الله صلى الله عليه وسلم فدرا عنها الحد واقامه على الذي اصابها . ولم يذكر انه جعل لها مهرا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2598-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2598-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {

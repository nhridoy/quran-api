  "items": [
    {
      "id": "69b6c88cdd1a4c9c86f0cbff",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2583,
      "bookHadithIndex": 51,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا ابو معاوية، عن الاعمش، عن ابي صالح، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" لعن الله السارق يسرق البيضة فتقطع يده ويسرق الحبل فتقطع يده",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2583-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2583-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2583-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2583-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc00",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2584,
      "bookHadithIndex": 52,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا علي بن مسهر، عن عبيد الله، عن نافع، عن ابن عمر، قال قطع النبي صلى الله عليه وسلم في مجن قيمته ثلاثة دراهم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2584-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2584-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2584-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2584-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc01",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2585,
      "bookHadithIndex": 53,
      "text": "حدثنا ابو مروان العثماني، حدثنا ابراهيم بن سعد، عن ابن شهاب، ان عمرة، اخبرته عن عايشة، قالت قال رسول الله صلى الله عليه وسلم \" لا تقطع اليد الا في ربع دينار فصاعدا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2585-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2585-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2585-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc02",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2586,
      "bookHadithIndex": 54,
      "text": "حدثنا محمد بن بشار، حدثنا ابو هشام المخزومي، حدثنا وهيب، حدثنا ابو واقد، عن عامر بن سعد، عن ابيه، عن النبي صلى الله عليه وسلم قال \" تقطع يد السارق في ثمن المجن",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2586-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2586-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2586-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc03",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2587,
      "bookHadithIndex": 55,
      "text": "حدثنا ابو بكر بن ابي شيبة، وابو بشر بكر بن خلف ومحمد بن بشار وابو سلمة الجوباري يحيى بن خلف قالوا حدثنا عمر بن علي بن عطاء بن مقدم، عن حجاج، عن مكحول، عن ابن محيريز، قال سالت فضالة بن عبيد عن تعليق اليد، في العنق فقال السنة قطع رسول الله صلى الله عليه وسلم يد رجل ثم علقها في عنقه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2587-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2587-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2587-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2587-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc04",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2588,
      "bookHadithIndex": 56,
      "text": "حدثنا محمد بن يحيى، حدثنا ابن ابي مريم، انبانا ابن لهيعة، عن يزيد بن ابي حبيب، عن عبد الرحمن بن ثعلبة الانصاري، عن ابيه، ان عمرو بن سمرة بن حبيب بن عبد شمس، جاء الى رسول الله صلى الله عليه وسلم فقال يا رسول الله اني سرقت جملا لبني فلان فطهرني . فارسل اليهم النبي صلى الله عليه وسلم فقالوا انا افتقدنا جملا لنا فامر به النبي صلى الله عليه وسلم فقطعت يده . قال ثعلبة انا انظر اليه حين وقعت يده وهو يقول الحمد لله الذي طهرني منك اردت ان تدخلي جسدي النار",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2588-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2588-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2588-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2588-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc05",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2589,
      "bookHadithIndex": 57,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا ابو اسامة، عن ابي عوانة، عن عمر بن ابي سلمة، عن ابيه، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" اذا سرق العبد فبيعوه ولو بنش",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2589-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2589-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2589-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2589-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc06",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2590,
      "bookHadithIndex": 58,
      "text": "حدثنا جبارة بن المغلس، حدثنا حجاج بن تميم، عن ميمون بن مهران، عن ابن عباس، ان عبدا، من رقيق الخمس سرق من الخمس فرفع ذلك الى النبي صلى الله عليه وسلم فلم يقطعه وقال \" مال الله عز وجل سرق بعضه بعضا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2590-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2590-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2590-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2590-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc07",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2591,
      "bookHadithIndex": 59,
      "text": "حدثنا محمد بن بشار، حدثنا ابو عاصم، عن ابن جريج، عن ابي الزبير، عن جابر بن عبد الله، ان رسول الله صلى الله عليه وسلم قال \" لا يقطع الخاين ولا المنتهب ولا المختلس",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2591-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2591-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2591-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2591-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc08",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2592,
      "bookHadithIndex": 60,
      "text": "حدثنا محمد بن يحيى، حدثنا محمد بن عاصم بن جعفر المصري، حدثنا المفضل بن فضالة، عن يونس بن يزيد، عن ابن شهاب، عن ابراهيم بن عبد الرحمن بن عوف، عن ابيه، قال سمعت رسول الله صلى الله عليه وسلم يقول \" ليس على المختلس قطع",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2592-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2592-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2592-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2592-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc09",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2593,
      "bookHadithIndex": 61,
      "text": "حدثنا علي بن محمد، حدثنا وكيع، عن سفيان، عن يحيى بن سعيد، عن محمد بن يحيى بن حبان، عن عمه، واسع بن حبان، عن رافع بن خديج، قال قال رسول الله صلى الله عليه وسلم \" لا قطع في ثمر ولا كثر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2593-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2593-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2593-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2593-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc0a",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2594,
      "bookHadithIndex": 62,
      "text": "حدثنا هشام بن عمار، حدثنا سعد بن سعيد المقبري، عن اخيه، عن ابيه، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" لا قطع في ثمر ولا كثر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2594-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2594-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2594-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc0b",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2595,
      "bookHadithIndex": 63,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا شبابة، عن مالك بن انس، عن الزهري، عن عبد الله بن صفوان، عن ابيه، انه نام في المسجد وتوسد رداءه فاخذ من تحت راسه فجاء بسارقه الى النبي صلى الله عليه وسلم فامر به النبي صلى الله عليه وسلم ان يقطع فقال صفوان يا رسول الله لم ارد هذا ردايي عليه صدقة فقال رسول الله صلى الله عليه وسلم \" فهلا قبل ان تاتيني به",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2595-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2595-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2595-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2595-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc0c",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2596,
      "bookHadithIndex": 64,
      "text": "حدثنا علي بن محمد، حدثنا ابو اسامة، عن الوليد بن كثير، عن عمرو بن شعيب، عن ابيه، عن جده، ان رجلا، من مزينة سال النبي صلى الله عليه وسلم عن الثمار فقال \" ما اخذ في اكمامه فاحتمل فثمنه ومثله معه وما كان في الجران ففيه القطع اذا بلغ ذلك ثمن المجن وان اكل ولم ياخذ فليس عليه \" . قال الشاة الحريسة منهن يا رسول الله قال \" ثمنها ومثله معه والنكال وما كان في المراح ففيه القطع اذا كان ما ياخذ من ذلك ثمن المجن",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2596-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2596-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2596-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2596-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc0d",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2597,
      "bookHadithIndex": 65,
      "text": "حدثنا هشام بن عمار، حدثنا سعيد بن يحيى، حدثنا حماد بن سلمة، عن اسحاق بن ابي طلحة، سمعت ابا المنذر، - مولى ابي ذر - يذكر ان ابا امية، حدثه ان رسول الله صلى الله عليه وسلم اتي بلص فاعترف اعترافا ولم يوجد معه المتاع فقال رسول الله صلى الله عليه وسلم \" ما اخالك سرقت \" . قال بلى . ثم قال \" ما اخالك سرقت \" . قال بلى . فامر به فقطع . فقال النبي صلى الله عليه وسلم \" قل استغفر الله واتوب اليه \" . قال استغفر الله واتوب اليه . قال \" اللهم تب عليه \" . مرتين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2597-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2597-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {

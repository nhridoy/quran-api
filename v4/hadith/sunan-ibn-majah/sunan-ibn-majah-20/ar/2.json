      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc12",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2602,
      "bookHadithIndex": 70,
      "text": "حدثنا هشام بن عمار، حدثنا اسماعيل بن عياش، حدثنا عباد بن كثير، عن يحيى بن ابي كثير، عن ابي سلمة، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" لا تعزروا فوق عشرة اسواط",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2602-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2602-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Hasan Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2602-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Very Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2602-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc13",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2603,
      "bookHadithIndex": 71,
      "text": "حدثنا محمد بن المثنى، حدثنا عبد الوهاب، وابن ابي عدي، عن خالد الحذاء، عن ابي قلابة، عن ابي الاشعث، عن عبادة بن الصامت، قال قال رسول الله صلى الله عليه وسلم \" من اصاب منكم حدا فعجلت له عقوبته فهو كفارته والا فامره الى الله",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2603-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2603-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2603-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2603-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc14",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2604,
      "bookHadithIndex": 72,
      "text": "حدثنا هارون بن عبد الله الحمال، حدثنا حجاج بن محمد، حدثنا يونس بن ابي اسحاق، عن ابي اسحاق، عن ابي جحيفة، عن علي، قال قال رسول الله صلى الله عليه وسلم \" من اصاب في الدنيا ذنبا فعوقب به فالله اعدل من ان يثني عقوبته على عبده ومن اذنب ذنبا في الدنيا فستره الله عليه فالله اكرم من ان يعود في شىء قد عفا عنه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2604-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2604-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2604-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc15",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2605,
      "bookHadithIndex": 73,
      "text": "حدثنا احمد بن عبدة، ومحمد بن عبيد المديني ابو عبيد، قالا حدثنا عبد العزيز بن محمد الدراوردي، عن سهيل بن ابي صالح، عن ابيه، عن ابي هريرة، ان سعد بن عبادة الانصاري، قال يا رسول الله الرجل يجد مع امراته رجلا ايقتله قال رسول الله صلى الله عليه وسلم \" لا \" . قال سعد بلى والذي اكرمك بالحق . فقال رسول الله صلى الله عليه وسلم \" اسمعوا ما يقول سيدكم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2605-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2605-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2605-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2605-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc16",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2606,
      "bookHadithIndex": 74,
      "text": "حدثنا علي بن محمد، حدثنا وكيع، عن الفضل بن دلهم، عن الحسن، عن قبيصة بن حريث، عن سلمة بن المحبق، قال قيل لابي ثابت سعد بن عبادة حين نزلت اية الحدود وكان رجلا غيورا ارايت لو انك وجدت مع ام ثابت رجلا اى شىء كنت تصنع قال كنت ضاربهما بالسيف انتظر حتى اجيء باربعة الى ما ذاك قد قضى حاجته وذهب . او اقول رايت كذا وكذا فتضربوني الحد ولا تقبلوا لي شهادة ابدا . قال فذكر ذلك للنبي صلى الله عليه وسلم فقال \" كفى بالسيف شاهدا \" . ثم قال \" لا اني اخاف ان يتتايع في ذلك السكران والغيران \" . قال ابو عبد الله يعني ابن ماجه سمعت ابا زرعة يقول هذا حديث علي بن محمد الطنافسي وفاتني منه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2606-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2606-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2606-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2606-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc17",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2607,
      "bookHadithIndex": 75,
      "text": "حدثنا اسماعيل بن موسى، حدثنا هشيم، ح وحدثنا سهل بن ابي سهل، حدثنا حفص بن غياث، جميعا عن اشعث، عن عدي بن ثابت، عن البراء بن عازب، قال مر بي خالي - سماه هشيم في حديثه الحارث بن عمرو - وقد عقد له النبي صلى الله عليه وسلم لواء فقلت له اين تريد فقال بعثني رسول الله صلى الله عليه وسلم الى رجل تزوج امراة ابيه من بعده فامرني ان اضرب عنقه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2607-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2607-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2607-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc18",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2608,
      "bookHadithIndex": 76,
      "text": "حدثنا محمد بن عبد الرحمن ابن اخي الحسين الجعفي، حدثنا يوسف بن منازل التيمي، حدثنا عبد الله بن ادريس، عن خالد بن ابي كريمة، عن معاوية بن قرة، عن ابيه، قال بعثني رسول الله صلى الله عليه وسلم الى رجل تزوج امراة ابيه ان اضرب عنقه واصفي ماله",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2608-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2608-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2608-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc19",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2609,
      "bookHadithIndex": 77,
      "text": "حدثنا ابو بشر، بكر بن خلف حدثنا ابن ابي الضيف، حدثنا عبد الله بن عثمان بن خثيم، عن سعيد بن جبير، عن ابن عباس، قال قال رسول الله صلى الله عليه وسلم \" من انتسب الى غير ابيه او تولى غير مواليه فعليه لعنة الله والملايكة والناس اجمعين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2609-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2609-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2609-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc1a",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2610,
      "bookHadithIndex": 78,
      "text": "حدثنا علي بن محمد، حدثنا ابو معاوية، عن عاصم الاحول، عن ابي عثمان النهدي، قال سمعت سعدا، وابا، بكرة وكل واحد منهما يقول سمعت اذناى، ووعى، قلبي محمدا صلى الله عليه وسلم يقول \" من ادعى الى غير ابيه وهو يعلم انه غير ابيه فالجنة عليه حرام",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2610-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2610-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2610-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-20-2610-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc1b",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 20,
      "hadithIndex": 2611,
      "bookHadithIndex": 79,
      "text": "حدثنا محمد بن الصباح، انبانا سفيان، عن عبد الكريم، عن مجاهد، عن عبد الله بن عمرو، قال قال رسول الله صلى الله عليه وسلم \" من ادعى الى غير ابيه لم يرح رايحة الجنة وان ريحها ليوجد من مسيرة خمسماية عام",
      "grades": [
        {

  "items": [
    {
      "id": "69b6c88cdd1a4c9c86f0ca12",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 11,
      "hadithIndex": 2090,
      "bookHadithIndex": 1,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا محمد بن مصعب، عن الاوزاعي، عن يحيى بن ابي كثير، عن هلال بن ابي ميمونة، عن عطاء بن يسار، عن رفاعة الجهني، قال كان النبي صلى الله عليه وسلم اذا حلف قال \" والذي نفس محمد بيده",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2090-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2090-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2090-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0ca13",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 11,
      "hadithIndex": 2091,
      "bookHadithIndex": 2,
      "text": "حدثنا هشام بن عمار، حدثنا عبد الملك بن محمد الصنعاني، حدثنا الاوزاعي، عن يحيى بن ابي كثير، عن هلال بن ابي ميمونة، عن عطاء بن يسار، عن رفاعة بن عرابة الجهني، قال كانت يمين رسول الله صلى الله عليه وسلم التى يحلف بها اشهد عند الله \" والذي نفسي بيده",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2091-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2091-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2091-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0ca14",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 11,
      "hadithIndex": 2092,
      "bookHadithIndex": 3,
      "text": "حدثنا ابو اسحاق الشافعي، ابراهيم بن محمد بن العباس حدثنا عبد الله بن رجاء المكي، عن عباد بن اسحاق، عن ابن شهاب، عن سالم، عن ابيه، قال كانت اكثر ايمان رسول الله صلى الله عليه وسلم \" لا ومصرف القلوب",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2092-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2092-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2092-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2092-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0ca15",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 11,
      "hadithIndex": 2093,
      "bookHadithIndex": 4,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا حماد بن خالد، ح وحدثنا يعقوب بن حميد بن كاسب، حدثنا معن بن عيسى، جميعا عن محمد بن هلال، عن ابيه، عن ابي هريرة، قال كانت يمين رسول الله صلى الله عليه وسلم \" لا واستغفر الله",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2093-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2093-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2093-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2093-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0ca16",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 11,
      "hadithIndex": 2094,
      "bookHadithIndex": 5,
      "text": "حدثنا محمد بن ابي عمر العدني، حدثنا سفيان بن عيينة، عن الزهري، عن سالم بن عبد الله بن عمر، عن ابيه، عن عمر بن الخطاب، ان رسول الله صلى الله عليه وسلم سمعه يحلف بابيه فقال رسول الله صلى الله عليه وسلم \" ان الله ينهاكم ان تحلفوا بابايكم \" . قال عمر فما حلفت بها ذاكرا ولا اثرا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2094-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2094-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2094-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2094-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0ca17",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 11,
      "hadithIndex": 2095,
      "bookHadithIndex": 6,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا عبد الاعلى، عن هشام، عن الحسن، عن عبد الرحمن بن سمرة، قال قال رسول الله صلى الله عليه وسلم \" لا تحلفوا بالطواغي ولا بابايكم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2095-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2095-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2095-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0ca18",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 11,
      "hadithIndex": 2096,
      "bookHadithIndex": 7,
      "text": "حدثنا عبد الرحمن بن ابراهيم الدمشقي، حدثنا عمر بن عبد الواحد، عن الاوزاعي، عن الزهري، عن حميد، عن ابي هريرة، ان رسول الله صلى الله عليه وسلم قال \" من حلف فقال في يمينه باللات والعزى فليقل لا اله الا الله",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2096-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2096-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2096-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2096-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0ca19",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 11,
      "hadithIndex": 2097,
      "bookHadithIndex": 8,
      "text": "حدثنا علي بن محمد، والحسن بن علي الخلال، قالا حدثنا يحيى بن ادم، عن اسراييل، عن ابي اسحاق، عن مصعب بن سعد، عن سعد، قال حلفت باللات والعزى فقال رسول الله صلى الله عليه وسلم \" قل لا اله الا الله وحده لا شريك له ثم انفث عن يسارك ثلاثا وتعوذ ولا تعد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2097-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2097-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2097-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2097-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0ca1a",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 11,
      "hadithIndex": 2098,
      "bookHadithIndex": 9,
      "text": "حدثنا محمد بن المثنى، حدثنا ابن ابي عدي، عن خالد الحذاء، عن ابي قلابة، عن ثابت بن الضحاك، قال قال رسول الله صلى الله عليه وسلم \" من حلف بملة سوى الاسلام كاذبا متعمدا فهو كما قال",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2098-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2098-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2098-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0ca1b",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 11,
      "hadithIndex": 2099,
      "bookHadithIndex": 10,
      "text": "حدثنا هشام بن عمار، حدثنا بقية، عن عبد الله بن محرر، عن قتادة، عن انس، قال سمع النبي صلى الله عليه وسلم رجلا يقول انا اذا ليهودي . فقال رسول الله صلى الله عليه وسلم \" وجبت",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2099-alalbani",
          "name": "Al-Albani",
          "grade": "Very Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2099-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Very Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2099-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2099-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0ca1c",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 11,
      "hadithIndex": 2100,
      "bookHadithIndex": 11,
      "text": "حدثنا عمرو بن رافع البجلي، حدثنا الفضل بن موسى، عن الحسين بن واقد، عن عبد الله بن بريدة، عن ابيه، قال قال رسول الله صلى الله عليه وسلم \" من قال اني بريء من الاسلام فان كان كاذبا فهو كما قال وان كان صادقا لم يعد اليه الاسلام سالما",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2100-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2100-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2100-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0ca1d",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 11,
      "hadithIndex": 2101,
      "bookHadithIndex": 12,
      "text": "حدثنا محمد بن اسماعيل بن سمرة، حدثنا اسباط بن محمد، عن محمد بن عجلان، عن نافع، عن ابن عمر، قال سمع النبي صلى الله عليه وسلم رجلا يحلف بابيه فقال \" لا تحلفوا بابايكم من حلف بالله فليصدق ومن حلف له بالله فليرض ومن لم يرض بالله فليس من الله",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2101-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2101-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2101-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0ca1e",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 11,
      "hadithIndex": 2102,
      "bookHadithIndex": 13,
      "text": "حدثنا يعقوب بن حميد بن كاسب، حدثنا حاتم بن اسماعيل، عن ابي بكر بن يحيى بن النضر، عن ابيه، عن ابي هريرة، ان النبي صلى الله عليه وسلم قال \" راى عيسى ابن مريم رجلا يسرق فقال اسرقت قال لا والذي لا اله الا هو . فقال عيسى امنت بالله وكذبت بصري",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2102-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2102-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2102-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0ca1f",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 11,
      "hadithIndex": 2103,
      "bookHadithIndex": 14,
      "text": "حدثنا علي بن محمد، حدثنا ابو معاوية، عن بشار بن كدام، عن محمد بن زيد، عن ابن عمر، قال قال رسول الله صلى الله عليه وسلم \" انما الحلف حنث او ندم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2103-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2103-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2103-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0ca20",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 11,
      "hadithIndex": 2104,
      "bookHadithIndex": 15,
      "text": "حدثنا العباس بن عبد العظيم العنبري، حدثنا عبد الرزاق، انبانا معمر، عن ابن طاوس، عن ابيه، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" من حلف فقال ان شاء الله فله ثنياه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2104-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2104-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2104-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2104-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0ca21",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 11,
      "hadithIndex": 2105,
      "bookHadithIndex": 16,
      "text": "حدثنا محمد بن زياد، حدثنا عبد الوارث بن سعيد، عن ايوب، عن نافع، عن ابن عمر، قال قال رسول الله صلى الله عليه وسلم \" من حلف واستثنى ان شاء رجع وان شاء ترك غير حانث",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2105-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2105-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2105-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2105-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0ca22",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 11,
      "hadithIndex": 2106,
      "bookHadithIndex": 17,
      "text": "حدثنا عبد الله بن محمد الزهري، حدثنا سفيان بن عيينة، عن ايوب، عن نافع، عن ابن عمر، رواية قال \" من حلف واستثنى فلم يحنث",

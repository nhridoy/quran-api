          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0ca34",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 11,
      "hadithIndex": 2124,
      "bookHadithIndex": 35,
      "text": "حدثنا سهل بن ابي سهل، حدثنا سفيان بن عيينة، حدثنا ايوب، عن ابي قلابة، عن عمه، عن عمران بن الحصين، قال قال رسول الله صلى الله عليه وسلم \" لا نذر في معصية ولا نذر فيما لا يملك ابن ادم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2124-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2124-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2124-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0ca35",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 11,
      "hadithIndex": 2125,
      "bookHadithIndex": 36,
      "text": "حدثنا احمد بن عمرو بن السرح المصري ابو طاهر، حدثنا ابن وهب، انبانا يونس، عن ابن شهاب، عن ابي سلمة، عن عايشة، ان رسول الله صلى الله عليه وسلم قال \" لا نذر في معصية وكفارته كفارة يمين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2125-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2125-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2125-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0ca36",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 11,
      "hadithIndex": 2126,
      "bookHadithIndex": 37,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا ابو اسامة، عن عبيد الله، عن طلحة بن عبد الملك، عن القاسم بن محمد، عن عايشة، قالت قال رسول الله صلى الله عليه وسلم \" من نذر ان يطيع الله فليطعه ومن نذر ان يعصي الله فلا يعصه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2126-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2126-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2126-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-11-2126-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0ca37",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 11,
      "hadithIndex": 2127,
      "bookHadithIndex": 38,
      "text": "حدثنا علي بن محمد، حدثنا وكيع، حدثنا اسماعيل بن رافع، عن خالد بن يزيد، عن عقبة بن عامر الجهني، قال قال رسول الله صلى الله عليه وسلم \" من نذر نذرا ولم يسمه فكفارته كفارة يمين",
      "grades": [

          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3893-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c8eedd1a4c9c86f0d11e",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 35,
      "hadithIndex": 3894,
      "bookHadithIndex": 2,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا عبد الاعلى، عن معمر، عن الزهري، عن سعيد، عن ابي هريرة، عن النبي صلى الله عليه وسلم قال \" رويا المومن جزء من ستة واربعين جزءا من النبوة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3894-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3894-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3894-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3894-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c8eedd1a4c9c86f0d11f",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 35,
      "hadithIndex": 3895,
      "bookHadithIndex": 3,
      "text": "حدثنا ابو بكر بن ابي شيبة، وابو كريب قالا حدثنا عبيد الله بن موسى، انبانا شيبان، عن فراس، عن عطية، عن ابي سعيد الخدري، عن النبي صلى الله عليه وسلم قال \" رويا الرجل المسلم الصالح جزء من سبعين جزءا من النبوة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3895-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3895-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3895-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3895-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c8eedd1a4c9c86f0d120",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 35,
      "hadithIndex": 3896,
      "bookHadithIndex": 4,
      "text": "حدثنا هارون بن عبد الله الحمال، حدثنا سفيان بن عيينة، عن عبيد الله بن ابي يزيد، عن ابيه، عن سباع بن ثابت، عن ام كرز الكعبية، قالت سمعت رسول الله صلى الله عليه وسلم يقول \" ذهبت النبوة وبقيت المبشرات",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3896-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3896-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3896-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3896-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c8eedd1a4c9c86f0d121",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 35,
      "hadithIndex": 3897,
      "bookHadithIndex": 5,
      "text": "حدثنا علي بن محمد، حدثنا ابو اسامة، وعبد الله بن نمير، عن عبيد الله بن عمر، عن نافع، عن ابن عمر، قال قال رسول الله صلى الله عليه وسلم \" الرويا الصالحة جزء من سبعين جزءا من النبوة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3897-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3897-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3897-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3897-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c8eedd1a4c9c86f0d122",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 35,
      "hadithIndex": 3898,
      "bookHadithIndex": 6,
      "text": "حدثنا علي بن محمد، حدثنا وكيع، عن علي بن المبارك، عن يحيى بن ابي كثير، عن ابي سلمة، عن عبادة بن الصامت، قال سالت رسول الله صلى الله عليه وسلم عن قول الله سبحانه {لهم البشرى في الحياة الدنيا وفي الاخرة} . قال \" هي الرويا الصالحة يراها المسلم او ترى له",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3898-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c8eedd1a4c9c86f0d123",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 35,
      "hadithIndex": 3899,
      "bookHadithIndex": 7,
      "text": "حدثنا اسحاق بن اسماعيل الايلي، حدثنا سفيان بن عيينة، عن سليمان بن سحيم، عن ابراهيم بن عبد الله بن معبد بن عباس، عن ابيه، عن ابن عباس، قال كشف رسول الله صلى الله عليه وسلم الستارة في مرضه والناس صفوف خلف ابي بكر فقال \" ايها الناس انه لم يبق من مبشرات النبوة الا الرويا الصالحة يراها المسلم او ترى له",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3899-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3899-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3899-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c8eedd1a4c9c86f0d124",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 35,
      "hadithIndex": 3900,
      "bookHadithIndex": 8,
      "text": "حدثنا علي بن محمد، حدثنا وكيع، عن سفيان، عن ابي اسحاق، عن ابي الاحوص، عن عبد الله، عن النبي صلى الله عليه وسلم قال \" من راني في المنام فقد راني في اليقظة فان الشيطان لا يتمثل على صورتي",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3900-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3900-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3900-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3900-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c8eedd1a4c9c86f0d125",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 35,
      "hadithIndex": 3901,
      "bookHadithIndex": 9,
      "text": "حدثنا ابو مروان العثماني، قال حدثنا عبد العزيز بن ابي حازم، عن العلاء بن عبد الرحمن، عن ابيه، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" من راني في المنام فقد راني فان الشيطان لا يتمثل بي",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3901-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3901-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3901-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3901-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c8eedd1a4c9c86f0d126",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 35,
      "hadithIndex": 3902,
      "bookHadithIndex": 10,
      "text": "حدثنا محمد بن رمح، انبانا الليث بن سعد، عن ابي الزبير، عن جابر، عن رسول الله صلى الله عليه وسلم انه قال \" من راني في المنام فقد راني انه لا ينبغي للشيطان ان يتمثل في صورتي",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3902-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3902-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3902-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3902-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c8eedd1a4c9c86f0d127",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 35,
      "hadithIndex": 3903,
      "bookHadithIndex": 11,
      "text": "حدثنا ابو بكر بن ابي شيبة، وابو كريب قالا حدثنا بكر بن عبد الرحمن، حدثنا عيسى بن المختار، عن ابن ابي ليلى، عن عطية، عن ابي سعيد، عن النبي صلى الله عليه وسلم قال \" من راني في المنام فقد راني فان الشيطان لا يتمثل بي",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3903-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3903-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3903-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c8eedd1a4c9c86f0d128",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 35,
      "hadithIndex": 3904,
      "bookHadithIndex": 12,
      "text": "حدثنا محمد بن يحيى، حدثنا سليمان بن عبد الرحمن الدمشقي، حدثنا سعدان بن يحيى بن صالح اللخمي، حدثنا صدقة بن ابي عمران، عن عون بن ابي جحيفة، عن ابيه، عن رسول الله صلى الله عليه وسلم قال \" من راني في المنام فكانما راني في اليقظة ان الشيطان لا يستطيع ان يتمثل بي",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3904-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3904-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3904-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3904-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c8eedd1a4c9c86f0d129",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 35,
      "hadithIndex": 3905,
      "bookHadithIndex": 13,
      "text": "حدثنا محمد بن يحيى، حدثنا ابو الوليد، قال ابو عوانة حدثنا عن جابر، عن عمار، - هو الدهني - عن سعيد بن جبير، عن ابن عباس، قال قال رسول الله صلى الله عليه وسلم \" من راني في المنام فقد راني فان الشيطان لا يتمثل بي",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3905-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3905-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3905-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3905-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c8eedd1a4c9c86f0d12a",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 35,
      "hadithIndex": 3906,
      "bookHadithIndex": 14,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا هوذة بن خليفة، حدثنا عوف، عن محمد بن سيرين، عن ابي هريرة، عن النبي صلى الله عليه وسلم قال \" الرويا ثلاث فبشرى من الله وحديث النفس وتخويف من الشيطان فاذا راى احدكم رويا تعجبه فليقصها ان شاء وان راى شييا يكرهه فلا يقصه على احد وليقم يصلي",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3906-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3906-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3906-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c8eedd1a4c9c86f0d12b",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 35,
      "hadithIndex": 3907,
      "bookHadithIndex": 15,
      "text": "حدثنا هشام بن عمار، حدثنا يحيى بن حمزة، حدثنا يزيد بن عبيدة، حدثني ابو عبيد الله، مسلم بن مشكم عن عوف بن مالك، عن رسول الله صلى الله عليه وسلم قال \" ان الرويا ثلاث منها اهاويل من الشيطان ليحزن بها ابن ادم ومنها ما يهم به الرجل في يقظته فيراه في منامه ومنها جزء من ستة واربعين جزءا من النبوة \" . قال قلت له انت سمعت هذا من رسول الله صلى الله عليه وسلم قال نعم انا سمعته من رسول الله صلى الله عليه وسلم انا سمعته من رسول الله صلى الله عليه وسلم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3907-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3907-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3907-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3907-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c8eedd1a4c9c86f0d12c",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 35,
      "hadithIndex": 3908,
      "bookHadithIndex": 16,
      "text": "حدثنا محمد بن رمح المصري، انبانا الليث بن سعد، عن ابي الزبير، عن جابر بن عبد الله، عن رسول الله صلى الله عليه وسلم انه قال \" اذا راى احدكم الرويا يكرهها فليبصق عن يساره ثلاثا وليستعذ بالله من الشيطان ثلاثا وليتحول عن جنبه الذي كان عليه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-35-3908-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {

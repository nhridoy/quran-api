        {
          "id": "69b55e8d6f42ba7ccb2a1324-5-1428-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-5-1428-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-5-1428-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c77d",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 5,
      "hadithIndex": 1429,
      "bookHadithIndex": 627,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا وكيع، ح وحدثنا ابو بشر، بكر بن خلف حدثنا يحيى بن سعيد، قالا حدثنا عبد الحميد بن جعفر، عن ابيه، عن تميم بن محمود، عن عبد الرحمن بن شبل، قال نهى رسول الله صلى الله عليه وسلم عن ثلاث عن نقرة الغراب وعن فرشة السبع وان يوطن الرجل المكان الذي يصلي فيه كما يوطن البعير",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-5-1429-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"

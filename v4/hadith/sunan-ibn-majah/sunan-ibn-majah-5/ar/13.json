          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-5-1403-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-5-1403-zubairalizai",

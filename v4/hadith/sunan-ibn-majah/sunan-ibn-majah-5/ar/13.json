  "items": [
    {
      "id": "69b6c859dd1a4c9c86f0c763",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 5,
      "hadithIndex": 1403,
      "bookHadithIndex": 601,
      "text": "حدثنا يحيى بن عثمان بن سعيد بن كثير بن دينار الحمصي، حدثنا بقية بن الوليد، حدثنا ضبارة بن عبد الله بن ابي السليل، اخبرني دويد بن نافع، عن الزهري، قال قال سعيد بن المسيب ان ابا قتادة بن ربعي اخبره ان رسول الله صلى الله عليه وسلم قال \" قال الله عز وجل افترضت على امتك خمس صلوات وعهدت عندي عهدا انه من حافظ عليهن لوقتهن ادخلته الجنة ومن لم يحافظ عليهن فلا عهد له عندي",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-5-1403-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {

  "items": [
    {
      "id": "69b6c8bfdd1a4c9c86f0d0c7",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 33,
      "hadithIndex": 3807,
      "bookHadithIndex": 151,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا عفان، حدثنا حماد بن سلمة، عن ابي سنان، عن عثمان بن ابي سودة، عن ابي هريرة، ان رسول الله صلى الله عليه وسلم مر به وهو يغرس غرسا فقال \" يا ابا هريرة ما الذي تغرس \" . قلت غراسا لي . قال \" الا ادلك على غراس خير لك من هذا \" . قال بلى يا رسول الله . قال \" قل سبحان الله والحمد لله ولا اله الا الله والله اكبر يغرس لك بكل واحدة شجرة في الجنة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3807-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3807-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3807-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0d0c8",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 33,
      "hadithIndex": 3808,
      "bookHadithIndex": 152,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا محمد بن بشر، حدثنا مسعر، حدثني محمد بن عبد الرحمن، عن ابي رشدين، عن ابن عباس، عن جويرية، قالت مر بها رسول الله صلى الله عليه وسلم حين صلى الغداة او بعد ما صلى الغداة وهي تذكر الله فرجع حين ارتفع النهار - او قال انتصف - وهي كذلك فقال \" لقد قلت منذ قمت عنك اربع كلمات ثلاث مرات هي اكثر وارجح - او اوزن - مما قلت سبحان الله عدد خلقه سبحان الله رضا نفسه سبحان الله زنة عرشه سبحان الله مداد كلماته",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3808-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3808-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3808-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3808-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0d0c9",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 33,
      "hadithIndex": 3809,
      "bookHadithIndex": 153,
      "text": "حدثنا ابو بشر، بكر بن خلف حدثني يحيى بن سعيد، عن موسى بن ابي عيسى الطحان، عن عون بن عبد الله، عن ابيه، او عن اخيه، عن النعمان بن بشير، قال قال رسول الله صلى الله عليه وسلم \" ان مما تذكرون من جلال الله التسبيح والتهليل والتحميد ينعطفن حول العرش لهن دوي كدوي النحل تذكر بصاحبها اما يحب احدكم ان يكون له - او لا يزال له - من يذكر به",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3809-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3809-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3809-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3809-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0d0ca",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 33,
      "hadithIndex": 3810,
      "bookHadithIndex": 154,
      "text": "حدثنا ابراهيم بن المنذر الحزامي، حدثنا ابو يحيى، زكريا بن منظور حدثني محمد بن عقبة بن ابي مالك، عن ام هاني، قالت اتيت الى رسول الله صلى الله عليه وسلم فقلت يا رسول الله دلني على عمل فاني قد كبرت وضعفت وبدنت . فقال \" كبري الله ماية مرة واحمدي الله ماية مرة وسبحي الله ماية مرة خير من ماية فرس ملجم مسرج في سبيل الله وخير من ماية بدنة وخير من ماية رقبة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3810-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3810-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3810-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3810-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0d0cb",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 33,
      "hadithIndex": 3811,
      "bookHadithIndex": 155,
      "text": "حدثنا ابو عمر، حفص بن عمرو حدثنا عبد الرحمن بن مهدي، حدثنا سفيان، عن سلمة بن كهيل، عن هلال بن يساف، عن سمرة بن جندب، عن النبي صلى الله عليه وسلم قال \" اربع افضل الكلام لا يضرك بايهن بدات سبحان الله والحمد لله ولا اله الا الله والله اكبر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3811-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3811-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3811-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3811-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0d0cc",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 33,
      "hadithIndex": 3812,
      "bookHadithIndex": 156,
      "text": "حدثنا نصر بن عبد الرحمن الوشاء، حدثنا عبد الرحمن المحاربي، عن مالك بن انس، عن سمى، عن ابي صالح، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" من قال سبحان الله وبحمده ماية مرة غفرت له ذنوبه ولو كانت مثل زبد البحر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3812-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3812-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3812-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3812-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0d0cd",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 33,
      "hadithIndex": 3813,
      "bookHadithIndex": 157,
      "text": "حدثنا علي بن محمد، حدثنا ابو معاوية، عن عمر بن راشد، عن يحيى بن ابي كثير، عن ابي سلمة بن عبد الرحمن، عن ابي الدرداء، قال قال لي رسول الله صلى الله عليه وسلم \" عليك بسبحان الله والحمد لله ولا اله الا الله والله اكبر فانها - يعني - يحططن الخطايا كما تحط الشجرة ورقها",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3813-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3813-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3813-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3813-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0d0ce",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 33,
      "hadithIndex": 3814,
      "bookHadithIndex": 158,
      "text": "حدثنا علي بن محمد، حدثنا ابو اسامة، والمحاربي، عن مالك بن مغول، عن محمد بن سوقة، عن نافع، عن ابن عمر، قال ان كنا لنعد لرسول الله صلى الله عليه وسلم في المجلس يقول \" رب اغفر لي وتب على انك انت التواب الرحيم \" . ماية مرة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3814-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3814-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3814-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3814-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0d0cf",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 33,
      "hadithIndex": 3815,
      "bookHadithIndex": 159,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا محمد بن بشر، عن محمد بن عمرو، عن ابي سلمة، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" اني لاستغفر الله واتوب اليه في اليوم ماية مرة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3815-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"

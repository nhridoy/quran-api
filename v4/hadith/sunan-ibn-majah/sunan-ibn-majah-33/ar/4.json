          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3817-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3817-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0d0d2",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 33,
      "hadithIndex": 3818,
      "bookHadithIndex": 162,
      "text": "حدثنا عمرو بن عثمان بن سعيد بن كثير بن دينار الحمصي، حدثنا ابي، حدثنا محمد بن عبد الرحمن بن عرق، سمعت عبد الله بن بسر، يقول قال النبي صلى الله عليه وسلم \" طوبى لمن وجد في صحيفته استغفارا كثيرا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3818-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3818-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3818-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-33-3818-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0d0d3",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 33,
      "hadithIndex": 3819,
      "bookHadithIndex": 163,
      "text": "حدثنا هشام بن عمار، حدثنا الوليد بن مسلم، حدثنا الحكم بن مصعب، عن محمد بن علي بن عبد الله بن عباس، انه حدثه عن عبد الله بن عباس، قال قال رسول الله صلى الله عليه وسلم \" من لزم الاستغفار جعل الله له من كل هم فرجا ومن كل ضيق مخرجا ورزقه من حيث لا يحتسب",
      "grades": [

{"total":107,"totalPage":3,"page":2,"pageSize":50,"items":[{"id":"69b6c8bfdd1a4c9c86f0cff8","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3600,"bookHadithIndex":51,"text":"بریدہ رضی اللہ عنہ کہتے ہیں کہ میں نے رسول اللہ صلی اللہ علیہ وسلم کو خطبہ دیتے دیکھا، اتنے میں حسن اور حسین رضی اللہ عنہما دونوں لال قمیص پہنے ہوئے آ گئے کبھی گرتے تھے کبھی اٹھتے تھے، نبی اکرم صلی اللہ علیہ وسلم ( منبر سے ) اترے، دونوں کو اپنی گود میں اٹھا لیا، اور فرمایا: اللہ اور اس کے رسول کا قول سچ ہے: «إنما أموالكم وأولادكم فتنة» بلاشبہ تمہارے مال اور تمہاری اولاد آزمائش ہیں ، میں نے ان دونوں کو دیکھا تو صبر نہ کر سکا، پھر آپ صلی اللہ علیہ وسلم نے خطبہ شروع کر دیا ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3600-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3600-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3600-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3600-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cff9","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3601,"bookHadithIndex":52,"text":"عبداللہ بن عمر رضی اللہ عنہما کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے «مفدم» سے منع کیا ہے، یزید کہتے ہیں کہ میں نے حسن سے پوچھا: «مفدم» کیا ہے؟ انہوں نے کہا: جو کپڑا «کسم» میں رنگنے سے خوب پیلا ہو جائے ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3601-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3601-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3601-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3601-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cffa","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3602,"bookHadithIndex":53,"text":"علی رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے مجھے پیلے رنگ کے کپڑے پہننے سے روکا، میں یہ نہیں کہتا کہ تمہیں منع کیا۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3602-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3602-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3602-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cffb","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3603,"bookHadithIndex":54,"text":"عبداللہ بن عمرو بن العاص رضی اللہ عنہما کہتے ہیں کہ ہم اذاخر ۱؎ کے موڑ سے رسول اللہ صلی اللہ علیہ وسلم کے ساتھ آئے، آپ میری طرف متوجہ ہوئے، میں باریک چادر پہنے ہوئے تھا جو کسم کے رنگ میں رنگی ہوئی تھی، تو آپ صلی اللہ علیہ وسلم نے پوچھا: یہ کیا ہے ؟ میں آپ کی اس ناگواری کو بھانپ گیا، چنانچہ میں اپنے گھر والوں کے پاس آیا، وہ اس وقت اپنا تنور گرم کر رہے تھے، میں نے اسے اس میں ڈال دیا، دوسری صبح میں آپ کے پاس آیا تو آپ صلی اللہ علیہ وسلم نے فرمایا: عبداللہ! چادر کیا ہوئی ؟ میں نے آپ کو ساری بات بتائی تو آپ صلی اللہ علیہ وسلم نے فرمایا: تم نے اپنی کسی گھر والی کو کیوں نہیں پہنا دی؟ اس لیے کہ اسے پہننے میں عورتوں کے لیے کوئی مضائقہ نہیں ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3603-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3603-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3603-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3603-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cffc","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3604,"bookHadithIndex":55,"text":"قیس بن سعد رضی اللہ عنہ کہتے ہیں کہ ہمارے پاس نبی اکرم صلی اللہ علیہ وسلم تشریف لائے، تو ہم نے آپ کے لیے پانی رکھا تاکہ آپ اس سے ٹھنڈے ہوں، آپ نے اس سے غسل فرمایا، پھر میں آپ کے پاس ایک پیلی چادر لے کر آیا، ( اس کو آپ نے پہنا ) تو میں نے آپ کے پیٹ کی سلوٹوں پر ورس کا نشان دیکھا ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3604-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3604-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3604-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3604-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cffd","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3605,"bookHadithIndex":56,"text":"عبداللہ بن عمرو بن العاص رضی اللہ عنہما کہتے ہیں کہ رسول اللہ صلی اللہعلیہ وسلم نے فرمایا: کھاؤ پیو، صدقہ و خیرات کرو، اور پہنو ہر وہ لباس جس میں اسراف و تکبر ( فضول خرچی اور گھمنڈ ) کی ملاوٹ نہ ہو ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3605-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3605-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3605-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3605-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cffe","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3606,"bookHadithIndex":57,"text":"عبداللہ بن عمر رضی اللہ عنہما کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جس شخص نے شہرت کا لباس پہنا اللہ تعالیٰ اسے قیامت کے دن ذلت کا لباس پہنائے گا ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3606-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3606-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3606-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3606-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cfff","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3607,"bookHadithIndex":58,"text":"عبداللہ بن عمر رضی اللہ عنہما کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جس شخص نے دنیا میں شہرت کا لباس پہنا اللہ تعالیٰ قیامت کے دن اسے ذلت کا لباس پہنائے گا، پھر اس میں آگ بھڑکائے گا۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3607-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3607-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3607-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3607-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0d000","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3608,"bookHadithIndex":59,"text":"ابوذر رضی اللہ عنہ کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: جس شخص نے شہرت کی خاطر لباس پہنا، اللہ تعالیٰ اس سے منہ پھیر لے گا یہاں تک کہ اسے اس جگہ رکھے گا جہاں اسے رکھنا ہے ( یعنی جہنم میں ) ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3608-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3608-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3608-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3608-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0d001","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3609,"bookHadithIndex":60,"text":"عبداللہ بن عباس رضی اللہ عنہما کہتے ہیں کہ میں نے رسول اللہ صلی اللہ علیہ وسلم کو فرماتے سنا: ہر وہ کھال جسے دباغت دے دی گئی ہو پاک ہے ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3609-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3609-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3609-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3609-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0d002","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3610,"bookHadithIndex":61,"text":"ام المؤمنین میمونہ رضی اللہ عنہا سے روایت ہے کہ ان کی ایک لونڈی کو صدقہ کی ایک بکری ملی تھی جو مری پڑی تھی، نبی اکرم صلی اللہ علیہ وسلم کا گزر اس بکری کے پاس ہوا تو آپ صلی اللہ علیہ وسلم نے فرمایا: ان لوگوں نے اس کی کھال کیوں نہیں اتار لی کہ اسے دباغت دے کر کام میں لے آتے ؟ لوگوں نے عرض کیا: اللہ کے رسول! یہ تو مردار ہے، آپ صلی اللہ علیہ وسلم نے فرمایا: صرف اس کا کھانا حرام ہے ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3610-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3610-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3610-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3610-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0d003","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3611,"bookHadithIndex":62,"text":"سلمان رضی اللہ عنہ کہتے ہیں کہ امہات المؤمنین میں سے کسی ایک کے پاس ایک بکری تھی جو مر گئی، رسول اللہ صلی اللہ علیہ وسلم کا اس پر گزر ہوا، تو آپ صلی اللہ علیہ وسلم نے فرمایا: اگر لوگ اس کی کھال کو کام میں لے آتے تو اس کے مالکوں کو کوئی نقصان نہ ہوتا ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3611-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3611-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3611-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3611-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0d004","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3612,"bookHadithIndex":63,"text":"ام المؤمنین عائشہ رضی اللہ عنہا کہتی ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے حکم فرمایا: جب مردہ جانوروں کی کھال کو دباغت دے دی جائے، تو لوگ ا سے فائدہ اٹھائیں ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3612-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3612-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3612-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0d005","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3613,"bookHadithIndex":64,"text":"عبداللہ بن عکیم کہتے ہیں کہ ہمارے پاس نبی اکرم صلی اللہ علیہ وسلم کا مکتوب آیا کہ مردار کی کھال اور پٹھوں سے فائدہ نہ اٹھاؤ ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3613-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3613-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3613-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0d006","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3614,"bookHadithIndex":65,"text":"عبداللہ بن عباس رضی اللہ عنہما کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم کی جوتیوں کے دو تسمے تھے، جو آگے سے دہرے ہوتے ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3614-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3614-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3614-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3614-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0d007","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3615,"bookHadithIndex":66,"text":"انس رضی اللہ عنہ کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم کی جوتیوں کے دو تسمے تھے۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3615-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3615-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3615-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3615-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari"}]},{"id":"69b6c8bfdd1a4c9c86f0d008","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3616,"bookHadithIndex":67,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جب تم میں سے کوئی جوتا پہنے تو دائیں پیر سے شروع کرے، اور اتارے تو پہلے بائیں پیر سے اتارے ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3616-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3616-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3616-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3616-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0d009","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3617,"bookHadithIndex":68,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: کوئی بھی شخص ایک جوتا یا ایک موزہ پہن کر نہ چلے، یا تو دونوں جوتے اور موزے اتار دے یا پھر دونوں جوتے اور موزے پہن لے ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3617-alalbani","name":"Al-Albani","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3617-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3617-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3617-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Bukhari And Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0d00a","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3618,"bookHadithIndex":69,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی
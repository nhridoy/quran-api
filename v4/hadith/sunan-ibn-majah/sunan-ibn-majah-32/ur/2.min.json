ہ رضی اللہ عنہ سے روایت ہے کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: یہود و نصاریٰ خضاب نہیں لگاتے، تو تم ان کی مخالفت کرو ( یعنی خضاب لگاؤ ) ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3621-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3621-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3621-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3621-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0d00e","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3622,"bookHadithIndex":73,"text":"ابوذر رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: بالوں کی سفیدی بدلنے کے لیے سب سے بہترین چیز مہندی اور کتم ہے ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3622-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3622-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3622-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3622-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0d00f","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3623,"bookHadithIndex":74,"text":"عثمان بن موہب کہتے ہیں کہ میں ام المؤمنین ام سلمہ رضی اللہ عنہا کی خدمت میں حاضر ہوا تو انہوں نے رسول اللہ صلی اللہ علیہ وسلم کا ایک بال نکال کر مجھے دکھایا، جو مہندی اور کتم سے رنگا ہوا تھا۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3623-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3623-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3623-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3623-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari"}]},{"id":"69b6c8bfdd1a4c9c86f0d010","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3624,"bookHadithIndex":75,"text":"جابر رضی اللہ عنہ کہتے ہیں کہ فتح مکہ کے دن ابوقحافہ رضی اللہ عنہ کو نبی اکرم صلی اللہ علیہ وسلم کے پاس لایا گیا، اس وقت ان کے بال سفید گھاس کی طرح تھے، چنانچہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: انہیں ان کی کسی عورت کے پاس لے جاؤ کہ وہ انہیں بدل دے ( یعنی خضاب لگا دے ) ، لیکن کالے خضاب سے انہیں بچاؤ ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3624-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3624-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3624-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0d011","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3625,"bookHadithIndex":76,"text":"صہیب الخیر رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جو خضاب تم لگاتے ہو ان میں بہترین کالا خضاب ہے، اس سے عورتیں تمہاری طرف زیادہ راغب ہوتی ہیں، اور تمہارے دشمنوں کے دلوں میں تمہاری ہیبت زیادہ بیٹھتی ہے ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3625-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3625-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3625-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3625-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0d012","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3626,"bookHadithIndex":77,"text":"عبید بن جریج سے روایت ہے کہ انہوں نے ابن عمر رضی اللہ عنہما سے پوچھا: میں آپ کو اپنی داڑھی ورس سے زرد ( پیلی ) کرتے دیکھتا ہوں؟، ابن عمر رضی اللہ عنہما نے کہا: میں اس لیے زرد ( پیلی ) کرتا ہوں کہ میں نے رسول اللہ صلی اللہ علیہ وسلم کو اپنی داڑھی زرد ( پیلی ) کرتے دیکھا۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3626-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3626-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3626-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3626-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0d013","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3627,"bookHadithIndex":78,"text":"عبداللہ بن عباس رضی اللہ عنہما کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم کا گزر ایک ایسے شخص کے پاس ہوا جس نے مہندی کا خضاب لگا رکھا تھا، تو آپ صلی اللہ علیہ وسلم نے فرمایا: یہ کتنا اچھا ہے ، پھر آپ ایک دوسرے شخص کے پاس سے گزرے جس نے مہندی اور کتم ( وسمہ ) کا خضاب لگایا تھا، آپ صلی اللہ علیہ وسلم نے فرمایا: یہ اس سے اچھا ہے ! پھر آپ کا گزر ایک دوسرے کے پاس ہوا جس نے زرد خضاب لگا رکھا تھا تو آپ صلی اللہ علیہ وسلم نے فرمایا: یہ ان سب سے اچھا اور بہتر ہے ۔ ابن طاؤس کہتے ہیں کہ اسی لیے طاؤس بالوں کو زرد خضاب کیا کرتے تھے","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3627-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3627-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3627-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3627-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0d014","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3628,"bookHadithIndex":79,"text":"ابوحجیفہ رضی اللہ عنہ کہتے ہیں کہ میں نے رسول اللہ صلی اللہ علیہ وسلم کے یہ بال یعنی داڑھی بچہ سفید دیکھی۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3628-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3628-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3628-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3628-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0d015","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3629,"bookHadithIndex":80,"text":"حمید کہتے ہیں کہ انس بن مالک رضی اللہ عنہ سے سوال کیا گیا: کیا رسول اللہ صلی اللہ علیہ وسلم نے خضاب لگایا ہے؟ کہا: میں نے آپ کی داڑھی میں سفید بال دیکھے ہی نہیں سوائے ان سترہ یا بیس بالوں کے جو آپ کی داڑھی کے سامنے والے حصے میں تھے۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3629-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3629-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3629-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3629-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0d016","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3630,"bookHadithIndex":81,"text":"عبداللہ بن عمر رضی اللہ عنہما کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم کا بڑھاپا تقریباً ً بیس بال کا تھا ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3630-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3630-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3630-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0d017","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3631,"bookHadithIndex":82,"text":"ام ہانی رضی اللہ عنہا کہتی ہیں کہ رسول اللہ صلی اللہ علیہ وسلم جب مکہ میں ( فتح کے روز ) داخل ہوئے، تو آپ کے سر میں چار چوٹیاں تھیں ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3631-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3631-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3631-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"
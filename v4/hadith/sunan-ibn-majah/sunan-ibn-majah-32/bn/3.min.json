{"total":107,"totalPage":3,"page":3,"pageSize":50,"items":[{"id":"69b6c8bfdd1a4c9c86f0d02a","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3650,"bookHadithIndex":101,"text":"। ‘আলী ইবনে আবূ তালিব (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যে ঘরে কুকুর ও ছবি থাকে সেই ঘরে ফেরেশতাগণ প্রবেশ করেন না।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3650-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3650-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3650-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3650-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0d02b","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3651,"bookHadithIndex":102,"text":"। আয়েশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর সাথে জিবরাঈল (আ)-এর একটি নির্দিষ্ট সময়ে সাক্ষাতের প্রতিশ্রুতি ছিল কিন্তু তাতে বিলম্ব হলে নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বাইরে বের হলেন এবং দেখলেন, জিবরাঈল (আ) দরজায় দাঁড়ানো। তিনি বলেনঃ ভিতরে প্রবেশ করতে কিসে আপনাকে বাধা দিলো? তিনি বলেনঃ এ ঘরে একটি কুকুর আছে। যে ঘরে কুকুর ও ছবি থাকে সে ঘরে আমরা প্রবেশ করি না।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3651-alalbani","name":"Al-Albani","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3651-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3651-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3651-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0d02c","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3652,"bookHadithIndex":103,"text":"। আবূ উমামা (রাঃ) থেকে বর্ণিত। এক মহিলা নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম -এর নিকট এসে তাঁকে অবহিত করে যে, তার স্বামী একটি জিহাদে গেছে। সে তাঁর নিকট তার ঘরে একটি খেজুর গাছের ছবি আঁকার অনুমতি চাইলে তিনি তাকে তা করতে নিষেধ করেন।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3652-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3652-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3652-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3652-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0d02d","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3653,"bookHadithIndex":104,"text":"। আয়েশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি আমার ঘরের দরজায় ছবিযুক্ত একটি পর্দা টানালাম। অতঃপর নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এসে তা ছিঁড়ে ফেলেন। পরে আমি তা দিয়ে দু’টি তাকিয়ার গেলাফ বানালাম। আমি নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কে তার একটিতে হেলান দিয়ে বসতে দেখেছি।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3653-alalbani","name":"Al-Albani","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3653-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3653-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3653-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Isnaad Hasan Bukhari And Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0d02e","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3654,"bookHadithIndex":105,"text":"। আলী (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম সোনার আংটি এবং লাল রঙের জিনপোষ ব্যবহার করতে নিষেধ করেছেন।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3654-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3654-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3654-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3654-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0d02f","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3655,"bookHadithIndex":106,"text":"। আমের আল-হাজরী (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম -এর সাহাবী আবূ রায়হানা (রাঃ) কে বলতে শুনেছি, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম চিতা বাঘের চামড়ার উপর সওয়ার হতে নিষেধ করতেন।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3655-alalbani","name":"Al-Albani","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3655-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3655-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3655-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0d030","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3656,"bookHadithIndex":107,"text":"। মু‘আবিয়া (রাঃ) থেকে বর্ণিত। তিনি বলেন, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম চিতা বাঘের চামড়ার উপর সওয়ার হতে নিষেধ করতেন।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3656-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3656-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3656-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3656-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]}]}
{"total":107,"totalPage":3,"page":3,"pageSize":50,"items":[{"id":"69b6c8bfdd1a4c9c86f0d02a","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3650,"bookHadithIndex":101,"text":"حدثنا ابو بكر، حدثنا غندر، عن شعبة، عن علي بن مدرك، عن ابي زرعة، عن عبد الله بن نجى، عن ابيه، عن علي بن ابي طالب، عن النبي صلى الله عليه وسلم قال \" ان الملايكة لا تدخل بيتا فيه كلب ولا صورة","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3650-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3650-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3650-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3650-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0d02b","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3651,"bookHadithIndex":102,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا علي بن مسهر، عن محمد بن عمرو، عن ابي سلمة، عن عايشة، قالت واعد رسول الله صلى الله عليه وسلم جبريل عليه السلام في ساعة ياتيه فيها فراث عليه فخرج النبي صلى الله عليه وسلم فاذا هو بجبريل قايم على الباب فقال \" ما منعك ان تدخل \" . قال ان في البيت كلبا وانا لا ندخل بيتا فيه كلب ولا صورة","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3651-alalbani","name":"Al-Albani","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3651-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3651-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3651-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0d02c","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3652,"bookHadithIndex":103,"text":"حدثنا العباس بن عثمان الدمشقي، حدثنا الوليد، حدثنا عفير بن معدان، حدثنا سليم بن عامر، عن ابي امامة، ان امراة، اتت النبي صلى الله عليه وسلم فاخبرته ان زوجها في بعض المغازي فاستاذنته ان تصور في بيتها نخلة فمنعها او نهاها","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3652-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3652-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3652-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3652-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0d02d","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3653,"bookHadithIndex":104,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا وكيع، عن اسامة بن زيد، عن عبد الرحمن بن القاسم، عن ابيه، عن عايشة، قالت سترت سهوة لي - تعني الداخل - بستر فيه تصاوير فلما قدم النبي صلى الله عليه وسلم هتكه فجعلت منه منبوذتين فرايت النبي صلى الله عليه وسلم متكيا على احداهما","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3653-alalbani","name":"Al-Albani","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3653-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3653-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3653-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Isnaad Hasan Bukhari And Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0d02e","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3654,"bookHadithIndex":105,"text":"حدثنا ابو بكر، حدثنا ابو الاحوص، عن ابي اسحاق، عن هبيرة، عن علي، قال نهى رسول الله صلى الله عليه وسلم عن خاتم الذهب وعن الميثرة يعني الحمراء","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3654-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3654-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3654-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3654-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0d02f","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3655,"bookHadithIndex":106,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا زيد بن الحباب، حدثنا يحيى بن ايوب، حدثني عياش بن عباس الحميري، عن ابي حصين الحجري الهيثم، عن عامر الحجري، قال سمعت ابا ريحانة، صاحب النبي صلى الله عليه وسلم يقول كان النبي صلى الله عليه وسلم ينهى عن ركوب النمور","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3655-alalbani","name":"Al-Albani","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3655-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3655-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3655-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0d030","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3656,"bookHadithIndex":107,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا وكيع، عن ابي المعتمر، عن ابن سيرين، عن معاوية، قال كان رسول الله صلى الله عليه وسلم ينهى عن ركوب النمور","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3656-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3656-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3656-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3656-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]}]}
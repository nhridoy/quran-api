{"total":107,"totalPage":3,"page":2,"pageSize":50,"items":[{"id":"69b6c8bfdd1a4c9c86f0cff8","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3600,"bookHadithIndex":51,"text":"حدثنا ابو عامر عبد الله بن عامر بن براد بن يوسف بن ابي بردة بن ابي موسى الاشعري، حدثنا زيد بن الحباب، حدثنا حسين بن واقد، قاضي مرو حدثني عبد الله بن بريدة، ان اباه، حدثه قال رايت رسول الله صلى الله عليه وسلم يخطب فاقبل حسن وحسين عليهما قميصان احمران يعثران ويقومان فنزل النبي صلى الله عليه وسلم فاخذهما فوضعهما في حجره فقال \" صدق الله ورسوله {انما اموالكم واولادكم فتنة} رايت هذين فلم اصبر \" . ثم اخذ في خطبته","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3600-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3600-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3600-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3600-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cff9","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3601,"bookHadithIndex":52,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا علي بن مسهر، عن يزيد بن ابي زياد، عن الحسن بن سهيل، عن ابن عمر، قال نهى رسول الله صلى الله عليه وسلم عن المفدم . قال يزيد قلت للحسن ما المفدم قال المشبع بالعصفر","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3601-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3601-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3601-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3601-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cffa","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3602,"bookHadithIndex":53,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا وكيع، عن اسامة بن زيد، عن عبد الله بن حنين، قال سمعت عليا، يقول نهاني رسول الله صلى الله عليه وسلم - ولا اقول نهاكم - عن لبس المعصفر","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3602-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3602-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3602-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cffb","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3603,"bookHadithIndex":54,"text":"حدثنا ابو بكر، حدثنا عيسى بن يونس، عن هشام بن الغاز، عن عمرو بن شعيب، عن ابيه، عن جده، قال اقبلنا مع رسول الله صلى الله عليه وسلم من ثنية اذاخر فالتفت الى وعلى ريطة مضرجة بالعصفر فقال \" ما هذه \" . فعرفت ما كره فاتيت اهلي وهم يسجرون تنورهم فقذفتها فيه ثم اتيته من الغد فقال \" يا عبد الله ما فعلت الريطة \" . فاخبرته فقال \" الا كسوتها بعض اهلك فانه لا باس بذلك للنساء","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3603-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3603-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3603-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3603-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cffc","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3604,"bookHadithIndex":55,"text":"حدثنا علي بن محمد، حدثنا وكيع، عن ابن ابي ليلى، عن محمد بن عبد الرحمن، عن محمد بن شرحبيل، عن قيس بن سعد، قال اتانا النبي صلى الله عليه وسلم فوضعنا له ماء يتبرد به فاغتسل ثم اتيته بملحفة صفراء فرايت اثر الورس على عكنه","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3604-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3604-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3604-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3604-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cffd","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3605,"bookHadithIndex":56,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا يزيد بن هارون، انبانا همام، عن قتادة، عن عمرو بن شعيب، عن ابيه، عن جده، قال قال رسول الله صلى الله عليه وسلم \" كلوا واشربوا وتصدقوا والبسوا ما لم يخالطه اسراف او مخيلة","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3605-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3605-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3605-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3605-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cffe","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3606,"bookHadithIndex":57,"text":"حدثنا محمد بن عبادة، ومحمد بن عبد الملك الواسطيان، قالا حدثنا يزيد بن هارون، انبانا شريك، عن عثمان بن ابي زرعة، عن مهاجر، عن ابن عمر، قال قال رسول الله صلى الله عليه وسلم \" من لبس ثوب شهرة البسه الله يوم القيامة ثوب مذلة","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3606-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3606-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3606-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3606-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cfff","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3607,"bookHadithIndex":58,"text":"حدثنا محمد بن عبد الملك بن ابي الشوارب، حدثنا ابو عوانة، عن عثمان بن المغيرة، عن المهاجر، عن عبد الله بن عمر، قال قال رسول الله صلى الله عليه وسلم \" من لبس ثوب شهرة في الدنيا البسه الله ثوب مذلة يوم القيامة ثم الهب فيه نارا","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3607-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3607-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3607-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3607-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0d000","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3608,"bookHadithIndex":59,"text":"حدثنا العباس بن يزيد البحراني، حدثنا وكيع بن محرز الناجي، حدثنا عثمان بن جهم، عن زر بن حبيش، عن ابي ذر، عن النبي صلى الله عليه وسلم قال \" من لبس ثوب شهرة اعرض الله عنه حتى يضعه متى وضعه","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3608-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3608-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3608-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3608-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0d001","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3609,"bookHadithIndex":60,"text":"حدثنا ابو بكر، حدثنا سفيان بن عيينة، عن زيد بن اسلم، عن عبد الرحمن بن وعلة، عن ابن عباس، قال سمعت رسول الله صلى الله عليه وسلم يقول \" ايما اهاب دبغ فقد طهر","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3609-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3609-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3609-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3609-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0d002","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3610,"bookHadithIndex":61,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا سفيان بن عيينة، عن الزهري، عن عبيد الله بن عبد الله، عن ابن عباس، عن ميمونة، ان شاة، لمولاة ميمونة مر بها - يعني النبي صلى الله عليه وسلم - قد اعطيتها من الصدقة ميتة فقال \" هلا اخذوا اهابها فدبغوه فانتفعوا به \" . فقالوا يا رسول الله انها ميتة . قال \" انما حرم اكلها","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3610-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3610-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3610-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3610-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0d003","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3611,"bookHadithIndex":62,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا عبد الرحيم بن سليمان، عن ليث، عن شهر بن حوشب، عن سلمان، قال كان لبعض امهات المومنين شاة فماتت فمر رسول الله صلى الله عليه وسلم عليها فقال \" ما ضر اهل هذه لو انتفعوا باهابها","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3611-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3611-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3611-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3611-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0d004","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3612,"bookHadithIndex":63,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا خالد بن مخلد، عن مالك بن انس، عن يزيد بن قسيط، عن محمد بن عبد الرحمن، عن امه، عن عايشة، قالت امر رسول الله صلى الله عليه وسلم ان يستمتع بجلود الميتة اذا دبغت","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3612-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3612-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3612-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0d005","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3613,"bookHadithIndex":64,"text":"حدثنا ابو بكر، حدثنا جرير، عن منصور، ح وحدثنا ابو بكر بن ابي شيبة، حدثنا علي بن مسهر، عن الشيباني، ح وحدثنا ابو بكر، حدثنا غندر، عن شعبة، كلهم عن الحكم، عن عبد الرحمن بن ابي ليلى، عن عبد الله بن عكيم، قال اتانا كتاب النبي صلى الله عليه وسلم \" ان لا تنتفعوا من الميتة باهاب ولا عصب","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3613-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3613-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3613-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0d006","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3614,"bookHadithIndex":65,"text":"حدثنا علي بن محمد، حدثنا وكيع، عن سفيان، عن خالد الحذاء، عن عبد الله بن الحارث، عن عبد الله بن العباس، قال كان لنعل النبي صلى الله عليه وسلم قبالان مثني شراكهما","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3614-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3614-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3614-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3614-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0d007","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3615,"bookHadithIndex":66,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا يزيد بن هارون، عن همام، عن قتادة، عن انس، قال كان لنعل النبي صلى الله عليه وسلم قبالان","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3615-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3615-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3615-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3615-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari"}]},{"id":"69b6c8bfdd1a4c9c86f0d008","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3616,"bookHadithIndex":67,"text":"حدثنا ابو بكر، حدثنا وكيع، عن شعبة، عن محمد بن زياد، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" اذا انتعل احدكم فليبدا باليمنى واذا خلع فليبدا باليسرى","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3616-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3616-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3616-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3616-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0d009","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3617,"bookHadithIndex":68,"text":"حدثنا ابو بكر، حدثنا عبد الله بن ادريس، عن ابن عجلان، عن سعيد بن ابي سعيد، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" لا يمشي احدكم في نعل واحد ولا خف واحد ليخلعهما جميعا او ليمش فيهما جميعا","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3617-alalbani","name":"Al-Albani","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3617-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3617-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3617-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Bukhari And Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0d00a","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3618,"bookHadithIndex":69,"text":"حدثنا علي بن محمد، حدثنا ابو معاوية، عن الاعمش، عن ابي صالح، عن ابي هريرة، قال نهى رسول الله صلى الله عليه وسلم ان ينتعل الرجل قايما","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3618-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3618-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3618-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3618-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0d00b","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3619,"bookHadithIndex":70,"text":"حدثنا علي بن محمد، حدثنا وكيع، عن سفيان، عن عبد الله بن دينار، عن ابن عمر، قال نهى النبي صلى الله عليه وسلم ان ينتعل الرجل قايما","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3619-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3619-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3619-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3619-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0d00c","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3620,"bookHadithIndex":71,"text":"حدثنا ابو بكر، حدثنا وكيع، حدثنا دلهم بن صالح الكندي، عن حجير بن عبد الله الكندي، عن ابن بريدة، عن ابيه، ان النجاشي، اهدى لرسول الله صلى الله عليه وسلم خفين ساذجين اسودين فلبسهما","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3620-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3620-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3620-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3620-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0d00d","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3621,"bookHadithIndex":72,"text":"حدثنا ابو بكر، حدثنا سفيان بن عيينة، عن الزهري، سمع ابا سلمة، وسليمان بن يسار، يخبران عن ابي هريرة، يبلغ به النبي صلى الله عليه وسلم قال \" ان اليهود والنصارى لا يصبغون فخالفوهم","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3621-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3621-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3621-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3621-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0d00e","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3622,"bookHadithIndex":73,"text":"حدثنا ابو بكر، حدثنا عبد الله بن ادريس، عن الاجلح، عن عبد الله بن بريدة، عن ابي الاسود الديلي، عن ابي ذر، قال قال رسول الله صلى الله عليه وسلم \" ان احسن ما غيرتم به الشيب الحناء والكتم","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3622-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3622-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3622-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3622-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0d00f","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3623,"bookHadithIndex":74,"text":"حدثنا ابو بكر، حدثنا يونس بن محمد، حدثنا سلام بن ابي مطيع، عن عثمان بن موهب، قال دخلت على ام سلمة . قال فاخرجت الى شعرا من شعر رسول الله صلى الله عليه وسلم مخضوبا بالحناء والكتم","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3623-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3623-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3623-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3623-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari"}]},{"id":"69b6c8bfdd1a4c9c86f0d010","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3624,"bookHadithIndex":75,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا اسماعيل ابن علية، عن ليث، عن ابي الزبير، عن جابر، قال جيء بابي قحافة يوم الفتح الى النبي صلى الله عليه وسلم وكان راسه ثغامة فقال رسول الله صلى الله عليه وسلم \" اذهبوا به الى بعض نسايه فلتغيره وجنبوه السواد","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3624-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3624-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3624-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0d011","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3625,"bookHadithIndex":76,"text":"حدثنا ابو هريرة الصيرفي، محمد بن فراس حدثنا عمر بن الخطاب بن زكريا الراسبي، حدثنا دفاع بن دغفل السدوسي، عن عبد الحميد بن صيفي، عن ابيه، عن جده، صهيب الخير قال قال رسول الله صلى الله عليه وسلم \" ان احسن ما اختضبتم به لهذا السواد ارغب لنسايكم فيكم واهيب لكم في صدور عدوكم","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3625-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3625-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3625-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3625-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0d012","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3626,"bookHadithIndex":77,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا ابو اسامة، عن عبيد الله بن عمر، عن سعيد بن ابي سعيد، ان عبيد بن جريج، سال ابن عمر قال رايتك تصفر لحيتك بالورس فقال ابن عمر اما تصفيري لحيتي فاني رايت رسول الله صلى الله عليه وسلم يصفر لحيته","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3626-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3626-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3626-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3626-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0d013","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3627,"bookHadithIndex":78,"text":"حدثنا ابو بكر، حدثنا اسحاق بن منصور، حدثنا محمد بن طلحة، عن حميد بن وهب، عن ابن طاوس، عن طاوس، عن ابن عباس، قال مر النبي صلى الله عليه وسلم على رجل قد خضب بالحناء فقال \" ما احسن هذا \" . ثم مر باخر قد خضب بالحناء والكتم فقال \" هذا احسن من هذا \" . ثم مر باخر قد خضب بالصفرة فقال \" هذا احسن من هذا كله \" . قال وكان طاوس يصفر","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3627-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3627-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3627-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3627-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0d014","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3628,"bookHadithIndex":79,"text":"حدثنا محمد بن المثنى، حدثنا ابو داود، حدثنا زهير، عن ابي اسحاق، عن ابي جحيفة، قال رايت رسول الله صلى الله عليه وسلم هذه منه بيضاء . يعني عنفقته","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3628-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3628-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3628-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3628-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0d015","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3629,"bookHadithIndex":80,"text":"حدثنا محمد بن المثنى، حدثنا خالد بن الحارث، وابن ابي عدي، عن حميد، قال سيل انس بن مالك اخضب رسول الله صلى الله عليه وسلم قال انه لم ير من الشيب الا نحو سبعة عشر او عشرين شعرة في مقدم لحيته","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3629-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3629-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3629-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3629-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0d016","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3630,"bookHadithIndex":81,"text":"حدثنا محمد بن عمر بن الوليد الكندي، حدثنا يحيى بن ادم، عن شريك، عن عبيد الله، عن نافع، عن ابن عمر، قال كان شيب رسول الله صلى الله عليه وسلم نحو عشرين شعرة","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3630-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3630-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3630-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0d017","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3631,"bookHadithIndex":82,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا سفيان بن عيينة، عن ابن ابي نجيح، عن مجاهد، قال قالت ام هاني دخل رسول الله صلى الله عليه وسلم مكة وله اربع غداير . تعني ضفاير","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3631-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3631-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3631-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3631-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0d018","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3632,"bookHadithIndex":83,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا يحيى بن ادم، عن ابراهيم بن سعد، عن الزهري، عن عبيد الله بن عبد الله، عن ابن عباس، قال كان اهل الكتاب يسدلون اشعارهم وكان المشركون يفرقون وكان رسول الله صلى الله عليه وسلم يحب موافقة اهل الكتاب . قال فسدل رسول الله صلى الله عليه وسلم ناصيته ثم فرق بعد","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3632-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3632-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3632-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3632-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0d019","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3633,"bookHadithIndex":84,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا اسحاق بن منصور، عن ابراهيم بن سعد، عن ابن اسحاق، عن يحيى بن عباد، عن ابيه، عن عايشة، قالت كنت افرق خلف يافوخ رسول الله صلى الله عليه وسلم ثم اسدل ناصيته","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3633-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3633-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3633-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3633-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0d01a","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3634,"bookHadithIndex":85,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا يزيد بن هارون، انبانا جرير بن حازم، عن قتادة، عن انس، قال كان شعر رسول الله صلى الله عليه وسلم شعرا رجلا بين اذنيه ومنكبيه","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3634-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3634-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3634-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3634-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0d01b","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3635,"bookHadithIndex":86,"text":"حدثنا عبد الرحمن بن ابراهيم، حدثنا ابن ابي فديك، عن عبد الرحمن بن ابي الزناد، عن هشام بن عروة، عن ابيه، عن عايشة، قالت كان لرسول الله صلى الله عليه وسلم شعر دون الجمة وفوق الوفرة","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3635-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3635-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3635-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3635-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0d01c","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3636,"bookHadithIndex":87,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا معاوية بن هشام، وسفيان بن عقبة، عن سفيان، عن عاصم بن كليب، عن ابيه، عن وايل بن حجر، قال راني النبي صلى الله عليه وسلم ولي شعر طويل فقال \" ذباب ذباب \" . فانطلقت فاخذته فراني النبي صلى الله عليه وسلم فقال \" اني لم اعنك وهذا احسن","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3636-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3636-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3636-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0d01d","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3637,"bookHadithIndex":88,"text":"حدثنا ابو بكر بن ابي شيبة، وعلي بن محمد، قالا حدثنا ابو اسامة، عن عبيد الله بن عمر، عن عمر بن نافع، عن نافع، عن ابن عمر، قال نهى رسول الله صلى الله عليه وسلم عن القزع . قال وما القزع قال ان يحلق من راس الصبي مكان ويترك مكان","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3637-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3637-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3637-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3637-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0d01e","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3638,"bookHadithIndex":89,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا شبابة، حدثنا شعبة، عن عبد الله بن دينار، عن ابن عمر، قال نهى رسول الله صلى الله عليه وسلم عن القزع","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3638-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3638-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3638-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3638-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari"}]},{"id":"69b6c8bfdd1a4c9c86f0d01f","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3639,"bookHadithIndex":90,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا سفيان بن عيينة، عن ايوب بن موسى، عن نافع، عن ابن عمر، قال اتخذ رسول الله صلى الله عليه وسلم خاتما من ورق ثم نقش فيه محمد رسول الله فقال \" لا ينقش احد على نقش خاتمي هذا","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3639-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3639-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3639-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3639-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0d020","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3640,"bookHadithIndex":91,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا اسماعيل ابن علية، عن عبد العزيز بن صهيب، عن انس بن مالك، قال اصطنع رسول الله صلى الله عليه وسلم خاتما فقال \" انا قد اصطنعنا خاتما ونقشنا فيه نقشا فلا ينقشن عليه احد","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3640-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3640-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3640-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3640-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0d021","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3641,"bookHadithIndex":92,"text":"حدثنا محمد بن يحيى، حدثنا عثمان بن عمر، حدثنا يونس، عن الزهري، عن انس بن مالك، ان رسول الله صلى الله عليه وسلم اتخذ خاتما من فضة له فص حبشي ونقشه محمد رسول الله","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3641-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3641-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3641-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3641-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0d022","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3642,"bookHadithIndex":93,"text":"حدثنا ابو بكر، حدثنا عبد الله بن نمير، عن عبيد الله، عن نافع بن جبير، مولى علي عن علي، قال نهى رسول الله صلى الله عليه وسلم عن التختم بالذهب","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3642-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3642-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3642-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3642-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0d023","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3643,"bookHadithIndex":94,"text":"حدثنا ابو بكر، حدثنا علي بن مسهر، عن يزيد بن ابي زياد، عن الحسن بن سهيل، عن ابن عمر، قال نهى رسول الله صلى الله عليه وسلم عن خاتم الذهب","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3643-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3643-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3643-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0d024","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3644,"bookHadithIndex":95,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا عبد الله بن نمير، عن محمد بن اسحاق، عن يحيى بن عباد بن عبد الله بن الزبير، عن ابيه، عن عايشة ام المومنين، قالت اهدى النجاشي الى رسول الله صلى الله عليه وسلم حلقة فيها خاتم ذهب فيه فص حبشي فاخذه رسول الله صلى الله عليه وسلم بعود وانه لمعرض عنه او ببعض اصابعه ثم دعا ابنة ابنته امامة بنت ابي العاص فقال \" تحلى بهذا يا بنية","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3644-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3644-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3644-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3644-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0d025","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3645,"bookHadithIndex":96,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا سفيان بن عيينة، عن ايوب بن موسى، عن نافع، عن ابن عمر، ان النبي صلى الله عليه وسلم كان يجعل فص خاتمه مما يلي كفه","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3645-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3645-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3645-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3645-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0d026","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3646,"bookHadithIndex":97,"text":"حدثنا محمد بن يحيى، حدثنا اسماعيل بن ابي اويس، حدثني سليمان بن بلال، عن يونس بن يزيد الايلي، عن ابن شهاب، عن انس بن مالك، ان رسول الله صلى الله عليه وسلم لبس خاتم فضة فيه فص حبشي كان يجعل فصه في بطن كفه","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3646-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3646-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3646-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0d027","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3647,"bookHadithIndex":98,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا عبد الله بن نمير، عن ابراهيم بن الفضل، عن عبد الله بن محمد بن عقيل، عن عبد الله بن جعفر، ان النبي صلى الله عليه وسلم كان يتختم في يمينه","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3647-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3647-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3647-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0d028","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3648,"bookHadithIndex":99,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا عبد الله بن ادريس، عن عاصم، عن ابي بردة، عن علي، قال نهاني رسول الله صلى الله عليه وسلم ان اتختم في هذه وفي هذه يعني الخنصر والابهام","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3648-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3648-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3648-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3648-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0d029","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":32,"hadithIndex":3649,"bookHadithIndex":100,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا سفيان بن عيينة، عن الزهري، عن عبيد الله بن عبد الله، عن ابن عباس، عن ابي طلحة، عن النبي صلى الله عليه وسلم قال \" لا تدخل الملايكة بيتا فيه كلب ولا صورة","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-32-3649-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3649-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3649-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-32-3649-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]}]}
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c912",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 8,
      "hadithIndex": 1834,
      "bookHadithIndex": 52,
      "text": "حدثنا علي بن محمد، حدثنا ابو معاوية، عن الاعمش، عن شقيق، عن عمرو بن الحارث بن المصطلق ابن اخي، زينب امراة عبد الله عن زينب، امراة عبد الله قالت سالت رسول الله صلى الله عليه وسلم ايجزي عني من الصدقة النفقة على زوجي وايتام في حجري قال رسول الله صلى الله عليه وسلم \" لها اجران اجر الصدقة واجر القرابة \" . حدثنا الحسن بن محمد بن الصباح، حدثنا ابو معاوية، حدثنا الاعمش، عن شقيق، عن عمرو بن الحارث ابن اخي، زينب عن زينب، امراة عبد الله عن النبي صلى الله عليه وسلم نحوه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-8-1834-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"

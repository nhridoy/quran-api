          "grade": "Very Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2719-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc88",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 23,
      "hadithIndex": 2720,
      "bookHadithIndex": 2,
      "text": "حدثنا محمد بن ابي عمر العدني، حدثنا سفيان بن عيينة، عن عبد الله بن محمد بن عقيل، عن جابر بن عبد الله، قال جاءت امراة سعد بن الربيع بابنتى سعد الى النبي صلى الله عليه وسلم فقالت يا رسول الله هاتان ابنتا سعد قتل معك يوم احد وان عمهما اخذ جميع ما ترك ابوهما وان المراة لا تنكح الا على مالها . فسكت رسول الله صلى الله عليه وسلم حتى انزلت اية الميراث فدعا رسول الله صلى الله عليه وسلم اخا سعد بن الربيع فقال \" اعط ابنتى سعد ثلثى ماله واعط امراته الثمن وخذ انت ما بقي",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2720-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2720-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2720-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc89",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 23,
      "hadithIndex": 2721,
      "bookHadithIndex": 3,
      "text": "حدثنا علي بن محمد، حدثنا وكيع، حدثنا سفيان، عن ابي قيس الاودي، عن الهزيل بن شرحبيل، قال جاء رجل الى ابي موسى الاشعري وسلمان بن ربيعة الباهلي فسالهما عن ابنة وابنة ابن واخت، لاب وام فقالا للابنة النصف وما بقي فللاخت وايت ابن مسعود فسيتابعنا . فاتى الرجل ابن مسعود فساله واخبره بما قالا فقال عبد الله قد ضللت اذا وما انا من المهتدين ولكني ساقضي بما قضى به رسول الله صلى الله عليه وسلم للابنة النصف ولابنة الابن السدس تكملة الثلثين وما بقي فللاخت",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2721-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2721-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2721-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2721-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc8a",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 23,
      "hadithIndex": 2722,
      "bookHadithIndex": 4,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا شبابة، حدثنا يونس بن ابي اسحاق، عن ابي اسحاق، عن عمرو بن ميمون، عن معقل بن يسار المزني، قال سمعت النبي صلى الله عليه وسلم اتي بفريضة فيها جد فاعطاه ثلثا او سدسا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2722-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2722-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2722-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc8b",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 23,
      "hadithIndex": 2723,
      "bookHadithIndex": 5,
      "text": "قال ابو الحسن القطان حدثنا ابو حاتم، حدثنا ابن الطباع، حدثنا هشيم، عن يونس، عن الحسن، عن معقل بن يسار، قال قضى رسول الله صلى الله عليه وسلم في جد كان فينا بالسدس",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2723-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2723-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2723-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc8c",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 23,
      "hadithIndex": 2724,
      "bookHadithIndex": 6,
      "text": "حدثنا احمد بن عمرو بن السرح المصري، انبانا عبد الله بن وهب، انبانا يونس، عن ابن شهاب، حدثه عن قبيصة بن ذويب، ح وحدثنا سويد بن سعيد، حدثنا مالك بن انس، عن ابن شهاب، عن عثمان بن اسحاق بن خرشة، عن ابن ذويب، قال جاءت الجدة الى ابي بكر الصديق تساله ميراثها فقال لها ابو بكر ما لك في كتاب الله شىء وما علمت لك في سنة رسول الله صلى الله عليه وسلم شييا فارجعي حتى اسال الناس . فسال الناس فقال المغيرة بن شعبة حضرت رسول الله صلى الله عليه وسلم اعطاها السدس فقال ابو بكر هل معك غيرك فقام محمد بن مسلمة الانصاري فقال مثل ما قال المغيرة بن شعبة فانفذه لها ابو بكر . ثم جاءت الجدة الاخرى من قبل الاب الى عمر تساله ميراثها فقال ما لك في كتاب الله شىء وما كان القضاء الذي قضي به الا لغيرك وما انا بزايد في الفرايض شييا ولكن هو ذاك السدس فان اجتمعتما فيه فهو بينكما وايتكما خلت به فهو لها",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2724-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2724-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2724-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2724-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc8d",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 23,
      "hadithIndex": 2725,
      "bookHadithIndex": 7,
      "text": "حدثنا عبد الرحمن بن عبد الوهاب، حدثنا سلم بن قتيبة، عن شريك، عن ليث، عن طاوس، عن ابن عباس، ان رسول الله صلى الله عليه وسلم ورث جدة سدسا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2725-alalbani",
          "name": "Al-Albani",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2725-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif Isnaad"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2725-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc8e",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 23,
      "hadithIndex": 2726,
      "bookHadithIndex": 8,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا اسماعيل ابن علية، عن سعيد، عن قتادة، عن سالم بن ابي الجعد، عن معدان بن ابي طلحة اليعمري، ان عمر بن الخطاب، قام خطيبا يوم الجمعة او خطبهم يوم الجمعة فحمد الله واثنى عليه وقال اني والله ما ادع بعدي شييا هو اهم الى من امر الكلالة وقد سالت رسول الله صلى الله عليه وسلم فما اغلظ لي في شىء ما اغلظ لي فيها حتى طعن باصبعه في جنبي او في صدري ثم قال \" يا عمر تكفيك اية الصيف التي نزلت في اخر سورة النساء",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2726-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2726-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2726-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2726-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc8f",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 23,
      "hadithIndex": 2727,
      "bookHadithIndex": 9,
      "text": "حدثنا علي بن محمد، وابو بكر بن ابي شيبة قالا حدثنا وكيع، حدثنا سفيان، حدثنا عمرو بن مرة، عن مرة بن شراحيل، قال قال عمر بن الخطاب ثلاث لان يكون رسول الله صلى الله عليه وسلم بينهن احب الى من الدنيا وما فيها الكلالة والربا والخلافة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2727-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2727-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2727-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc90",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 23,
      "hadithIndex": 2728,
      "bookHadithIndex": 10,
      "text": "حدثنا هشام بن عمار، حدثنا سفيان، عن محمد بن المنكدر، سمع جابر بن عبد الله، يقول مرضت فاتاني رسول الله صلى الله عليه وسلم يعودني هو وابو بكر معه وهما ماشيان وقد اغمي على فتوضا رسول الله صلى الله عليه وسلم فصب على من وضويه فقلت يا رسول الله كيف اصنع كيف اقضي في مالي حتى نزلت اية الميراث في اخر النساء {وان كان رجل يورث كلالة} الاية و {يستفتونك قل الله يفتيكم في الكلالة} الاية",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2728-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"

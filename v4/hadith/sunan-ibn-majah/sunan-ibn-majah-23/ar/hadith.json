      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc91",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 23,
      "hadithIndex": 2729,
      "bookHadithIndex": 11,
      "text": "حدثنا هشام بن عمار، ومحمد بن الصباح، قالا حدثنا سفيان بن عيينة، عن الزهري، عن علي بن الحسين، عن عمرو بن عثمان، عن اسامة بن زيد، رفعه الى النبي صلى الله عليه وسلم قال \" لا يرث المسلم الكافر ولا الكافر المسلم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2729-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2729-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2729-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc92",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 23,
      "hadithIndex": 2730,
      "bookHadithIndex": 12,
      "text": "حدثنا احمد بن عمرو بن السرح، حدثنا عبد الله بن وهب، انبانا يونس، عن ابن شهاب، عن علي بن الحسين، انه حدثه ان عمرو بن عثمان اخبره عن اسامة بن زيد، انه قال يا رسول الله اتنزل في دارك بمكة قال \" وهل ترك لنا عقيل من رباع او دور \" . وكان عقيل ورث ابا طالب هو وطالب ولم يرث جعفر ولا علي شييا لانهما كانا مسلمين وكان عقيل وطالب كافرين . فكان عمر من اجل ذلك يقول لا يرث المومن الكافر . وقال اسامة قال رسول الله صلى الله عليه وسلم \" لا يرث المسلم الكافر ولا الكافر المسلم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-23-2730-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {

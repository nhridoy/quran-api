        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc56",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 21,
      "hadithIndex": 2670,
      "bookHadithIndex": 56,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا عبد الله بن نمير، عن يزيد بن ابي زياد، حدثنا جامع بن شداد، عن طارق المحاربي، قال رايت رسول الله صلى الله عليه وسلم يرفع يديه حتى رايت بياض ابطيه يقول \" الا لا تجني ام على ولد الا لا تجني ام على ولد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2670-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"

        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc5f",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 21,
      "hadithIndex": 2679,
      "bookHadithIndex": 65,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا اسحاق بن منصور، قال حدثنا عبد السلام، عن اسحاق بن عبد الله بن ابي فروة، عن سلمة بن روح بن زنباع، عن جده، انه قدم على النبي صلى الله عليه وسلم وقد خصى غلاما له فاعتقه النبي صلى الله عليه وسلم بالمثلة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2679-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2679-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Hasan Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2679-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc60",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 21,
      "hadithIndex": 2680,
      "bookHadithIndex": 66,
      "text": "حدثنا رجاء بن المرجى السمرقندي، حدثنا النضر بن شميل، حدثنا ابو حمزة الصيرفي، حدثني عمرو بن شعيب، عن ابيه، عن جده، قال جاء رجل الى النبي صلى الله عليه وسلم صارخا فقال له رسول الله صلى الله عليه وسلم \" ما لك \" . قال سيدي راني اقبل جارية له فجب مذاكيري . فقال النبي صلى الله عليه وسلم \" على بالرجل \" . فطلب فلم يقدر عليه . فقال رسول الله صلى الله عليه وسلم \" اذهب فانت حر \" . قال على من نصرتي يا رسول الله قال يقول ارايت ان استرقني مولاى فقال رسول الله صلى الله عليه وسلم \" على كل مومن او مسلم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2680-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2680-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2680-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc61",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 21,
      "hadithIndex": 2681,
      "bookHadithIndex": 67,
      "text": "حدثنا يعقوب بن ابراهيم الدورقي، حدثنا هشيم، عن مغيرة، عن شباك، عن ابراهيم، عن علقمة، قال قال عبد الله قال رسول الله صلى الله عليه وسلم \" ان من اعف الناس قتلة اهل الايمان",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2681-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2681-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2681-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc62",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 21,
      "hadithIndex": 2682,
      "bookHadithIndex": 68,
      "text": "حدثنا عثمان بن ابي شيبة، حدثنا غندر، عن شعبة، عن مغيرة، عن شباك، عن ابراهيم، عن هنى بن نويرة، عن علقمة، عن عبد الله، قال قال رسول الله صلى الله عليه وسلم \" ان اعف الناس قتلة اهل الايمان",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2682-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2682-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2682-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc63",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 21,
      "hadithIndex": 2683,
      "bookHadithIndex": 69,
      "text": "حدثنا محمد بن عبد الاعلى الصنعاني، حدثنا المعتمر بن سليمان، عن ابيه، عن حنش، عن عكرمة، عن ابن عباس، عن النبي صلى الله عليه وسلم قال \" المسلمون تتكافا دماوهم وهم يد على من سواهم يسعى بذمتهم ادناهم ويرد على اقصاهم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2683-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2683-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2683-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc64",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 21,
      "hadithIndex": 2684,
      "bookHadithIndex": 70,
      "text": "حدثنا ابراهيم بن سعيد الجوهري، حدثنا انس بن عياض ابو ضمرة، عن عبد السلام بن ابي الجنوب، عن الحسن، عن معقل بن يسار، قال قال رسول الله صلى الله عليه وسلم \" المسلمون يد على من سواهم وتتكافا دماوهم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2684-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2684-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2684-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc65",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 21,
      "hadithIndex": 2685,
      "bookHadithIndex": 71,
      "text": "حدثنا هشام بن عمار، حدثنا حاتم بن اسماعيل، عن عبد الرحمن بن عياش، عن عمرو بن شعيب، عن ابيه، عن جده، قال قال رسول الله صلى الله عليه وسلم \" يد المسلمين على من سواهم تتكافا دماوهم ويجير على المسلمين ادناهم ويرد على المسلمين اقصاهم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2685-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2685-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2685-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2685-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc66",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 21,
      "hadithIndex": 2686,
      "bookHadithIndex": 72,
      "text": "حدثنا ابو كريب، حدثنا ابو معاوية، عن الحسن بن عمرو، عن مجاهد، عن عبد الله بن عمرو، قال قال رسول الله صلى الله عليه وسلم \" من قتل معاهدا لم يرح رايحة الجنة وان ريحها ليوجد من مسيرة اربعين عاما",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2686-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2686-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2686-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc67",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 21,
      "hadithIndex": 2687,
      "bookHadithIndex": 73,
      "text": "حدثنا محمد بن بشار، حدثنا معدي بن سليمان، انبانا ابن عجلان، عن ابيه، عن ابي هريرة، عن النبي صلى الله عليه وسلم قال \" من قتل معاهدا له ذمة الله وذمة رسوله لم يرح رايحة الجنة وان ريحها ليوجد من مسيرة سبعين عاما",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2687-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2687-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2687-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2687-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc68",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 21,
      "hadithIndex": 2688,
      "bookHadithIndex": 74,
      "text": "حدثنا محمد بن عبد الملك بن ابي الشوارب، حدثنا ابو عوانة، عن عبد الملك بن عمير، عن رفاعة بن شداد القتباني، قال لولا كلمة سمعتها من، عمرو بن الحمق الخزاعي لمشيت فيما بين راس المختار وجسده سمعته يقول قال رسول الله صلى الله عليه وسلم \" من امن رجلا على دمه فقتله فانه يحمل لواء غدر يوم القيامة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2688-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2688-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2688-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2688-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc69",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 21,
      "hadithIndex": 2689,
      "bookHadithIndex": 75,
      "text": "حدثنا علي بن محمد، حدثنا وكيع، حدثنا ابو ليلى، عن ابي عكاشة، عن رفاعة، قال دخلت على المختار في قصره فقال قام جبراييل من عندي الساعة . فما منعني من ضرب عنقه الا حديث سمعته من سليمان بن صرد عن النبي صلى الله عليه وسلم انه قال \" اذا امنك الرجل على دمه فلا تقتله \" . فذاك الذي منعني منه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2689-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2689-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2689-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2689-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc6a",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 21,
      "hadithIndex": 2690,
      "bookHadithIndex": 76,
      "text": "حدثنا ابو بكر بن ابي شيبة، وعلي بن محمد، قالا حدثنا ابو معاوية، عن الاعمش، عن ابي صالح، عن ابي هريرة، قال قتل رجل على عهد رسول الله صلى الله عليه وسلم فرفع ذلك الى النبي صلى الله عليه وسلم فدفعه الى ولي المقتول فقال القاتل يا رسول الله والله ما اردت قتله . فقال رسول الله صلى الله عليه وسلم للولي \" اما انه ان كان صادقا ثم قتلته دخلت النار \" . قال فخلى سبيله . قال وكان مكتوفا بنسعة فخرج يجر نسعته فسمي ذا النسعة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2690-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2690-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2690-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2690-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc6b",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 21,
      "hadithIndex": 2691,
      "bookHadithIndex": 77,
      "text": "حدثنا ابو عمير، عيسى بن محمد النحاس وعيسى بن يونس والحسين بن ابي السري العسقلاني قالوا حدثنا ضمرة بن ربيعة، عن ابن شوذب، عن ثابت البناني، عن انس بن مالك، قال اتى رجل بقاتل وليه الى رسول الله صلى الله عليه وسلم فقال النبي صلى الله عليه وسلم \" اعف \" . فابى فقال \" خذ ارشك \" . فابى . قال \" اذهب فاقتله فانك مثله \" . قال فلحق به فقيل له ان رسول الله صلى الله عليه وسلم قد قال \" اقتله فانك مثله \" . فخلى سبيله . قال فريي يجر نسعته ذاهبا الى اهله . قال كانه قد كان اوثقه . قال ابو عمير في حديثه قال ابن شوذب عن عبد الرحمن بن القاسم، فليس لاحد بعد النبي صلى الله عليه وسلم ان يقول \" اقتله فانك مثله \" . قال ابن ماجه هذا حديث الرمليين ليس الا عندهم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2691-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2691-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2691-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2691-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc6c",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 21,
      "hadithIndex": 2692,
      "bookHadithIndex": 78,
      "text": "حدثنا اسحاق بن منصور، انبانا حبان بن هلال، حدثنا عبد الله بن بكر المزني، عن عطاء بن ابي ميمونة، قال لا اعلمه الا عن انس بن مالك، قال ما رفع الى رسول الله صلى الله عليه وسلم شىء فيه القصاص الا امر فيه بالعفو",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2692-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2692-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2692-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc6d",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 21,
      "hadithIndex": 2693,
      "bookHadithIndex": 79,
      "text": "حدثنا علي بن محمد، حدثنا وكيع، عن يونس بن ابي اسحاق، عن ابي السفر، قال قال ابو الدرداء سمعت رسول الله صلى الله عليه وسلم يقول \" ما من رجل يصاب بشىء من جسده فيتصدق به الا رفعه الله به درجة او حط عنه به خطيية \" . سمعته اذناى ووعاه قلبي",

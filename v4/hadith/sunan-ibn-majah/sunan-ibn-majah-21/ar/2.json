          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc54",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 21,
      "hadithIndex": 2668,
      "bookHadithIndex": 54,
      "text": "حدثنا ابراهيم بن المستمر، حدثنا الحر بن مالك العنبري، حدثنا مبارك بن فضالة، عن الحسن، عن ابي بكرة، قال قال رسول الله صلى الله عليه وسلم \" لا قود الا بالسيف",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2668-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2668-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2668-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2668-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc55",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 21,
      "hadithIndex": 2669,
      "bookHadithIndex": 55,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا ابو الاحوص، عن شبيب بن غرقدة، عن سليمان بن عمرو بن الاحوص، عن ابيه، قال سمعت رسول الله صلى الله عليه وسلم يقول في حجة الوداع \" الا لا يجني جان الا على نفسه لا يجني والد على ولده ولا مولود على والده",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2669-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2669-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {

          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc5c",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 21,
      "hadithIndex": 2676,
      "bookHadithIndex": 62,
      "text": "حدثنا احمد بن الازهر، حدثنا عبد الرزاق، عن معمر، عن همام، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" النار جبار والبير جبار",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2676-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2676-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2676-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {

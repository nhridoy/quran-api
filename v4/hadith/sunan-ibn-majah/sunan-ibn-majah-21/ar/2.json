      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc53",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 21,
      "hadithIndex": 2667,
      "bookHadithIndex": 53,
      "text": "حدثنا ابراهيم بن المستمر العروقي، حدثنا ابو عاصم، عن سفيان، عن جابر، عن ابي عازب، عن النعمان بن بشير، ان رسول الله صلى الله عليه وسلم قال \" لا قود الا بالسيف",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2667-alalbani",
          "name": "Al-Albani",
          "grade": "Very Daif"
        },
        {

      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc59",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 21,
      "hadithIndex": 2673,
      "bookHadithIndex": 59,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا سفيان، عن الزهري، عن سعيد بن المسيب، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" العجماء جرحها جبار والمعدن جبار والبير جبار",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2673-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2673-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2673-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2673-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc5a",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 21,
      "hadithIndex": 2674,
      "bookHadithIndex": 60,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا خالد بن مخلد، حدثنا كثير بن عبد الله بن عمرو بن عوف، عن ابيه، عن جده، قال سمعت رسول الله صلى الله عليه وسلم يقول \" العجماء جرحها جبار والمعدن جبار",
      "grades": [

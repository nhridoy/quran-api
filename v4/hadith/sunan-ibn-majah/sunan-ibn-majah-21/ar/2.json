          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc57",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 21,
      "hadithIndex": 2671,
      "bookHadithIndex": 57,
      "text": "حدثنا عمرو بن رافع، حدثنا هشيم، عن يونس، عن حصين بن ابي الحر، عن الخشخاش العنبري، قال اتيت النبي صلى الله عليه وسلم ومعي ابني فقال \" لا تجني عليه ولا يجني عليك",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2671-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2671-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {

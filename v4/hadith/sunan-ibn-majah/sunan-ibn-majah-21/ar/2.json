      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc52",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 21,
      "hadithIndex": 2666,
      "bookHadithIndex": 52,
      "text": "حدثنا محمد بن بشار، حدثنا محمد بن جعفر، ح وحدثنا اسحاق بن منصور، حدثنا النضر بن شميل، قالا حدثنا شعبة، عن هشام بن زيد، عن انس بن مالك، ان يهوديا، قتل جارية على اوضاح لها فقال لها \" اقتلك فلان \" . فاشارت براسها ان لا ثم سالها الثانية فاشارت براسها ان لا ثم سالها الثالثة فاشارت براسها ان نعم فقتله رسول الله صلى الله عليه وسلم بين حجرين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-21-2666-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"

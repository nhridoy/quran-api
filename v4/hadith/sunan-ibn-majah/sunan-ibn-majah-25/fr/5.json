          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-25-3113-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",

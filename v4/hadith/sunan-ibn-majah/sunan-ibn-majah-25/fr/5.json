    {
      "id": "69b6c8bfdd1a4c9c86f0cdf7",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 25,
      "hadithIndex": 3087,
      "bookHadithIndex": 206,
      "text": "Rapporté par ‘Aishah : Le Prophète (ﷺ) a dit : “Il y a cinq nuisibles que l’on peut tuer, que l’on soit à l’intérieur ou à l’extérieur du territoire sacré : le serpent, la corneille tachetée, la souris, le chien dangereux et le milan.”",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-25-3087-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-25-3087-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-25-3087-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-25-3087-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0cdf8",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 25,
      "hadithIndex": 3088,
      "bookHadithIndex": 207,
      "text": "Rapporté par Ibn ‘Umar : Le Messager d’Allah (ﷺ) a dit : “Il y a cinq animaux pour lesquels il n’y a pas de faute si on les tue” – ou il a dit : “si on les tue en état d’Ihram – le scorpion, la corneille, le milan, la souris et le chien dangereux.”",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-25-3088-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-25-3088-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-25-3088-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-25-3088-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0cdf9",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 25,
      "hadithIndex": 3089,
      "bookHadithIndex": 208,
      "text": "Rapporté par Abu Sa’eed : Le Prophète (ﷺ) a dit : “Celui qui est en état d’Ihram peut tuer le serpent, le scorpion, le prédateur agressif, le chien dangereux et la souris nuisible.” On lui a demandé : “Pourquoi dit-on qu’ils sont nuisibles ?” Il a répondu : “Parce que le Messager d’Allah (ﷺ) s’est réveillé à cause d’une souris, et elle avait pris la mèche (de la lampe) pour brûler la maison.”",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-25-3089-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-25-3089-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-25-3089-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-25-3089-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0cdfa",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 25,
      "hadithIndex": 3090,
      "bookHadithIndex": 209,
      "text": "Rapporté par Ibn ‘Abbas : Sa’b bin Jaththamah nous a dit : “Le Messager d’Allah (ﷺ) est passé près de moi alors que j’étais à Abwa’ ou Waddan, et je lui ai offert de la viande d’âne sauvage, mais il me l’a rendue. Quand il a vu que j’étais peiné, il a dit : ‘La seule raison pour laquelle nous te la rendons, c’est parce que nous sommes en état d’Ihram.’”",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-25-3090-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"

          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cae8",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 12,
      "hadithIndex": 2304,
      "bookHadithIndex": 168,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا وكيع، عن هشام بن عروة، عن ابيه، عن ام هاني، ان النبي صلى الله عليه وسلم قال لها \" اتخذي غنما فان فيها بركة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-12-2304-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-12-2304-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {

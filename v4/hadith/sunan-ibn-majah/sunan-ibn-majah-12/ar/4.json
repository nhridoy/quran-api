    },
    {
      "id": "69b6c88cdd1a4c9c86f0caea",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 12,
      "hadithIndex": 2306,
      "bookHadithIndex": 170,
      "text": "حدثنا عصمة بن الفضل النيسابوري، ومحمد بن فراس ابو هريرة الصيرفي، قالا حدثنا حرمي بن عمارة، حدثنا زربي، امام مسجد هشام بن حسان حدثنا محمد بن سيرين، عن ابن عمر، رضى الله عنه قال قال رسول الله صلى الله عليه وسلم \" الشاة من دواب الجنة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-12-2306-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"

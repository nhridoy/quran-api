          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8c2",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1754,
      "bookHadithIndex": 117,
      "text": "حدثنا جبارة بن المغلس، حدثنا هشيم، عن عبيد الله بن ابي بكر، عن انس بن مالك، قال كان النبي صلى الله عليه وسلم لا يخرج يوم الفطر حتى يطعم تمرات",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1754-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"

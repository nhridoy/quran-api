      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8bf",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1751,
      "bookHadithIndex": 114,
      "text": "حدثنا احمد بن يوسف السلمي، حدثنا ابو عاصم، انبانا ابن جريج، عن ابي الزبير، عن جابر، قال قال رسول الله صلى الله عليه وسلم \" من دعي الى طعام وهو صايم فليجب فان شاء طعم وان شاء ترك",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1751-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1751-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1751-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1751-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8c0",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1752,
      "bookHadithIndex": 115,
      "text": "حدثنا علي بن محمد، حدثنا وكيع، عن سعدان الجهني، عن سعد ابي مجاهد الطايي، - وكان ثقة - عن ابي مدلة، - وكان ثقة - عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" ثلاثة لا ترد دعوتهم الامام العادل والصايم حتى يفطر ودعوة المظلوم يرفعها الله دون الغمام يوم القيامة وتفتح لها ابواب السماء ويقول بعزتي لانصرنك ولو بعد حين",
      "grades": [
        {

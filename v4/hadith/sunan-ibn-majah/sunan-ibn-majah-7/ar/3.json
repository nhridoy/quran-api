    {
      "id": "69b6c859dd1a4c9c86f0c8d0",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1768,
      "bookHadithIndex": 131,
      "text": "حدثنا عبد الله بن محمد الزهري، حدثنا سفيان، عن ابن عبيد بن نسطاس، عن ابي الضحى، عن مسروق، عن عايشة، قالت كان النبي صلى الله عليه وسلم اذا دخلت العشر احيا الليل وشد الميزر وايقظ اهله",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1768-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"

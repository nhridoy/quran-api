          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8ca",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1762,
      "bookHadithIndex": 125,
      "text": "حدثنا محمد بن يحيى، حدثنا يحيى بن حماد، حدثنا ابو عوانة، عن سليمان، عن ابي صالح، عن ابي سعيد، قال نهى رسول الله صلى الله عليه وسلم النساء ان يصمن الا باذن ازواجهن",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1762-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1762-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1762-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1762-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8cb",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1763,
      "bookHadithIndex": 126,
      "text": "حدثنا محمد بن يحيى الازدي، حدثنا موسى بن داود، وخالد بن ابي يزيد، قالا حدثنا ابو بكر المدني، عن هشام بن عروة، عن ابيه، عن عايشة، عن النبي صلى الله عليه وسلم قال \" اذا نزل الرجل بقوم فلا يصوم الا باذنهم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1763-alalbani",
          "name": "Al-Albani",
          "grade": "Very Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1763-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Very Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1763-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1763-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8cc",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1764,
      "bookHadithIndex": 127,
      "text": "حدثنا يعقوب بن حميد بن كاسب، حدثنا محمد بن معن، عن ابيه، وعن عبد الله بن عبد الله الاموي، عن معن بن محمد، عن حنظلة بن علي الاسلمي، عن ابي هريرة، عن النبي صلى الله عليه وسلم انه قال \" الطاعم الشاكر بمنزلة الصايم الصابر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1764-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1764-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1764-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8cd",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1765,
      "bookHadithIndex": 128,
      "text": "حدثنا اسماعيل بن عبد الله الرقي، حدثنا عبد الله بن جعفر، حدثنا عبد العزيز بن محمد، عن محمد بن عبد الله بن ابي حرة، عن عمه، حكيم بن ابي حرة عن سنان بن سنة الاسلمي، صاحب النبي صلى الله عليه وسلم قال قال رسول الله صلى الله عليه وسلم \" الطاعم الشاكر له مثل اجر الصايم الصابر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1765-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1765-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1765-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8ce",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1766,
      "bookHadithIndex": 129,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا اسماعيل ابن علية، عن هشام الدستوايي، عن يحيى بن ابي كثير، عن ابي سلمة، عن ابي سعيد الخدري، قال اعتكفنا مع رسول الله صلى الله عليه وسلم العشر الاوسط من رمضان فقال \" اني اريت ليلة القدر فانسيتها فالتمسوها في العشر الاواخر في الوتر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1766-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1766-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1766-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1766-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Bukhari And Muslim"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8cf",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1767,
      "bookHadithIndex": 130,
      "text": "حدثنا محمد بن عبد الملك بن ابي الشوارب، وابو اسحاق الهروي ابراهيم بن عبد الله بن حاتم قالا حدثنا عبد الواحد بن زياد، حدثنا الحسن بن عبيد الله، عن ابراهيم النخعي، عن الاسود، عن عايشة، قالت كان النبي صلى الله عليه وسلم يجتهد في العشر الاواخر ما لا يجتهد في غيره",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1767-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1767-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {

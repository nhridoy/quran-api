        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1768-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Bukhari And Muslim"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8d1",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1769,
      "bookHadithIndex": 132,
      "text": "حدثنا هناد بن السري، حدثنا ابو بكر بن عياش، عن ابي حصين، عن ابي صالح، عن ابي هريرة، قال كان النبي صلى الله عليه وسلم يعتكف كل عام عشرة ايام فلما كان العام الذي قبض فيه اعتكف عشرين يوما وكان يعرض عليه القران في كل عام مرة فلما كان العام الذي قبض فيه عرض عليه مرتين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1769-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1769-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1769-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1769-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8d2",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1770,
      "bookHadithIndex": 133,
      "text": "حدثنا محمد بن يحيى، حدثنا عبد الرحمن بن مهدي، عن حماد بن سلمة، عن ثابت، عن ابي رافع، عن ابى بن كعب، ان النبي صلى الله عليه وسلم كان يعتكف العشر الاواخر من رمضان فسافر عاما فلما كان من العام المقبل اعتكف عشرين يوما",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1770-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1770-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1770-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1770-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8d3",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1771,
      "bookHadithIndex": 134,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا يعلى بن عبيد، حدثنا يحيى بن سعيد، عن عمرة، عن عايشة، قالت كان النبي صلى الله عليه وسلم اذا اراد ان يعتكف صلى الصبح ثم دخل المكان الذي يريد ان يعتكف فيه فاراد ان يعتكف العشر الاواخر من رمضان فامر فضرب له خباء فامرت عايشة بخباء فضرب لها وامرت حفصة بخباء فضرب لها فلما رات زينب خباءهما امرت بخباء فضرب لها فلما راى ذلك رسول الله صلى الله عليه وسلم قال \" البر تردن \" . فلم يعتكف في رمضان واعتكف عشرا من شوال",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1771-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1771-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1771-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1771-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Bukhari And Muslim"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8d4",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1772,
      "bookHadithIndex": 135,
      "text": "حدثنا اسحاق بن موسى الخطمي، حدثنا سفيان بن عيينة، عن ايوب، عن نافع، عن ابن عمر، عن عمر، انه كان عليه نذر ليلة في الجاهلية يعتكفها فسال النبي صلى الله عليه وسلم فامره ان يعتكف",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1772-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1772-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1772-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Bukhari And Muslim"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8d5",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1773,
      "bookHadithIndex": 136,
      "text": "حدثنا احمد بن عمرو بن السرح، حدثنا عبد الله بن وهب، انبانا يونس، ان نافعا، حدثه عن عبد الله بن عمر، ان رسول الله صلى الله عليه وسلم كان يعتكف العشر الاواخر من رمضان . قال نافع وقد اراني عبد الله بن عمر المكان الذي كان يعتكف فيه رسول الله صلى الله عليه وسلم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1773-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1773-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1773-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Bukhari And Muslim"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8d6",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1774,
      "bookHadithIndex": 137,
      "text": "حدثنا محمد بن يحيى، حدثنا نعيم بن حماد، حدثنا ابن المبارك، عن عيسى بن عمر بن موسى، عن نافع، عن ابن عمر، عن النبي صلى الله عليه وسلم انه كان اذا اعتكف طرح له فراشه - او يوضع له سريره وراء اصطوانة التوبة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1774-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1774-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1774-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1774-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8d7",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1775,
      "bookHadithIndex": 138,
      "text": "حدثنا محمد بن عبد الاعلى الصنعاني، حدثنا المعتمر بن سليمان، حدثني عمارة بن غزية، قال سمعت محمد بن ابراهيم، عن ابي سلمة، عن ابي سعيد الخدري، ان رسول الله صلى الله عليه وسلم اعتكف في قبة تركية على سدتها قطعة حصير . قال فاخذ الحصير بيده فنحاها في ناحية القبة ثم اطلع راسه فكلم الناس",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1775-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1775-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1775-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1775-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8d8",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1776,
      "bookHadithIndex": 139,
      "text": "حدثنا محمد بن رمح، انبانا الليث بن سعد، عن ابن شهاب، عن عروة بن الزبير، وعمرة بنت عبد الرحمن، ان عايشة، قالت ان كنت لادخل البيت للحاجة والمريض فيه فما اسال عنه الا وانا مارة . قالت وكان رسول الله صلى الله عليه وسلم لا يدخل البيت الا لحاجة اذا كانوا معتكفين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1776-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1776-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1776-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1776-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8d9",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1777,
      "bookHadithIndex": 140,
      "text": "حدثنا احمد بن منصور ابو بكر، حدثنا يونس بن محمد، حدثنا الهياج الخراساني، حدثنا عنبسة بن عبد الرحمن، عن عبد الخالق، عن انس بن مالك، قال قال رسول الله صلى الله عليه وسلم \" المعتكف يتبع الجنازة ويعود المريض",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1777-alalbani",
          "name": "Al-Albani",
          "grade": "Mawdu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1777-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Mawdu"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1777-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8da",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1778,
      "bookHadithIndex": 141,
      "text": "حدثنا علي بن محمد، حدثنا وكيع، عن هشام بن عروة، عن ابيه، عن عايشة، قالت كان رسول الله صلى الله عليه وسلم يدني الى راسه وهو مجاور فاغسله وارجله وانا في حجرتي وانا حايض وهو في المسجد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1778-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1778-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1778-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1778-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8db",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1779,
      "bookHadithIndex": 142,
      "text": "حدثنا ابراهيم بن المنذر الحزامي، حدثنا عمر بن عثمان بن عمر بن موسى بن عبيد الله بن معمر، عن ابيه، عن ابن شهاب، اخبرني علي بن الحسين، عن صفية بنت حيى، زوج النبي صلى الله عليه وسلم انها جاءت الى رسول الله صلى الله عليه وسلم تزوره وهو معتكف في المسجد في العشر الاواخر من شهر رمضان فتحدثت عنده ساعة من العشاء ثم قامت تنقلب فقام معها رسول الله صلى الله عليه وسلم يقلبها حتى اذا بلغت باب المسجد الذي كان عند مسكن ام سلمة زوج النبي صلى الله عليه وسلم مر بهما رجلان من الانصار فسلما على رسول الله صلى الله عليه وسلم ثم نفذا فقال لهما رسول الله صلى الله عليه وسلم \" على رسلكما انها صفية بنت حيى \" . قالا سبحان الله يا رسول الله وكبر عليهما ذلك فقال رسول الله صلى الله عليه وسلم \" ان الشيطان يجري من ابن ادم مجرى الدم واني خشيت ان يقذف في قلوبكما شييا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1779-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1779-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1779-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Bukhari And Muslim"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8dc",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1780,
      "bookHadithIndex": 143,
      "text": "حدثنا الحسن بن محمد بن الصباح، حدثنا عفان، حدثنا يزيد بن زريع، عن خالد الحذاء، عن عكرمة، قال قالت عايشة اعتكفت مع رسول الله صلى الله عليه وسلم امراة من نسايه فكانت ترى الحمرة والصفرة فربما وضعت تحتها الطست",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1780-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1780-muhammadfouadabdalbaqi",

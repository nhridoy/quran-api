          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1780-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1780-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8dd",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1781,
      "bookHadithIndex": 144,
      "text": "حدثنا عبيد الله بن عبد الكريم، حدثنا محمد بن امية، حدثنا عيسى بن موسى البخاري، عن عبيدة العمي، عن فرقد السبخي، عن سعيد بن جبير، عن ابن عباس، ان رسول الله صلى الله عليه وسلم قال في المعتكف \" هو يعكف الذنوب ويجرى له من الحسنات كعامل الحسنات كلها",

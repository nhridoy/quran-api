        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1755-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8c4",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1756,
      "bookHadithIndex": 119,
      "text": "حدثنا محمد بن يحيى، حدثنا ابو عاصم، حدثنا ثواب بن عتبة المهري، عن ابن بريدة، عن ابيه، ان رسول الله صلى الله عليه وسلم كان لا يخرج يوم الفطر حتى ياكل وكان لا ياكل يوم النحر حتى يرجع",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1756-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1756-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1756-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1756-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8c5",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1757,
      "bookHadithIndex": 120,
      "text": "حدثنا محمد بن يحيى، حدثنا قتيبة، حدثنا عبثر، عن اشعث، عن محمد بن سيرين، عن نافع، عن ابن عمر، قال قال رسول الله صلى الله عليه وسلم \" من مات وعليه صيام شهر فليطعم عنه مكان كل يوم مسكين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1757-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1757-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1757-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8c6",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1758,
      "bookHadithIndex": 121,
      "text": "حدثنا عبد الله بن سعيد، حدثنا ابو خالد الاحمر، عن الاعمش، عن مسلم البطين، والحكم، وسلمة بن كهيل، عن سعيد بن جبير، وعطاء، ومجاهد، عن ابن عباس، قال جاءت امراة الى النبي صلى الله عليه وسلم فقالت يا رسول الله ان اختي ماتت وعليها صيام شهرين متتابعين قال \" ارايت لو كان على اختك دين اكنت تقضينه \" . قالت بلى . قال \" فحق الله احق",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1758-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1758-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1758-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Bukhari And Muslim"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8c7",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1759,
      "bookHadithIndex": 122,
      "text": "حدثنا زهير بن محمد، حدثنا عبد الرزاق، عن سفيان، عن عبد الله بن عطاء، عن ابن بريدة، عن ابيه، قال جاءت امراة الى النبي صلى الله عليه وسلم فقالت يا رسول الله ان امي ماتت وعليها صوم افاصوم عنها قال \" نعم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1759-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1759-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1759-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1759-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8c8",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1760,
      "bookHadithIndex": 123,
      "text": "حدثنا محمد بن يحيى، حدثنا احمد بن خالد الوهبي، حدثنا محمد بن اسحاق، عن عيسى بن عبد الله بن مالك، عن عطية بن سفيان بن عبد الله بن ربيعة، قال حدثنا وفدنا الذين، قدموا على رسول الله صلى الله عليه وسلم باسلام ثقيف . قال وقدموا عليه في رمضان وضرب عليهم قبة في المسجد فلما اسلموا صاموا ما بقي عليهم من الشهر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1760-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1760-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1760-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1760-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8c9",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1761,
      "bookHadithIndex": 124,
      "text": "حدثنا هشام بن عمار، حدثنا سفيان بن عيينة، عن ابي الزناد، عن الاعرج، عن ابي هريرة، عن النبي صلى الله عليه وسلم قال \" لا تصوم المراة وزوجها شاهد يوما من غير شهر رمضان الا باذنه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1761-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1761-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1761-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",

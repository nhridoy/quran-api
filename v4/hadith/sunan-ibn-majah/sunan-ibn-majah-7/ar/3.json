          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c859dd1a4c9c86f0c8c3",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 7,
      "hadithIndex": 1755,
      "bookHadithIndex": 118,
      "text": "حدثنا جبارة بن المغلس، حدثنا مندل بن علي، حدثنا عمر بن صهبان، عن نافع، عن ابن عمر، قال كان النبي صلى الله عليه وسلم لا يغدو يوم الفطر حتى يغدي اصحابه من صدقة الفطر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1755-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1755-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-7-1755-shuaibalarnaut",

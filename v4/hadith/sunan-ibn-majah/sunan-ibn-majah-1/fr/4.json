          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-1-456-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c81fdd1a4c9c86f0c3b1",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 1,
      "hadithIndex": 457,
      "bookHadithIndex": 191,
      "text": "Rapporté par Miqdam bin Ma'dikarib : Le Messager d'Allah ﷺ a fait ses ablutions ; il s'est donc lavé les pieds trois fois",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-1-457-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {

      "bookIndex": 1,
      "hadithIndex": 461,
      "bookHadithIndex": 195,
      "text": "Rapporté par Hakam bin Sufyan Ath-Thawri : Il a vu le Messager d'Allah ﷺ faire ses ablutions puis prendre une poignée d'eau et la saupoudrer sur sa partie intime pour dissiper tout doute concernant des gouttes d'urine",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-1-461-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-1-461-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-1-461-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },

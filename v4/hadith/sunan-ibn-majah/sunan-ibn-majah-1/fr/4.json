          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-1-457-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-1-457-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c81fdd1a4c9c86f0c3b2",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 1,
      "hadithIndex": 458,
      "bookHadithIndex": 192,
      "text": "Rapporté par Rubai' : Ibn 'Abbas est venu me voir et m'a interrogée sur ce hadith — c'est-à-dire le hadith que j'avais rapporté, disant que le Messager d'Allah ﷺ avait fait ses ablutions et s'était lavé les pieds. Ibn 'Abbas a dit : « Les gens insistent pour se laver les pieds, mais je ne trouve rien dans le Coran sauf (l'ordre de) les essuyer. »",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-1-458-alalbani",
          "name": "Al-Albani",
          "grade": "Munkar"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-1-458-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Munkar"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-1-458-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },

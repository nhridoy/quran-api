{"total":400,"totalPage":8,"page":3,"pageSize":50,"items":[{"id":"69b6c81fdd1a4c9c86f0c357","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":367,"bookHadithIndex":101,"text":"کبشہ بنت کعب رضی اللہ عنہما جو ابوقتادہ کی بہو تھیں کہتی ہیں کہ انہوں نے ابوقتادہ رضی اللہ عنہ کے وضو کے لیے پانی نکالا تو ایک بلی آئی اور اس میں سے پینے لگی، ابوقتادہ رضی اللہ عنہ نے اس کے لیے برتن جھکا دیا، میں ان کی جانب حیرت سے دیکھنے لگی تو انہوں نے کہا: بھتیجی! تمہیں تعجب ہو رہا ہے؟ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا ہے: بلی ناپاک نہیں ہے وہ گھروں میں گھومنے پھرنے والوں یا والیوں میں سے ہے ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-367-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-367-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-367-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-367-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c81fdd1a4c9c86f0c358","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":368,"bookHadithIndex":102,"text":"ام المؤمنین عائشہ رضی اللہ عنہا کہتی ہیں کہ میں اور رسول اللہ صلی اللہ علیہ وسلم ایک ہی برتن سے وضو کیا کرتے تھے اور اس سے پہلے بلی اس میں سے پی چکی ہوتی تھی۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-368-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-368-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-368-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-368-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c359","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":369,"bookHadithIndex":103,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: بلی نماز کو نہیں توڑتی، اس لیے کہ وہ گھر کے سامانوں میں سے ایک سامان ہے ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-369-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-369-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-369-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c81fdd1a4c9c86f0c35a","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":370,"bookHadithIndex":104,"text":"عبداللہ بن عباس رضی اللہ عنہما کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم کی ازواج مطہرات رضی اللہ عنہن میں سے کسی نے لگن سے غسل کیا، پھر نبی اکرم صلی اللہ علیہ وسلم تشریف لائے، اور اس بچے ہوئے پانی سے غسل یا وضو کرنا چاہا تو وہ بولیں: اے اللہ کے رسول! میں ناپاک تھی، آپ صلی اللہ علیہ وسلم نے فرمایا: پانی ناپاک نہیں ہوتا ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-370-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-370-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-370-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-1-370-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c35b","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":371,"bookHadithIndex":105,"text":"عبداللہ بن عباس رضی اللہ عنہما کہتے ہیں کہ ازواج مطہرات رضی اللہ عنہن میں سے کسی نے غسل جنابت کیا، پھر ان کے بچے ہوئے پانی سے نبی اکرم صلی اللہ علیہ وسلم نے وضو یا غسل کیا","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-371-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-371-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-371-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-1-371-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c35c","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":372,"bookHadithIndex":106,"text":"ام المؤمنین میمونہ رضی اللہ عنہا کہتی ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے ان کے غسل جنابت سے بچے ہوئے پانی سے وضو کیا۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-372-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-372-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-372-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-372-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c35d","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":373,"bookHadithIndex":107,"text":"حکم بن عمرو غفاری رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے مرد کو عورت کے وضو سے بچے ہوئے پانی سے وضو کرنے سے منع فرمایا ہے ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-373-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-373-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-373-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-373-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c81fdd1a4c9c86f0c35e","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":374,"bookHadithIndex":108,"text":"عبداللہ بن سرجس رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے منع فرمایا کہ مرد عورت کے بچے ہوئے پانی سے غسل کرے اور عورت مرد کے بچے ہوئے پانی سے غسل کرے، البتہ دونوں ایک ساتھ شروع کریں۔ ابوعبداللہ ابن ماجہ کہتے ہیں: صحیح پہلی حدیث یعنی حکم بن عمرو رضی اللہ عنہ کی ہے، اور دوسری حدیث یعنی عبداللہ بن سرجس رضی اللہ عنہ کی وہم ہے ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-374-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-374-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-374-zubairalizai","name":"Zubair Ali Zai","grade"
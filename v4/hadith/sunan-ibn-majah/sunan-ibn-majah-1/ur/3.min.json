24-1-380-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Bukhari And Muslim"}]},{"id":"69b6c81fdd1a4c9c86f0c365","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":381,"bookHadithIndex":115,"text":"عبداللہ بن عمر رضی اللہ عنہما کہتے ہیں کہ مرد و عورت رسول اللہ صلی اللہ علیہ وسلم کے زمانے میں ایک ہی برتن سے وضو کیا کرتے تھے۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-381-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-381-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-381-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-381-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari"}]},{"id":"69b6c81fdd1a4c9c86f0c366","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":382,"bookHadithIndex":116,"text":"ام صبیہ جہنیہ خولہ بنت قیس رضی اللہ عنہا کہتی ہیں کہ اکثر میرا اور رسول اللہ صلی اللہ علیہ وسلم کا ہاتھ ایک ہی برتن سے وضو کرتے وقت ٹکرا جایا کرتا تھا۔ ابوعبداللہ ابن ماجہ کہتے ہیں: میں نے محمد کو کہتے ہوئے سنا کہ ام صبیہ یہ خولہ بنت قیس ہیں اور میں نے اس کا ذکر ابوزرعہ سے کیا تو انہوں نے اس کی تصدیق کی۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-382-alalbani","name":"Al-Albani","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-382-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-382-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-1-382-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c81fdd1a4c9c86f0c367","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":383,"bookHadithIndex":117,"text":"ام المؤمنین عائشہ رضی اللہ عنہا کہتی ہیں کہ وہ اور نبی اکرم صلی اللہ علیہ وسلم دونوں نماز کے لیے ایک ہی ساتھ وضو کرتے تھے۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-383-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-383-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-383-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c81fdd1a4c9c86f0c368","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":384,"bookHadithIndex":118,"text":"عبداللہ بن مسعود رضی اللہ عنہ سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے ان سے «لیلۃالجن» ( جنوں سے ملاقات والی رات ) میں فرمایا: کیا تمہارے پاس وضو کا پانی ہے؟ ، انہوں نے کہا: برتن میں تھوڑے سے نبیذ کے سوا کچھ نہیں ہے، آپ صلی اللہ علیہ وسلم نے فرمایا: یہ پاک کھجور اور پاک پانی کا شربت ہے ، پھر آپ صلی اللہ علیہ وسلم نے وضو کیا ۱؎۔ یہ وکیع کی حدیث ہے۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-384-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-384-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-384-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-384-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c369","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":385,"bookHadithIndex":119,"text":"عبداللہ بن عباس رضی اللہ عنہما سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے ابن مسعود رضی اللہ عنہ سے «لیلۃالجن» میں فرمایا: کیا تمہارے پاس پانی ہے ؟ انہوں نے کہا: نہیں، چھاگل ( مشک ) میں نبیذ کے سوا کچھ نہیں ہے، تو رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: یہ پاک کھجور اور پاک پانی ہے، میرے اوپر ڈالو ، عبداللہ بن مسعود رضی اللہ عنہ کہتے ہیں: میں نے انڈیلا اور آپ صلی اللہ علیہ وسلم نے وضو کیا ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-385-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-385-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-385-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-385-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c36a","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":386,"bookHadithIndex":120,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ ایک آدمی نبی اکرم صلی اللہ علیہ وسلم کے پاس آیا اور عرض کیا: اللہ کے رسول! ہم سمندری سفر کرتے ہیں اور اپنے ساتھ تھوڑا سا پانی رکھتے ہیں، اگر ہم اس پانی سے وضو کریں تو پیاسے رہ جائیں، کیا ہم سمندر کے پانی سے وضو کر لیا کریں؟ آپ صلی اللہ علیہ وسلم نے فرمایا: اس کا پانی بذات خود پاک ہے، اور دوسرے کو پاک کرنے والا ہے، اس کا مردار حلال ہے ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-386-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-386-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-386-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-386-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c81fdd1a4c9c86f0c36b","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":387,"bookHadithIndex":121,"text":"ابن الفراسی کہتے ہیں کہ میں شکار کیا کرتا تھا، میرے پاس ایک مشک تھی، جس میں میں پانی رکھتا تھا، اور میں نے سمندر کے پانی سے وضو کر لیا، میں نے رسول اللہ صلی اللہ علیہ وسلم سے اس کا ذکر کیا، آپ صلی اللہ علیہ وسلم نے فرمایا: اس کا پانی پاک ہے، اور پاک کرنے والا ہے، اور اس کا مردار حلال ہے ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-387-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-387-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-1-387-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-387-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c36c","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":388,"bookHadithIndex":122,"text":"جابر رضی اللہ عنہ سے روایت ہے کہ نبی اکرم صلی اللہ علیہ وسلم سے سمندر کے پانی کے بارے میں پوچھا گیا تو آپ صلی اللہ علیہ وسلم نے فرمایا: اس کا پانی پاک ہے اور اس کا مردار حلال ہے ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-388-alalbani","name":"Al-Albani","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-388-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-388-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-1-388-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c81fdd1a4c9c86f0c36d","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":389,"bookHadithIndex":123,"text":"مغیرہ بن شعبہ رضی اللہ عنہ کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم اپنی کسی حاجت کے لیے تشریف لے گئے، جب آپ واپس ہوئے تو میں لوٹے میں پانی لے کر آپ سے ملا، میں نے پانی ڈالا، آپ صلی اللہ علیہ وسلم نے اپنے دونوں ہاتھ دھوئے، پھر اپنا چہرہ دھویا، پھر اپنے دونوں بازو دھونے لگے تو جبہ کی آستین تنگ پڑ گئی، آپ صلی اللہ علیہ وسلم نے اپنے ہاتھ جبہ کے نیچے سے نکال لیے، انہیں دھویا، اور اپنے موزوں پر مسح کیا، پھر ہمیں نماز پڑھائی۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-389-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-389-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-389-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-389-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Bukhari And Muslim"}]},{"id":"69b6c81fdd1a4c9c86f0c36e","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":390,"bookHadithIndex":124,"text":"ربیع بنت معوذ رضی اللہ عنہما کہتی ہیں کہ میں نبی اکرم صلی اللہ علیہ وسلم کے پاس وضو کا برتن لے کر آئی، آپ صلی اللہ علیہ وسلم نے فرمایا: پانی ڈالو ۱؎، میں نے پانی ڈالا، آپ صلی اللہ علیہ وسلم نے اپنا چہرہ اور اپنے دونوں بازو دھوئے اور نیا پانی لے کر سر کے اگلے اور پچھلے حصے کا مسح کیا، اور اپنے دونوں پاؤں تین تین بار دھوئے۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-390-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-1-390-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-1-390-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c36f","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":391,"bookHadithIndex":125,"text":"صفوان بن عسال رضی اللہ عنہ کہتے ہیں کہ میں نے نبی اکرم صلی اللہ علیہ وسلم کو سفر و حضر میں کئی بار وضو کرایا ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-391-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-391-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-391-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-391-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c370","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":392,"bookHadithIndex":126,"text":"رقیہ بنت رسول اللہ صلی اللہ علیہ وسلم کی لونڈی ام عیاش رضی اللہ عنہا کہتی ہیں کہ میں رسول اللہ صلی اللہ علیہ وسلم کو وضو کراتی تھی، میں کھڑی ہوتی تھی اور آپ بیٹھے ہوتے۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-392-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-392-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-392-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-392-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c371","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":393,"bookHadithIndex":127,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جب کوئی شخص رات کو سو کر بیدار ہو تو اپنا ہاتھ برتن میں نہ ڈالے، جب تک کہ دو یا تین مرتبہ اس پہ پانی نہ بہا لے کیونکہ وہ نہیں جانتا کہ رات میں اس کا ہاتھ کہاں کہاں رہا ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-393-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-393-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-393-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-393-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c81fdd1a4c9c86f0c372","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":394,"bookHadithIndex":128,"text":"عبداللہ بن عمر رضی اللہ عنہما کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جب کوئی شخص سو کر اٹھے تو اپنا ہاتھ برتن میں نہ ڈالے جب تک کہ اسے دھو نہ لے ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-394-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-394-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-394-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c81fdd1a4c9c86f0c373","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":395,"bookHadithIndex":129,"text":"جابر رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جب کوئی شخص نیند سے اٹھے، اور وضو کرنا چاہے تو اپنا ہاتھ وضو کے پانی میں نہ ڈالے، جب تک کہ اسے دھو نہ لے، کیونکہ اسے نہیں معلوم کہ اس کا ہاتھ رات میں کہاں کہاں رہا، اور اس نے اسے کس چیز پہ رکھا ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-395-alalbani","name":"Al-Albani","grade":"Munkar"},{"id":"69b55e8d6f42ba7ccb2a1324-1-395-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Munkar"},{"id":"69b55e8d6f42ba7ccb2a1324-1-395-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c374","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":396,"bookHadithIndex":130,"text":"حارث کہتے ہیں کہ علی رضی اللہ عنہ نے پانی منگایا اور برتن میں ہاتھ داخل کرنے سے پہلے دونوں ہاتھ دھوئے، پھر کہا کہ رسول اللہ صلی اللہ علیہ وسلم کو میں نے ایسا ہی کرتے دیکھا ہے۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-396-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-396-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-396-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c81fdd1a4c9c86f0c375","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":397,"bookHadithIndex":131,"text":"ابوسعید رضی اللہ عنہ سے روایت ہے کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: جو وضو سے پہلے «بسم اللہ» نہ کہے اس کا وضو نہیں ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-397-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-1-397-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-1-397-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c81fdd1a4c9c86f0c376","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":398,"bookHadithIndex":132,"text":"سعید بن زید رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جس کا وضو نہیں اس کی نماز نہیں، اور جس نے «بسم اللہ» نہیں کہا، اس کا وضو نہیں ہوا ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-398-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-398-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-1-398-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c81fdd1a4c9c86f0c377","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":399,"bookHadithIndex":133,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جس کا وضو نہیں اس کی نماز نہیں، اور جس نے «بسم اللہ» نہیں کہا، اس کا وضو نہیں ہوا ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-399-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-399-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-1-399-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c81fdd1a4c9c86f0c378","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":400,"bookHadithIndex":134,"text":"سہل بن سعد ساعدی رضی اللہ عنہ کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: اس شخص کی نماز نہیں، جس کا وضو نہیں، اور اس شخص کا وضو نہیں جو وضو کے وقت «بسم اللہ» نہ پڑھے، اور اس شخص کی نماز نہیں جو نبی اکرم صلی اللہ علیہ وسلم پہ درود نہ بھیجے، اور اس شخص کی نماز نہیں جو انصار سے محبت نہ کرے ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-400-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-400-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Munkar"},{"id":"69b55e8d6f42ba7ccb2a1324-1-400-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-400-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c379","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":401,"bookHadithIndex":135,"text":"ام المؤمنین عائشہ رضی اللہ عنہا سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم جب طہارت ( وضو و غسل ) کرتے اور جب کنگھا کرتے، اور جب جوتے پہنتے تو دائیں طرف سے شروع کرنا پسند فرماتے تھے۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-401-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-401-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-401-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-401-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Bukhari And Muslim"}]},{"id":"69b6c81fdd1a4c9c86f0c37a","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":402,"bookHadithIndex":136,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے ارشاد فرمایا: جب تم وضو کرو تو داہنے اعضاء سے شروع کرو ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-402-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f4
d6f42ba7ccb2a1324-1-405-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-405-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-405-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Bukhari And Muslim"}]},{"id":"69b6c81fdd1a4c9c86f0c37e","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":406,"bookHadithIndex":140,"text":"سلمہ بن قیس رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے مجھ سے فرمایا: جب تم وضو کرو تو ناک جھاڑو، اور جب استنجاء کرو تو طاق ڈھیلے استعمال کرو ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-406-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-406-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-406-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-406-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c81fdd1a4c9c86f0c37f","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":407,"bookHadithIndex":141,"text":"لقیط بن صبرہ رضی اللہ عنہ کہتے ہیں کہ میں نے عرض کیا: اللہ کے رسول! مجھے وضو کے بارے میں بتائیے! آپ صلی اللہ علیہ وسلم نے فرمایا: تم مکمل طور پر وضو کرو، اور ناک میں پانی چڑھانے میں مبالغہ کرو، الا یہ کہ تم روزے سے ہو ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-407-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-407-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-407-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c81fdd1a4c9c86f0c380","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":408,"bookHadithIndex":142,"text":"عبداللہ بن عباس رضی اللہ عنہما کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: دو بار یا تین بار اچھی طرح ناک میں پانی چڑھا کر جھاڑو ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-408-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-408-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-408-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c81fdd1a4c9c86f0c381","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":409,"bookHadithIndex":143,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جو شخص وضو کرے تو اچھی طرح ناک میں پانی چڑھا کر جھاڑے، اور جب استنجاء کرے تو طاق ڈھیلے استعمال کرے ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-409-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-409-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-409-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-409-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Bukhari And Muslim"}]},{"id":"69b6c81fdd1a4c9c86f0c382","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":410,"bookHadithIndex":144,"text":"ثابت بن ابوصفیہ ثمالی کہتے ہیں کہ میں نے ابوجعفر سے پوچھا: کیا آپ کو جابر بن عبداللہ رضی اللہ عنہما سے یہ حدیث پہنچی ہے کہ نبی اکرم صلی اللہ علیہ وسلم نے وضو میں اعضاء وضو کو ایک ایک بار دھویا، کہا: ہاں، میں نے کہا: اور دو دو بار اور تین تین بار؟ کہا: ہاں","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-410-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-410-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-410-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c383","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":411,"bookHadithIndex":145,"text":"عبداللہ بن عباس رضی اللہ عنہما کہتے ہیں کہ میں نے رسول اللہ صلی اللہ علیہ وسلم کو دیکھا کہ آپ نے اعضاء وضو کو ایک ایک چلو سے دھویا۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-411-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-411-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-411-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-411-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari"}]},{"id":"69b6c81fdd1a4c9c86f0c384","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":412,"bookHadithIndex":146,"text":"عمر رضی اللہ عنہ کہتے ہیں کہ میں نے رسول اللہ صلی اللہ علیہ وسلم کو غزوہ تبوک میں دیکھا کہ آپ نے اعضاء وضو کو ایک ایک بار دھویا۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-412-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-1-412-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-1-412-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c385","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":413,"bookHadithIndex":147,"text":"شقیق بن سلمہ کہتے ہیں کہ میں نے عثمان اور علی رضی اللہ عنہما کو دیکھا کہ وہ اعضاء وضو کو تین تین بار دھوتے تھے، اور کہتے تھے: رسول اللہ صلی اللہ علیہ وسلم کا وضو ایسا ہی تھا۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-413-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-413-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-413-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-1-413-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c81fdd1a4c9c86f0c386","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":414,"bookHadithIndex":148,"text":"مطلب بن عبداللہ بن حنطب کہتے ہیں کہ ابن عمر رضی اللہ عنہما نے اعضاء وضو کو تین تین بار دھویا، اور اس کو نبی اکرم صلی اللہ علیہ وسلم کی طرف منسوب کیا ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-414-alalbani","name":"Al
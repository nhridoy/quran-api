{"total":400,"totalPage":8,"page":5,"pageSize":50,"items":[{"id":"69b6c81fdd1a4c9c86f0c3bb","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":467,"bookHadithIndex":201,"text":"ام المؤمنین میمونہ رضی اللہ عنہا کہتی ہیں کہ جب رسول اللہ صلی اللہ علیہ وسلم غسل جنابت کر چکے تو میں آپ کے پاس ایک کپڑا لائی، آپ نے اسے واپس لوٹا دیا اور ( بدن سے ) پانی جھاڑنے لگے ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-467-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-467-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-467-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-467-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Bukhari And Muslim"}]},{"id":"69b6c81fdd1a4c9c86f0c3bc","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":468,"bookHadithIndex":202,"text":"سلمان فارسی رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے وضو کیا، اور اپنے پہنے ہوئے اون کے جبہ کو الٹ کر اس سے اپنا چہرہ پونچھ لیا ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-468-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-1-468-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-1-468-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-468-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c3bd","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":469,"bookHadithIndex":203,"text":"انس بن مالک رضی اللہ عنہ کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: جس شخص نے اچھی طرح وضو کیا، پھر تین مرتبہ «أشهد أن لا إله إلا الله وحده لا شريك له وأشهد أن محمدا عبده ورسوله» میں گواہی دیتا ہوں کہ اللہ کے علاوہ کوئی معبود برحق نہیں، وہ اکیلا ہے، اس کا کوئی شریک نہیں، اور میں گواہی دیتا ہوں کہ محمد صلی اللہ علیہ وسلم اس کے بندے، اور اس کے رسول ہیں کہا، تو اس کے لیے جنت کے آٹھوں دروازے کھول دئیے جائیں گے وہ جس دروازہ سے چاہے داخل ہو ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-469-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-469-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-469-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c3be","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":470,"bookHadithIndex":204,"text":"عمر بن خطاب رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جو مسلمان بھی اچھی طرح سے وضو کرے پھر «أشهد أن لا إله إلا الله وأشهد أن محمدا عبده ورسوله» میں گواہی دیتا ہوں کہ اللہ کے علاوہ کوئی معبود برحق نہیں، اور محمد صلی اللہ علیہ وسلم اس کے بندے، اور رسول ہیں تو اس کے لیے جنت کے آٹھوں دروازے کھول دئیے جائیں گے جس دروازے سے چاہے وہ داخل ہو جائے ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-470-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-470-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-470-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c81fdd1a4c9c86f0c3bf","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":471,"bookHadithIndex":205,"text":"صحابی رسول عبداللہ بن زید رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم ہمارے پاس تشریف لائے تو ہم نے پیتل کے ایک چھوٹے برتن میں پانی حاضر کیا جس سے آپ نے وضو کیا۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-471-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-471-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-471-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Bukhari And Muslim"}]},{"id":"69b6c81fdd1a4c9c86f0c3c0","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":472,"bookHadithIndex":206,"text":"ام المؤمنین زینب بنت جحش رضی اللہ عنہا کہتی ہیں کہ 
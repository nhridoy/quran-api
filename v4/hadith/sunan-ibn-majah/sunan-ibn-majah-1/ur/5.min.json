ndex":484,"bookHadithIndex":218,"text":"ابوامامہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم سے شرمگاہ چھونے کے بارے میں پوچھا گیا تو آپ صلی اللہ علیہ وسلم نے فرمایا: وہ تو تمہارے جسم کا ایک حصہ ہے ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-484-alalbani","name":"Al-Albani","grade":"Very Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-484-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Very Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-484-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Very Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-484-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c3cd","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":485,"bookHadithIndex":219,"text":"ابوہریرہ رضی اللہ عنہ سے روایت ہے کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: آگ پر پکی ہوئی چیزوں کے استعمال سے وضو کرو ، اس پر ابن عباس رضی اللہ عنہما نے کہا: کیا ہم گرم پانی استعمال کرنے سے بھی وضو کریں؟ ابوہریرہ رضی اللہ عنہ نے کہا: میرے بھتیجے! جب تم رسول اللہ صلی اللہ علیہ وسلم کی کوئی حدیث سنو تو اس پر باتیں مت بناؤ ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-485-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-1-485-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-1-485-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-1-485-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c81fdd1a4c9c86f0c3ce","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":486,"bookHadithIndex":220,"text":"ام المؤمنین عائشہ رضی اللہ عنہا کہتی ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ہر اس چیز کے استعمال سے وضو کرو جس کو آگ پر پکایا گیا ہو ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-486-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-486-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-486-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-486-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c81fdd1a4c9c86f0c3cf","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":487,"bookHadithIndex":221,"text":"انس بن مالک رضی اللہ عنہ سے روایت ہے وہ اپنے دونوں ہاتھ اپنے دونوں کانوں پر رکھتے اور کہتے: یہ دونوں کان بہرے ہو جائیں اگر میں نے رسول اللہ صلی اللہ علیہ وسلم کو یہ فرماتے ہوئے نہ سنا ہو: تم ہر اس چیز کے استعمال سے وضو کرو جسے آگ پر پکایا گیا ہو ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-487-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-487-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-487-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sanad Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-487-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c3d0","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":488,"bookHadithIndex":222,"text":"عبداللہ بن عباس رضی اللہ عنہما کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے بکری کے دست کا گوشت کھایا، پھر نیچے بچھے ہوئے چمڑے میں اپنا ہاتھ پونچھا، پھر نماز کے لیے کھڑے ہوئے، اور نماز پڑھائی۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-488-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-488-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-488-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-488-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c3d1","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":489,"bookHadithIndex":223,"text":"جابر بن عبداللہ رضی اللہ عنہما کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم اور ابوبکرو عمر رضی اللہ عنہما نے روٹی اور گوشت کھایا، اور وضو نہیں کیا۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-489-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-489-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-489-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-489-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c81fdd1a4c9c86f0c3d2","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":490,"bookHadithIndex":224,"text":"زہری کہتے ہیں کہ میں ولید یا عبدالملک کے ساتھ شام کے کھانے پہ حاضر ہوا، جب نماز کا وقت ہوا تو میں وضو کے لیے اٹھا تو جعفر بن عمرو بن امیہ ۱؎ نے کہا: میں گواہی دیتا ہوں کہ میرے والد ( عمرو بن امیہ ضمری مدنی رضی اللہ عنہ ) نے کہا کہ میں گواہی دیتا ہوں کہ رسول اللہ صلی اللہ علیہ وسلم نے آگ پہ پکا ہوا کھانا کھایا، پھر نماز پڑھی، اور وضو نہیں کیا۔ علی بن عبداللہ بن عباس نے کہا کہ میں اپنے والد ( عبداللہ بن عباس رضی اللہ عنہما ) کے بارے میں بھی اسی طرح کی گواہی دیتا ہوں۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-490-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-490-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-490-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-490-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Bukhari And Muslim"}]},{"id":"69b6c81fdd1a4c9c86f0c3d3","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":491,"bookHadithIndex":225,"text":"ام المؤمنین ام سلمہ رضی اللہ عنہا کہتی ہیں کہ رسول اللہ صلی اللہ علیہ وسلم کی خدمت میں بکری کی ( پکی ہوئی ) دست پیش کی گئی، آپ نے اس میں سے کھایا، پھر نماز پڑھی، اور پانی کو ہاتھ نہیں لگایا۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-491-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-491-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-491-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-491-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c81fdd1a4c9c86f0c3d4","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":492,"bookHadithIndex":226,"text":"سوید بن نعمان انصاری رضی اللہ عنہ کہتے ہیں کہ وہ لوگ رسول اللہ صلی اللہ علیہ وسلم کے ساتھ خیبر کی جانب نکلے، جب مقام صہباء ۱؎ میں پہنچے تو عصر کی نماز پڑھی، پھر آپ صلی اللہ علیہ وسلم نے کھانا منگایا تو صرف ستو لایا گیا لوگوں نے اسے کھایا، پیا، پھر آپ صلی اللہ علیہ وسلم نے پانی منگایا، اور کلی کی، پھر اٹھے اور ہمیں مغرب کی نماز پڑھائی۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-492-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-492-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-492-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-492-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari"}]},{"id":"69b6c81fdd1a4c9c86f0c3d5","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":493,"bookHadithIndex":227,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے بکری کے دست کا گوشت کھایا، پھر کلی کی، اور اپنے ہاتھ دھو کر نماز پڑھی ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-493-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-493-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-493-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-493-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c81fdd1a4c9c86f0c3d6","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":494,"bookHadithIndex":228,"text":"براء بن عازب رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم سے سوال کیا گیا: کیا اونٹ کا گوشت کھانے سے وضو ہے؟ آپ صلی اللہ علیہ وسلم نے فرمایا: اس سے وضو کرو ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-494-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-494-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-494-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-494-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c81fdd1a4c9c86f0c3d7","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":495,"bookHadithIndex":229,"text":"جابر بن سمرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے ہمیں حکم دیا کہ ہم اونٹ کا گوشت کھائیں تو وضو کریں، اور بکری کا گوشت کھائیں تو وضو نہ کریں ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-495-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-495-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-495-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-495-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c81fdd1a4c9c86f0c3d8","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":496,"bookHadithIndex":230,"text":"اسید بن حضیر رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: بکری کا دودھ پی کر وضو نہ کرو، البتہ اونٹنی کا دودھ پی کر وضو کرو ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-496-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-496-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-496-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-496-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c3d9","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":497,"bookHadithIndex":231,"text":"عبداللہ بن عمر رضی اللہ عنہما کہتے ہیں کہ میں نے رسول اللہ صلی اللہ علیہ وسلم کو فرماتے ہوئے سنا: اونٹ کے گوشت سے وضو کر لیا کرو، اور بکری کے گوشت سے وضو نہ کرو، اور اونٹنی کے دودھ سے وضو کیا کرو، اور بکری کے دودھ سے وضو نہ کرو، بکریوں کے باڑوں میں نماز پڑھو، اور اونٹ کے باڑوں میں نماز نہ پڑھو ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-497-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-497-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-497-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c3da","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":498,"bookHadithIndex":232,"text":"عبداللہ بن عباس رضی اللہ عنہما سے روایت ہے کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: دودھ پی کر کلی کر لیا کرو کیونکہ اس میں چکناہٹ ہوتی ہے ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-498-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-498-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-498-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-498-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Bukhari And Muslim"}]},{"id":"69b6c81fdd1a4c9c86f0c3db","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":499,"bookHadithIndex":233,"text":"ام المؤمنین ام سلمہ رضی اللہ عنہا سے روایت ہے کہ اللہ کے رسول صلی اللہ علیہ وسلم نے فرمایا: جب تم دودھ پیو تو کلی کر لیا کرو کیونکہ اس میں چکناہٹ ہوتی ہے ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-499-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-499-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-499-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c81fdd1a4c9c86f0c3dc","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":500,"bookHadithIndex":234,"text":"سہل بن سعد ساعدی رضی اللہ عنہ سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: دودھ پی کر کلی کر لیا کرو کیونکہ اس میں چکناہٹ ہوتی ہے ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-500-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-500-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-500-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c81fdd1a4c9c86f0c3dd","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":501,"bookHadithIndex":235,"text":"انس بن مالک رضی اللہ عنہ سے روایت ہے انہوں نے فرمایا کہ رسول اللہ صلی اللہ علیہ وسلم نے ایک بکری دودھ کر دودھ پیا، پھر پانی منگوا کر کلی کی اور فرمایا: اس میں چکناہٹ ہوتی ہے ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-501-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-501-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-501-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c3de","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":502,"bookHadithIndex":236,"text":"ام المؤمنین عائشہ رضی اللہ عنہا فرماتی ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے اپنی کسی بیوی کا بوسہ لیا، پھر نماز کے لیے نکلے اور وضو نہیں کیا، ( عروہ بن زبیر کہتے ہیں کہ ) میں نے ( ام المؤمنین عائشہ رضی اللہ عنہا سے ) کہا: وہ آپ ہی رہی ہوں گی! تو وہ ہنس پڑیں۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-502-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-502-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-502-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-502-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c3df","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":503,"bookHadithIndex":237,"text":"ام المؤمنین عائشہ رضی اللہ عنہا سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم وضو کرتے پھر بوسہ لیتے، اور بغیر وضو کئے نماز پڑھتے، اور بعض دفعہ آپ صلی اللہ علیہ وسلم نے میرے ساتھ بھی ایسا کیا ہے۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-503-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-503-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-503-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-503-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c3e0","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":504,"bookHadithIndex":238,"text":"علی رضی اللہ عنہ کہتے ہیں کہ رسول صلی اللہ علیہ وسلم سے مذی ۱؎ کے بارے میں پوچھا گیا، تو آپ نے فرمایا: اس میں وضو ہے، اور منی ۲؎ میں غسل ہے ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-504-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-504-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-504-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-504-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c3e1","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":505,"bookHadithIndex":239,"text":"مقداد بن اسود رضی اللہ عنہ کہتے ہیں کہ انہوں نے نبی اکرم صلی اللہ علیہ وسلم سے اس شخص کے متعلق سوال کیا جو اپنی بیوی سے قریب ہوتا ہے، اور اسے انزال نہیں ہوتا، تو آپ صلی اللہ علیہ وسلم نے فرمایا: جب ایسا ہو تو آدمی اپنی شرمگاہ پر پانی ڈال لے یعنی اسے دھو لے، اور وضو کر لے ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-505-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-505-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-505-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-505-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c3e2","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":506,"bookHadithIndex":240,"text":"سہل بن حنیف رضی اللہ عنہ کہتے ہیں کہ مجھے شدت سے مذی آتی تھی جس کی وجہ سے میں کثرت سے غسل کیا کرتا تھا، چنانچہ میں نے رسول اللہ صلی اللہ علیہ وسلم سے پوچھا تو آپ نے فرمایا: اس سے وضو کافی ہے ، میں نے پوچھا: اللہ کے رسول! جو کپڑے میں لگ جائے اس کا حکم کیا ہے؟ تو آپ صلی اللہ علیہ وسلم نے فرمایا: تم ایک چلو پانی لو، اور جہاں پہ دیکھو کہ مذی لگ گئی ہے وہاں پہ چھڑک دو، بس یہ تمہارے لیے کافی ہو گا ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-506-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-1-506-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-1-506-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-1-506-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c81fdd1a4c9c86f0c3e3","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":507,"bookHadithIndex":241,"text":"عبداللہ بن عباس رضی اللہ عنہما سے روایت ہے کہ وہ عمر رضی اللہ عنہ کے ہمراہ ابی بن کعب رضی اللہ عنہ کے ہاں گئے۔ وہ ( گھر سے ) باہر تشریف لائے۔ ( بات چیت کے دوران ان میں ابی نے ) فرمایا: مجھے مذی آ گئی تھی تو میں نے عضو خاص کو دھو کر وضو کیا ہے ( اس لیے باہر آنے میں دیر ہوئی ) عمر رضی اللہ عنہ نے فرمایا: کیا یہ ( وضو کر لینا ) کافی ہوتا ہے؟ انہوں نے کہا: جی ہاں! فرمایا: کیا آپ نے یہ مسئلہ رسول اللہ صلی اللہ علیہ وسلم سے ( خود ) سنا ہے؟ انہوں نے کہا: جی ہاں۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-507-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-507-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-507-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c3e4","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":508,"bookHadithIndex":242,"text":"عبداللہ بن عباس رضی اللہ عنہما فرماتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم رات میں بیدار ہوئے، بیت الخلاء گئے اور قضائے حاجت کی، پھر اپنے چہرے اور دونوں ہتھیلیوں کو دھویا، پھر سو گئے۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-508-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-508-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-508-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Bukhari And Muslim"}]},{"id":"69b6c81fdd1a4c9c86f0c3e5","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":509,"bookHadithIndex":243,"text":"انس بن مالک رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم ہر نماز کے لیے وضو کرتے تھے، اور ہم ساری نماز ایک وضو سے پڑھ لیا کرتے تھے","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-509-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-509-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-509-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari"}]},{"id":"69b6c81fdd1a4c9c86f0c3e6","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":510,"bookHadithIndex":244,"text":"بریدہ رضی اللہ عنہ فرماتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم ہر نماز کے لیے وضو کیا کرتے تھے، لیکن فتح مکہ کے دن آپ صلی اللہ علیہ وسلم نے ایک وضو سے ساری نماز پڑھیں ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-510-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-510-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-510-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-510-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c81fdd1a4c9c86f0c3e7","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":511,"bookHadithIndex":245,"text":"فضل بن مبشر کہتے ہیں کہ میں نے جابر بن عبداللہ رضی اللہ عنہما کو ایک ہی وضو سے کئی نماز پڑھتے دیکھا، تو میں نے کہا: یہ کیا ہے؟ عرض کیا: میں نے رسول اللہ صلی اللہ علیہ وسلم کو ایسا کرتے دیکھا ہے، چنانچہ میں بھی ویسے ہی کرتا ہوں جیسے رسول اللہ صلی اللہ علیہ وسلم نے کیا ہے ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-511-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-511-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-1-511-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-511-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c3e8","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":512,"bookHadithIndex":246,"text":"ابوغطیف ہذلی کہتے ہیں کہ میں نے مسجد میں عبداللہ بن عمر بن خطاب رضی اللہ عنہما سے ان کی مجلس میں سنا، پھر جب نماز کا وقت ہوا، تو وہ اٹھے وضو کیا، اور نماز ادا کی، پھر مجلس میں دوبارہ حاضر ہوئے، پھر جب عصر کا وقت آیا تو اٹھے وضو کیا، اور نماز پڑھی، پھر اپنی مجلس میں واپس آئے، پھر جب مغرب کا وقت ہوا تو اٹھے وضو کیا، اور نماز ادا کی پھر اپنی مجلس میں دوبارہ حاضر ہوئے تو میں نے کہا: اللہ آپ کو سلامت رکھے، کیا یہ وضو ( ہر نماز کے لیے ) فرض ہے یا سنت؟ کہا: کیا تم نے میرے اس کام کو سمجھ لیا اور یہ سمجھا ہے کہ یہ میں نے اپنی طرف سے کیا ہے؟ میں نے کہا: جی ہاں، بولے: نہیں، ( ہر نماز کے لیے وضو کرنا فرض نہیں ) اگر میں نماز فجر کے لیے وضو کرتا تو اس سے وضو نہ ٹوٹنے تک ساری نماز پڑھتا، لیکن میں نے رسول اللہ صلی اللہ علیہ وسلم کو فرماتے ہوئے سنا ہے: جس شخص نے وضو ہوتے ہوئے وضو کیا، تو اس کے لیے دس نیکیاں ہیں ، اور مجھ کو ان نیکیوں ہی کا شوق ہے۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-512-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-512-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-512-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-1-512-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c81fdd1a4c9c86f0c3e9","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":513,"bookHadithIndex":247,"text":"عباد بن تمیم کے چچا عبداللہ بن زید بن عاصم انصاری رضی اللہ عنہ کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم کے پاس اس شخص کا معاملہ لے جایا گیا جس نے نماز میں ( حدث کا ) شبہ محسوس کیا، آپ صلی اللہ علیہ وسلم نے فرمایا: نہیں، شک و شبہ سے وضو نہیں ٹوٹتا جب تک کہ وہ گوز کی آواز نہ سن لے، یا بو نہ محسوس کرے ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-513-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-513-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-513-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Bukhari And Muslim"}]},{"id":"69b6c81fdd1a4c9c86f0c3ea","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":514,"bookHadithIndex":248,"text":"ابو سعید خدری رضی اللہ عنہ کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم سے نماز میں حدث کا شبہ ہو جانے کے متعلق پوچھا گیا تو آپ صلی اللہ علیہ وسلم نے فرمایا: جب تک کہ آواز نہ سن لے یا بو نہ محسوس کر لے نماز نہ توڑے ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-514-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-514-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-1-514-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-1-514-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c81fdd1a4c9c86f0c3eb","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":515,"bookHadithIndex":249,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: بغیر آواز یا بو کے وضو واجب نہیں ہے ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-515-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-515-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-515-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-515-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c81fdd1a4c9c86f0c3ec","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":1,"hadithIndex":516,"bookHadithIndex":250,"text":"محمد بن عمرو بن عطاء کہتے ہیں کہ میں نے سائب بن یزید رضی اللہ عنہما کو اپنا کپڑا سونگھتے دیکھا، میں نے پوچھا: اس کا سبب کیا ہے؟ تو انہوں نے کہا کہ میں نے رسول اللہ صلی اللہ علیہ وسلم کو فرماتے سنا: بغیر بو سونگھے یا آواز سنے وضو واجب نہیں ہے ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-1-516-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-1-516-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-1-516-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-1-516-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]}]}
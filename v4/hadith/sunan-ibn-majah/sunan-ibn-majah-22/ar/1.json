          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc7f",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 22,
      "hadithIndex": 2711,
      "bookHadithIndex": 17,
      "text": "حدثنا علي بن محمد، حدثنا وكيع، عن هشام بن عروة، عن ابيه، عن ابن عباس، قال وددت ان الناس، غضوا من الثلث الى الربع لان رسول الله صلى الله عليه وسلم قال \" الثلث كبير - او كثير",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2711-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2711-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2711-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2711-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc80",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 22,
      "hadithIndex": 2712,
      "bookHadithIndex": 18,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا يزيد بن هارون، انبانا سعيد بن ابي عروبة، عن قتادة، عن شهر بن حوشب، عن عبد الرحمن بن غنم، عن عمرو بن خارجة، ان النبي صلى الله عليه وسلم خطبهم وهو على راحلته وان راحلته لتقصع بجرتها وان لغامها ليسيل بين كتفى قال \" ان الله قسم لكل وارث نصيبه من الميراث فلا يجوز لوارث وصية الولد للفراش وللعاهر الحجر ومن ادعى الى غير ابيه او تولى غير مواليه فعليه لعنة الله والملايكة والناس اجمعين لا يقبل منه صرف ولا عدل \" . او قال \" عدل ولا صرف",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2712-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2712-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2712-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2712-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc81",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 22,
      "hadithIndex": 2713,
      "bookHadithIndex": 19,
      "text": "حدثنا هشام بن عمار، حدثنا اسماعيل بن عياش، حدثنا شرحبيل بن مسلم الخولاني، سمعت ابا امامة الباهلي، يقول سمعت رسول الله صلى الله عليه وسلم يقول في خطبته عام حجة الوداع \" ان الله قد اعطى كل ذي حق حقه فلا وصية لوارث",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2713-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2713-muhammadfouadabdalbaqi",

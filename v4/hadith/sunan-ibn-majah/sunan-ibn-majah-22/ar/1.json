          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2716-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2716-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc85",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 22,
      "hadithIndex": 2717,
      "bookHadithIndex": 23,
      "text": "حدثنا اسحاق بن منصور، حدثنا ابو اسامة، عن هشام بن عروة، عن ابيه، عن عايشة، ان رجلا، اتى النبي صلى الله عليه وسلم فقال ان امي افتلتت نفسها ولم توص واني اظنها لو تكلمت لتصدقت فلها اجر ان تصدقت عنها ولي اجر فقال \" نعم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2717-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"

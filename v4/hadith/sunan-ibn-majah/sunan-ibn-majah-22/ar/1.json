  "items": [
    {
      "id": "69b6c88cdd1a4c9c86f0cc6f",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 22,
      "hadithIndex": 2695,
      "bookHadithIndex": 1,
      "text": "حدثنا محمد بن عبد الله بن نمير، حدثنا ابي وابو معاوية ح وحدثنا ابو بكر بن ابي شيبة، وعلي بن محمد، قالا حدثنا ابو معاوية، - قال ابو بكر وعبد الله بن نمير - عن الاعمش، عن شقيق، عن مسروق، عن عايشة، قالت ما ترك رسول الله صلى الله عليه وسلم دينارا ولا درهما ولا شاة ولا بعيرا ولا اوصى بشىء",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2695-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2695-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2695-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc70",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 22,
      "hadithIndex": 2696,
      "bookHadithIndex": 2,
      "text": "حدثنا علي بن محمد، حدثنا وكيع، عن مالك بن مغول، عن طلحة بن مصرف، قال قلت لعبد الله بن ابي اوفى اوصى رسول الله صلى الله عليه وسلم بشىء قال لا . قلت فكيف امر المسلمين بالوصية قال اوصى بكتاب الله . قال مالك وقال طلحة بن مصرف قال الهزيل بن شرحبيل ابو بكر كان يتامر على وصي رسول الله صلى الله عليه وسلم ود ابو بكر انه وجد من رسول الله صلى الله عليه وسلم عهدا فخزم انفه بخزام",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2696-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2696-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2696-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2696-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc71",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 22,
      "hadithIndex": 2697,
      "bookHadithIndex": 3,
      "text": "حدثنا احمد بن المقدام، حدثنا المعتمر بن سليمان، سمعت ابي يحدث، عن قتادة، عن انس بن مالك، قال كانت عامة وصية رسول الله صلى الله عليه وسلم حين حضرته الوفاة وهو يغرغر بنفسه \" الصلاة وما ملكت ايمانكم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2697-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2697-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2697-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2697-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc72",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 22,
      "hadithIndex": 2698,
      "bookHadithIndex": 4,
      "text": "حدثنا سهل بن ابي سهل، حدثنا محمد بن فضيل، عن مغيرة، عن ام موسى، عن علي بن ابي طالب، قال كان اخر كلام النبي صلى الله عليه وسلم \" الصلاة وما ملكت ايمانكم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2698-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2698-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2698-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih Lighairihi"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2698-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc73",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 22,
      "hadithIndex": 2699,
      "bookHadithIndex": 5,
      "text": "حدثنا علي بن محمد، حدثنا عبد الله بن نمير، عن عبيد الله بن عمر، عن نافع، عن ابن عمر، قال قال رسول الله صلى الله عليه وسلم \" ما حق امري مسلم ان يبيت ليلتين وله شىء يوصي فيه الا ووصيته مكتوبة عنده",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2699-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2699-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2699-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc74",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 22,
      "hadithIndex": 2700,
      "bookHadithIndex": 6,
      "text": "حدثنا نصر بن علي الجهضمي، حدثنا درست بن زياد، حدثنا يزيد الرقاشي، عن انس بن مالك، قال قال رسول الله صلى الله عليه وسلم \" المحروم من حرم وصيته",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2700-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2700-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2700-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2700-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc75",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 22,
      "hadithIndex": 2701,
      "bookHadithIndex": 7,
      "text": "حدثنا محمد بن المصفى الحمصي، حدثنا بقية بن الوليد، عن يزيد بن عوف، عن ابي الزبير، عن جابر بن عبد الله، قال قال رسول الله صلى الله عليه وسلم \" من مات على وصية مات على سبيل وسنة ومات على تقى وشهادة ومات مغفورا له",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2701-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2701-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2701-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Very Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2701-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc76",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 22,
      "hadithIndex": 2702,
      "bookHadithIndex": 8,
      "text": "حدثنا محمد بن معمر، حدثنا روح بن عوف، عن نافع، عن ابن عمر، عن النبي صلى الله عليه وسلم قال \" ما حق امري مسلم يبيت ليلتين وله شىء يوصي به الا ووصيته مكتوبة عنده",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2702-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2702-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2702-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc77",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 22,
      "hadithIndex": 2703,
      "bookHadithIndex": 9,
      "text": "حدثنا سويد بن سعيد، حدثنا عبد الرحيم بن زيد العمي، عن ابيه، عن انس بن مالك، قال قال رسول الله صلى الله عليه وسلم \" من فر من ميراث وارثه قطع الله ميراثه من الجنة يوم القيامة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2703-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2703-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2703-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc78",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 22,
      "hadithIndex": 2704,
      "bookHadithIndex": 10,
      "text": "حدثنا احمد بن الازهر، حدثنا عبد الرزاق بن همام، انبانا معمر، عن اشعث بن عبد الله، عن شهر بن حوشب، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" ان الرجل ليعمل بعمل اهل الخير سبعين سنة فاذا اوصى حاف في وصيته فيختم له بشر عمله فيدخل النار وان الرجل ليعمل بعمل اهل الشر سبعين سنة فيعدل في وصيته فيختم له بخير عمله فيدخل الجنة \" . قال ابو هريرة واقرءوا ان شيتم {تلك حدود الله} الى قوله {عذاب مهين}",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2704-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2704-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2704-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc79",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 22,
      "hadithIndex": 2705,
      "bookHadithIndex": 11,
      "text": "حدثنا يحيى بن عثمان بن سعيد بن كثير بن دينار الحمصي، حدثنا بقية، عن ابي حلبس، عن خليد بن ابي خليد، عن معاوية بن قرة، عن ابيه، قال قال رسول الله صلى الله عليه وسلم \" من حضرته الوفاة فاوصى وكانت وصيته على كتاب الله كانت كفارة لما ترك من زكاته في حياته",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2705-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2705-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2705-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Very Daif"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc7a",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 22,
      "hadithIndex": 2706,
      "bookHadithIndex": 12,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا شريك، عن عمارة بن القعقاع، وابن، شبرمة عن ابي زرعة، عن ابي هريرة، قال جاء رجل الى النبي صلى الله عليه وسلم فقال يا رسول الله نبيني باحق الناس مني بحسن الصحبة فقال \" نعم وابيك لتنبان امك \" . قال ثم من قال \" ثم امك \" . قال ثم من قال \" ثم امك \" . قال ثم من قال \" ثم ابوك \" . قال نبيني يا رسول الله عن مالي كيف اتصدق فيه قال \" نعم والله لتنبان ان تصدق وانت صحيح شحيح تامل العيش وتخاف الفقر ولا تمهل حتى اذا بلغت نفسك هاهنا قلت مالي لفلان ومالي لفلان وهو لهم وان كرهت",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2706-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2706-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2706-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2706-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc7b",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 22,
      "hadithIndex": 2707,
      "bookHadithIndex": 13,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا يزيد بن هارون، انبانا حريز بن عثمان، حدثني عبد الرحمن بن ميسرة، عن جبير بن نفير، عن بسر بن جحاش القرشي، قال بزق النبي صلى الله عليه وسلم في كفه ثم وضع اصبعه السبابة وقال \" يقول الله عز وجل انى تعجزني ابن ادم وقد خلقتك من مثل هذه فاذا بلغت نفسك هذه - واشار الى حلقه - قلت اتصدق وانى اوان الصدقة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2707-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2707-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2707-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2707-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Sahih"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc7c",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 22,
      "hadithIndex": 2708,
      "bookHadithIndex": 14,
      "text": "حدثنا هشام بن عمار، والحسين بن الحسن المروزي، وسهل، قالوا حدثنا سفيان بن عيينة، عن الزهري، عن عامر بن سعد، عن ابيه، قال مرضت عام الفتح حتى اشفيت على الموت فعادني رسول الله صلى الله عليه وسلم فقلت اى رسول الله ان لي مالا كثيرا وليس يرثني الا ابنتي افاتصدق بثلثى مالي قال \" لا \" . قلت فالشطر قال \" لا \" . قلت فالثلث قال \" الثلث والثلث كثير انك ان تترك ورثتك اغنياء خير من ان تتركهم عالة يتكففون الناس",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2708-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2708-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2708-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2708-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c88cdd1a4c9c86f0cc7d",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 22,
      "hadithIndex": 2709,
      "bookHadithIndex": 15,
      "text": "حدثنا علي بن محمد، حدثنا وكيع، عن طلحة بن عمرو، عن عطاء، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" ان الله تصدق عليكم عند وفاتكم بثلث اموالكم زيادة لكم في اعمالكم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2709-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-22-2709-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Hasan"
        },
        {

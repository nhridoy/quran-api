    {
      "id": "69b6c81fdd1a4c9c86f0c500",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 4,
      "hadithIndex": 792,
      "bookHadithIndex": 58,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا ابو اسامة، عن زايدة، عن عاصم، عن ابي رزين، عن ابن ام مكتوم، قال قلت للنبي صلى الله عليه وسلم اني كبير ضرير شاسع الدار وليس لي قايد يلاومني فهل تجد لي من رخصة قال \" هل تسمع النداء \" . قلت نعم . قال \" ما اجد لك رخصة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-792-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-792-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-792-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-792-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c81fdd1a4c9c86f0c501",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 4,
      "hadithIndex": 793,
      "bookHadithIndex": 59,
      "text": "حدثنا عبد الحميد بن بيان الواسطي، انبانا هشيم، عن شعبة، عن عدي بن ثابت، عن سعيد بن جبير، عن ابن عباس، عن النبي صلى الله عليه وسلم قال \" من سمع النداء فلم ياته فلا صلاة له الا من عذر",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-793-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-793-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-793-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c81fdd1a4c9c86f0c502",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 4,
      "hadithIndex": 794,
      "bookHadithIndex": 60,
      "text": "حدثنا علي بن محمد، حدثنا ابو اسامة، عن هشام الدستوايي، عن يحيى بن ابي كثير، عن الحكم بن ميناء، اخبرني ابن عباس، وابن، عمر انهما سمعا النبي صلى الله عليه وسلم يقول على اعواده \" لينتهين اقوام عن ودعهم الجماعات او ليختمن الله على قلوبهم ثم ليكونن من الغافلين",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-794-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-794-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-794-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-794-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c81fdd1a4c9c86f0c503",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 4,
      "hadithIndex": 795,
      "bookHadithIndex": 61,
      "text": "حدثنا عثمان بن اسماعيل الهذلي الدمشقي، حدثنا الوليد بن مسلم، عن ابن ابي ذيب، عن الزبرقان بن عمرو الضمري، عن اسامة بن زيد، قال قال رسول الله صلى الله عليه وسلم \" لينتهين رجال عن ترك الجماعة او لاحرقن بيوتهم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-795-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-795-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-795-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c81fdd1a4c9c86f0c504",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 4,
      "hadithIndex": 796,
      "bookHadithIndex": 62,
      "text": "حدثنا عبد الرحمن بن ابراهيم الدمشقي، حدثنا الوليد بن مسلم، حدثنا الاوزاعي، حدثنا يحيى بن ابي كثير، حدثني محمد بن ابراهيم التيمي، حدثني عيسى بن طلحة، حدثتني عايشة، قالت قال رسول الله صلى الله عليه وسلم \" لو يعلم الناس ما في صلاة العشاء وصلاة الفجر لاتوهما ولو حبوا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-796-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"

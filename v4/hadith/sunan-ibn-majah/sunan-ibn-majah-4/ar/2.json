    {
      "id": "69b6c81fdd1a4c9c86f0c4fb",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 4,
      "hadithIndex": 787,
      "bookHadithIndex": 53,
      "text": "حدثنا ابو مروان، محمد بن عثمان العثماني حدثنا ابراهيم بن سعد، عن ابن شهاب، عن سعيد بن المسيب، عن ابي هريرة، ان رسول الله صلى الله عليه وسلم قال \" فضل الجماعة على صلاة احدكم وحده خمس وعشرون جزءا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-787-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-787-muhammadfouadabdalbaqi",

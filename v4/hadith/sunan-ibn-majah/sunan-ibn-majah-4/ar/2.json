          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-788-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-788-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c81fdd1a4c9c86f0c4fd",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 4,
      "hadithIndex": 789,
      "bookHadithIndex": 55,
      "text": "حدثنا عبد الرحمن بن عمر، رسته حدثنا يحيى بن سعيد، حدثنا عبيد الله بن عمر، عن نافع، عن ابن عمر، قال قال رسول الله صلى الله عليه وسلم \" صلاة الرجل في جماعة تفضل على صلاة الرجل وحده بسبع وعشرين درجة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-789-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-789-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-789-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-789-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c81fdd1a4c9c86f0c4fe",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 4,
      "hadithIndex": 790,
      "bookHadithIndex": 56,
      "text": "حدثنا محمد بن معمر، حدثنا ابو بكر الحنفي، حدثنا يونس بن ابي اسحاق، عن ابيه، عن عبد الله بن ابي بصير، عن ابيه، عن ابى بن كعب، قال قال رسول الله صلى الله عليه وسلم \" صلاة الرجل في جماعة تزيد على صلاة الرجل وحده اربعا وعشرين او خمسا وعشرين درجة",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-790-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-790-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-790-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Hasan"
        }
      ]
    },
    {
      "id": "69b6c81fdd1a4c9c86f0c4ff",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 4,
      "hadithIndex": 791,
      "bookHadithIndex": 57,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا ابو معاوية، عن الاعمش، عن ابي صالح، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" لقد هممت ان امر بالصلاة فتقام ثم امر رجلا فيصلي بالناس ثم انطلق برجال معهم حزم من حطب الى قوم لا يشهدون الصلاة فاحرق عليهم بيوتهم بالنار",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-4-791-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"

{"total":65,"totalPage":2,"page":1,"pageSize":50,"items":[{"id":"69b6c8bfdd1a4c9c86f0cf13","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3371,"bookHadithIndex":1,"text":"। আবূ দারদা (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমার বন্ধু (নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম) আমাকে উপদেশ দিয়েছেনঃ শরাব পান করো না, কারণ তা সমস্ত পাপাচারের প্রসূতি।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3371-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3371-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3371-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3371-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf14","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3372,"bookHadithIndex":2,"text":"। খাব্বাব ইবনুল আরাত্তি (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ সাবধান! শরাব পরিহার করো। কারণ শরাবের পাপ অন্যান্য পাপাচারকে আওতাভুক্ত করে নেয়, যেমন তার গাছ (আংগুর গাছ) অন্যান্য গাছের উপর বিস্তারিত হয়।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3372-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3372-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3372-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3372-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cf15","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3373,"bookHadithIndex":3,"text":"। ইবনে উমার (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যে ব্যক্তি দুনিয়াতে শরাব পান করলো, সে তা থেকে তওবা না করলে, আখেরাতে তা পান করতে পারবে না।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3373-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3373-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3373-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3373-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf16","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3374,"bookHadithIndex":4,"text":"। আবু হুরায়রা (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যে ব্যক্তি দুনিয়াতে শরাব পান করে, সে আখেরাতে তা পান করতে পারবে না।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3374-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3374-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3374-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf17","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3375,"bookHadithIndex":5,"text":"। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ শরাবখোর (পাপের ক্ষেত্রে) মূর্তিপূজকের সমতুল্য।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3375-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3375-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3375-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf18","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3376,"bookHadithIndex":6,"text":"। আবূ দারদা (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ শরাব পানে অভ্যস্ত ব্যক্তি জান্নাতে প্রবেশ করতে পারবে না।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3376-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3376-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3376-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf19","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3377,"bookHadithIndex":7,"text":"। ‘আবদুল্লাহ ইবনে ‘আমর (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ যে ব্যক্তি শরাব পান করে এবং মাতাল হয়, চল্লিশ দিন পর্যন্ত তার নামায কবুল হয় না। সে মারা গেলে জাহান্নামে প্রবেশ করবে। আর যদি সে তওবা করে, তবে আল্লাহ তা‘আলা তার তওবা কবুল করবেন। সে পুনরায় শরাব পানে লিপ্ত হলে কিয়ামতের দিন অল্লাহ তা‘আলা অবশ্যি তাকে ‘‘রাদগাতুল খাবাল’’ পান করাবেন। সাহাবীগণ জিজ্ঞেস করেন, ইয়া রাসূলাল্লাহ! ‘রাদগাতুল খাবাল’ কী? তিনি বলেনঃ জাহান্নামীদের দেহ থেকে নির্গত পুঁজ ও রক্ত।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3377-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3377-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3377-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3377-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf1a","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3378,"bookHadithIndex":8,"text":"। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ শরাব এই দু’টি গাছ থেকে তৈরি হয়ঃ খেজুর গাছ ও আংগুর গাছ।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3378-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3378-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3378-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf1b","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3379,"bookHadithIndex":9,"text":"। নু'মান ইবনে বাশীর (রাঃ) বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ গম থেকে শরাব হয়, বার্লি থেকে শরাব হয়, আংগুর থেকে শরাব হয়, খেজুর থেকে শরাব হয় এবং মধু থেকে শরাব হয়।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3379-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3379-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3379-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf1c","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3380,"bookHadithIndex":10,"text":"। ইবনে উমার (রাঃ) বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ শরাবের উপর দশভাবে অভিসম্পাত করা হয়েছেঃ স্বয়ং শরাব (অভিশপ্ত), শরাব উৎপাদক, যে তা উৎপাদন করায়, তার বিক্রেতা, তার ক্রেতা, তার বহনকারী, তা যার জন্য বহন করা হয়, এর মূল্য ভোগকারী, তা পানকারী ও তা পরিবেশনকারী (এদের সকলেই অভিশপ্ত)।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3380-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3380-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3380-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3380-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf1d","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3381,"bookHadithIndex":11,"text":"। আনাস ইবনে মালেক (রাঃ) বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম দশভাবে শরাবের উপর অভিসম্পাত করেছেনঃ শরাব প্রস্তুতকারী, তা উৎপাদনকারী, যে তা উৎপাদন করায়, তা যার জন্য উৎপাদন করা হয়, তা বহনকারী, যার জন্য তা বহন করা হয়, তার বিক্রেতা, তার ক্রেতা, তা পরিবেশনকারী এবং যার জন্য পরিবেশন করা হয়। এভাবে তিনি দশজনের উল্লেখ করেছেন।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3381-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3381-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3381-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3381-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf1e","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3382,"bookHadithIndex":12,"text":"। আয়েশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, যখন সুদ সম্পর্কিত সূরা বাকারার শেষ আয়াতগুলো নাযিল হয়, তখন রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বাইরে বের হয়ে আসেন এবং শরাবের ব্যবসাও নিষিদ্ধ (হারাম) ঘোষণা করেন।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3382-alalbani","name":"Al-Albani","grade":"Sahih Hadith"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3382-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3382-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3382-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0cf1f","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3383,"bookHadithIndex":13,"text":"। ইবনে আব্বাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, সামুরা (রাঃ) শরাব বিক্রয় করেন এ কথা উমার (রাঃ) জানতে পেরে বললেন, আল্লাহ সামুরাকে ধ্বংস করুনঃ সে কি জানে না যে, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ ‘‘আল্লাহ তা‘আলা ইহূদীদের অভিসম্পাত করুন, তাদের প্রতি চর্বি হারাম করা হয়েছিল; কিন্তু তারা তা গলিয়ে বিক্রয় করতো’’।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3383-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3383-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3383-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3383-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0cf20","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3384,"bookHadithIndex":14,"text":"। আবূ উমামা আল-বাহিলী (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ এমন কোন রাত এবং দিন অতিবাহিত হবে না, যখন আমার উম্মাতের কতক লোক শরাবের ভিন্ন নামকরণ করে তা পান করবে না।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3384-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3384-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3384-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3384-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf21","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3385,"bookHadithIndex":15,"text":"। উবাদা ইবনুস সামিত (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ আমার উম্মাতের কতক লোক শরাবের ভিন্নতর নাম রেখে তা পান করবে।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3385-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3385-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3385-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf22","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3386,"bookHadithIndex":16,"text":"। আয়েশা (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ নেশা উদ্রেককর প্রতিটি পানীয় হারাম।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3386-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3386-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3386-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3386-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0cf23","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3387,"bookHadithIndex":17,"text":"। আবদুল্লাহ ইবনে উমার (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ প্রতিটি নেশা উদ্রেককর জিনিস হারাম।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3387-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3387-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3387-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3387-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf24","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3388,"bookHadithIndex":18,"text":"। ইবনে মাসউদ (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ প্রতিটি নেশা উদ্রেককর জিনিস হারাম।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3388-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3388-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3388-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3388-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf25","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3389,"bookHadithIndex":19,"text":"। মু‘আবিয়া (রাঃ) বলেন, আমি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কে বলতে শুনেছিঃ প্রতিটি নেশা উদ্রেককর জিনিস প্রত্যেক মুমিন ব্যক্তির জন্য হারাম।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3389-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3389-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3389-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cf26","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3390,"bookHadithIndex":20,"text":"। উমার (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ প্রতিটি নেশা উদ্রেককর জিনিস শরাবের অন্তর্ভুক্ত এবং যে কোন শরাবই হারাম।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3390-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3390-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3390-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf27","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3391,"bookHadithIndex":21,"text":"। আবূ মূসা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ নেশা সৃষ্টিকারী প্রতিটি জিনিস হারাম।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3391-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3391-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3391-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3391-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0cf28","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3392,"bookHadithIndex":22,"text":"। আবদুল্লাহ ইবনে উমার (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ যে কোন নেশা উদ্রেককর জিনিস হারাম। আর যে জিনিসের অধিক পরিমাণ নেশা সৃষ্টি করে, তার সামান্য পরিমাণও হারাম।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3392-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3392-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3392-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf29","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3393,"bookHadithIndex":23,"text":"। জাবির ইবনে আবদুল্লাহ (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যে জিনিসের অধিক পরিমাণ নেশা উদ্রেক করে, তার সামান্য পরিমাণও হারাম।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3393-alalbani","name":"Al-Albani","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3393-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3393-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3393-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf2a","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3394,"bookHadithIndex":24,"text":"। ‘আমর ইবনে শু‘আয়ব (রাঃ) থেকে পর্যায়ক্রমে তার পিতা ও তার দাদার সূত্রে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যে জিনিসের অধিক পরিমাণ নেশা সৃষ্টি করে, তার সামান্য পরিমাণও হারাম।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3394-alalbani","name":"Al-Albani","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3394-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3394-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3394-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf2b","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3395,"bookHadithIndex":25,"text":"। জাবির ইবনে আবদুল্লাহ (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম খেজুর ও আংগুর একত্রে ভিজিয়ে নবীয তৈরি করতে নিষেধ করেছেন এবং পাকা খেজুর ও কাঁচা খেজুর একত্রে মিশিয়ে নবীয তৈরি করতেও নিষেধ করেছেন।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3395-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3395-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3395-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3395-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf2c","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3396,"bookHadithIndex":26,"text":"। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ তোমরা কাঁচা খেজুর ও শুকনা খেজুর একত্রে ভিজিয়ে নবীয তৈরি করো না, তবে এর প্রতিটি পৃথকভাবে ভিজিয়ে নবীয তৈরি করতে পার।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3396-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3396-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3396-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3396-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf2d","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3397,"bookHadithIndex":27,"text":"। আবদুল্লাহ ইবনে আবূ কাতাদা (রাঃ) থেকে তার পিতার সূত্রে বর্ণিত। তিনি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লামকে বলতে শুনেছেনঃ কাঁচা খেজুর ও পাকা খেজুর একত্রে মিশাবে না এবং খেজুর ও আংগুরও একত্রে মিশাবে না। তবে এর প্রতিটি পৃথকভাবে ভিজিয়ে নবীয তৈরি করতে পারো।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3397-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3397-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3397-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3397-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0cf2e","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3398,"bookHadithIndex":28,"text":"। আয়েশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমরা রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর জন্য একটি পাত্রে নবীয বানাতাম। আমরা এক মুঠো খেজুর অথবা এক মুঠো আংগুর তুলে নিয়ে পাত্রের মধ্যে ছেড়ে দিতাম, অতঃপর তাতে পানি ঢেলে দিতাম। আমরা সকালবেলা তা ভিজাতাম এবং তিনি সন্ধ্যাবেলা তা পান করতেন। আবার কখনও আমরা সন্ধ্যাবেলা তা ভিজাতাম এবং তিনি সকালবেলা তা পান করতেন। আবূ মুআবিয়া (রাঃ) তার বর্ণনায় বলেন, দিনে ভিজাতেন এবং তিনি রাতের বেলা তা পান করতেন অথবা রাতের বেলা ভিজাতেন এবং তিনি দিনের বেলা তা পান করতেন।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3398-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3398-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3398-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3398-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cf2f","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3399,"bookHadithIndex":29,"text":"। ইবনে আব্বাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর জন্য নবীয তৈরি করা হতো এবং তিনি তা ঐ দিন অথবা পরের দিন সকাল অথবা তৃতীয় দিন পর্যন্ত পান করতেন। পান করার পর এর কিছু অবশিষ্ট থাকলে তিনি তা ঢেলে ফেলে দিতেন অথবা ঢেলে ফেলার নির্দেশ দিতেন।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3399-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3399-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3399-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf30","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3400,"bookHadithIndex":30,"text":"। জাবির ইবনে আবদুল্লাহ (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর জন্য একটি পাথরের পাত্রে নবীয তৈরি করা হতো।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3400-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3400-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3400-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3400-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf31","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3401,"bookHadithIndex":31,"text":"। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কাঠের পাত্রে, তৈলাক্ত পাত্রে, কদুর খোলের পাত্রে ও মাটির সবুজ পাত্রে নবীয তৈরি করতে নিষেধ করেছেন। তিনি আরও বলেনঃ সমস্ত নেশা সৃষ্টিকর জিনিস হারাম।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3401-alalbani","name":"Al-Albani","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3401-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3401-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3401-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf32","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3402,"bookHadithIndex":32,"text":"। ইবনে উমার (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম তৈলাক্ত পাত্রে ও কদুর খোলে নবীয তৈর করতে নিষেধ করেছেন।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3402-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3402-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3402-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3402-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf33","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3403,"bookHadithIndex":33,"text":"। আবূ সাঈদ খুদরী (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম মাটির সবুজ পাত্রে, কদুর খোলে ও কাঠের পাত্রে পান করতে নিষেধ করেছেন।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3403-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3403-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3403-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3403-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf34","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3404,"bookHadithIndex":34,"text":"। আবদুর রহমান ইবনে ইয়ামার (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কদুর খোল ও মাটির সবুজ পাত্র ব্যবহার করতে নিষেধ করেছেন।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3404-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3404-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3404-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3404-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf35","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3405,"bookHadithIndex":35,"text":"। আবদুল্লাহ ইবনে বুরাইদা (রহঃ) থেকে তার পিতার সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ আমি তোমাদেরকে কতগুলো পাত্র ব্যবহার করতে নিষেধ করেছিলাম। এখন তোমরা তাতে নবীয তৈরি করতে পারো এবং সমস্ত নেশা উদ্রেককারী জিনিস পরিহার করো।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3405-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3405-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3405-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf36","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3406,"bookHadithIndex":36,"text":"। ইবনে মাসউদ (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ আমি কতকগুলো পাত্রে নবীয তৈরি করতে তোমাদের নিষেধ করেছিলাম। জেনে রাখো! পাত্র কোন জিনিসকে হারাম করে না। তবে সকল নেশাকর দ্রব্যই হারাম।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3406-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3406-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3406-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3406-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf37","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3407,"bookHadithIndex":37,"text":"। আয়েশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, তোমাদের মধ্যে কোন মহিলা কি প্রতি বছর তার কোরবানীর পশুর চামড়া দিয়ে একটি মশক বানাতে সক্ষম নয়? তিনি পুনরায় বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম মাটির কলসে এবং এরূপ এরূপ পাত্রে নবীয তৈরি করতে নিষেধ করেছেন, অবশ্য সিরকা বানানো যেতে পারে।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3407-alalbani","name":"Al-Albani","grade":"Daif Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3407-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3407-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3407-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cf38","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3408,"bookHadithIndex":38,"text":"। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম মাটির কলসে নবীয বানাতে নিষেধ করেছেন।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3408-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3408-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3408-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3408-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf39","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3409,"bookHadithIndex":39,"text":"। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর নিকট মাটির কলসে প্রস্তুত নবীয নিয়ে আসা হলো, যাতে মাদকতা সৃষ্টি হয়েছিলা। তিনি বলেনঃ কলসটা ঐ দেয়ালের উপর নিক্ষেপ করো। কারণ তা কেবল সেইসব লোক পান করতে পারে যাদের আল্লাহ ও আখেরাতের দিনের প্রতি ঈমান নাই।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3409-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3409-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3409-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf3a","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3410,"bookHadithIndex":40,"text":"। জাবির ইবনে আবদুল্লাহ (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ তোমরা খাদ্য ও পানীয় পাত্র ঢেকে রাখো, মশকের মুখ বন্ধ করো, প্রদীপ নিভিয়ে দাও এবং (শয়নকালে) ঘরের দরজা বন্ধ করো। কারণ শয়তান (মুখবন্ধ) মশক খুলতে পারে না, (বন্ধ) দরজাও খুলতে পারে না এবং (ঢেকে রাখা) পাত্রও খুলতে পারে না। তোমাদের কেউ যদি পাত্র ঢাকার মত কিছু না পায় তবে সে যেন তার উপর একটি কাঠ আড়াআড়িভাবে রেখে দেয় এবং আল্লাহর নাম স্মরণ করে। কেননা ইঁদুর মানুষের ঘর জ্বালিয়ে দেয়।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3410-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3410-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3410-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3410-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf3b","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3411,"bookHadithIndex":41,"text":"। অবু হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম পাত্র ঢেকে রাখতে, মশকের মুখ বন্ধ করতে এবং খালি পাত্র উপুড় করে রাখতে আমাদের নির্দেশ দিয়েছেন।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3411-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3411-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3411-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3411-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf3c","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3412,"bookHadithIndex":42,"text":"। আয়েশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর জন্য রাতের বেলা তিনটি পাত্র রাখতাম এবং তিনটিই ঢেকে রাখতাম। একটি তাঁর পবিত্রতা অর্জনের জন্য, একটি তাঁর মিসওয়াকের জন্য একটি তাঁর পান করার জন্য।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3412-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3412-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3412-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3412-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cf3d","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3413,"bookHadithIndex":43,"text":"। উম্মু সালামা (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যে ব্যক্তি রূপার পাত্রে পান করে, সে নিজের পেটে গড় গড় করে জাহান্নামের আগুন ঢালে।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3413-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3413-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3413-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3413-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0cf3e","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3414,"bookHadithIndex":44,"text":"। হুযায়ফা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম সোনা ও রূপার পাত্রে পান করতে নিষেধ করেছেন এবং বলেছেনঃ তা দুনিয়াতে তাদের (কাফিরদের) জন্য এবং তোমাদের জন্য আখেরাতে।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3414-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3414-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3414-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3414-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0cf3f","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3415,"bookHadithIndex":45,"text":"। আয়েশা (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যে ব্যক্তি রূপার পাত্রে পান করে, সে নিজের পেটে গড় গড় করে জাহান্নামের আগুন ঢালে।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3415-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3415-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3415-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3415-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf40","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3416,"bookHadithIndex":46,"text":"। আনাস (রাঃ) থেকে বর্ণিত। তিনি তিন নিঃশ্বাসে পানি পান করতেন। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম তিন নিঃশ্বাসে পানি পান করতেন।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3416-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3416-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3416-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3416-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0cf41","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3417,"bookHadithIndex":47,"text":"। ইবনে আব্বাস (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম পানি পান করলেন এবং পানের সময় দু’বার নিঃশ্বাস নিলেন।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3417-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3417-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3417-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3417-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cf42","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3418,"bookHadithIndex":48,"text":"। আবূ সাঈদ খুদরী (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম মশকের মুখ উল্টিয়ে তাতে মুখ লাগিয়ে পান করতে নিষেধ করেছেন।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3418-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3418-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3418-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3418-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0cf43","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3419,"bookHadithIndex":49,"text":"। ইবনে আব্বাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম মশকের মুখ উল্টিয়ে পানি পান করতে নিষেধ করেছেন। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর এ নিষেধাজ্ঞার পর এক ব্যক্তি রাতের বেলা উঠে পাত্রের মুখ উল্টে পানি পান করতে গেলে তৎক্ষণাৎ তা থেকে একটি সাপ বের হয়ে আসে।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3419-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3419-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3419-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3419-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cf44","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3420,"bookHadithIndex":50,"text":"। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম মশকের মুখে মুখ লাগিয়ে পানি পান করতে নিষেধ করেছেন।","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3420-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3420-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3420-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3420-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari"}]}]}
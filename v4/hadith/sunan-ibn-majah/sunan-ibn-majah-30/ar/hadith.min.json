{"total":65,"items":[{"id":"69b6c8bfdd1a4c9c86f0cf13","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3371,"bookHadithIndex":1,"text":"حدثنا الحسين بن الحسن المروزي، حدثنا ابن ابي عدي، ح وحدثنا ابراهيم بن سعيد الجوهري، حدثنا عبد الوهاب، جميعا عن راشد ابي محمد الحماني، عن شهر بن حوشب، عن ام الدرداء، عن ابي الدرداء، قال اوصاني خليلي صلى الله عليه وسلم \" لا تشرب الخمر فانها مفتاح كل شر","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3371-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3371-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3371-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3371-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf14","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3372,"bookHadithIndex":2,"text":"حدثنا العباس بن عثمان الدمشقي، حدثنا الوليد بن مسلم، حدثنا منير بن الزبير، انه سمع عبادة بن نسى، يقول سمعت خباب بن الارت، عن رسول الله صلى الله عليه وسلم انه قال \" اياك والخمر فان خطييتها تفرع الخطايا كما ان شجرتها تفرع الشجر","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3372-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3372-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3372-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3372-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cf15","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3373,"bookHadithIndex":3,"text":"حدثنا علي بن محمد، حدثنا عبد الله بن نمير، عن عبيد الله بن عمر، عن نافع، عن ابن عمر، ان رسول الله صلى الله عليه وسلم قال \" من شرب الخمر في الدنيا لم يشربها في الاخرة الا ان يتوب","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3373-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3373-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3373-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3373-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf16","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3374,"bookHadithIndex":4,"text":"حدثنا هشام بن عمار، حدثنا يحيى بن حمزة، حدثني زيد بن واقد، ان خالد بن عبد الله بن حسين، حدثه قال حدثني ابو هريرة، ان رسول الله صلى الله عليه وسلم قال \" من شرب الخمر في الدنيا لم يشربها في الاخرة","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3374-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3374-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3374-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf17","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3375,"bookHadithIndex":5,"text":"حدثنا ابو بكر بن ابي شيبة، ومحمد بن الصباح، قالا حدثنا محمد بن سليمان بن الاصبهاني، عن سهيل، عن ابيه، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" مدمن الخمر كعابد وثن","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3375-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3375-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3375-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf18","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3376,"bookHadithIndex":6,"text":"حدثنا هشام بن عمار، حدثنا سليمان بن عتبة، حدثني يونس بن ميسرة بن حلبس، عن ابي ادريس، عن ابي الدرداء، عن النبي صلى الله عليه وسلم قال \" لا يدخل الجنة مدمن خمر","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3376-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3376-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3376-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf19","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3377,"bookHadithIndex":7,"text":"حدثنا عبد الرحمن بن ابراهيم الدمشقي، حدثنا الوليد بن مسلم، حدثنا الاوزاعي، عن ربيعة بن يزيد، عن ابن الديلمي، عن عبد الله بن عمرو، قال قال رسول الله صلى الله عليه وسلم \" من شرب الخمر وسكر لم تقبل له صلاة اربعين صباحا وان مات دخل النار فان تاب تاب الله عليه وان عاد فشرب فسكر لم تقبل له صلاة اربعين صباحا فان مات دخل النار فان تاب تاب الله عليه وان عاد فشرب فسكر لم تقبل له صلاة اربعين صباحا فان مات دخل النار فان تاب تاب الله عليه وان عاد كان حقا على الله ان يسقيه من ردغة الخبال يوم القيامة \" . قالوا يا رسول الله وما ردغة الخبال قال \" عصارة اهل النار","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3377-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3377-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3377-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3377-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf1a","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3378,"bookHadithIndex":8,"text":"حدثنا يزيد بن عبد الله اليمامي، حدثنا عكرمة بن عمار، حدثنا ابو كثير السحيمي، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" الخمر من هاتين الشجرتين النخلة والعنبة","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3378-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3378-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3378-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf1b","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3379,"bookHadithIndex":9,"text":"حدثنا محمد بن رمح، انبانا الليث بن سعد، عن يزيد بن ابي حبيب، ان خالد بن كثير الهمداني، حدثه ان السري بن اسماعيل حدثه ان الشعبي حدثه انه، سمع النعمان بن بشير، يقول قال رسول الله صلى الله عليه وسلم \" ان من الحنطة خمرا ومن الشعير خمرا ومن الزبيب خمرا ومن التمر خمرا ومن العسل خمرا","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3379-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3379-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3379-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf1c","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3380,"bookHadithIndex":10,"text":"حدثنا علي بن محمد، ومحمد بن اسماعيل، قالا حدثنا وكيع، حدثنا عبد العزيز بن عمر بن عبد العزيز، عن عبد الرحمن بن عبد الله الغافقي، وابي، طعمة مولاهم انهما سمعا ابن عمر، يقول قال رسول الله صلى الله عليه وسلم \" لعنت الخمر على عشرة اوجه بعينها وعاصرها ومعتصرها وبايعها ومبتاعها وحاملها والمحمولة اليه واكل ثمنها وشاربها وساقيها","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3380-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3380-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3380-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3380-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf1d","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3381,"bookHadithIndex":11,"text":"حدثنا محمد بن سعيد بن يزيد بن ابراهيم التستري، حدثنا ابو عاصم، عن شبيب، سمعت انس بن مالك، - او حدثني انس، - قال لعن رسول الله صلى الله عليه وسلم في الخمر عشرة عاصرها ومعتصرها والمعصورة له وحاملها والمحمولة له وبايعها والمبتاعة له وساقيها والمستقاة له \" . حتى عد عشرة من هذا الضرب","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3381-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3381-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3381-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3381-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf1e","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3382,"bookHadithIndex":12,"text":"حدثنا ابو بكر بن ابي شيبة، وعلي بن محمد، قالا حدثنا ابو معاوية، حدثنا الاعمش، عن مسلم، عن مسروق، عن عايشة، قالت لما نزلت الايات من اخر سورة البقرة في الربا خرج رسول الله صلى الله عليه وسلم فحرم التجارة في الخمر","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3382-alalbani","name":"Al-Albani","grade":"Sahih Hadith"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3382-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3382-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3382-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0cf1f","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3383,"bookHadithIndex":13,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا سفيان، عن عمرو بن دينار، عن طاوس، عن ابن عباس، قال بلغ عمر ان سمرة، باع خمرا فقال قاتل الله سمرة الم يعلم ان رسول الله صلى الله عليه وسلم قال \" لعن الله اليهود حرمت عليهم الشحوم فجملوها فباعوها","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3383-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3383-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3383-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3383-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0cf20","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3384,"bookHadithIndex":14,"text":"حدثنا العباس بن الوليد الدمشقي، حدثنا عبد السلام بن عبد القدوس، حدثنا ثور بن يزيد، عن خالد بن معدان، عن ابي امامة الباهلي، قال قال رسول الله صلى الله عليه وسلم \" لا تذهب الليالي والايام حتى تشرب طايفة من امتي الخمر يسمونها بغير اسمها","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3384-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3384-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3384-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3384-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf21","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3385,"bookHadithIndex":15,"text":"حدثنا الحسين بن ابي السري، حدثنا عبيد الله، حدثنا سعد بن اوس العبسي، عن بلال بن يحيى العبسي، عن ابي بكر بن حفص، عن ابن محيريز، عن ثابت بن السمط، عن عبادة بن الصامت، قال قال رسول الله صلى الله عليه وسلم \" يشرب ناس من امتي الخمر باسم يسمونها اياه","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3385-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3385-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3385-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf22","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3386,"bookHadithIndex":16,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا سفيان بن عيينة، عن الزهري، عن ابي سلمة، عن عايشة، تبلغ به النبي صلى الله عليه وسلم قال \" كل شراب اسكر فهو حرام","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3386-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3386-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3386-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3386-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0cf23","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3387,"bookHadithIndex":17,"text":"حدثنا هشام بن عمار، حدثنا صدقة بن خالد، حدثنا يحيى بن الحارث الذماري، سمعت سالم بن عبد الله بن عمر، يحدث عن ابيه، قال قال رسول الله صلى الله عليه وسلم \" كل مسكر حرام","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3387-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3387-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3387-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3387-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf24","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3388,"bookHadithIndex":18,"text":"حدثنا يونس بن عبد الاعلى، حدثنا ابن وهب، اخبرنا ابن جريج، عن ايوب بن هاني، عن مسروق، عن ابن مسعود، ان رسول الله صلى الله عليه وسلم قال \" كل مسكر حرام \" . قال ابن ماجه هذا حديث المصريين","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3388-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3388-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3388-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3388-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf25","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3389,"bookHadithIndex":19,"text":"حدثنا علي بن ميمون الرقي، حدثنا خالد بن حيان، عن سليمان بن عبد الله بن الزبرقان، عن يعلى بن شداد بن اوس، سمعت معاوية، يقول سمعت رسول الله صلى الله عليه وسلم يقول \" كل مسكر حرام على كل مومن \" . وهذا حديث الرقيين","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3389-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3389-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3389-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cf26","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3390,"bookHadithIndex":20,"text":"حدثنا سهل، حدثنا يزيد بن هارون، عن محمد بن عمرو بن علقمة، عن ابي سلمة، عن ابن عمر، قال قال رسول الله صلى الله عليه وسلم \" كل مسكر خمر وكل خمر حرام","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3390-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3390-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3390-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf27","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3391,"bookHadithIndex":21,"text":"حدثنا محمد بن بشار، حدثنا ابو داود، حدثنا شعبة، عن سعيد بن ابي بردة، عن ابيه، عن ابي موسى، قال قال رسول الله صلى الله عليه وسلم \" كل مسكر حرام","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3391-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3391-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3391-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3391-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0cf28","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3392,"bookHadithIndex":22,"text":"حدثنا ابراهيم بن المنذر الحزامي، حدثنا ابو يحيى، زكريا بن منظور عن ابي حازم، عن عبد الله بن عمر، قال قال رسول الله صلى الله عليه وسلم \" كل مسكر حرام وما اسكر كثيره فقليله حرام","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3392-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3392-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3392-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf29","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3393,"bookHadithIndex":23,"text":"حدثنا عبد الرحمن بن ابراهيم، حدثنا انس بن عياض، حدثني داود بن بكر، عن محمد بن المنكدر، عن جابر بن عبد الله، ان رسول الله صلى الله عليه وسلم قال \" ما اسكر كثيره فقليله حرام","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3393-alalbani","name":"Al-Albani","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3393-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3393-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3393-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf2a","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3394,"bookHadithIndex":24,"text":"حدثنا عبد الرحمن بن ابراهيم، حدثنا انس بن عياض، حدثنا عبيد الله بن عمر، عن عمرو بن شعيب، عن ابيه، عن جده، ان رسول الله صلى الله عليه وسلم قال \" ما اسكر كثيره فقليله حرام","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3394-alalbani","name":"Al-Albani","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3394-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3394-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3394-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf2b","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3395,"bookHadithIndex":25,"text":"حدثنا محمد بن رمح، انبانا الليث بن سعد، عن ابي الزبير، عن جابر بن عبد الله، ان رسول الله صلى الله عليه وسلم نهى ان ينبذ التمر والزبيب جميعا ونهى ان ينبذ البسر والرطب جميعا . قال الليث بن سعد حدثني عطاء بن ابي رباح المكي، عن جابر بن عبد الله، عن النبي صلى الله عليه وسلم مثله","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3395-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3395-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3395-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3395-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf2c","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3396,"bookHadithIndex":26,"text":"حدثنا يزيد بن عبد الله اليمامي، حدثنا عكرمة بن عمار، عن ابي كثير، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" لا تنبذوا التمر والبسر جميعا وانبذوا كل واحد منهما على حدته","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3396-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3396-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3396-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3396-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf2d","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3397,"bookHadithIndex":27,"text":"حدثنا هشام بن عمار، حدثنا الوليد بن مسلم، حدثنا الاوزاعي، عن يحيى بن ابي كثير، عن عبد الله بن ابي قتادة، عن ابيه، انه سمع رسول الله صلى الله عليه وسلم يقول \" لا تجمعوا بين الرطب والزهو ولا بين الزبيب والتمر وانبذوا كل واحد منهما على حدته","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3397-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3397-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3397-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3397-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0cf2e","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3398,"bookHadithIndex":28,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا ابو معاوية، ح وحدثنا محمد بن عبد الملك بن ابي الشوارب، حدثنا عبد الواحد بن زياد، قالا حدثنا عاصم الاحول، حدثتنا بنانة بنت يزيد العبشمية، عن عايشة، قالت كنا ننبذ لرسول الله صلى الله عليه وسلم في سقاء فناخذ قبضة من تمر او قبضة من زبيب فنطرحها فيه ثم نصب عليه الماء فننبذه غدوة فيشربه عشية وننبذه عشية فيشربه غدوة . وقال ابو معاوية نهارا فيشربه ليلا او ليلا فيشربه نهارا","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3398-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3398-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3398-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3398-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cf2f","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3399,"bookHadithIndex":29,"text":"حدثنا ابو كريب، عن اسماعيل بن صبيح، عن ابي اسراييل، عن ابي عمر البهراني، عن ابن عباس، قال كان ينبذ لرسول الله صلى الله عليه وسلم فيشربه يومه ذلك والغد واليوم الثالث فان بقي منه شىء اهراقه او امر به فاهريق","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3399-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3399-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3399-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf30","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3400,"bookHadithIndex":30,"text":"حدثنا محمد بن عبد الملك بن ابي الشوارب، حدثنا ابو عوانة، عن ابي الزبير، عن جابر بن عبد الله، قال كان ينبذ لرسول الله صلى الله عليه وسلم في تور من حجارة","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3400-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3400-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3400-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3400-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf31","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3401,"bookHadithIndex":31,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا محمد بن بشر، عن محمد بن عمرو، حدثنا ابو سلمة، عن ابي هريرة، قال نهى رسول الله صلى الله عليه وسلم ان ينبذ في النقير والمزفت والدباء والحنتمة وقال \" كل مسكر حرام","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3401-alalbani","name":"Al-Albani","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3401-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3401-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3401-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf32","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3402,"bookHadithIndex":32,"text":"حدثنا محمد بن رمح، انبانا الليث بن سعد، عن نافع، عن ابن عمر، قال نهى رسول الله صلى الله عليه وسلم ان ينبذ في المزفت والقرع","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3402-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3402-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3402-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3402-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf33","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3403,"bookHadithIndex":33,"text":"حدثنا نصر بن علي، حدثنا ابي، عن المثنى بن سعيد، عن ابي المتوكل، عن ابي سعيد الخدري، قال نهى رسول الله صلى الله عليه وسلم عن الشرب في الحنتم والدباء والنقير","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3403-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3403-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3403-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3403-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf34","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3404,"bookHadithIndex":34,"text":"حدثنا ابو بكر، والعباس بن عبد العظيم العنبري، قالا حدثنا شبابة، عن شعبة، عن بكير بن عطاء، عن عبد الرحمن بن يعمر، قال نهى رسول الله صلى الله عليه وسلم عن الدباء والحنتم","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3404-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3404-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3404-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3404-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf35","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3405,"bookHadithIndex":35,"text":"حدثنا عبد الحميد بن بيان الواسطي، حدثنا اسحاق بن يوسف، عن شريك، عن سماك، عن القاسم بن مخيمرة، عن ابن بريدة، عن ابيه، عن النبي صلى الله عليه وسلم قال \" كنت نهيتكم عن الاوعية فانتبذوا فيه واجتنبوا كل مسكر","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3405-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3405-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3405-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf36","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3406,"bookHadithIndex":36,"text":"حدثنا يونس بن عبد الاعلى، حدثنا عبد الله بن وهب، انبانا ابن جريج، عن ايوب بن هاني، عن مسروق بن الاجدع، عن ابن مسعود، ان رسول الله صلى الله عليه وسلم قال \" اني كنت نهيتكم عن نبيذ الاوعية الا وان وعاء لا يحرم شييا كل مسكر حرام","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3406-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3406-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3406-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3406-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf37","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3407,"bookHadithIndex":37,"text":"حدثنا سويد بن سعيد، حدثنا المعتمر بن سليمان، عن ابيه، حدثتني رميثة، عن عايشة، انها قالت اتعجز احداكن ان تتخذ كل عام من جلد اضحيتها سقاء ثم قالت نهى رسول الله صلى الله عليه وسلم ان ينبذ في الجر وفي كذا وفي كذا الا الخل","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3407-alalbani","name":"Al-Albani","grade":"Daif Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3407-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3407-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3407-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cf38","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3408,"bookHadithIndex":38,"text":"حدثنا اسحاق بن موسى الخطمي، حدثنا الوليد بن مسلم، حدثنا الاوزاعي، عن يحيى بن ابي كثير، عن ابي سلمة، عن ابي هريرة، قال نهى رسول الله صلى الله عليه وسلم ان ينبذ في الجرار","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3408-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3408-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3408-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3408-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf39","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3409,"bookHadithIndex":39,"text":"حدثنا مجاهد بن موسى، حدثنا الوليد، عن صدقة ابي معاوية، عن زيد بن واقد، عن خالد بن عبد الله، عن ابي هريرة، قال اتي النبي صلى الله عليه وسلم بنبيذ جر ينش فقال \" اضرب بهذا الحايط فان هذا شراب من لا يومن بالله واليوم الاخر","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3409-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3409-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3409-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf3a","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3410,"bookHadithIndex":40,"text":"حدثنا محمد بن رمح، انبانا الليث بن سعد، عن ابي الزبير، عن جابر بن عبد الله، عن رسول الله صلى الله عليه وسلم انه قال \" غطوا الاناء واوكوا السقاء واطفيوا السراج واغلقوا الباب فان الشيطان لا يحل سقاء ولا يفتح بابا ولا يكشف اناء فان لم يجد احدكم الا ان يعرض على انايه عودا ويذكر اسم الله فليفعل فان الفويسقة تضرم على اهل البيت بيتهم","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3410-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3410-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3410-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3410-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf3b","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3411,"bookHadithIndex":41,"text":"حدثنا عبد الحميد بن بيان الواسطي، حدثنا خالد بن عبد الله، عن سهيل، عن ابيه، عن ابي هريرة، قال امرنا رسول الله بتغطية الاناء وايكاء السقاء واكفاء الاناء","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3411-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3411-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3411-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3411-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf3c","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3412,"bookHadithIndex":42,"text":"حدثنا عصمة بن الفضل، حدثنا حرمي بن عمارة بن ابي حفصة، حدثنا حريش بن خريت، انبانا ابن ابي مليكة، عن عايشة، قالت كنت اصنع لرسول الله صلى الله عليه وسلم ثلاثة انية من الليل مخمرة اناء لطهوره واناء لسواكه واناء لشرابه","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3412-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3412-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3412-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3412-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cf3d","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3413,"bookHadithIndex":43,"text":"حدثنا محمد بن رمح، انبانا الليث بن سعد، عن نافع، عن زيد بن عبد الله بن عمر، عن عبد الله بن عبد الرحمن بن ابي بكر، عن ام سلمة، انها اخبرته عن رسول الله صلى الله عليه وسلم قال \" ان الذي يشرب في اناء الفضة انما يجرجر في بطنه نار جهنم","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3413-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3413-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3413-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3413-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0cf3e","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3414,"bookHadithIndex":44,"text":"حدثنا محمد بن عبد الملك بن ابي الشوارب، حدثنا ابو عوانة، عن ابي بشر، عن مجاهد، عن عبد الرحمن بن ابي ليلى، عن حذيفة، قال نهى رسول الله صلى الله عليه وسلم عن الشرب في انية الذهب والفضة وقال \" هي لهم في الدنيا وهي لكم في الاخرة","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3414-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3414-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3414-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3414-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0cf3f","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3415,"bookHadithIndex":45,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا غندر، عن شعبة، عن سعد بن ابراهيم، عن نافع، عن امراة ابن عمر، عن عايشة، عن رسول الله صلى الله عليه وسلم قال \" من شرب في اناء فضة فكانما يجرجر في بطنه نار جهنم","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3415-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3415-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3415-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3415-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf40","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3416,"bookHadithIndex":46,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا ابن مهدي، حدثنا عزرة بن ثابت الانصاري، عن ثمامة بن عبد الله، عن انس، انه كان يتنفس في الاناء ثلاثا وزعم انس ان رسول الله صلى الله عليه وسلم كان يتنفس في الاناء ثلاثا","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3416-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3416-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3416-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3416-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0cf41","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3417,"bookHadithIndex":47,"text":"حدثنا هشام بن عمار، ومحمد بن الصباح، قالا حدثنا مروان بن معاوية، حدثنا رشدين بن كريب، عن ابيه، عن ابن عباس، ان النبي صلى الله عليه وسلم شرب فتنفس فيه مرتين","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3417-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3417-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3417-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3417-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cf42","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3418,"bookHadithIndex":48,"text":"حدثنا احمد بن عمرو بن السرح، حدثنا ابن وهب، عن يونس، عن ابن شهاب، عن عبيد الله بن عبد الله بن عتبة، عن ابي سعيد الخدري، قال نهى رسول الله صلى الله عليه وسلم عن اختناث الاسقية ان يشرب من افواهها","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3418-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3418-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3418-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3418-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0cf43","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3419,"bookHadithIndex":49,"text":"حدثنا محمد بن بشار، حدثنا ابو عامر، حدثنا زمعة بن صالح، عن سلمة بن وهرام، عن عكرمة، عن ابن عباس، قال نهى رسول الله صلى الله عليه وسلم عن اختناث الاسقية وان رجلا بعدما نهى رسول الله صلى الله عليه وسلم عن ذلك قام من الليل الى سقاء فاختنثه فخرجت عليه منه حية","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3419-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3419-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3419-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3419-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cf44","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3420,"bookHadithIndex":50,"text":"حدثنا بشر بن هلال الصواف، حدثنا عبد الوارث بن سعيد، عن ايوب، عن عكرمة، عن ابي هريرة، قال نهى رسول الله صلى الله عليه وسلم عن الشرب من في السقاء","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3420-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3420-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3420-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3420-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari"}]},{"id":"69b6c8bfdd1a4c9c86f0cf45","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3421,"bookHadithIndex":51,"text":"حدثنا بكر بن خلف ابو بشر، حدثنا يزيد بن زريع، حدثنا خالد الحذاء، عن عكرمة، عن ابن عباس، ان رسول الله صلى الله عليه وسلم نهى ان يشرب من فم السقاء","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3421-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3421-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3421-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3421-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari"}]},{"id":"69b6c8bfdd1a4c9c86f0cf46","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3422,"bookHadithIndex":52,"text":"حدثنا سويد بن سعيد، حدثنا علي بن مسهر، عن عاصم، عن الشعبي، عن ابن عباس، قال سقيت النبي صلى الله عليه وسلم من زمزم فشرب قايما . فذكرت ذلك لعكرمة فحلف بالله ما فعل","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3422-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3422-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3422-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3422-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0cf47","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3423,"bookHadithIndex":53,"text":"حدثنا محمد بن الصباح، انبانا سفيان بن عيينة، عن يزيد بن يزيد بن جابر، عن عبد الرحمن بن ابي عمرة، عن جدة، له يقال لها كبشة الانصارية ان رسول الله صلى الله عليه وسلم دخل عليها وعندها قربة معلقة فشرب منها وهو قايم فقطعت فم القربة تبتغي بركة موضع في رسول الله صلى الله عليه وسلم","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3423-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3423-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3423-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3423-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf48","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3424,"bookHadithIndex":54,"text":"حدثنا حميد بن مسعدة، حدثنا بشر بن المفضل، حدثنا سعيد، عن قتادة، عن انس، ان رسول الله صلى الله عليه وسلم نهى عن الشرب قايما","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3424-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3424-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3424-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3424-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf49","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3425,"bookHadithIndex":55,"text":"حدثنا هشام بن عمار، حدثنا مالك بن انس، عن الزهري، عن انس بن مالك، ان رسول الله صلى الله عليه وسلم اتي بلبن قد شيب بماء وعن يمينه اعرابي وعن يساره ابو بكر فشرب ثم اعطى الاعرابي وقال \" الايمن فالايمن","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3425-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3425-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3425-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3425-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0cf4a","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3426,"bookHadithIndex":56,"text":"حدثنا هشام بن عمار، حدثنا اسماعيل بن عياش، حدثنا ابن جريج، عن ابن شهاب، عن عبيد الله بن عبد الله، عن ابن عباس، قال اتي رسول الله صلى الله عليه وسلم بلبن وعن يمينه ابن عباس وعن يساره خالد بن الوليد فقال رسول الله صلى الله عليه وسلم لابن عباس \" اتاذن لي ان اسقي خالدا \" . قال ابن عباس ما احب ان اوثر بسور رسول الله صلى الله عليه وسلم على نفسي احدا . فاخذ ابن عباس فشرب وشرب خالد","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3426-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3426-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3426-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3426-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cf4b","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3427,"bookHadithIndex":57,"text":"حدثنا ابو بكر بن ابي شيبة، حدثنا داود بن عبد الله، عن عبد العزيز بن محمد، عن الحارث بن ابي ذباب، عن عمه، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" اذا شرب احدكم فلا يتنفس في الاناء فاذا اراد ان يعود فلينح الاناء ثم ليعد ان كان يريد","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3427-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3427-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3427-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3427-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf4c","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3428,"bookHadithIndex":58,"text":"حدثنا بكر بن خلف ابو بشر، حدثنا يزيد بن زريع، عن خالد الحذاء، عن عكرمة، عن ابن عباس، قال نهى رسول الله صلى الله عليه وسلم عن التنفس في الاناء","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3428-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3428-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3428-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3428-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf4d","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3429,"bookHadithIndex":59,"text":"حدثنا ابو بكر بن خلاد الباهلي، حدثنا سفيان، عن عبد الكريم، عن عكرمة، عن ابن عباس، قال نهى رسول الله صلى الله عليه وسلم ان ينفخ في الاناء","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3429-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3429-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3429-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3429-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cf4e","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3430,"bookHadithIndex":60,"text":"حدثنا ابو كريب، حدثنا عبد الرحيم بن عبد الرحمن المحاربي، عن شريك، عن عبد الكريم، عن عكرمة، عن ابن عباس، قال لم يكن رسول الله صلى الله عليه وسلم ينفخ في الشراب","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3430-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3430-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3430-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3430-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf4f","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3431,"bookHadithIndex":61,"text":"حدثنا محمد بن المصفى الحمصي، حدثنا بقية، عن مسلم بن عبد الله، عن زياد بن عبد الله، عن عاصم بن محمد بن زيد بن عبد الله بن عمر، عن ابيه، عن جده، قال نهانا رسول الله صلى الله عليه وسلم ان نشرب على بطوننا وهو الكرع ونهانا ان نغترف باليد الواحدة وقال \" لا يلغ احدكم كما يلغ الكلب ولا يشرب باليد الواحدة كما يشرب القوم الذين سخط الله عليهم ولا يشرب بالليل من اناء حتى يحركه الا ان يكون اناء مخمرا ومن شرب بيده وهو يقدر على اناء يريد التواضع كتب الله له بعدد اصابعه حسنات وهو اناء عيسى ابن مريم عليهما السلام اذ طرح القدح فقال اف هذا مع الدنيا","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3431-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3431-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3431-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Very Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3431-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cf50","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3432,"bookHadithIndex":62,"text":"حدثنا احمد بن منصور ابو بكر، حدثنا يونس بن محمد، حدثنا فليح بن سليمان، عن سعيد بن الحارث، عن جابر بن عبد الله، قال دخل رسول الله صلى الله عليه وسلم على رجل من الانصار وهو يحول الماء في حايطه فقال له رسول الله صلى الله عليه وسلم \" ان كان عندك ماء بات في شن فاسقنا والا كرعنا \" . قال عندي ماء بات في شن . فانطلق وانطلقنا معه الى العريش فحلب له شاة على ماء بات في شن فشرب ثم فعل مثل ذلك بصاحبه الذي معه","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3432-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3432-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3432-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Bukhari"}]},{"id":"69b6c8bfdd1a4c9c86f0cf51","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3433,"bookHadithIndex":63,"text":"حدثنا واصل بن عبد الاعلى، حدثنا ابن فضيل، عن ليث، عن سعيد بن عامر، عن ابن عمر، قال مررنا على بركة فجعلنا نكرع فيها فقال رسول الله صلى الله عليه وسلم \" لا تكرعوا ولكن اغسلوا ايديكم ثم اشربوا فيها فانه ليس اناء اطيب من اليد","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3433-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3433-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3433-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3433-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cf52","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3434,"bookHadithIndex":64,"text":"حدثنا احمد بن عبدة، وسويد بن سعيد، قالا حدثنا حماد بن زيد، عن ثابت البناني، عن عبد الله بن رباح، عن ابي قتادة، قال قال رسول الله صلى الله عليه وسلم \" ساقي القوم اخرهم شربا","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3434-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3434-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3434-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3434-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf53","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3435,"bookHadithIndex":65,"text":"حدثنا احمد بن سنان، حدثنا زيد بن الحباب، حدثنا مندل بن علي، عن محمد بن اسحاق، عن الزهري، عن عبيد الله بن عبد الله، عن ابن عباس، قال كان لرسول الله صلى الله عليه وسلم قدح من قوارير يشرب فيه","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3435-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3435-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3435-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3435-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]}]}
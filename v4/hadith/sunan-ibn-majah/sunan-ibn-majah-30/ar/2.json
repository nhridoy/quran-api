          "grade": "Hasan Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3428-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0cf4d",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 30,
      "hadithIndex": 3429,
      "bookHadithIndex": 59,
      "text": "حدثنا ابو بكر بن خلاد الباهلي، حدثنا سفيان، عن عبد الكريم، عن عكرمة، عن ابن عباس، قال نهى رسول الله صلى الله عليه وسلم ان ينفخ في الاناء",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3429-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3429-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3429-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3429-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0cf4e",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 30,
      "hadithIndex": 3430,
      "bookHadithIndex": 60,
      "text": "حدثنا ابو كريب، حدثنا عبد الرحيم بن عبد الرحمن المحاربي، عن شريك، عن عبد الكريم، عن عكرمة، عن ابن عباس، قال لم يكن رسول الله صلى الله عليه وسلم ينفخ في الشراب",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3430-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3430-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3430-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3430-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0cf4f",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 30,
      "hadithIndex": 3431,
      "bookHadithIndex": 61,
      "text": "حدثنا محمد بن المصفى الحمصي، حدثنا بقية، عن مسلم بن عبد الله، عن زياد بن عبد الله، عن عاصم بن محمد بن زيد بن عبد الله بن عمر، عن ابيه، عن جده، قال نهانا رسول الله صلى الله عليه وسلم ان نشرب على بطوننا وهو الكرع ونهانا ان نغترف باليد الواحدة وقال \" لا يلغ احدكم كما يلغ الكلب ولا يشرب باليد الواحدة كما يشرب القوم الذين سخط الله عليهم ولا يشرب بالليل من اناء حتى يحركه الا ان يكون اناء مخمرا ومن شرب بيده وهو يقدر على اناء يريد التواضع كتب الله له بعدد اصابعه حسنات وهو اناء عيسى ابن مريم عليهما السلام اذ طرح القدح فقال اف هذا مع الدنيا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3431-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3431-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3431-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Very Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3431-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0cf50",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 30,
      "hadithIndex": 3432,
      "bookHadithIndex": 62,
      "text": "حدثنا احمد بن منصور ابو بكر، حدثنا يونس بن محمد، حدثنا فليح بن سليمان، عن سعيد بن الحارث، عن جابر بن عبد الله، قال دخل رسول الله صلى الله عليه وسلم على رجل من الانصار وهو يحول الماء في حايطه فقال له رسول الله صلى الله عليه وسلم \" ان كان عندك ماء بات في شن فاسقنا والا كرعنا \" . قال عندي ماء بات في شن . فانطلق وانطلقنا معه الى العريش فحلب له شاة على ماء بات في شن فشرب ثم فعل مثل ذلك بصاحبه الذي معه",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3432-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3432-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3432-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Bukhari"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0cf51",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 30,
      "hadithIndex": 3433,
      "bookHadithIndex": 63,
      "text": "حدثنا واصل بن عبد الاعلى، حدثنا ابن فضيل، عن ليث، عن سعيد بن عامر، عن ابن عمر، قال مررنا على بركة فجعلنا نكرع فيها فقال رسول الله صلى الله عليه وسلم \" لا تكرعوا ولكن اغسلوا ايديكم ثم اشربوا فيها فانه ليس اناء اطيب من اليد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3433-alalbani",
          "name": "Al-Albani",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3433-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3433-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3433-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0cf52",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 30,
      "hadithIndex": 3434,
      "bookHadithIndex": 64,
      "text": "حدثنا احمد بن عبدة، وسويد بن سعيد، قالا حدثنا حماد بن زيد، عن ثابت البناني، عن عبد الله بن رباح، عن ابي قتادة، قال قال رسول الله صلى الله عليه وسلم \" ساقي القوم اخرهم شربا",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3434-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"

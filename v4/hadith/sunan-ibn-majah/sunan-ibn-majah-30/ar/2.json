      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0cf46",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 30,
      "hadithIndex": 3422,
      "bookHadithIndex": 52,
      "text": "حدثنا سويد بن سعيد، حدثنا علي بن مسهر، عن عاصم، عن الشعبي، عن ابن عباس، قال سقيت النبي صلى الله عليه وسلم من زمزم فشرب قايما . فذكرت ذلك لعكرمة فحلف بالله ما فعل",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3422-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3422-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3422-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3422-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0cf47",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 30,
      "hadithIndex": 3423,
      "bookHadithIndex": 53,
      "text": "حدثنا محمد بن الصباح، انبانا سفيان بن عيينة، عن يزيد بن يزيد بن جابر، عن عبد الرحمن بن ابي عمرة، عن جدة، له يقال لها كبشة الانصارية ان رسول الله صلى الله عليه وسلم دخل عليها وعندها قربة معلقة فشرب منها وهو قايم فقطعت فم القربة تبتغي بركة موضع في رسول الله صلى الله عليه وسلم",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3423-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3423-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3423-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3423-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0cf48",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 30,
      "hadithIndex": 3424,
      "bookHadithIndex": 54,
      "text": "حدثنا حميد بن مسعدة، حدثنا بشر بن المفضل، حدثنا سعيد، عن قتادة، عن انس، ان رسول الله صلى الله عليه وسلم نهى عن الشرب قايما",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3424-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3424-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3424-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3424-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih Muslim"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0cf49",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 30,
      "hadithIndex": 3425,
      "bookHadithIndex": 55,
      "text": "حدثنا هشام بن عمار، حدثنا مالك بن انس، عن الزهري، عن انس بن مالك، ان رسول الله صلى الله عليه وسلم اتي بلبن قد شيب بماء وعن يمينه اعرابي وعن يساره ابو بكر فشرب ثم اعطى الاعرابي وقال \" الايمن فالايمن",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3425-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3425-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3425-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3425-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Sahih - Agreed Upon"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0cf4a",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 30,
      "hadithIndex": 3426,
      "bookHadithIndex": 56,
      "text": "حدثنا هشام بن عمار، حدثنا اسماعيل بن عياش، حدثنا ابن جريج، عن ابن شهاب، عن عبيد الله بن عبد الله، عن ابن عباس، قال اتي رسول الله صلى الله عليه وسلم بلبن وعن يمينه ابن عباس وعن يساره خالد بن الوليد فقال رسول الله صلى الله عليه وسلم لابن عباس \" اتاذن لي ان اسقي خالدا \" . قال ابن عباس ما احب ان اوثر بسور رسول الله صلى الله عليه وسلم على نفسي احدا . فاخذ ابن عباس فشرب وشرب خالد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3426-alalbani",
          "name": "Al-Albani",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3426-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3426-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Daif"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3426-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Daif"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0cf4b",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 30,
      "hadithIndex": 3427,
      "bookHadithIndex": 57,
      "text": "حدثنا ابو بكر بن ابي شيبة، حدثنا داود بن عبد الله، عن عبد العزيز بن محمد، عن الحارث بن ابي ذباب، عن عمه، عن ابي هريرة، قال قال رسول الله صلى الله عليه وسلم \" اذا شرب احدكم فلا يتنفس في الاناء فاذا اراد ان يعود فلينح الاناء ثم ليعد ان كان يريد",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3427-alalbani",
          "name": "Al-Albani",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3427-muhammadfouadabdalbaqi",
          "name": "Muhammad Fouad Abd al-Baqi",
          "grade": "Sahih"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3427-shuaibalarnaut",
          "name": "Shuaib Al Arnaut",
          "grade": "Hasan"
        },
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3427-zubairalizai",
          "name": "Zubair Ali Zai",
          "grade": "Isnaad Hasan"
        }
      ]
    },
    {
      "id": "69b6c8bfdd1a4c9c86f0cf4c",
      "editionId": "69b55e8d6f42ba7ccb2a1324",
      "bookIndex": 30,
      "hadithIndex": 3428,
      "bookHadithIndex": 58,
      "text": "حدثنا بكر بن خلف ابو بشر، حدثنا يزيد بن زريع، عن خالد الحذاء، عن عكرمة، عن ابن عباس، قال نهى رسول الله صلى الله عليه وسلم عن التنفس في الاناء",
      "grades": [
        {
          "id": "69b55e8d6f42ba7ccb2a1324-30-3428-alalbani",

{"total":65,"totalPage":2,"page":1,"pageSize":50,"items":[{"id":"69b6c8bfdd1a4c9c86f0cf13","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3371,"bookHadithIndex":1,"text":"ابو الدرداء رضی اللہ عنہ کہتے ہیں کہ میرے خلیل ( جگری دوست ) رسول اللہ صلی اللہ علیہ وسلم نے مجھے وصیت فرمائی: شراب مت پیو، اس لیے کہ یہ تمام برائیوں کی کنجی ہے ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3371-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3371-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3371-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3371-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf14","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3372,"bookHadithIndex":2,"text":"خباب بن ارت رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: شراب سے بچو، اس لیے کہ اس کے گناہ سے دوسرے بہت سے گناہ پھوٹتے ہیں جس طرح ایک درخت ہوتا ہے اور اس سے بہت سی شاخیں پھوٹتی ہیں ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3372-alalbani","name":"Al-Albani","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3372-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3372-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3372-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cf15","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3373,"bookHadithIndex":3,"text":"عبداللہ بن عمر رضی اللہ عنہما سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جو شخص دنیا میں شراب پئے گا، وہ آخرت میں نہیں پی سکے گا مگر یہ کہ وہ توبہ کر لے ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3373-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3373-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3373-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3373-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf16","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3374,"bookHadithIndex":4,"text":"ابوہریرہ رضی اللہ عنہ بیان کرتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جو دنیا میں شراب پئے گا، وہ آخرت میں اس سے محروم رہے گا ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3374-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3374-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3374-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf17","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3375,"bookHadithIndex":5,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: شراب کا عادی ایسے ہی ہے جیسے بتوں کا پجاری ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3375-alalbani","name":"Al-Albani","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3375-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3375-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf18","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3376,"bookHadithIndex":6,"text":"ابو الدرداء رضی اللہ عنہ کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: عادی شرابی جنت میں داخل نہیں ہو گا ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3376-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3376-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3376-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf19","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3377,"bookHadithIndex":7,"text":"عبداللہ بن عمرو رضی اللہ عنہما کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جو شراب پی کر مست ہو جائے ( نشہ ہو جائے ) اس کی نماز چالیس روز تک قبول نہیں ہوتی، اور اگر وہ اس دوران مر جائے تو وہ جہنم میں جائے گا، لیکن اگر وہ توبہ کر لے تو اللہ تعالیٰ اس کی توبہ قبول فرمائے گا، پھر اگر وہ توبہ سے پھر جائے اور شراب پئے، اور اسے نشہ آ جائے تو چالیس روز تک اس کی نماز قبول نہیں ہو گی، اگر وہ اس دوران مر گیا تو جہنم میں جائے گا، لیکن اگر وہ پھر توبہ کر لے تو اللہ تعالیٰ اس کی توبہ قبول فرمائے گا، اگر وہ پھر پی کر بدمست ہو جائے تو پھر اس کی نماز چالیس روز تک قبول نہیں ہو گی، اور وہ اسی حالت میں مر گیا تو جہنم میں جائے گا، اور اگر اس نے پھر توبہ کر لی تو اللہ تعالیٰ اس کی توبہ قبول کر لے گا، اب اگر وہ ( اس کے بعد بھی ) پئے تو اللہ تعالیٰ کے لیے حق ہو گا کہ اسے قیامت کے دن «ردغۃ الخبال» پلائے، لوگوں نے سوال کیا: اللہ کے رسول! یہ «ردغۃ الخبال» کیا ہے؟ فرمایا: جہنمیوں کا پیپ ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3377-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3377-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3377-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3377-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf1a","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3378,"bookHadithIndex":8,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: شراب ان دو درختوں: کھجور اور انگور سے بنتی ہے ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3378-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3378-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3378-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf1b","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3379,"bookHadithIndex":9,"text":"نعمان بن بشیر رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: شراب کئی چیزوں سے بنائی جاتی ہے، گیہوں سے، جو سے، منقیٰ سے، کھجور سے اور شہد سے ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3379-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3379-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3379-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf1c","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3380,"bookHadithIndex":10,"text":"عبداللہ بن عمر رضی اللہ عنہما کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: شراب دس طرح سے ملعون ہے، یہ لعنت خود اس پر ہے، اس کے نچوڑنے والے پر، نچڑوانے والے پر، اس کے بیچنے والے پر، اس کے خریدنے والے پر، اس کو اٹھا کر لے جانے والے پر، اس شخص پر جس کے پاس اٹھا کر لے جائی جائے، اس کی قیمت کھانے والے پر، اس کے پینے والے پر اور اس کے پلانے والے پر ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3380-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3380-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3380-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Hasan"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3380-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf1d","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3381,"bookHadithIndex":11,"text":"انس بن مالک رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے دس قسم کے لوگوں پر شراب کی وجہ سے لعنت فرمائی: اس کے نچوڑنے والے پر، نچڑوانے والے پر، اور اس پر جس کے لیے نچوڑی جائے، اسے لے جانے والے پر، اس شخص پر جس کے لیے لے جائی جائے، بیچنے والے پر، اس پر جس کو بیچی جائے، پلانے والے پر اور اس پر جس کو پلائی جائے ، یہاں تک کہ دسوں کو آپ نے گن کر اس طرح بتایا","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3381-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3381-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3381-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3381-zubairalizai","name":"Zubair Ali Zai","grade":"Hasan"}]},{"id":"69b6c8bfdd1a4c9c86f0cf1e","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3382,"bookHadithIndex":12,"text":"ام المؤمنین عائشہ رضی اللہ عنہا کہتی ہیں کہ جب سود کے سلسلے میں سورۃ البقرہ کی آخری آیات نازل ہوئیں تو رسول اللہ صلی اللہ علیہ وسلم باہر تشریف لائے، اور شراب کی تجارت کو حرام قرار دے دیا۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3382-alalbani","name":"Al-Albani","grade":"Sahih Hadith"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3382-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3382-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3382-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}]},{"id":"69b6c8bfdd1a4c9c86f0cf1f","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3383,"bookHadithIndex":13,"text":"عبداللہ بن عباس رضی اللہ عنہما کہتے ہیں کہ عمر رضی اللہ عنہ کو خبر ملی کہ سمرہ رضی اللہ عنہ نے شراب بیچی ہے تو کہا: اللہ تعالیٰ سمرہ کو تباہ کرے، کیا اسے نہیں معلوم کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا ہے کہ یہود پر اللہ کی لعنت ہو، اس لیے کہ ان پر چربی حرام کی گئی تھی، تو انہوں نے اسے پگھلایا اور بیچ دیا ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3383-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3383-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3383-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3383-zubairalizai","name":"Zubai
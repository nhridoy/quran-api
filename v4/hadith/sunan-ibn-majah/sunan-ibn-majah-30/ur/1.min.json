نی روایت میں یوں کہتے ہیں: دن میں بھگوتے تو رات میں پیتے اور رات میں بھگوتے تو دن میں پیتے ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3398-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3398-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3398-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3398-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cf2f","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3399,"bookHadithIndex":29,"text":"عبداللہ بن عباس رضی اللہ عنہما کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم کے لیے نبیذ تیار کی جاتی تو آپ اسے اسی دن پیتے، پھر اگلے دن، پھر تیسرے دن، اور اگر اس کے بعد بھی اس میں سے کچھ بچ جاتا تو اسے بہا دیتے یا کسی کو حکم دیتے تو وہ بہا دیتا۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3399-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3399-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3399-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf30","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3400,"bookHadithIndex":30,"text":"جابر بن عبداللہ رضی اللہ عنہما کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم کے لیے پتھر کے ایک پیالے میں نبیذ تیار بنائی جاتی تھی۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3400-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3400-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3400-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3400-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf31","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3401,"bookHadithIndex":31,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے منع فرمایا ہے کہ نقیر، مزفت، دباء اور حنتمہ میں نبیذ تیار کی جائے، اور آپ صلی اللہ علیہ وسلم کا ارشاد ہے: ہر نشہ آور چیز حرام ہے ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3401-alalbani","name":"Al-Albani","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3401-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3401-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3401-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf32","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3402,"bookHadithIndex":32,"text":"عبداللہ بن عمر رضی اللہ عنہما کہتے ہیں رسول اللہ صلی اللہ علیہ وسلم نے مزفت ( روغنی برتن ) ، اور دباء ( کدو کی تونبی ) میں نبیذ تیار کرنے سے منع فرمایا۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3402-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3402-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3402-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3402-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf33","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3403,"bookHadithIndex":33,"text":"ابو سعید خدری رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے حنتم، دباء اور نقیر میں پینے سے منع فرمایا۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3403-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3403-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3403-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3403-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf34","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3404,"bookHadithIndex":34,"text":"عبدالرحمٰن بن یعمر رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے دباء اور حنتم ( کے استعمال ) سے منع فرمایا ہے۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3404-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3404-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3404-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3404-zubairalizai","name":"Zubair Ali Zai","grade":"Isnaad Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf35","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3405,"bookHadithIndex":35,"text":"بریدہ رضی اللہ عنہ کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: میں نے تمہیں ( مخصوص ) برتنوں کے استعمال سے روکا تھا، اب ان میں نبیذ تیار کر سکتے ہو لیکن ہر نشہ لانے والی چیز سے بچو ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3405-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3405-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3405-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf36","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3406,"bookHadithIndex":36,"text":"عبداللہ بن مسعود رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: میں نے تمہیں ( مخصوص ) برتنوں میں نبیذ بنانے سے منع کیا تھا، سنو! برتن کی وجہ سے کوئی چیز حرام نہیں ہوتی، البتہ ہر نشہ لانے والی چیز حرام ہے ۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3406-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3406-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3406-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3406-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf37","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3407,"bookHadithIndex":37,"text":"ام المؤمنین عائشہ رضی اللہ عنہا کہتی ہیں کہ انہوں نے سوال کیا: کیا تم میں سے کوئی عورت اس بات سے عاجز ہے کہ وہ ہر سال اپنی قربانی کے جانور کی کھال سے ایک مشک تیار کرے؟ پھر کہا: رسول اللہ صلی اللہ علیہ وسلم نے مٹی کے روغنی گھڑے میں نبیذ تیار کرنے سے منع فرمایا ہے، اور فلاں فلاں برتن میں بھی، البتہ ان میں سرکہ بنایا جا سکتا ہے۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3407-alalbani","name":"Al-Albani","grade":"Daif Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3407-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Daif Isnaad"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3407-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Daif"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3407-zubairalizai","name":"Zubair Ali Zai","grade":"Daif"}]},{"id":"69b6c8bfdd1a4c9c86f0cf38","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3408,"bookHadithIndex":38,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے مٹی کے روغنی برتنوں میں نبیذ تیار کرنے سے منع فرمایا ہے۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3408-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3408-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3408-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3408-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf39","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3409,"bookHadithIndex":39,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم کے پاس ایک ایسے گھڑے میں نبیذ لائی گئی جو جوش مار رہی تھی، آپ صلی اللہ علیہ وسلم نے فرمایا: اسے دیوار پر مار دو، اس لیے کہ یہ ایسے لوگوں کا مشروب ہے جو اللہ اور یوم آخرت پر ایمان نہیں رکھتے ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3409-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3409-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3409-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih"}]},{"id":"69b6c8bfdd1a4c9c86f0cf3a","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3410,"bookHadithIndex":40,"text":"جابر رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: برتن کو ڈھانک کر رکھو، مشک کا منہ بند کر کے رکھو، چراغ بجھا دو، اور دروازہ بند کر لو، اس لیے کہ شیطان نہ ایسی مشک کو کھولتا ہے، اور نہ ایسے دروازے کو اور نہ ہی ایسے برتن کو جو بند کر دیا گیا ہو، اب اگر تم میں سے کسی کو ڈھانکنے کے لیے لکڑی کے علاوہ کوئی چیز نہ ہو تو اسی کو «بسم الله» کہہ کر برتن پر آڑا رکھ دے، اس لیے کہ چوہیا لوگوں کے گھر جلا دیتی ہے ۱؎۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3410-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3410-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3410-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3410-zubairalizai","name":"Zubair Ali Zai","grade":"Sahih Muslim"}]},{"id":"69b6c8bfdd1a4c9c86f0cf3b","editionId":"69b55e8d6f42ba7ccb2a1324","bookIndex":30,"hadithIndex":3411,"bookHadithIndex":41,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے ہمیں برتن ڈھانکنے، مشک کا منہ بند کر دینے، اور برتن کو الٹ کر رکھنے کا حکم دیا ہے۔","grades":[{"id":"69b55e8d6f42ba7ccb2a1324-30-3411-alalbani","name":"Al-Albani","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3411-muhammadfouadabdalbaqi","name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3411-shuaibalarnaut","name":"Shuaib Al Arnaut","grade":"Sahih"},{"id":"69b55e8d6f42ba7ccb2a1324-30-3411-zuba
  "no": 97,
  "name": "سُورَةُ القَدۡرِ",
  "enName": "Al-Qadr",
  "enNameTranslation": "The Power, Fate",
  "bnNameTranslation": "আল কাদ্‌র",
  "revelationType": "Meccan",

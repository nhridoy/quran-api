ুক হয়ে গিয়েছিল। [কুরতুবী, ইবন কাসীর]</p>"},"audio":{"ar.abdullahbasfar":{"primary":"https://cdn.islamic.network/quran/audio/128/ar.abdullahbasfar/6.mp3","secondary":"https://cdn.islamic.network/quran/audio/64/ar.abdullahbasfar/6.mp3","tertiary":"https://cdn.islamic.app/quran/audio/ar.abdullahbasfar/6.mp3","local":"data/audio/107/ar.abdullahbasfar/6.mp3"},"ar.abdurrahmaansudais":{"primary":"https://cdn.islamic.network/quran/audio/128/ar.abdurrahmaansudais/6.mp3","secondary":"https://cdn.islamic.network/quran/audio/64/ar.abdurrahmaansudais/6.mp3","tertiary":"https://cdn.islamic.app/quran/audio/ar.abdurrahmaansudais/6.mp3","local":"data/audio/107/ar.abdurrahmaansudais/6.mp3"},"ar.abdulsamad":{"primary":"https://cdn.islamic.network/quran/audio/128/ar.abdulsamad/6.mp3","secondary":"https://cdn.islamic.network/quran/audio/64/ar.abdulsamad/6.mp3","tertiary":"https://cdn.islamic.app/quran/audio/ar.abdulsamad/6.mp3","local":"data/audio/107/ar.abdulsamad/6.mp3"},"ar.shaatree":{"primary":"https://cdn.islamic.network/quran/audio/128/ar.shaatree/6.mp3","secondary":"https://cdn.islamic.network/quran/audio/64/ar.shaatree/6.mp3","tertiary":"https://cdn.islamic.app/quran/audio/ar.shaatree/6.mp3","local":"data/audio/107/ar.shaatree/6.mp3"},"ar.ahmedajamy":{"primary":"https://cdn.islamic.network/quran/audio/128/ar.ahmedajamy/6.mp3","secondary":"https://cdn.islamic.network/quran/audio/64/ar.ahmedajamy/6.mp3","tertiary":"https://cdn.islamic.app/quran/audio/ar.ahmedajamy/6.mp3","local":"data/audio/107/ar.ahmedajamy/6.mp3"},"ar.alafasy":{"primary":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/6.mp3","secondary":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/6.mp3","tertiary":"https://cdn.islamic.app/quran/audio/ar.alafasy/6.mp3","local":"data/audio/107/ar.alafasy/6.mp3"},"ar.hanirifai":{"primary":"https://cdn.islamic.network/quran/audio/128/ar.hanirifai/6.mp3","secondary":"https://cdn.islamic.network/quran/audio/64/ar.hanirifai/6.mp3","tertiary":"https://cdn.islamic.ap
l/6.mp3","tertiary":"https://cdn.islamic.app/quran/audio/ar.muhammadjibreel/6.mp3","local":"data/audio/107/ar.muhammadjibreel/6.mp3"},"ar.saoodshuraym":{"primary":"https://cdn.islamic.network/quran/audio/128/ar.saoodshuraym/6.mp3","secondary":"https://cdn.islamic.network/quran/audio/64/ar.saoodshuraym/6.mp3","tertiary":"https://cdn.islamic.app/quran/audio/ar.saoodshuraym/6.mp3","local":"data/audio/107/ar.saoodshuraym/6.mp3"},"ar.parhizgar":{"primary":"https://cdn.islamic.network/quran/audio/128/ar.parhizgar/6.mp3","secondary":"https://cdn.islamic.network/quran/audio/64/ar.parhizgar/6.mp3","tertiary":"https://cdn.islamic.app/quran/audio/ar.parhizgar/6.mp3","local":"data/audio/107/ar.parhizgar/6.mp3"},"ar.aymanswoaid":{"primary":"https://cdn.islamic.network/quran/audio/128/ar.aymanswoaid/6.mp3","secondary":"https://cdn.islamic.network/quran/audio/64/ar.aymanswoaid/6.mp3","tertiary":"https://cdn.islamic.app/quran/audio/ar.aymanswoaid/6.mp3","local":"data/audio/107/ar.aymanswoaid/6.mp3"}},"image":{"primary":"http://cdn.islamic.network/quran/images/107_6.png","secondary":"http://cdn.islamic.network/quran/images/high-resolution/107_6.png","local":"data/images/107/6.png"}},{"totalNumber":6204,"numberInSurah":7,"juz":30,"sajda":{"recommended":false,"obligatory":false},"text":{"arText":"وَيَمْنَعُونَ الْمَاعُونَ","enText":"And withhold [simple] assistance.","enTextTransliteration":"Wa yamna'oonal ma'oon","bnText":"এবং নিত্য ব্যবহার্য্য বস্তু অন্যকে দেয় না।","bntextLatin":"ebam nitya byabaharyya bastu an'yake deya na."},"tafsir":{"en":"","bn":"<p>এবং মা‘উন [১] প্ৰদান করতে বিরত থাকে।</p><p>[১] ماعون শব্দের অর্থ অধিকাংশ মুফাসসিরদের নিকট যৎকিঞ্চিৎ ও সামান্য উপকারী বস্তু। মূলত: মাউন ছোট ও সামান্য পরিমাণ জিনিসকে বলা হয়। এমন ধরনের জিনিস যা লোকদের কোন কাজে লাগে বা এর থেকে তারা ফায়দা অর্জন করতে পারে। অধিকাংশ তাফসীরকারের মতে, সাধারণত প্রতিবেশীরা একজন আর একজনের কাছ থেকে দৈনন্দিন যেসব জিনিস চেয়ে নিয়ে থাকে, যেগুলোর পারস্পরিক লেন-দেন সাধারণ মানবতারূপে গণ্য হয়; যথা কুড়াল, কোদাল অথবা রান্না-বান্নার পাত্ৰ এ সবই মাউনের অন্তরভুক্ত। প্রয়োজনে এসব জিনিস প্রতিবেশীর কাছ থেকে চেয়ে নেয়া দোষণীয় মনে করা হয় না। কেউ এগুলো দিতে অস্বীকৃত হলে তাকে বড় কৃপণ ও নীচ মনে করা হয়। আবার কারও কারও মতে আলোচ্য আয়াতে ماعون বলে যাকাত বোঝানো হয়েছে। যাকাতকে ماعون বলার কারণ সম্ভবত এই যে, যাকাত পরিমাণে আসল অর্থের তুলনায় খুবই কম-অর্থাৎ চল্লিশ ভাগের এক ভাগ-হয়ে থাকে। ব্যবহার্য জিনিসপত্র অপরকে দেয়া খুব সওয়াবের কাজ এবং মানবতার দিক দিয়ে জরুরি। কোন কোন হাদীসে ماعون এর তাফসীর ব্যবহার্য জিনিস, যেমন: বালতি, পাত্র ইত্যাদি করা হয়েছে। [আবু দাঊদ: ১৬৫৭] [আদ্ওয়াউল বায়ান, মুয়াসসার, ফাতহুল কাদীর]</p>"},"audio":{"ar.abdullahbasfar":{"primary":"https://cdn.islamic.network/quran/audio/128/ar.abdullahbasfar/7.mp3","secondary":"https://cdn.islamic.network/quran/audio/64/ar.abdullahbasfar/7.mp3","tertiary":"https://cdn.islamic.app/quran/audio/ar.abdullahbasfar/7.mp3","local":"data/audio/107/ar.abdullahbasfar/7.mp3"},"ar.abdurrahmaansudais":{"primary":"https://cdn.islamic.network/quran/audio/128/ar.abdurrahmaansudais/7.mp3","secondary":"https://cdn.islamic.network/quran/audio/64/ar.abdurrahmaansudais/7.mp3","tertiary":"https://cdn.islamic.app/quran/audio/ar.abdurrahmaansudais/7.mp3","local":"data/audio/107/ar.abdurrahmaansudais/7.mp3"},"ar.abdulsamad":{"primary":"https://cdn.islamic.network/quran/audio/128/ar.abdulsamad/7.mp3","secondary":"https://cdn.islamic.network/quran/audio/64/ar.abdulsamad/7.mp3","tertiary":"https://cdn.islamic.app/quran/audio/ar.abdulsamad/7.mp3","local":"data/audio/107/ar.abdulsamad/7.mp3"},"ar.shaatree":{"primary":"https://cdn.islamic.network/quran/audio/128/ar.shaatree/7.mp3","secondary":"https://cdn.islamic.network/quran/audio/64/ar.shaatree/7.mp3","tertiary":"https://cdn.islamic.app/quran/audio/ar.shaatree/7.mp3","local":"data/audio/107/ar.shaatree/7.mp3"},"ar.ahmedajamy":{"primary":"https://cdn.islamic.network/quran/audio/128/ar.ahmedajamy/7.mp3","secondary":"https://cdn.islamic.network/quran/audio/64/ar.ahmedajamy/7.mp3","tertiary":"https://cdn.islamic.app
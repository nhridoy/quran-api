":"","bn":""},"audio":{"ar.abdullahbasfar":{"primary":"https://cdn.islamic.network/quran/audio/128/ar.abdullahbasfar/5.mp3","secondary":"https://cdn.islamic.network/quran/audio/64/ar.abdullahbasfar/5.mp3","tertiary":"https://cdn.islamic.app/quran/audio/ar.abdullahbasfar/5.mp3","local":"data/audio/98/ar.abdullahbasfar/5.mp3"},"ar.abdurrahmaansudais":{"primary":"https://cdn.islamic.network/quran/audio/128/ar.abdurrahmaansudais/5.mp3","secondary":"https://cdn.islamic.network/quran/audio/64/ar.abdurrahmaansudais/5.mp3","tertiary":"https://cdn.islamic.app/quran/audio/ar.abdurrahmaansudais/5.mp3","local":"data/audio/98/ar.abdurrahmaansudais/5.mp3"},"ar.abdulsamad":{"primary":"https://cdn.islamic.network/quran/audio/128/ar.abdulsamad/5.mp3","secondary":"https://cdn.islamic.network/quran/audio/64/ar.abdulsamad/5.mp3","tertiary":"https://cdn.islamic.app/quran/audio/ar.abdulsamad/5.mp3","local":"data/audio/98/ar.abdulsamad/5.mp3"},"ar.shaatree":{"primary":"https://cdn.islamic.network/quran/audio/128/ar.shaatree/5.mp3","secondary":"https://cdn.islamic.network/quran/audio/64/ar.shaatree/5.mp3","tertiary":"https://cdn.islamic.app/quran/audio/ar.shaatree/5.mp3","local":"data/audio/98/ar.shaatree/5.mp3"},"ar.ahmedajamy":{"primary":"https://cdn.islamic.network/quran/audio/128/ar.ahmedajamy/5.mp3","secondary":"https://cdn.islamic.network/quran/audio/64/ar.ahmedajamy/5.mp3","tertiary":"https://cdn.islamic.app/quran/audio/ar.ahmedajamy/5.mp3","local":"data/audio/98/ar.ahmedajamy/5.mp3"},"ar.alafasy":{"primary":"https://cdn.islamic.network/quran/audio/128/ar.alafasy/5.mp3","secondary":"https://cdn.islamic.network/quran/audio/64/ar.alafasy/5.mp3","tertiary":"https://cdn.islamic.app/quran/audio/ar.alafasy/5.mp3","local":"data/audio/98/ar.alafasy/5.mp3"},"ar.hanirifai":{"primary":"https://cdn.islamic.network/quran/audio/128/ar.hanirifai/5.mp3","secondary":"https://cdn.islamic.network/quran/audio/64/ar.hanirifai/5.mp3","tertiary":"https://cdn.islamic.app/quran/audio/ar.hanirifai/5.mp3","lo
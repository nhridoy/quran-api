{
  "no": 100,
  "name": "سُورَةُ العَادِيَاتِ",
  "enName": "Al-Aadiyaat",
  "enNameTranslation": "The Chargers",
  "bnNameTranslation": "আল আদিয়াত",
  "revelationType": "Meccan",
  "revelationOrder": 14,
  "numberOfAyahs": 11,
  "verses": [
    {
      "totalNumber": 6147,
      "numberInSurah": 1,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "وَالْعَادِيَاتِ ضَبْحًا",
        "enText": "By the racers, panting,",
        "enTextTransliteration": "Wal'aadi yaati dabha",
        "bnText": "শপথ উর্ধ্বশ্বাসে চলমান অশ্বসমূহের",
        "bntextLatin": "Sapatha urdhbasbase calamana asbasamuhera"
      }
    },
    {
      "totalNumber": 6148,
      "numberInSurah": 2,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "فَالْمُورِيَاتِ قَدْحًا",
        "enText": "And the producers of sparks [when] striking",
        "enTextTransliteration": "Fal moori yaati qadha",
        "bnText": "অতঃপর ক্ষুরাঘাতে অগ্নিবিচ্ছুরক অশ্বসমূহের",
        "bntextLatin": "atahpara ksuraghate agnibicchuraka asbasamuhera"
      }
    },
    {
      "totalNumber": 6149,
      "numberInSurah": 3,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "فَالْمُغِيرَاتِ صُبْحًا",
        "enText": "And the chargers at dawn,",
        "enTextTransliteration": "Fal mugheeraati subha",
        "bnText": "অতঃপর প্রভাতকালে আক্রমণকারী অশ্বসমূহের",
        "bntextLatin": "atahpara prabhatakale akramanakari asbasamuhera"
      }
    },
    {
      "totalNumber": 6150,
      "numberInSurah": 4,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "فَأَثَرْنَ بِهِ نَقْعًا",
        "enText": "Stirring up thereby [clouds of] dust,",
        "enTextTransliteration": "Fa atharna bihee naq'a",
        "bnText": "ও যারা সে সময়ে ধুলি উৎক্ষিপ্ত করে",
        "bntextLatin": "o yara se samaye dhuli utksipta kare"
      }
    },
    {
      "totalNumber": 6151,
      "numberInSurah": 5,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "فَوَسَطْنَ بِهِ جَمْعًا",
        "enText": "Arriving thereby in the center collectively,",
        "enTextTransliteration": "Fawa satna bihee jam'a",
        "bnText": "অতঃপর যারা শক্রদলের অভ্যন্তরে ঢুকে পড়ে",
        "bntextLatin": "atahpara yara sakradalera abhyantare dhuke pare"
      }
    },
    {
      "totalNumber": 6152,
      "numberInSurah": 6,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "إِنَّ الْإِنسَانَ لِرَبِّهِ لَكَنُودٌ",
        "enText": "Indeed mankind, to his Lord, is ungrateful.",
        "enTextTransliteration": "Innal-insana lirabbihee lakanood",
        "bnText": "নিশ্চয় মানুষ তার পালনকর্তার প্রতি অকৃতজ্ঞ।",
        "bntextLatin": "niscaya manusa tara palanakartara prati akrtajna."
      }
    },
    {
      "totalNumber": 6153,
      "numberInSurah": 7,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "وَإِنَّهُ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ",
        "enText": "And indeed, he is to that a witness.",
        "enTextTransliteration": "Wa innahu 'alaa zaalika la shaheed",
        "bnText": "এবং সে অবশ্য এ বিষয়ে অবহিত",
        "bntextLatin": "Ebam se abasya e bisaye abahita"
      }
    },
    {
      "totalNumber": 6154,
      "numberInSurah": 8,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "وَإِنَّهُ لِحُبِّ الْخَيْرِ لَشَدِيدٌ",
        "enText": "And indeed he is, in love of wealth, intense.",
        "enTextTransliteration": "Wa innahu lihubbil khairi la shadeed",
        "bnText": "এবং সে নিশ্চিতই ধন-সম্পদের ভালবাসায় মত্ত।",
        "bntextLatin": "ebam se niscita'i dhana-sampadera bhalabasaya matta."
      }
    },
    {
      "totalNumber": 6155,
      "numberInSurah": 9,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِي الْقُبُورِ",
        "enText": "But does he not know that when the contents of the graves are scattered",
        "enTextTransliteration": "Afala ya'lamu iza b'uthira ma filquboor",
        "bnText": "সে কি জানে না, যখন কবরে যা আছে, তা উত্থিত হবে",
        "bntextLatin": "Se ki jane na, yakhana kabare ya ache, ta ut'thita habe"
      }
    },
    {
      "totalNumber": 6156,
      "numberInSurah": 10,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "وَحُصِّلَ مَا فِي الصُّدُورِ",
        "enText": "And that within the breasts is obtained,",
        "enTextTransliteration": "Wa hussila maa fis sudoor",
        "bnText": "এবং অন্তরে যা আছে, তা অর্জন করা হবে",
        "bntextLatin": "ebam antare ya ache, ta arjana kara habe"
      }
    },
    {
      "totalNumber": 6157,
      "numberInSurah": 11,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌ",
        "enText": "Indeed, their Lord with them, that Day, is [fully] Acquainted.",
        "enTextTransliteration": "Inna rabbahum bihim yauma 'izil la khabeer",
        "bnText": "সেদিন তাদের কি হবে, সে সম্পর্কে তাদের পালনকর্তা সবিশেষ জ্ঞাত।",
        "bntextLatin": "sedina tadera ki habe, se samparke tadera palanakarta sabisesa jnata."
      }
    }
  ]
}
{
  "no": 96,
  "name": "سُورَةُ العَلَقِ",
  "enName": "Al-Alaq",
  "enNameTranslation": "The Clot",
  "bnNameTranslation": "আল আলাক",
  "revelationType": "Meccan",
  "revelationOrder": 1,
  "numberOfAyahs": 19,
  "verses": [
    {
      "totalNumber": 6107,
      "numberInSurah": 1,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "اقْرَأْ بِاسْمِ رَبِّكَ الَّذِي خَلَقَ",
        "enText": "Recite in the name of your Lord who created -",
        "enTextTransliteration": "Iqra bismi rab bikal lazee khalaq",
        "bnText": "পাঠ করুন আপনার পালনকর্তার নামে যিনি সৃষ্টি করেছেন",
        "bntextLatin": "patha karuna apanara palanakartara name yini srsti karechena"
      }
    },
    {
      "totalNumber": 6108,
      "numberInSurah": 2,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "خَلَقَ الْإِنسَانَ مِنْ عَلَقٍ",
        "enText": "Created man from a clinging substance.",
        "enTextTransliteration": "Khalaqal insaana min 'alaq",
        "bnText": "সৃষ্টি করেছেন মানুষকে জমাট রক্ত থেকে।",
        "bntextLatin": "srsti karechena manusake jamata rakta theke."
      }
    },
    {
      "totalNumber": 6109,
      "numberInSurah": 3,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "اقْرَأْ وَرَبُّكَ الْأَكْرَمُ",
        "enText": "Recite, and your Lord is the most Generous -",
        "enTextTransliteration": "Iqra wa rab bukal akram",
        "bnText": "পাঠ করুন, আপনার পালনকর্তা মহা দয়ালু",
        "bntextLatin": "Patha karuna, apanara palanakarta maha dayalu"
      }
    },
    {
      "totalNumber": 6110,
      "numberInSurah": 4,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "الَّذِي عَلَّمَ بِالْقَلَمِ",
        "enText": "Who taught by the pen -",
        "enTextTransliteration": "Al lazee 'allama bil qalam",
        "bnText": "যিনি কলমের সাহায্যে শিক্ষা দিয়েছেন",
        "bntextLatin": "yini kalamera sahayye siksa diyechena"
      }
    },
    {
      "totalNumber": 6111,
      "numberInSurah": 5,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "عَلَّمَ الْإِنسَانَ مَا لَمْ يَعْلَمْ",
        "enText": "Taught man that which he knew not.",
        "enTextTransliteration": "'Al lamal insaana ma lam y'alam",
        "bnText": "শিক্ষা দিয়েছেন মানুষকে যা সে জানত না।",
        "bntextLatin": "siksa diyechena manusake ya se janata na."
      }
    },
    {
      "totalNumber": 6112,
      "numberInSurah": 6,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "كَلَّا إِنَّ الْإِنسَانَ لَيَطْغَىٰ",
        "enText": "No! [But] indeed, man transgresses",
        "enTextTransliteration": "Kallaa innal insaana layatghaa",
        "bnText": "সত্যি সত্যি মানুষ সীমালংঘন করে",
        "bntextLatin": "Satyi satyi manusa simalanghana kare"
      }
    },
    {
      "totalNumber": 6113,
      "numberInSurah": 7,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "أَن رَّآهُ اسْتَغْنَىٰ",
        "enText": "Because he sees himself self-sufficient.",
        "enTextTransliteration": "Ar-ra aahus taghnaa",
        "bnText": "এ কারণে যে, সে নিজেকে অভাবমুক্ত মনে করে।",
        "bntextLatin": "e karane ye, se nijeke abhabamukta mane kare."
      }
    },
    {
      "totalNumber": 6114,
      "numberInSurah": 8,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "إِنَّ إِلَىٰ رَبِّكَ الرُّجْعَىٰ",
        "enText": "Indeed, to your Lord is the return.",
        "enTextTransliteration": "Innna ilaa rabbikar ruj'aa",
        "bnText": "নিশ্চয় আপনার পালনকর্তার দিকেই প্রত্যাবর্তন হবে।",
        "bntextLatin": "Niscaya apanara palanakartara dike'i pratyabartana habe."
      }
    },
    {
      "totalNumber": 6115,
      "numberInSurah": 9,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "أَرَأَيْتَ الَّذِي يَنْهَىٰ",
        "enText": "Have you seen the one who forbids",
        "enTextTransliteration": "Ara-aital lazee yanhaa",
        "bnText": "আপনি কি তাকে দেখেছেন, যে নিষেধ করে",
        "bntextLatin": "Apani ki take dekhechena, ye nisedha kare"
      }
    },
    {
      "totalNumber": 6116,
      "numberInSurah": 10,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "عَبْدًا إِذَا صَلَّىٰ",
        "enText": "A servant when he prays?",
        "enTextTransliteration": "'Abdan iza sallaa",
        "bnText": "এক বান্দাকে যখন সে নামায পড়ে",
        "bntextLatin": "eka bandake yakhana se namaya pare"
      }
    },
    {
      "totalNumber": 6117,
      "numberInSurah": 11,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "أَرَأَيْتَ إِن كَانَ عَلَى الْهُدَىٰ",
        "enText": "Have you seen if he is upon guidance",
        "enTextTransliteration": "Ara-aita in kana 'alal hudaa",
        "bnText": "আপনি কি দেখেছেন যদি সে সৎপথে থাকে।",
        "bntextLatin": "apani ki dekhechena yadi se satpathe thake."
      }
    },
    {
      "totalNumber": 6118,
      "numberInSurah": 12,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "أَوْ أَمَرَ بِالتَّقْوَىٰ",
        "enText": "Or enjoins righteousness?",
        "enTextTransliteration": "Au amara bit taqwaa",
        "bnText": "অথবা খোদাভীতি শিক্ষা দেয়।",
        "bntextLatin": "Athaba khodabhiti siksa deya."
      }
    },
    {
      "totalNumber": 6119,
      "numberInSurah": 13,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "أَرَأَيْتَ إِن كَذَّبَ وَتَوَلَّىٰ",
        "enText": "Have you seen if he denies and turns away -",
        "enTextTransliteration": "Ara-aita in kaz zaba wa ta walla",
        "bnText": "আপনি কি দেখেছেন, যদি সে মিথ্যারোপ করে ও মুখ ফিরিয়ে নেয়।",
        "bntextLatin": "Apani ki dekhechena, yadi se mithyaropa kare o mukha phiriye neya."
      }
    },
    {
      "totalNumber": 6120,
      "numberInSurah": 14,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "أَلَمْ يَعْلَم بِأَنَّ اللَّهَ يَرَىٰ",
        "enText": "Does he not know that Allah sees?",
        "enTextTransliteration": "Alam y'alam bi-an nal lahaa yaraa",
        "bnText": "সে কি জানে না যে, আল্লাহ দেখেন",
        "bntextLatin": "Se ki jane na ye, allaha dekhena"
      }
    },
    {
      "totalNumber": 6121,
      "numberInSurah": 15,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًا بِالنَّاصِيَةِ",
        "enText": "No! If he does not desist, We will surely drag him by the forelock -",
        "enTextTransliteration": "Kalla la illam yantahi la nasfa'am bin nasiyah",
        "bnText": "কখনই নয়, যদি সে বিরত না হয়, তবে আমি মস্তকের সামনের কেশগুচ্ছ ধরে হেঁচড়াবই",
        "bntextLatin": "kakhana'i naya, yadi se birata na haya, tabe ami mastakera samanera kesaguccha dhare hemcaraba'i"
      }
    },
    {
      "totalNumber": 6122,
      "numberInSurah": 16,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "نَاصِيَةٍ كَاذِبَةٍ خَاطِئَةٍ",
        "enText": "A lying, sinning forelock.",
        "enTextTransliteration": "Nasiyatin kazi batin khaatiyah",
        "bnText": "মিথ্যাচারী, পাপীর কেশগুচ্ছ।",
        "bntextLatin": "mithyacari, papira kesaguccha."
      }
    },
    {
      "totalNumber": 6123,
      "numberInSurah": 17,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "فَلْيَدْعُ نَادِيَهُ",
        "enText": "Then let him call his associates;",
        "enTextTransliteration": "Fal yad'u naadiyah",
        "bnText": "অতএব, সে তার সভাসদদেরকে আহবান করুক।",
        "bntextLatin": "Ata'eba, se tara sabhasadaderake ahabana karuka."
      }
    },
    {
      "totalNumber": 6124,
      "numberInSurah": 18,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "سَنَدْعُ الزَّبَانِيَةَ",
        "enText": "We will call the angels of Hell.",
        "enTextTransliteration": "Sanad 'uz zabaaniyah",
        "bnText": "আমিও আহবান করব জাহান্নামের প্রহরীদেরকে",
        "bntextLatin": "Ami'o ahabana karaba jahannamera prahariderake"
      }
    },
    {
      "totalNumber": 6125,
      "numberInSurah": 19,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": true
      },
      "text": {
        "arText": "كَلَّا لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِب ۩",
        "enText": "No! Do not obey him. But prostrate and draw near [to Allah].",
        "enTextTransliteration": "Kalla; la tuti'hu wasjud waqtarib",
        "bnText": "কখনই নয়, আপনি তার আনুগত্য করবেন না। আপনি সেজদা করুন ও আমার নৈকট্য অর্জন করুন।",
        "bntextLatin": "kakhana'i naya, apani tara anugatya karabena na. Apani sejada karuna o amara naikatya arjana karuna."
      }
    }
  ]
}
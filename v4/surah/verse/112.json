        "obligatory": false
      },
      "text": {
        "arText": "قُلْ هُوَ اللَّهُ أَحَدٌ",
        "enText": "Say, \"He is Allah, [who is] One,",
        "enTextTransliteration": "Qul huwal laahu ahad",
        "bnText": "বলুন, তিনি আল্লাহ, এক",
        "bntextLatin": "Baluna, tini allaha, eka"
      }
    },
    {
      "totalNumber": 6223,
      "numberInSurah": 2,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "اللَّهُ الصَّمَدُ",
        "enText": "Allah, the Eternal Refuge.",
        "enTextTransliteration": "Allah hus-samad",
        "bnText": "আল্লাহ অমুখাপেক্ষী",
        "bntextLatin": "allaha amukhapeksi"
      }
    },
    {
      "totalNumber": 6224,
      "numberInSurah": 3,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "لَمْ يَلِدْ وَلَمْ يُولَدْ",
        "enText": "He neither begets nor is born,",
        "enTextTransliteration": "Lam yalid wa lam yoolad",
        "bnText": "তিনি কাউকে জন্ম দেননি এবং কেউ তাকে জন্ম দেয়নি",
        "bntextLatin": "tini ka'uke janma denani ebam ke'u take janma deyani"
      }
    },
    {
      "totalNumber": 6225,
      "numberInSurah": 4,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "وَلَمْ يَكُن لَّهُ كُفُوًا أَحَدٌ",
        "enText": "Nor is there to Him any equivalent.\"",
        "enTextTransliteration": "Wa lam yakul-lahu kufuwan ahad",
        "bnText": "এবং তার সমতুল্য কেউ নেই।",
        "bntextLatin": "ebam tara samatulya ke'u ne'i."
      }
    }
  ]
}
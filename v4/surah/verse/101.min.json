{"no":101,"name":"سُورَةُ القَارِعَةِ","enName":"Al-Qaari'a","enNameTranslation":"The Calamity","bnNameTranslation":"আল কারি’আহ","revelationType":"Meccan","revelationOrder":30,"numberOfAyahs":11,"verses":[{"totalNumber":6158,"numberInSurah":1,"juz":30,"sajda":{"recommended":false,"obligatory":false},"text":{"arText":"الْقَارِعَةُ","enText":"The Striking Calamity -","enTextTransliteration":"Al qaari'ah","bnText":"করাঘাতকারী","bntextLatin":"Karaghatakari"}},{"totalNumber":6159,"numberInSurah":2,"juz":30,"sajda":{"recommended":false,"obligatory":false},"text":{"arText":"مَا الْقَارِعَةُ","enText":"What is the Striking Calamity?","enTextTransliteration":"Mal qaariah","bnText":"করাঘাতকারী কি","bntextLatin":"karaghatakari ki"}},{"totalNumber":6160,"numberInSurah":3,"juz":30,"sajda":{"recommended":false,"obligatory":false},"text":{"arText":"وَمَا أَدْرَاكَ مَا الْقَارِعَةُ","enText":"And what can make you know what is the Striking Calamity?","enTextTransliteration":"Wa maa adraaka mal qaari'ah","bnText":"করাঘাতকারী সম্পর্কে আপনি কি জানেন","bntextLatin":"karaghatakari samparke apani ki janena"}},{"totalNumber":6161,"numberInSurah":4,"juz":30,"sajda":{"recommended":false,"obligatory":false},"text":{"arText":"يَوْمَ يَكُونُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوثِ","enText":"It is the Day when people will be like moths, dispersed,","enTextTransliteration":"Yauma ya koonun naasu kal farashil mabthooth","bnText":"যেদিন মানুষ হবে বিক্ষিপ্ত পতংগের মত","bntextLatin":"yedina manusa habe biksipta patangera mata"}},{"totalNumber":6162,"numberInSurah":5,"juz":30,"sajda":{"recommended":false,"obligatory":false},"text":{"arText":"وَتَكُونُ الْجِبَالُ كَالْعِهْنِ الْمَنفُوشِ","enText":"And the mountains will be like wool, fluffed up.","enTextTransliteration":"Wa ta koonul jibalu kal 'ihnil manfoosh","bnText":"এবং পর্বতমালা হবে ধুনিত রঙ্গীন পশমের মত।","bntextLatin":"ebam parbatamala habe dhunita rangina pasamera mata."}},{"totalNumber":6163,"numberInSurah":6,"juz":30,"sajda":{"recommended":false,"obligatory":false},"text":{"arText":"فَأَمَّا مَن ثَقُلَتْ مَوَازِينُهُ","enText":"Then as for one whose scales are heavy [with good deeds],","enTextTransliteration":"Fa-amma man thaqulat mawa zeenuh","bnText":"অতএব যার পাল্লা ভারী হবে","bntextLatin":"Ata'eba yara palla bhari habe"}},{"totalNumber":6164,"numberInSurah":7,"juz":30,"sajda":{"recommended":false,"obligatory":false},"text":{"arText":"فَهُوَ فِي عِيشَةٍ رَّاضِيَةٍ","enText":"He will be in a pleasant life.","enTextTransliteration":"Fahuwa fee 'ishatir raadiyah","bnText":"সে সুখীজীবন যাপন করবে।","bntextLatin":"se sukhijibana yapana karabe."}},{"totalNumber":6165,"numberInSurah":8,"juz":30,"sajda":{"recommended":false,"obligatory":false},"text":{"arText":"وَأَمَّا مَنْ خَفَّتْ مَوَازِينُهُ","enText":"But as for one whose scales are light,","enTextTransliteration":"Wa amma man khaffat mawa zeenuh","bnText":"আর যার পাল্লা হালকা হবে","bntextLatin":"Ara yara palla halaka habe"}},{"totalNumber":6166,"numberInSurah":9,"juz":30,"sajda":{"recommended":false,"obligatory":false},"text":{"arText":"فَأُمُّهُ هَاوِيَةٌ","enText":"His refuge will be an abyss.","enTextTransliteration":"Fa-ummuhu haawiyah","bnText":"তার ঠিকানা হবে হাবিয়া।","bntextLatin":"tara thikana habe habiya."}},{"totalNumber":6167,"numberInSurah":10,"juz":30,"sajda":{"recommended":false,"obligatory":false},"text":{"arText":"وَمَا أَدْرَاكَ مَا هِيَهْ","enText":"And what can make you know what that is?","enTextTransliteration":"Wa maa adraaka maa hiyah","bnText":"আপনি জানেন তা কি","bntextLatin":"Apani janena ta ki"}},{"totalNumber":6168,"numberInSurah":11,"juz":30,"sajda":{"recommended":false,"obligatory":false},"text":{"arText":"نَارٌ حَامِيَةٌ","enText":"It is a Fire, intensely hot.","enTextTransliteration":"Naarun hamiyah","bnText":"প্রজ্জ্বলিত অগ্নি","bntextLatin":"prajjbalita agni"}}]}
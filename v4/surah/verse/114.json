{
  "no": 114,
  "name": "سُورَةُ النَّاسِ",
  "enName": "An-Naas",
  "enNameTranslation": "Mankind",
  "bnNameTranslation": "আন নাস",
  "revelationType": "Meccan",
  "revelationOrder": 21,
  "numberOfAyahs": 6,
  "verses": [
    {
      "totalNumber": 6231,
      "numberInSurah": 1,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "قُلْ أَعُوذُ بِرَبِّ النَّاسِ",
        "enText": "Say, \"I seek refuge in the Lord of mankind,",
        "enTextTransliteration": "Qul a'uzu birabbin naas",
        "bnText": "বলুন, আমি আশ্রয় গ্রহণ করিতেছি মানুষের পালনকর্তার",
        "bntextLatin": "Baluna, ami asraya grahana karitechi manusera palanakartara"
      }
    },
    {
      "totalNumber": 6232,
      "numberInSurah": 2,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "مَلِكِ النَّاسِ",
        "enText": "The Sovereign of mankind.",
        "enTextTransliteration": "Malikin naas",
        "bnText": "মানুষের অধিপতির",
        "bntextLatin": "manusera adhipatira"
      }
    },
    {
      "totalNumber": 6233,
      "numberInSurah": 3,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "إِلَٰهِ النَّاسِ",
        "enText": "The God of mankind,",
        "enTextTransliteration": "Ilaahin naas",
        "bnText": "মানুষের মা’বুদের",
        "bntextLatin": "manusera ma’budera"
      }
    },
    {
      "totalNumber": 6234,
      "numberInSurah": 4,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "مِن شَرِّ الْوَسْوَاسِ الْخَنَّاسِ",
        "enText": "From the evil of the retreating whisperer -",
        "enTextTransliteration": "Min sharril was waasil khannaas",
        "bnText": "তার অনিষ্ট থেকে, যে কুমন্ত্রণা দেয় ও আত্নগোপন করে",
        "bntextLatin": "tara anista theke, ye kumantrana deya o atnagopana kare"
      }
    },
    {
      "totalNumber": 6235,
      "numberInSurah": 5,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ",
        "enText": "Who whispers [evil] into the breasts of mankind -",
        "enTextTransliteration": "Al lazee yuwas wisu fee sudoorin naas",
        "bnText": "যে কুমন্ত্রণা দেয় মানুষের অন্তরে",
        "bntextLatin": "ye kumantrana deya manusera antare"
      }
    },
    {
      "totalNumber": 6236,
      "numberInSurah": 6,
      "juz": 30,
      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text": {
        "arText": "مِنَ الْجِنَّةِ وَالنَّاسِ",
        "enText": "From among the jinn and mankind.\"",
        "enTextTransliteration": "Minal jinnati wan naas",
        "bnText": "জ্বিনের মধ্য থেকে অথবা মানুষের মধ্য থেকে।",
        "bntextLatin": "jbinera madhya theke athaba manusera madhya theke."
      }
    }
  ]
}
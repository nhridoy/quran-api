    {
      "totalNumber": 5571,
      "numberInSurah": 20,
      "juz": 29,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "ليس الأمر كما زعمتم -يا معشر المشركين- أن لا بعث ولا جزاء، بل أنتم قوم تحبون الدنيا وزينتها، وتتركون الآخرة ونعيمها."
    },
    {
      "totalNumber": 5572,
      "numberInSurah": 21,
      "juz": 29,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "ليس الأمر كما زعمتم- يا معشر المشركين- أن لا بعث ولا جزاء، بل أنتم قوم تحبون الدنيا وزينتها، وتتركون الآخرة ونعيمها."
    },
    {
      "totalNumber": 5573,
      "numberInSurah": 22,
      "juz": 29,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "وجوه أهل السعادة يوم القيامة مشرقة حسنة ناعمة، ترى خالقها ومالك أمرها، فتتمتع بذلك."
    },
    {
      "totalNumber": 5574,
      "numberInSurah": 23,
      "juz": 29,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": ""
    },
    {
      "totalNumber": 5575,
      "numberInSurah": 24,
      "juz": 29,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "ووجوه الأشقياء يوم القيامة عابسة كالحة، تتوقع أن تنزل بها مصيبة عظيمة، تقصم فَقَار الظَّهْر."
    },
    {
      "totalNumber": 5576,
      "numberInSurah": 25,
      "juz": 29,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": ""
    },
    {
      "totalNumber": 5577,
      "numberInSurah": 26,
      "juz": 29,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "حقًّا إذا وصلت الروح إلى أعالي الصدر،<span class=\"blue\"> وقال بعض الحاضرين لبعض:</span> هل مِن راق يَرْقيه ويَشْفيه مما هو فيه؟ وأيقن المحتضر أنَّ الذي نزل به هو فراق الدنيا؛ لمعاينته ملائكة الموت، واتصلت شدة آخر الدنيا بشدة أول الآخرة،<span class=\"blue\"> إلى الله تعالى مساق العباد يوم القيامة:</span> إما إلى الجنة وإما إلى النار."
    },

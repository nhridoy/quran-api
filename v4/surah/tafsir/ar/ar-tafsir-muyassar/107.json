      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "أرأيت حال ذلك الذي يكذِّب بالبعث والجزاء؟"
    },
    {
      "totalNumber": 6199,
      "numberInSurah": 2,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "فذلك الذي يدفع اليتيم الذي مات أبوه وهو صغير بعنف وشدة عن حقه؛ لقساوة قلبه."
    },
    {
      "totalNumber": 6200,
      "numberInSurah": 3,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "ولا يحضُّ غيره على إطعام المحتاج الذي لا يملك ما يكفيه ويسد حاجته، فكيف له أن يطعمه بنفسه؟"
    },
    {
      "totalNumber": 6201,
      "numberInSurah": 4,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "فعذاب شديد للمصلين الذين هم عن صلاتهم لاهون، لا يقيمونها على وجهها، ولا يؤدونها في وقتها."
    },
    {
      "totalNumber": 6202,
      "numberInSurah": 5,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",

    {
      "totalNumber": 5999,
      "numberInSurah": 6,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "ألم تر -أيها الرسول- كيف فعل ربُّك بقوم عاد، قبيلة إرم، ذات القوة والأبنية المرفوعة على الأعمدة، التي لم يُخلق مثلها في البلاد في عِظَم الأجساد وقوة البأس؟"
    },
    {
      "totalNumber": 6000,
      "numberInSurah": 7,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": ""
    },
    {
      "totalNumber": 6001,
      "numberInSurah": 8,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": ""
    },
    {
      "totalNumber": 6002,
      "numberInSurah": 9,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "وكيف فعل بثمود قوم صالح الذين قطعوا الصخر بالوادي واتخذوا منه بيوتًا؟"
    },
    {
      "totalNumber": 6003,
      "numberInSurah": 10,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "وكيف فعل بفرعون مَلِك <span class=\"brown\">«مصر»</span> ، صاحب الجنود الذين ثبَّتوا مُلْكه، وقوَّوا له أمره؟"
    },
    {
      "totalNumber": 6004,
      "numberInSurah": 11,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "هؤلاء الذين استبدُّوا، وظلموا في بلاد الله، فأكثروا فيها بظلمهم الفساد، فصب عليهم ربُّك عذابا شديدا. إنَّ ربك -أيها الرسول- لبالمرصاد لمن يعصيه، يمهله قليلا ثم يأخذه أخْذَ عزيز مقتدر."
    },
    {
      "totalNumber": 6005,
      "numberInSurah": 12,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": ""
    },
    {
      "totalNumber": 6006,
      "numberInSurah": 13,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": ""
    },
    {
      "totalNumber": 6007,
      "numberInSurah": 14,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": ""
    },
    {
      "totalNumber": 6008,
      "numberInSurah": 15,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "فأما الإنسان إذا ما اختبره ربه بالنعمة، وبسط له رزقه، وجعله في أطيب عيش، فيظن أن ذلك لكرامته عند ربه،<span class=\"blue\"> فيقول:</span> ربي أكرمن."
    },
    {
      "totalNumber": 6009,
      "numberInSurah": 16,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "وأما إذا ما اختبره، فضيَّق عليه رزقه، فيظن أن ذلك لهوانه على الله،<span class=\"blue\"> فيقول:</span> ربي أهانن."
    },
    {
      "totalNumber": 6010,
      "numberInSurah": 17,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "ليس الأمر كما يظن هذا الإنسان، بل الإكرام بطاعة الله، والإهانة بمعصيته، وأنتم لا تكرمون اليتيم الذي مات أبوه وهو صغير، ولا تحسنون معاملته، ولا يَحُثُّ بعضكم بعضًا على إطعام المحتاج الذي لا يملك ما يكفيه ويسد حاجته، وتأكلون حقوق الآخرين في الميراث أكلا شديدًا، وتحبون المال حبًا مفرطًا."
    },
    {
      "totalNumber": 6011,
      "numberInSurah": 18,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "ليس الأمر كما يظن هذا الإنسان، بل الإكرام بطاعة الله، والإهانة بمعصيته، وأنتم لا تكرمون اليتيم، ولا تحسنون معاملته، ولا يَحُثُّ بعضكم بعضًا على إطعام المسكين، وتأكلون حقوق الآخرين في الميراث أكلا شديدًا، وتحبون المال حبًا مفرطًا."
    },
    {
      "totalNumber": 6012,
      "numberInSurah": 19,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": ""
    },
    {
      "totalNumber": 6013,
      "numberInSurah": 20,
      "juz": 30,
      "lang": "Arabic",

      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "أفرأيتم النار التي توقدون، أأنتم أوجدتم شجرتها التي تقدح منها النار، أم نحن الموجدون لها؟"
    },
    {
      "totalNumber": 5051,
      "numberInSurah": 72,
      "juz": 27,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",

      "tafsir": ""
    },
    {
      "totalNumber": 5033,
      "numberInSurah": 54,
      "juz": 27,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": ""
    },
    {
      "totalNumber": 5034,
      "numberInSurah": 55,
      "juz": 27,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": ""
    },
    {
      "totalNumber": 5035,
      "numberInSurah": 56,
      "juz": 27,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "هذا الذي يلقونه من العذاب هو ما أُعدَّ لهم من الزاد يوم القيامة. وفي هذا توبيخ لهم وتهكُّم بهم."
    },
    {
      "totalNumber": 5036,
      "numberInSurah": 57,
      "juz": 27,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "نحن خلقناكم -أيها الناس- ولم تكونوا شيئًا، فهلا تصدِّقون بالبعث."
    },
    {
      "totalNumber": 5037,
      "numberInSurah": 58,
      "juz": 27,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "أفرأيتم النُّطَف التي تقذفونها في أرحام نسائكم، هل أنتم تخلقون ذلك بشرًا أم نحن الخالقون؟"
    },
    {
      "totalNumber": 5038,
      "numberInSurah": 59,
      "juz": 27,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": ""
    },
    {
      "totalNumber": 5039,
      "numberInSurah": 60,
      "juz": 27,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "نحن قَدَّرنا بينكم الموت، وما نحن بعاجزين عن أن نغيِّر خلقكم يوم القيامة، وننشئكم فيما لا تعلمونه من الصفات والأحوال."
    },
    {
      "totalNumber": 5040,
      "numberInSurah": 61,
      "juz": 27,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": ""
    },
    {
      "totalNumber": 5041,
      "numberInSurah": 62,
      "juz": 27,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "ولقد علمتم أن الله أنشأكم النشأة الأولى ولم تكونوا شيئًا، فهلا تذكَّرون قدرة الله على إنشائكم مرة أخرى."
    },
    {
      "totalNumber": 5042,
      "numberInSurah": 63,
      "juz": 27,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "أفرأيتم الحرث الذي تحرثونه هل أنتم تُنبتونه في الأرض؟ بل نحن نُقِرُّ قراره وننبته في الأرض؟ لو نشاء لجعلنا ذلك الزرع هشيمًا، لا يُنتفع به في مطعم، فأصبحتم تتعجبون مما نزل بزرعكم،<span class=\"blue\"> وتقولون:</span> إنا لخاسرون معذَّبون، بل نحن محرومون من الرزق."

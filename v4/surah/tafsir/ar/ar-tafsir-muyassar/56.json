    },
    {
      "totalNumber": 5014,
      "numberInSurah": 35,
      "juz": 27,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "إنا أنشأنا نساء أهل الجنة نشأة غير النشأة التي كانت في الدنيا، نشأة كاملة لا تقبل الفناء، فجعلناهن أبكارًا، متحببات إلى أزواجهن، في سنٍّ واحدة، خلقناهن لأصحاب اليمين."
    },
    {
      "totalNumber": 5015,
      "numberInSurah": 36,
      "juz": 27,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": ""
    },
    {
      "totalNumber": 5016,

    {
      "totalNumber": 5900,
      "numberInSurah": 16,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "أقسم الله تعالى باحمرار الأفق عند الغروب، وبالليل وما جمع من الدواب والحشرات والهوام وغير ذلك، وبالقمر إذا تكامل نوره، لتركبُنَّ -أيها الناس-<span class=\"blue\"> أطوارا متعددة وأحوالا متباينة:</span> من النطفة إلى العلقة إلى المضغة إلى نفخ الروح إلى الموت إلى البعث والنشور. ولا يجوز للمخلوق أن يقسم بغير الله، ولو فعل ذلك لأشرك."
    },
    {
      "totalNumber": 5901,
      "numberInSurah": 17,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "أقسم الله تعالى باحمرار الأفق عند الغروب، وبالليل وما جمع من الدواب والحشرات والهوام وغير ذلك، وبالقمر إذا تكامل نوره، لتركبُنَّ- أيها الناس-<span class=\"blue\"> أطوارا متعددة وأحوالا متباينة:</span> من النطفة إلى العلقة إلى المضغة إلى نفخ الروح إلى الموت إلى البعث والنشور. ولا يجوز للمخلوق أن يقسم بغير الله، ولو فعل ذلك لأشرك."

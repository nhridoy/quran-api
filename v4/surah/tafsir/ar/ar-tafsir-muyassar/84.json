  "name": "سُورَةُ الانشِقَاقِ",
  "enName": "Al-Inshiqaaq",
  "enNameTranslation": "The Splitting Open",
  "bnNameTranslation": "আল ইনশিকাক",
  "revelationType": "Meccan",

{"no":81,"name":"سُورَةُ التَّكۡوِيرِ","enName":"At-Takwir","enNameTranslation":"The Overthrowing","bnNameTranslation":"আত তাকবীর","revelationType":"Meccan","revelationOrder":7,"numberOfAyahs":29,"verses":[{"totalNumber":5801,"numberInSurah":1,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":"إذا الشمس لُفَّت وذهب ضَوْءُها، وإذا النجوم تناثرت، فذهب نورها، وإذا الجبال سيِّرت عن وجه الأرض فصارت هباءً منبثًا، وإذا النوق الحوامل تُركت وأهملت، وإذا الحيوانات الوحشية جُمعت واختلطت؛ ليقتصَّ الله من بعضها لبعض، وإذا البحار أوقدت، فصارت على عِظَمها نارًا تتوقد، وإذا النفوس قُرنت بأمثالها ونظائرها،<span class=\"blue\"> وإذا الطفلة المدفونة حية سُئلت يوم القيامة سؤالَ تطييب لها وتبكيت لوائدها:</span> بأيِّ ذنب كان دفنها؟ وإذا صحف الأعمال عُرضت، وإذا السماء قُلعت وأزيلت من مكانها، وإذا النار أوقدت فأضرِمت، وإذا الجنة دار النعيم قُرِّبت من أهلها المتقين، إذا وقع ذلك، تيقنتْ ووجدتْ كلُّ نفس ما قدَّمت من خير أو شر."},{"totalNumber":5802,"numberInSurah":2,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":""},{"totalNumber":5803,"numberInSurah":3,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":""},{"totalNumber":5804,"numberInSurah":4,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":""},{"totalNumber":5805,"numberInSurah":5,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":""},{"totalNumber":5806,"numberInSurah":6,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":""},{"totalNumber":5807,"numberInSurah":7,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":""},{"totalNumber":5808,"numberInSurah":8,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":""},{"totalNumber":5809,"numberInSurah":9,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":""},{"totalNumber":5810,"numberInSurah":10,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":""},{"totalNumber":5811,"numberInSurah":11,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":""},{"totalNumber":5812,"numberInSurah":12,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":""},{"totalNumber":5813,"numberInSurah":13,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":""},{"totalNumber":5814,"numberInSurah":14,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":""},{"totalNumber":5815,"numberInSurah":15,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":"أقسم الله تعالى بالنجوم المختفية أنوارها نهارًا، الجارية والمستترة في أبراجها، والليل إذا أقبل بظلامه، والصبح إذا ظهر ضياؤه، إن القرآن لَتبليغ رسول كريم -هو جبريل عليه السلام-، ذِي قوة في تنفيذ ما يؤمر به، صاحبِ مكانة رفيعة عند الله، تطيعه الملائكة، مؤتمن على الوحي الذي ينزل به."},{"totalNumber":5816,"numberInSurah":16,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":"أقسم الله تعالى بالنجوم المختفية أنوارها نهارًا، الجارية والمستترة في أبراجها، والليل إذا أقبل بظلامه، والصبح إذا ظهر ضياؤه، إن القرآن لَتبليغ رسول كريم- هو جبريل عليه السلام-، ذِي قوة في تنفيذ ما يؤمر به، صاحبِ مكانة رفيعة عند الله، تطيعه الملائكة، مؤتمن على الوحي الذي ينزل به."},{"totalNumber":5817,"numberInSurah":17,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":""},{"totalNumber":5818,"numberInSurah":18,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":""},{"totalNumber":5819,"numberInSurah":19,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":""},{"totalNumber":5820,"numberInSurah":20,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":""},{"totalNumber":5821,"numberInSurah":21,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":""},{"totalNumber":5822,"numberInSurah":22,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":"وما محمد الذي تعرفونه بمجنون، ولقد رأى محمد صلى الله عليه وسلم جبريل الذي يأتيه بالرسالة على صورته الحقيقية التي خلقه الله عليها في الأفق العظيم من ناحية المشرق بـ <span class=\"brown\">«مكة»</span> ، وهي الرؤية الأولى الواقعة بـ <span class=\"brown\">«غار حراء»</span> . وما محمد صلى الله عليه وسلم ببخيل في تبليغ الوحي. وما هذا القرآن بقول شيطان رجيم، مطرود من رحمة الله، ولكنه كلام الله ووحيه."},{"totalNumber":5823,"numberInSurah":23,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":"وما محمد الذي تعرفونه بمجنون، ولقد رأى محمد جبريل الذي يأتيه بالرسالة في الأفق العظيم، وما هو ببخيل في تبليغ الوحي. وما هذا القرآن بقول شيطان رجيم، مطرود من رحمة الله، ولكنه كلام الله ووحيه."},{"totalNumber":5824,"numberInSurah":24,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":""},{"totalNumber":5825,"numberInSurah":25,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":""},{"totalNumber":5826,"numberInSurah":26,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":"فأين تذهب بكم عقولكم في التكذيب بالقرآن بعد هذه الحجج القاطعة؟ ما هو إلا موعظة من الله لجميع الناس، لمن شاء منكم أن يستقيم على الحق والإيمان، وما تشاؤون الاستقامة، ولا تقدرون على ذلك، إلا بمشيئة الله رب الخلائق أجمعين."},{"totalNumber":5827,"numberInSurah":27,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":""},{"totalNumber":5828,"numberInSurah":28,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":""},{"totalNumber":5829,"numberInSurah":29,"juz":30,"lang":"Arabic","authorName":"Group of scholars","tafsirName":"Al-Tafsir al-Muyassar","tafsir":""}]}
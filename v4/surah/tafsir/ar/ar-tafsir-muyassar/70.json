  "name": "سُورَةُ المَعَارِجِ",
  "enName": "Al-Ma'aarij",
  "enNameTranslation": "The Ascending Stairways",
  "bnNameTranslation": "আল মাআরিজ",
  "revelationType": "Meccan",

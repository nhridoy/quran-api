      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "عن أيِّ شيء يسأل بعض كفار قريش بعضاً؟ يتساءلون عن الخبر العظيم الشأن، وهو القرآن العظيم الذي ينبئ عن البعث الذي شك فيه كفار قريش وكذَّبوا به."
    },
    {
      "totalNumber": 5674,
      "numberInSurah": 2,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "عن أيِّ شيء يسأل بعض كفار قريش بعضا؟ يتساءلون عن الخبر العظيم الشأن، وهو القرآن العظيم الذي ينبئ عن البعث الذي شك فيه كفار قريش وكذَّبوا به."
    },
    {
      "totalNumber": 5675,
      "numberInSurah": 3,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": ""
    },
    {
      "totalNumber": 5676,
      "numberInSurah": 4,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "ما الأمر كما يزعم هؤلاء المشركون، سيعلم هؤلاء المشركون عاقبة تكذيبهم، ويظهر لهم ما الله فاعل بهم يوم القيامة، ثم سيتأكد لهم ذلك، ويتأكد لهم صدق ما جاء به محمد صلى الله عليه وسلم، من القرآن والبعث. وهذا تهديد ووعيد لهم."
    },
    {
      "totalNumber": 5677,
      "numberInSurah": 5,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": ""
    },
    {
      "totalNumber": 5678,
      "numberInSurah": 6,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "ألم نجعل الأرض ممهدة لكم كالفراش؟"
    },
    {
      "totalNumber": 5679,
      "numberInSurah": 7,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "والجبال رواسي؛ كي لا تتحرك بكم الأرض؟"
    },
    {
      "totalNumber": 5680,
      "numberInSurah": 8,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "وخلقناكم أصنافا ذكرا وأنثى؟"
    },
    {
      "totalNumber": 5681,
      "numberInSurah": 9,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "وجعلنا نومكم راحة لأبدانكم، فيه تهدؤون وتسكنون؟"
    },
    {
      "totalNumber": 5682,
      "numberInSurah": 10,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "وجعلنا الليل لباسًا تَلْبَسكم ظلمته وتغشاكم، كما يستر الثوب لابسه؟"
    },
    {
      "totalNumber": 5683,
      "numberInSurah": 11,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "وجعلنا النهار معاشا تنتشرون فيه لمعاشكم، وتسعَون فيه لمصالحكم؟"
    },
    {
      "totalNumber": 5684,
      "numberInSurah": 12,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "وبنينا فوقكم سبع سموات متينة البناء محكمة الخلق، لا صدوع لها ولا فطور؟"
    },
    {
      "totalNumber": 5685,
      "numberInSurah": 13,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "وجعلنا الشمس سراجًا وقَّادًا مضيئًا؟"
    },
    {
      "totalNumber": 5686,
      "numberInSurah": 14,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "وأنزلنا من السحب الممطرة ماء منصَبّا بكثرة، لنخرج به حبًا مما يقتات به الناس وحشائش مما تأكله الدَّواب، وبساتين ملتفة بعضها ببعض لتشعُّب أغصانها؟"
    },
    {
      "totalNumber": 5687,
      "numberInSurah": 15,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "وأنزلنا من السحب الممطرة ماء منصَبّا بكثرة، لنخرج به حبًا مما يقتات به الناس وحشائش مما تأكله الدَّواب، وبساتين ملتفة بعضها ببعض لتشعب أغصانها؟"
    },
    {
      "totalNumber": 5688,
      "numberInSurah": 16,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": ""
    },
    {
      "totalNumber": 5689,
      "numberInSurah": 17,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "إن يوم الفصل بين الخلق، وهو يوم القيامة، كان وقتًا وميعادًا محددًا للأولين والآخرين، يوم ينفخ المَلَك في <span class=\"brown\">«القرن»</span> إيذانًا بالبعث فتأتون أممًا، كل أمة مع إمامهم."
    },
    {
      "totalNumber": 5690,
      "numberInSurah": 18,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "إن يوم الفصل بين الخلق، وهو يوم القيامة، كان وقتًا وميعادًا محددًا للأولين والآخرين، يوم ينفخ المَلَك في <span class=\"red\">\"القرن\"</span> إيذانًا بالبعث فتأتون أممًا، كل أمة مع إمامهم."
    },
    {
      "totalNumber": 5691,
      "numberInSurah": 19,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "وفُتحت السماء، فكانت ذات أبواب كثيرة لنزول الملائكة."
    },
    {
      "totalNumber": 5692,
      "numberInSurah": 20,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "ونسفت الجبال بعد ثبوتها، فكانت كالسراب."
    },
    {
      "totalNumber": 5693,
      "numberInSurah": 21,
      "juz": 30,
      "lang": "Arabic",
      "authorName": "Group of scholars",
      "tafsirName": "Al-Tafsir al-Muyassar",
      "tafsir": "إن جهنم كانت يومئذ ترصد أهل الكفر الذين أُعِدَّت لهم، للكافرين مرجعًا، ماكثين فيها دهورًا متعاقبة لا تنقطع، لا يَطْعَمون فيها ما يُبْرد حرَّ السعير عنهم، ولا شرابًا يرويهم، إلا ماءً حارًا، وصديد أهل النار، يجازَون بذلك جزاء عادلا موافقًا لأعمالهم التي كانوا يعملونها في الدنيا."
    },
    {
      "totalNumber": 5694,

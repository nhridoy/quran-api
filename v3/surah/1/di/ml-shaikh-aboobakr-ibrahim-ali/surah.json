      "sajda": {
        "recommended": false,
        "obligatory": false
      },
      "text_uthmani": "صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ",
      "text_uthmani_simple": "صرط الذين انعمت عليهم غير المغضوب عليهم ولا الضالين",
      "text_imlaei": "صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ",
      "text_imlaei_simple": "صراط الذين انعمت عليهم غير المغضوب عليهم ولا الضالين",
      "text_indopak": "صِرَاطَ الَّذِيۡنَ اَنۡعَمۡتَ عَلَيۡهِمۡ ۙ‏ غَيۡرِ الۡمَغۡضُوۡبِ عَلَيۡهِمۡ وَلَا الضَّآلِّيۡنَ‏",
      "text_uthmani_tajweed": "صِر<tajweed class=madda_normal>َٲ</tajweed>طَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ <tajweed class=ham_wasl>ٱ</tajweed>لْمَغْضُوبِ عَلَيْهِمْ وَلَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ضّ<tajweed class=madda_necessary>َا</tajweed>ٓلّ<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٧</span>",
      "text_literation": "Sirata allatheena anAAamta AAalayhim ghayri almaghdoobi AAalayhim wala addalleen",
      "translated_text": "އެއީ އިބަރަސްކަލާނގެ އެބޭބޭކަލުންނަށް نعمة ލެއްވި (ރަސޫލުބޭކަލުންނާއި ނަބީބޭކަލުންނާއި ޝަހީދުންނާއި صدّيق ންފަދަ) ބޭބޭކަލުންގެ މަގެވެ. އަދި (ޔަހޫދީންފަދައިން) ކޯފާލެއްވުނު މީހުންގެ މަގެއްނޫނެވެ. އަދި (نصارى އިންފަދައިން) މަގުފުރެދުނުމީހުންގެ މަގެއްވެސްނުމެނޫންމެއެވެ.\\n• ދަންނައެ! آمين މިކަލިމައަކީ الحمد ގެ ބައެއްނޫނެވެ. އެއީ خاصّ دعاء އެކެވެ. އޭގެ މާނައަކީ އަޅަމެންގެ دعاء އިޖާބަކުރައްވާނދޭވެ. މިއެވެ.\\n• أَعُوذ އާއި بِسْم އާއި އަދި الحمد ގައި އެކުލެވިގެންވާ ބައެއް ކަލިމައާއިމެދު تفسير علم ވެރިން ދައްކަވާފައިވާ ދިގު تَفْصِيل ވާހަކައާއި إِخْتِلاَفُ މިކުޑަކުޑަ ތަރުޖަމާއަށް އުފުލައިގަނެވޭވަރު ނުވާތީއެވާހަކަތައް ﷲ توفيق ދެއްވި އެހެން ވަގުތެއްގައި ކޮންމެވެސް މިންވަރަކަށް بيان ކޮށްދިނުމުގެ قصد ގައި އިހަށް ބޭއްވީއެވެ. އެވާހަކަތައް އަޅުގަނޑުމެންނަށް ބަޔާންކޮށްދެވޭތޯ ޤަލަމްކޮޅުތައް حركات ކުރެއްވި ބޭބޭކަލުންނަށް ﷲ ހެޔޮ رحمة އާއި މާތް ދަރަޖަދެއްވާނދޭވެ! އަޅަމެން އޭގައި شامل ކުރައްވާނދޭވެ! آمين آمين آمين",
